# Ghostty config — trialed as an alternative to Alacritty (kitty-graphics-protocol terminal
# for nvim inline images). Cross-platform (Linux + macOS). Palette mirrors the Alacritty
# gruvbox-dark config (dot_config/alacritty/alacritty.toml) so the trial is visually identical.

font-family = "Inconsolata Nerd Font"
font-size = 14

# gruvbox dark — mirrors the Alacritty palette exactly
background = #282828
foreground = #ebdbb2
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# epoll, not io_uring, for the event loop (Linux only; macOS always uses kqueue and ignores this).
# Ghostty's io_uring loop waits with a read pending, and the kernel counts that wait as iowait, so
# /proc/pressure/io reads 50-75% "full" on an idle machine and stops meaning anything for anyone
# reading it. Measured on the workstation 2026-11-28: the Ghostty scope held the whole system's io
# stall while the NVMe was busy 1.2% of the sample, and a minimal io_uring wait showed the same
# stall unless it set IORING_ENTER_NO_IOWAIT. Ghostty's docs report no measured difference between
# the backends. Takes effect only after a full Ghostty restart.
async-backend = epoll
