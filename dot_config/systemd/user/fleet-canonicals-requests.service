# One pass over the canonical lifecycle request queue: each request a sandboxed session wrote with
# `fleet-canonicals request` is checked and, if every check passes, its verb is run. Run by
# fleet-canonicals-requests.timer every minute; see `fleet-canonicals --help`.
# Linux only: the base's .chezmoiignore skips .config/systemd on macOS, which runs the LaunchAgent
# local.dotfiles.fleet-canonicals-requests instead.
#
# Not enabled by the base. The machine's owner enables the timer once, from a terminal:
#   systemctl --user enable --now fleet-canonicals-requests.timer
[Unit]
Description=Serve the canonical lifecycle request queue (fleet-canonicals serve-requests)

[Service]
Type=oneshot
# A user unit's PATH is the manager's, which lacks ~/.local/bin, where the base installs
# fleet-canonicals and fleet-decl and where Claude Code installs `claude`. A session this runner
# launches inherits this PATH, so it also carries fnm's default Node (node, npm, npx), which an
# interactive shell gets from .zshrc and a service never reads (measured 2026-11-08: a refreshed
# canonical had no npm or npx). It is fnm's default alias, not a shell's per-session multishell
# link, so every launch gets the same Node. A machine without fnm simply has no such directory.
Environment=PATH=%h/.local/bin:%h/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/fleet-canonicals serve-requests
# A refresh waits for a stopped row and a launch; this bounds a pass that hangs.
TimeoutStartSec=15min
