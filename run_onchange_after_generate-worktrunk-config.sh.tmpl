#!/bin/sh
# Regenerates worktrunk's user config whenever its public inputs change.
#
# worktrunk's config.toml is generated by wt-config-gen from base.toml, an optional private
# fragment and a repo manifest (see the generator's header). This script re-runs it when the
# base.toml or the generator itself changes; a private layer carries its own trigger for its inputs.
#   base.toml:     {{ include "dot_config/worktrunk/base.toml" | sha256sum }}
#   wt-config-gen: {{ include "private_dot_local/bin/executable_wt-config-gen" | sha256sum }}
#
# A machine without worktrunk is not an error -- this layer is installed on machines that may not
# use it -- but a generator that runs and fails is: the apply reports it, and the previous config
# stays in place, because the generator never replaces the file on failure.
set -eu
command -v wt >/dev/null 2>&1 || { echo "generate-worktrunk-config: wt not installed, skipped" >&2; exit 0; }
command -v wt-config-gen >/dev/null 2>&1 || { echo "generate-worktrunk-config: wt-config-gen not on PATH" >&2; exit 1; }
wt-config-gen
