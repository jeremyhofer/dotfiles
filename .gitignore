__pycache__/
node_modules/
.nx/
# A pytest run by hand leaves .pytest_cache/, which ignores itself with an inner .gitignore. Unlisted
# here, git descends into it, and every suite that walks the checkout with git reads that file, which
# verify-task-io refuses at landing (2026-11-22). The suites themselves write none (PYTEST_ADDOPTS).
.pytest_cache/

# Nested worktrees (the fleet layout puts them at .worktrees/<name>, or at .claude/worktrees/<name>
# where the claudeWorktrees flag is on). Ignored here, not only by a global excludes file, because the
# suites run with no global git config and copy the source tree.
.worktrees/
.claude/worktrees/
