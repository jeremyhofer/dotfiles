#!/bin/sh
# overlay-doctor — audit a private overlay against the current standard and point at what
# to provision. READ-ONLY; never mutates. Exit 0 = compliant; 1 = a required piece is
# missing/placeholder; 2 = precondition error. Runnable from the public base checkout ALONE
# (a fresh/locked-down box may have only the base cloned) — it inspects the overlay SOURCE
# tree for presence + shape, and PATH for the base-provided generic mechanism.
#
# Tiers: A generic (from the base, auto-propagated) · B private-vocab (authored per-domain
# from THAT domain's own vault — never copied from another domain) · C domain-specific ·
# H leak-guard (OPTIONAL, home-only by design). Only required A/B/C pieces gate the exit;
# Tier H is reported, never enforced.
set -eu

OSRC="${OVERLAY_SRC:-$HOME/.local/share/chezmoi-overlay}"
BSRC="${BASE_SRC:-$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd)}"
STUB_MARK='FIXME(overlay-doctor)'   # scaffold stubs carry this until filled in
fail=0
note() { printf '  %s\n' "$*"; }
miss() { printf '  MISSING     %s\n' "$*"; fail=1; }
stub() { printf '  PLACEHOLDER %s\n' "$*"; fail=1; }

[ -d "$OSRC" ] || {
  echo "overlay-doctor: no overlay source at $OSRC" >&2
  echo "  scaffold one first:  setup/scaffold-overlay $OSRC" >&2
  exit 2
}

# require REL DESC — a required file must exist and not still carry the stub sentinel.
require() {
  # A required piece may be authored as a chezmoi TEMPLATE -- ssh/config.tmpl is the same
  # provisioned thing as ssh/config. Checking only the literal name reported the real home
  # overlay's Brewfile.role.tmpl and ssh/config.tmpl as MISSING and exited 1 on a fully
  # provisioned overlay; an audit that cries wolf on a correct setup trains you to ignore it.
  _f="$OSRC/$1"
  [ -f "$_f" ] || _f="$OSRC/$1.tmpl"
  if [ ! -f "$_f" ]; then miss "$1 ($2)"
  elif grep -q "$STUB_MARK" "$_f" 2>/dev/null; then stub "$1"
  fi
}

echo "overlay-doctor: auditing $OSRC"

# --- Tier A: generic mechanism (base-provided; auto-propagated, non-gating) ---
if command -v spell-capture >/dev/null 2>&1; then
  note "OK          Tier A: spell-capture on PATH (base applied)"
else
  note "WARN        Tier A: spell-capture not on PATH — apply the base (chezmoi apply)"
fi

# --- Overlay config template (chezmoi init renders it; prompts the per-machine config data) ---
require .chezmoi.toml.tmpl "overlay config template (prompts nasGit/secretsRepo via chezmoi init)"

# --- Tier B: private-vocab (author from THIS domain's vault) ---
require dot_dotlocal/gitconfig                  "identity: user/signingkey/gpgsign"
if [ -f "$OSRC/dot_dotlocal/gitconfig" ] && ! grep -q 'signingkey' "$OSRC/dot_dotlocal/gitconfig"; then
  miss "dot_dotlocal/gitconfig: no signingkey (identity incomplete)"
fi
require dot_dotlocal/allowed_signers            "signer principals"
require dot_dotlocal/zshenv.tmpl                "private env layer"
require dot_config/nvim/spell/private.utf-8.add "private spell tier (may be empty)"
# ensure-keys required only where this domain actually signs.
if [ -f "$OSRC/dot_dotlocal/gitconfig" ] && grep -Eq 'gpgsign[[:space:]]*=[[:space:]]*true' "$OSRC/dot_dotlocal/gitconfig"; then
  [ -f "$OSRC/private_dot_local/bin/executable_ensure-keys" ] \
    || miss "private_dot_local/bin/executable_ensure-keys (gpgsign=true needs the signing-key preload)"
fi

# --- Tier C: domain-specific ---
require dot_dotlocal/Brewfile.role "role Brewfile (private additions; the base self-includes it)"
require dot_dotlocal/ssh/config    "ssh host config"
require Devel/mani.yaml.tmpl       "fleet repo manifest (mani clones/syncs ~/Devel)"
ls "$OSRC"/dot_dotlocal/bootstrap.d/*.sh >/dev/null 2>&1 \
  || miss "dot_dotlocal/bootstrap.d/*.sh (at least one stage)"

# --- Tier S: skills layer (base ships the public half; the overlay supplies private fragments) ---
# Promised when the skills layer was designed and initially not built, so every hybrid skill's
# fragment was verified BY HAND -- the vigilance-instead-of-mechanism this auditor exists to replace.
_skdir="$BSRC/dot_claude/skills"
if [ -d "$_skdir" ]; then
  for _sk in "$_skdir"/*/SKILL.md; do
    [ -f "$_sk" ] || continue
    _skname=$(basename "$(dirname "$_sk")")
    # Pointer resolution: a public skill that defers to a fragment must have that fragment supplied
    # by THIS overlay, or its deferral is a dead end for the reader.
    for _ref in $(grep -o '\.dotlocal/skills/[A-Za-z0-9._-]*\.md' "$_sk" 2>/dev/null | sort -u); do
      _frag=${_ref##*/}
      if [ -f "$OSRC/dot_dotlocal/skills/$_frag" ]; then
        note "OK          Tier S: skill '$_skname' -> fragment $_frag supplied"
      else
        # Non-gating by design: the public half must stand alone on a machine whose domain has
        # nothing to add, so an unsupplied fragment is a gap to notice, not a broken overlay.
        note "WARN        Tier S: skill '$_skname' defers to $_frag, which this overlay does not supply"
      fi
    done
  done

  # Publish-safety: the base is PUBLIC. Its skills must not carry this domain's private vocabulary.
  # The vocabulary is read from the OVERLAY at runtime, so the public base never embeds the patterns
  # it is being checked against -- the same reason the leak-guard keeps its word list private.
  _vocab="$OSRC/dot_dotlocal/git-leak-markers"
  if [ -f "$_vocab" ]; then
    _re=$(grep -v '^[[:space:]]*#' "$_vocab" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1)
    if [ -n "$_re" ]; then
      _hits=$(grep -rInE "$_re" "$_skdir" 2>/dev/null | head -5 || true)
      if [ -n "$_hits" ]; then
        printf '%s\n' "$_hits" | while IFS= read -r _h; do [ -n "$_h" ] && printf '  found       %s\n' "$_h"; done
        miss "public base skills carry this domain's private vocabulary (above) — move that content into an overlay fragment; the base is world-readable"
      fi
    fi
  fi
fi

# --- Tier H: leak-guard (optional, home-only) ---
if [ -d "$OSRC/dot_dotlocal/git-hooks" ]; then
  note "OK          Tier H: leak-guard present (home profile)"
else
  note "info        Tier H: leak-guard not installed (optional; home-only by design)"
fi

# ============================================================================================
# Cross-layer safety — base <-> overlay are two chezmoi instances both targeting ~. Their managed
# sets must stay disjoint (no co-owned target FILE) and neither may put a DELETING attribute (exact_/remove_) on a co-owned or
# shared directory, or conflicting perms on a co-owned one. (Born from a real data-loss incident.)
# ============================================================================================
TAB=$(printf '\t')

# Map a chezmoi SOURCE relpath to its TARGET relpath + the (sorted) attribute-set on its LAST component.
_totarget() {
  _p=$1; _tgt=""; _la=""; _oIFS=$IFS; IFS=/
  for _c in $_p; do
    [ "$_c" = "." ] && continue
    _r=$_c; _a=""
    while :; do
      case $_r in
        encrypted_*)  _a="${_a}encrypted ";  _r=${_r#encrypted_} ;;
        private_*)    _a="${_a}private ";    _r=${_r#private_} ;;
        readonly_*)   _a="${_a}readonly ";   _r=${_r#readonly_} ;;
        exact_*)      _a="${_a}exact ";      _r=${_r#exact_} ;;
        executable_*) _a="${_a}executable "; _r=${_r#executable_} ;;
        symlink_*)    _a="${_a}symlink ";    _r=${_r#symlink_} ;;
        create_*)     _a="${_a}create ";     _r=${_r#create_} ;;
        modify_*)     _a="${_a}modify ";     _r=${_r#modify_} ;;
        remove_*)     _a="${_a}remove ";     _r=${_r#remove_} ;;
        literal_*)    _r=${_r#literal_} ;;
        *) break ;;
      esac
    done
    case $_r in dot_*) _r=".${_r#dot_}" ;; esac
    _tgt="$_tgt/$_r"; _la=$_a
  done
  IFS=$_oIFS
  printf '%s\t%s\n' "${_tgt#/}" "$(printf '%s' "$_la" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
}

# Emit "target<TAB>attrs" per managed directory in a source tree (skip VCS + non-deployed meta dirs).
# Same as _emit_dirs but for FILES, and skipping chezmoi METADATA (.chezmoi*), which exists in
# both trees by design and is never a deployed target -- counting it would false-positive forever.
_emit_files() {
  [ -d "$1" ] || return 0
  ( CDPATH= cd -- "$1" && find . -type f \
      ! -path './.git' ! -path './.git/*' \
      ! -name '.chezmoi*' ! -path './.chezmoi*' \
      ! -name '.chezmoitemplates' ! -path './.chezmoitemplates/*' \
      ! -path './tests' ! -path './tests/*' ! -path './setup' ! -path './setup/*' \
      ! -path './overlay-skeleton' ! -path './overlay-skeleton/*' -print ) \
  | while IFS= read -r _pp; do [ "$_pp" = "." ] || _totarget "${_pp#./}"; done
}

_emit_dirs() {
  [ -d "$1" ] || return 0
  ( CDPATH= cd -- "$1" && find . -type d \
      ! -path './.git' ! -path './.git/*' \
      ! -name '.chezmoitemplates' ! -path './.chezmoitemplates/*' \
      ! -path './tests' ! -path './tests/*' ! -path './setup' ! -path './setup/*' \
      ! -path './overlay-skeleton' ! -path './overlay-skeleton/*' -print ) \
  | while IFS= read -r _pp; do [ "$_pp" = "." ] || _totarget "${_pp#./}"; done
}

echo
echo "cross-layer safety (base <-> overlay):"
xmark=$(mktemp "${TMPDIR:-/tmp}/xdoctor.XXXXXX"); btmp=$(mktemp "${TMPDIR:-/tmp}/xdoctor-b.XXXXXX")
bftmp=$(mktemp "${TMPDIR:-/tmp}/xdoctor-bf.XXXXXX")
trap 'rm -f "$xmark" "$btmp" "$bftmp"' EXIT
xbad() { printf '  CONFLICT    %s\n' "$*"; printf 'x\n' >> "$xmark"; }

# (1) Destructive attributes anywhere (exact_/remove_) — the ONLY attrs that delete unmanaged files.
#     A stray exact_ on a co-owned dir (~/.local/bin, ~/.config) wipes the other layer + real tools.
_dz=$(find "$BSRC" "$OSRC" -path '*/.git' -prune -o \( -name 'exact_*' -o -name '*_exact_*' -o -name 'remove_*' -o -name '*_remove_*' \) -print 2>/dev/null || true)
if [ -n "$_dz" ]; then
  printf '%s\n' "$_dz" | while IFS= read -r _d; do [ -n "$_d" ] && printf '  found       %s\n' "$_d"; done
  xbad "'exact_'/'remove_' attribute present (above) — it deletes unmanaged files in its target dir; forbidden on the co-owned home tree. Remove it, or confine it to a directory ONLY this layer owns."
fi

# (2) Directory attribute conflicts on co-owned dirs (e.g. private_ vs plain -> 0700<->0755 flip-flop).
_emit_dirs "$BSRC" > "$btmp"
_emit_dirs "$OSRC" | while IFS="$TAB" read -r _otgt _oattr; do
  [ -n "$_otgt" ] || continue
  if _battr=$(awk -F"$TAB" -v t="$_otgt" '$1==t{print $2; f=1} END{exit !f}' "$btmp"); then
    [ "$_battr" = "$_oattr" ] || xbad "directory '$_otgt' co-owned with CONFLICTING attributes — base:[${_battr:-none}] overlay:[${_oattr:-none}] (perms flip-flop on alternating applies). Make them agree."
  fi
done

# (2b) The SAME TARGET FILE owned by BOTH layers. The rule at the top of this section -- managed
# sets stay disjoint -- was stated but never enforced: only directory ATTRIBUTES were compared, so a
# co-owned FILE passed silently and became last-apply-wins, each instance behaving correctly by its
# own lights and neither able to see the other. That is the same silent-loss shape as a stray exact_,
# and it is invisible after the fact. Repo docs are excluded above with the rest of the metadata.
# Honour each tree's .chezmoiignore for this comparison: a file both trees carry but neither
# DEPLOYS (agent context like CLAUDE.md, repo READMEs) is not a collision. Literal lines only --
# templated or glob rules are not evaluated here, so this can only ever UNDER-ignore, i.e. it may
# report a collision that ignores would have excused, never hide a real one.
_ignored() {  # _ignored <tree> <target-path>
  _ig="$1/.chezmoiignore"; [ -f "$_ig" ] || return 1
  grep -v '^[[:space:]]*#' "$_ig" 2>/dev/null | grep -v '{{' \
    | sed 's/[[:space:]]*$//' | grep -qxF "$2"
}

_emit_files "$BSRC" > "$bftmp"
_emit_files "$OSRC" | while IFS="$TAB" read -r _otgt _oattr; do
  [ -n "$_otgt" ] || continue
  if awk -F"$TAB" -v t="$_otgt" '$1==t{f=1} END{exit !f}' "$bftmp"; then
    _ignored "$BSRC" "$_otgt" && continue
    _ignored "$OSRC" "$_otgt" && continue
    xbad "co-owned file '$_otgt' is managed by BOTH layers — last-apply-wins, silently. Give it exactly one owner; if the other layer needs a say, use the ~/.dotlocal fragment-include indirection."
  fi
done

# (3) Always-print destructive-directive summary — the "be careful, review this" line, never silent.
for _pair in "base=$BSRC" "overlay=$OSRC"; do
  _who=${_pair%%=*}; _dir=${_pair#*=}
  if [ -f "$_dir/.chezmoiremove" ]; then
    # The file is a TEMPLATE. Printing it raw listed '{{ if ... }}' and '{{ end }}' as if they were
    # removal targets, and left the reader unable to tell whether a guarded entry applies to THIS
    # machine -- in a summary whose entire job is to warn before something is deleted. Control lines
    # are now shown as the guard they are, and entries inside one are marked conditional.
    _guard=""
    grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$_dir/.chezmoiremove" 2>/dev/null \
      | while IFS= read -r _ln; do
          [ -n "$_ln" ] || continue
          case "$_ln" in
            *'{{'*'end'*'}}'*) _guard=""; continue ;;
            *'{{'*)            _guard=$(printf '%s' "$_ln" | tr -d '{}' | sed 's/^[[:space:]-]*//;s/[[:space:]-]*$//'); continue ;;
          esac
          if [ -n "$_guard" ]; then
            printf '  removes (%s)  %s   [ONLY IF: %s -- depends on this machine]\n' "$_who" "$_ln" "$_guard"
          else
            printf '  removes (%s)  %s   [ALWAYS]\n' "$_who" "$_ln"
          fi
        done
  fi
done

if [ -s "$xmark" ]; then fail=1; else note "OK          no cross-layer conflicts"; fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

overlay-doctor: the overlay is INCOMPLETE. Provision each MISSING/PLACEHOLDER item above
from THIS domain's own vault/records (identity + signing key, signer principals, host
aliases) and remove the FIXME line once filled. Generic mechanism (Tier A) comes from the
base automatically — apply the base if it is not on PATH. Never copy private values from
another domain's overlay.
MSG
  exit 1
fi
echo "overlay-doctor: compliant — every required tier is present and filled."
exit 0
