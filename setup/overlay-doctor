#!/bin/sh
# overlay-doctor — audit a private overlay against the current standard and point at what
# to provision. READ-ONLY; never mutates. Exit 0 = compliant; 1 = a required piece is
# missing/placeholder; 2 = precondition error. Runnable from the public base checkout ALONE
# (a fresh/locked-down box may have only the base cloned) — it inspects the overlay SOURCE
# tree for presence + shape, and PATH for the base-provided generic mechanism.
#
# Tiers: A generic (from the base, auto-propagated) · B private-vocab (authored per-domain
# from THAT domain's own vault — never copied from another domain) · C domain-specific ·
# H leak-guard (OPTIONAL: on when the domain supplies pattern files) · V signing-verification material
# (ADVISORY). Only required A/B/C pieces gate the exit; Tiers H and V are reported, never
# enforced -- signing is legitimately disabled where an agent sandbox cannot reach ~/.ssh.
set -eu

# macOS sets TMPDIR WITH a trailing slash, so a naive "$_TMP/x.XXXXXX" yields a
# path containing "//". Harmless for file I/O and fatal the moment such a path is compared
# textually against one a tool reports back normalized. Strip it once, here.
_TMP=${TMPDIR:-/tmp}; _TMP=${_TMP%/}
OSRC="${OVERLAY_SRC:-$HOME/.local/share/chezmoi-overlay}"
BSRC="${BASE_SRC:-$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd)}"
STUB_MARK='FIXME(overlay-doctor)'   # scaffold stubs carry this until filled in
fail=0
note() { printf '  %s\n' "$*"; }
miss() { printf '  MISSING     %s\n' "$*"; fail=1; }
stub() { printf '  PLACEHOLDER %s\n' "$*"; fail=1; }

# --- Machine assessment (ADVISORY, never gating) ---------------------------------------------
# What this machine can do for the setup, measured rather than assumed: the git that runs and whether
# its configured hooks fire, the tools the base expects, the shell, and Claude Code with the key names
# of any managed policy. It prints versions, presence and key names only -- never a value, and never a
# path under the home directory -- so the report can be read aloud or retyped off any machine.
# `overlay-doctor --machine` runs this alone, with or without an overlay.
_home_safe() { case "$1" in "$HOME"/*) printf '~/%s' "${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }
assess() {
  echo
  echo "machine assessment (advisory):"
  # git: configured hooks (hook.<name>.command/.event) need 2.54+; an older git skips them silently.
  if command -v git >/dev/null 2>&1; then
    _gv=$(git --version 2>/dev/null | awk '{print $3}')
    _maj=$(printf '%s' "$_gv" | cut -d. -f1); _min=$(printf '%s' "$_gv" | cut -d. -f2)
    if [ "${_maj:-0}" -gt 2 ] 2>/dev/null || { [ "${_maj:-0}" -eq 2 ] && [ "${_min:-0}" -ge 54 ]; } 2>/dev/null; then
      note "git                   $_gv (configured hooks supported)"
    else
      note "git                   $_gv -- older than 2.54: configured hooks (the secret scan, the co-author trailer) are skipped silently"
    fi
    _all=""; _oIFS=$IFS; IFS=:
    for _d in $PATH; do [ -x "$_d/git" ] && _all="$_all $(_home_safe "$_d/git")"; done
    IFS=$_oIFS
    note "git on PATH, in order $_all"
    # Fire one: a throwaway repository, no global or system config, one configured pre-commit hook
    # that refuses. A commit that then fails, where the same commit without the hook succeeds, is a
    # hook that fired. The control keeps "git could not commit at all" from reading as a yes.
    _hr=$(mktemp -d "$_TMP/assess-hook.XXXXXX")
    if ( cd "$_hr" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git init -q . >/dev/null 2>&1 ); then
      _c() { ( cd "$_hr" && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c user.name=a -c user.email=a@a \
                 -c commit.gpgsign=false "$@" commit -q --allow-empty -m probe >/dev/null 2>&1 ); }
      if ! _c; then note "configured hooks fire  INCONCLUSIVE (a plain commit failed)"
      elif _c -c hook.assess.command=false -c hook.assess.event=pre-commit; then note "configured hooks fire  no"
      else note "configured hooks fire  yes"
      fi
    else
      note "configured hooks fire  INCONCLUSIVE (could not create a repository)"
    fi
    rm -rf "$_hr"
    _gh=$(git config --global --get-regexp '^hook\..*\.event$' 2>/dev/null | sed 's/^hook\.//;s/\.event .*//' | tr '\n' ' ')
    note "global configured hooks ${_gh:-none}"
  else
    note "git                   missing"
  fi
  # Tools the base expects. Override the list with ASSESS_TOOLS (space-separated).
  for _t in ${ASSESS_TOOLS:-git zsh jq yq gitleaks chezmoi mani wt claude}; do
    if command -v "$_t" >/dev/null 2>&1; then note "present               $_t"; else note "missing               $_t"; fi
  done
  _sh=${SHELL##*/}
  if [ "$_sh" = zsh ] && command -v zsh >/dev/null 2>&1; then
    note "login shell           zsh $(zsh --version 2>/dev/null | awk '{print $2}')"
  else
    note "login shell           ${_sh:-unknown}"
  fi
  note "operating system      $(uname -s) $( [ "$(uname -s)" = Darwin ] && sw_vers -productVersion 2>/dev/null || uname -r)"
  if command -v claude >/dev/null 2>&1; then
    note "Claude Code           $(claude --version 2>/dev/null | awk '{print $1}')"
  else
    note "Claude Code           not on PATH"
  fi
  # A managed policy an administrator installed. Key names only: they say which settings are enforced.
  _ms=${ASSESS_MANAGED_SETTINGS:-}
  if [ -z "$_ms" ]; then
    for _c2 in "/Library/Application Support/ClaudeCode/managed-settings.json" /etc/claude-code/managed-settings.json; do
      [ -f "$_c2" ] && { _ms=$_c2; break; }
    done
  fi
  if [ -n "$_ms" ] && [ -f "$_ms" ]; then
    if command -v jq >/dev/null 2>&1; then
      note "managed settings keys $(jq -r 'keys | join(" ")' "$_ms" 2>/dev/null || echo '(unreadable)')"
    else
      note "managed settings      present (install jq to list its key names)"
    fi
  else
    note "managed settings      none"
  fi
  note "next: claude-context-probe (what Claude Code loads here); claude-context-probe --fleet (background-session features)"
}

if [ "${1:-}" = "--machine" ]; then assess; exit 0; fi

[ -d "$OSRC" ] || {
  echo "overlay-doctor: no overlay source at $OSRC" >&2
  echo "  scaffold one first:  setup/scaffold-overlay $OSRC" >&2
  exit 2
}

# require REL DESC — a required file must exist and not still carry the stub sentinel.
require() {
  # A required piece may be authored as a chezmoi TEMPLATE -- ssh/config.tmpl is the same
  # provisioned thing as ssh/config. Checking only the literal name reported the real home
  # overlay's Brewfile.role.tmpl and ssh/config.tmpl as MISSING and exited 1 on a fully
  # provisioned overlay; an audit that cries wolf on a correct setup trains you to ignore it.
  _f="$OSRC/$1"
  [ -f "$_f" ] || _f="$OSRC/$1.tmpl"
  if [ ! -f "$_f" ]; then miss "$1 ($2)"
  elif grep -q "$STUB_MARK" "$_f" 2>/dev/null; then stub "$1"
  fi
}

echo "overlay-doctor: auditing $OSRC"

# --- Tier A: generic mechanism (base-provided; auto-propagated, non-gating) ---
if command -v spell-capture >/dev/null 2>&1; then
  note "OK          Tier A: spell-capture on PATH (base applied)"
else
  note "WARN        Tier A: spell-capture not on PATH — apply the base (chezmoi apply)"
fi

# --- Overlay config template (chezmoi init renders it; prompts the per-machine config data) ---
require .chezmoi.toml.tmpl "overlay config template (chezmoi init prompts this domain's [data] values)"

# --- Tier B: private-vocab (author from THIS domain's vault) ---
require dot_dotlocal/gitconfig                  "identity: user/signingkey/gpgsign"
if [ -f "$OSRC/dot_dotlocal/gitconfig" ] && ! grep -q 'signingkey' "$OSRC/dot_dotlocal/gitconfig"; then
  miss "dot_dotlocal/gitconfig: no signingkey (identity incomplete)"
fi
require dot_dotlocal/allowed_signers            "signer principals"
require dot_dotlocal/zshenv.tmpl                "private env layer"
require dot_config/nvim/spell/private.utf-8.add "private spell tier (may be empty)"
# ensure-keys required only where this domain actually signs.
if [ -f "$OSRC/dot_dotlocal/gitconfig" ] && grep -Eq 'gpgsign[[:space:]]*=[[:space:]]*true' "$OSRC/dot_dotlocal/gitconfig"; then
  [ -f "$OSRC/private_dot_local/bin/executable_ensure-keys" ] \
    || miss "private_dot_local/bin/executable_ensure-keys (gpgsign=true needs the signing-key preload)"
fi

# --- Tier C: domain-specific ---
require dot_dotlocal/Brewfile.role "role Brewfile (private additions; the base self-includes it)"
require dot_dotlocal/ssh/config    "ssh host config"
require Devel/mani.yaml.tmpl       "fleet repo manifest (mani clones/syncs ~/Devel)"
# The manifest's SCHEMA, checked on the DEPLOYED record (the source is a template): the same
# `fleet-decl --check` every reader of the record trusts, so a typo'd key, a missing policy or a
# half-declared canonical gates here rather than surfacing later as a guard quietly using its
# default. Not yet deployed is reported, not gated: apply the overlay and re-run.
_rec="${FLEET_RECORD:-$HOME/Devel/mani.yaml}"
_fd="$BSRC/private_dot_local/bin/executable_fleet-decl"
if [ ! -f "$_rec" ]; then
  note "WARN        manifest: $(_home_safe "$_rec") is not deployed yet; apply the overlay, then re-run"
elif [ ! -f "$_fd" ]; then
  note "WARN        manifest: no fleet-decl in the base checkout, so its schema is not checked"
else
  _mo=$(FLEET_RECORD="$_rec" sh "$_fd" --check 2>&1) && _mrc=0 || _mrc=$?
  case "$_mrc" in
    0) note "OK          manifest: $(_home_safe "$_rec") passes fleet-decl --check" ;;
    1) printf '%s\n' "$_mo" | grep '^\[' | while IFS= read -r _l; do printf '  MISSING     manifest: %s\n' "$_l"; done
       fail=1 ;;
    *) miss "manifest: fleet-decl --check cannot read $(_home_safe "$_rec"): $(printf '%s' "$_mo" | head -1)" ;;
  esac
fi

# The global gitignore must carry the base's defaults. git reads ONE global ignore file, so the
# overlay owns it and the defaults have to be copied in; this keeps the copy from drifting. The list
# is the skeleton's example, every non-comment line above its domain-additions marker.
_gdef="$BSRC/overlay-skeleton/dot_gitignore_global.example"
_gi="$OSRC/dot_gitignore_global"; [ -f "$_gi" ] || _gi="$_gi.tmpl"
if [ ! -f "$_gdef" ]; then
  note "WARN        gitignore: the base has no default list ($_gdef), so none is checked"
elif [ ! -f "$_gi" ]; then
  miss "dot_gitignore_global (the global gitignore; it must carry the base defaults in $_gdef)"
else
  _gm=$(sed '/^# --- domain-specific additions below ---/,$d' "$_gdef" \
        | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' \
        | while IFS= read -r _l; do grep -qxF -- "$_l" "$_gi" || printf '%s\n' "$_l"; done)
  if [ -n "$_gm" ]; then
    printf '%s\n' "$_gm" | while IFS= read -r _l; do printf '  MISSING     dot_gitignore_global lacks the base default: %s\n' "$_l"; done
    fail=1
  else
    note "OK          gitignore: every base default is in dot_gitignore_global"
  fi
fi
ls "$OSRC"/dot_dotlocal/bootstrap.d/*.sh >/dev/null 2>&1 \
  || miss "dot_dotlocal/bootstrap.d/*.sh (at least one stage)"

# --- Tier S: skills layer (base ships the public half; the overlay supplies private fragments) ---
# Promised when the skills layer was designed and initially not built, so every hybrid skill's
# fragment was verified BY HAND -- the vigilance-instead-of-mechanism this auditor exists to replace.
_skdir="$BSRC/dot_claude/skills"
if [ -d "$_skdir" ]; then
  for _sk in "$_skdir"/*/SKILL.md; do
    [ -f "$_sk" ] || continue
    _skname=$(basename "$(dirname "$_sk")")
    # Pointer resolution: a public skill that defers to a fragment must have that fragment supplied
    # by THIS overlay, or its deferral is a dead end for the reader.
    for _ref in $(grep -o '\.dotlocal/skills/[A-Za-z0-9._-]*\.md' "$_sk" 2>/dev/null | sort -u); do
      _frag=${_ref##*/}
      if [ -f "$OSRC/dot_dotlocal/skills/$_frag" ]; then
        note "OK          Tier S: skill '$_skname' -> fragment $_frag supplied"
      else
        # Non-gating by design: the public half must stand alone on a machine whose domain has
        # nothing to add, so an unsupplied fragment is a gap to notice, not a broken overlay.
        note "WARN        Tier S: skill '$_skname' defers to $_frag, which this overlay does not supply"
      fi
    done
  done

  # Publish-safety: the base is PUBLIC. Its skills must not carry this domain's private vocabulary.
  # The vocabulary is read from the OVERLAY at runtime, so the public base never embeds the patterns
  # it is being checked against -- the same reason the leak-guard keeps its word list private.
  _vocab="$OSRC/dot_dotlocal/git-leak-markers"
  if [ -f "$_vocab" ]; then
    _re=$(grep -v '^[[:space:]]*#' "$_vocab" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1)
    if [ -n "$_re" ]; then
      _hits=$(grep -rInE "$_re" "$_skdir" 2>/dev/null | head -5 || true)
      if [ -n "$_hits" ]; then
        printf '%s\n' "$_hits" | while IFS= read -r _h; do [ -n "$_h" ] && printf '  found       %s\n' "$_h"; done
        miss "public base skills carry this domain's private vocabulary (above) — move that content into an overlay fragment; the base is world-readable"
      fi
    fi
  fi
fi

# --- Tier V: signing verification material (ADVISORY, never gating) ---
#
# `allowed_signers` is a shared, overlay-managed asset: every signing repo on this machine points
# `gpg.ssh.allowedSignersFile` at the same file, so one bad or absent copy degrades signature
# VERIFICATION everywhere at once, silently -- git reports an unverified signature much the same
# way it reports a missing signer file.
#
# REPORTED, NEVER ENFORCED, and that is a deliberate constraint rather than laziness: signing is
# legitimately disabled in some environments. Where an agent's sandbox cannot reach ~/.ssh at all,
# even for a signing key, requiring signers would turn a correct setup into a hard failure -- exactly the cry-wolf failure the `require` helper above already
# documents for templated files. An advisory line is useful; a gate here would be wrong.
_as=$(git config --get gpg.ssh.allowedSignersFile 2>/dev/null || true)
case "$_as" in "~/"*) _as="$HOME/${_as#\~/}" ;; esac
if [ -z "$_as" ]; then
  note "info        Tier V: no allowedSignersFile configured (signature verification is off here)"
elif [ ! -f "$_as" ]; then
  note "advisory    Tier V: allowedSignersFile points at a missing file: $_as"
  note "            signature verification cannot succeed; not gating (signing may be off by design)"
else
  # A principal line is "<principal> [namespaces=...] <keytype> <key>". Comment and blank lines
  # do not count -- a file containing only comments looks populated and verifies nothing.
  _n=$(grep -cE '^[^#[:space:]]+[[:space:]]+.*(ssh-|sk-ssh-)' "$_as" 2>/dev/null || true)
  if [ "${_n:-0}" -eq 0 ]; then
    note "advisory    Tier V: allowedSignersFile has no principal lines: $_as"
  else
    note "OK          Tier V: allowedSignersFile present, $_n principal(s)"
  fi
fi

# --- Tier H: leak-guard (optional, per domain) ---
# The guard and its git wiring ship in the base; a domain turns it on by supplying its own pattern
# files (~/.dotlocal/git-leak-markers and/or git-leak-sensitive). Without them the guard passes every
# commit, which is correct for a domain that has nothing to keep out. hook-doctor plants a token the
# markers match to prove the guard live, and only the domain knows one: `probe-marker=` in its
# git-leak-policy.
_lk=$(find "$OSRC/dot_dotlocal" -maxdepth 1 \( -name '*git-leak-markers*' -o -name '*git-leak-sensitive*' \) 2>/dev/null | head -1)
if [ -z "$_lk" ]; then
  note "info        Tier H: leak-guard not configured (optional; this domain supplies no pattern files)"
else
  note "OK          Tier H: leak-guard configured by this domain's pattern files"
  _lp=$(find "$OSRC/dot_dotlocal" -maxdepth 1 -name '*git-leak-policy*' 2>/dev/null | head -1)
  if [ -z "$_lp" ] || ! grep -q '^probe-marker=' "$_lp" 2>/dev/null; then
    note "advisory    Tier H: no probe-marker= in git-leak-policy, so hook-doctor cannot prove the guard live"
  fi
fi

# ============================================================================================
# Cross-layer safety — base <-> overlay are two chezmoi instances both targeting ~. Their managed
# sets must stay disjoint (no co-owned target FILE) and neither may put a DELETING attribute (exact_/remove_) on a co-owned or
# shared directory, or conflicting perms on a co-owned one. (Born from a real data-loss incident.)
# ============================================================================================
TAB=$(printf '\t')

# Map a chezmoi SOURCE relpath to its TARGET relpath + the (sorted) attribute-set on its LAST component.
_totarget() {
  _p=$1; _tgt=""; _la=""; _oIFS=$IFS; IFS=/
  for _c in $_p; do
    [ "$_c" = "." ] && continue
    _r=$_c; _a=""
    while :; do
      case $_r in
        encrypted_*)  _a="${_a}encrypted ";  _r=${_r#encrypted_} ;;
        private_*)    _a="${_a}private ";    _r=${_r#private_} ;;
        readonly_*)   _a="${_a}readonly ";   _r=${_r#readonly_} ;;
        exact_*)      _a="${_a}exact ";      _r=${_r#exact_} ;;
        executable_*) _a="${_a}executable "; _r=${_r#executable_} ;;
        symlink_*)    _a="${_a}symlink ";    _r=${_r#symlink_} ;;
        create_*)     _a="${_a}create ";     _r=${_r#create_} ;;
        modify_*)     _a="${_a}modify ";     _r=${_r#modify_} ;;
        remove_*)     _a="${_a}remove ";     _r=${_r#remove_} ;;
        literal_*)    _r=${_r#literal_} ;;
        *) break ;;
      esac
    done
    case $_r in dot_*) _r=".${_r#dot_}" ;; esac
    _tgt="$_tgt/$_r"; _la=$_a
  done
  IFS=$_oIFS
  # A template's `.tmpl` suffix is not part of its target: ssh/config.tmpl deploys ~/.ssh/config.
  # Keeping it made a plain file in one layer and a template of the same target in the other look
  # like two different files, and a reason written for the target never matched its template.
  _tgt=${_tgt%.tmpl}
  printf '%s\t%s\n' "${_tgt#/}" "$(printf '%s' "$_la" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/^ *//;s/ *$//')"
}

# Emit "target<TAB>attrs" per managed directory in a source tree (skip VCS + non-deployed meta dirs).
# Same as _emit_dirs but for FILES, and skipping chezmoi METADATA (.chezmoi*), which exists in
# both trees by design and is never a deployed target -- counting it would false-positive forever.
_emit_files() {
  [ -d "$1" ] || return 0
  ( CDPATH= cd -- "$1" && find . -type f \
      ! -path './.git' ! -path './.git/*' \
      ! -name '.chezmoi*' ! -path './.chezmoi*' \
      ! -name '.chezmoitemplates' ! -path './.chezmoitemplates/*' \
      ! -path './tests' ! -path './tests/*' ! -path './setup' ! -path './setup/*' \
      ! -path './overlay-skeleton' ! -path './overlay-skeleton/*' -print ) \
  | while IFS= read -r _pp; do
      [ "$_pp" = "." ] && continue
      # chezmoi never deploys a source entry whose name starts with `.` (the repository's
      # .gitignore, say); dotfiles are spelled dot_ in a source tree.
      case "/${_pp#./}" in */.*) continue ;; esac
      _totarget "${_pp#./}"
    done
}

_emit_dirs() {
  [ -d "$1" ] || return 0
  ( CDPATH= cd -- "$1" && find . -type d \
      ! -path './.git' ! -path './.git/*' \
      ! -name '.chezmoitemplates' ! -path './.chezmoitemplates/*' \
      ! -path './tests' ! -path './tests/*' ! -path './setup' ! -path './setup/*' \
      ! -path './overlay-skeleton' ! -path './overlay-skeleton/*' -print ) \
  | while IFS= read -r _pp; do
      [ "$_pp" = "." ] && continue
      # chezmoi never deploys a source entry whose name starts with `.` (the repository's
      # .gitignore, say); dotfiles are spelled dot_ in a source tree.
      case "/${_pp#./}" in */.*) continue ;; esac
      _totarget "${_pp#./}"
    done
}

echo
echo "cross-layer safety (base <-> overlay):"
xmark=$(mktemp "$_TMP/xdoctor.XXXXXX"); btmp=$(mktemp "$_TMP/xdoctor-b.XXXXXX")
bftmp=$(mktemp "$_TMP/xdoctor-bf.XXXXXX")
trap 'rm -f "$xmark" "$btmp" "$bftmp"' EXIT
xbad() { printf '  CONFLICT    %s\n' "$*"; printf 'x\n' >> "$xmark"; }

# (1) Destructive attributes anywhere (exact_/remove_) — the ONLY attrs that delete unmanaged files.
#     A stray exact_ on a co-owned dir (~/.local/bin, ~/.config) wipes the other layer + real tools.
_dz=$(find "$BSRC" "$OSRC" -path '*/.git' -prune -o \( -name 'exact_*' -o -name '*_exact_*' -o -name 'remove_*' -o -name '*_remove_*' \) -print 2>/dev/null || true)
if [ -n "$_dz" ]; then
  printf '%s\n' "$_dz" | while IFS= read -r _d; do [ -n "$_d" ] && printf '  found       %s\n' "$_d"; done
  xbad "'exact_'/'remove_' attribute present (above) — it deletes unmanaged files in its target dir; forbidden on the co-owned home tree. Remove it, or confine it to a directory ONLY this layer owns."
fi

# (2) Directory attribute conflicts on co-owned dirs (e.g. private_ vs plain -> 0700<->0755 flip-flop).
_emit_dirs "$BSRC" > "$btmp"
_emit_dirs "$OSRC" | while IFS="$TAB" read -r _otgt _oattr; do
  [ -n "$_otgt" ] || continue
  if _battr=$(awk -F"$TAB" -v t="$_otgt" '$1==t{print $2; f=1} END{exit !f}' "$btmp"); then
    [ "$_battr" = "$_oattr" ] || xbad "directory '$_otgt' co-owned with CONFLICTING attributes — base:[${_battr:-none}] overlay:[${_oattr:-none}] (perms flip-flop on alternating applies). Make them agree."
  fi
done

# (2b) The SAME TARGET FILE owned by BOTH layers. The rule at the top of this section -- managed
# sets stay disjoint -- was stated but never enforced: only directory ATTRIBUTES were compared, so a
# co-owned FILE passed silently and became last-apply-wins, each instance behaving correctly by its
# own lights and neither able to see the other. That is the same silent-loss shape as a stray exact_,
# and it is invisible after the fact. Repo docs are excluded above with the rest of the metadata.
# Honour each tree's .chezmoiignore for this comparison: a file both trees carry but neither
# DEPLOYS (agent context like CLAUDE.md, repo READMEs) is not a collision. Literal lines only --
# templated or glob rules are not evaluated here, so this can only ever UNDER-ignore, i.e. it may
# report a collision that ignores would have excused, never hide a real one.
_ignored() {  # _ignored <tree> <target-path>
  _ig="$1/.chezmoiignore"; [ -f "$_ig" ] || return 1
  grep -v '^[[:space:]]*#' "$_ig" 2>/dev/null | grep -v '{{' \
    | sed 's/[[:space:]]*$//' | grep -qxF "$2"
}

_emit_files "$BSRC" > "$bftmp"
_emit_files "$OSRC" | while IFS="$TAB" read -r _otgt _oattr; do
  [ -n "$_otgt" ] || continue
  # A run_ script is executed by its own instance and deployed nowhere, so a same-named script in
  # each tree is two scripts, not one file with two owners. Counting it failed a correct overlay.
  case "${_otgt##*/}" in run_*) continue ;; esac
  if awk -F"$TAB" -v t="$_otgt" '$1==t{f=1} END{exit !f}' "$bftmp"; then
    _ignored "$BSRC" "$_otgt" && continue
    _ignored "$OSRC" "$_otgt" && continue
    xbad "co-owned file '$_otgt' is managed by BOTH layers — last-apply-wins, silently. Give it exactly one owner; if the other layer needs a say, use the ~/.dotlocal fragment-include indirection."
  fi
done

# (3) Always-print destructive-directive summary — the "be careful, review this" line, never silent.
for _pair in "base=$BSRC" "overlay=$OSRC"; do
  _who=${_pair%%=*}; _dir=${_pair#*=}
  if [ -f "$_dir/.chezmoiremove" ]; then
    # The file is a TEMPLATE. Printing it raw listed '{{ if ... }}' and '{{ end }}' as if they were
    # removal targets, and left the reader unable to tell whether a guarded entry applies to THIS
    # machine -- in a summary whose entire job is to warn before something is deleted. Control lines
    # are now shown as the guard they are, and entries inside one are marked conditional.
    _guard=""
    grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$_dir/.chezmoiremove" 2>/dev/null \
      | while IFS= read -r _ln; do
          [ -n "$_ln" ] || continue
          case "$_ln" in
            *'{{'*'end'*'}}'*) _guard=""; continue ;;
            *'{{'*)            _guard=$(printf '%s' "$_ln" | tr -d '{}' | sed 's/^[[:space:]-]*//;s/[[:space:]-]*$//'); continue ;;
          esac
          if [ -n "$_guard" ]; then
            printf '  removes (%s)  %s   [ONLY IF: %s -- depends on this machine]\n' "$_who" "$_ln" "$_guard"
          else
            printf '  removes (%s)  %s   [ALWAYS]\n' "$_who" "$_ln"
          fi
        done
  fi
done

if [ -s "$xmark" ]; then fail=1; else note "OK          no cross-layer conflicts"; fi

# --- Tier P: a reason to be private (ADVISORY, never gating) ---
# Public by default: every file the overlay deploys either carries one of five reasons to stay private,
# or is a candidate to move to the base, with the private part supplied through a ~/.dotlocal fragment,
# chezmoi data, the repository manifest or an environment variable. The reasons are listed in
# PRIVATE-REASONS at the overlay source root, one "target-glob<TAB>reason<TAB>why" line each; the
# glob is matched against the deployed path relative to $HOME, and `*` crosses `/`. Advisory, so an
# overlay written before the list existed still passes, and its report is the list of what to move.
echo
echo "Tier P: reasons to stay private (advisory):"
_reasons="$OSRC/PRIVATE-REASONS"
if [ ! -f "$_reasons" ]; then
  note "ADVISORY    Tier P: no PRIVATE-REASONS at the overlay root, so no file states why it is private"
else
  _ptmp=$(mktemp "$_TMP/xdoctor-p.XXXXXX")
  _emit_files "$OSRC" | while IFS="$TAB" read -r _t _a; do
    [ -n "$_t" ] || continue
    _ignored "$OSRC" "$_t" && continue
    _hit=""; _why=""
    while IFS="$TAB" read -r _g _r _rest; do
      case "$_g" in ''|'#'*) continue ;; esac
      # shellcheck disable=SC2254 -- the glob is the point
      case "$_t" in $_g) _hit=$_r; break ;; esac
    done < "$_reasons"
    if [ -z "$_hit" ]; then
      printf '  UNREASONED  %s\n' "$_t"; printf 'u\n' >> "$_ptmp"
    else
      case "$_hit" in
        secrets|identity|infra|domain-program|domain-context) ;;
        *) printf '  BADREASON   %s  (%s is not one of: secrets identity infra domain-program domain-context)\n' "$_t" "$_hit"
           printf 'b\n' >> "$_ptmp" ;;
      esac
    fi
  done
  _nu=$(grep -c u "$_ptmp" 2>/dev/null || true); _nb=$(grep -c b "$_ptmp" 2>/dev/null || true)
  rm -f "$_ptmp"
  if [ "${_nu:-0}" -eq 0 ] && [ "${_nb:-0}" -eq 0 ]; then
    note "OK          Tier P: every overlay file states a reason to stay private"
  else
    note "ADVISORY    Tier P: ${_nu:-0} file(s) with no reason (candidates to move to the base), ${_nb:-0} with an unknown reason"
  fi
fi

assess

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

overlay-doctor: the overlay is INCOMPLETE. Provision each MISSING/PLACEHOLDER item above
from THIS domain's own vault/records (identity + signing key, signer principals, host
aliases) and remove the FIXME line once filled. Generic mechanism (Tier A) comes from the
base automatically — apply the base if it is not on PATH. Never copy private values from
another domain's overlay.
MSG
  exit 1
fi
echo "overlay-doctor: compliant — every required tier is present and filled."
exit 0
