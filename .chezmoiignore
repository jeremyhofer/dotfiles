**/__pycache__/**

{{ if eq .chezmoi.os "darwin" }}
# --- Linux-only, ignored on macOS. Ignore whole DIRS (not just the config file) so the
#     directory itself is never scaffolded. ---
# X11
.Xresources
.xinitrc
.xbindkeysrc
# Wayland compositors / WMs + their tools (i3 is X11)
.config/i3
.config/i3status
.config/sway
.config/hypr
.config/mako
# XDG autostart (freedesktop/Linux-only)
.config/autostart
# systemd-user env routing — Linux-only; macOS uses its own launchd ssh-agent
.config/environment.d
# per-user tmpfiles rules and systemd-user timer drop-ins — Linux-only
.config/user-tmpfiles.d
.config/systemd
# Brave Wayland fractional-scale flag — Linux/Wayland only; wrong path + inert on macOS
.config/brave-flags.conf
{{ end }}

{{ if or (ne .chezmoi.os "linux") (not (get . "miseActive")) }}
# The SOPS age key loader, its login unit and the link that enables it: Linux only (the key is a
# systemd credential there), and only on a machine whose generated config sets miseActive = true,
# so a machine that has not switched to mise deploys exactly what it did before. The loader's link
# is the only entry in default.target.wants, so the directory is ignored whole: ignoring the link
# alone still creates the empty directory. Another unit enabled there must change this line.
.local/bin/sops-key-loader
.config/systemd/user/sops-key-loader.service
.config/systemd/user/default.target.wants
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# --- macOS-only, ignored elsewhere: launchd agents (Linux runs the systemd user timers instead) ---
Library
{{ end }}

{{ if eq .domain "work" }}
# Local-dev TLS cert provisioning is personal-only (home machines); not managed on work.
setup-dev-tls.sh
# Alacritty's config is deployed in the personal domain only.
.config/alacritty
# image-bump moves the pinned images of self-hosted services; it is generic, so it lives in the
# base, but it is deployed in the personal domain only.
.local/bin/image-bump
{{- if not (get . "machineSnapshot") }}
# The machine-snapshot sampler records every process every 15 seconds; on a work machine it is
# opt-in (machineSnapshot = true in the generated config), so by default neither the macOS agent and
# its loader nor the Linux timer, its unit and the link that enables it are deployed.
Library/LaunchAgents/local.dotfiles.machine-snapshot.plist
load-machine-snapshot-agent.sh
.config/systemd/user/machine-snapshot.service
.config/systemd/user/machine-snapshot.timer
.config/systemd/user/timers.target.wants/machine-snapshot.timer
{{- end }}
{{ end }}

{{ if not (get . "miseActive") }}
# --- mise, off until this machine switches to it. miseActive is never prompted: it is set by
#     editing the [data] of the generated config (~/.config/chezmoi/chezmoi.toml), and absent means
#     false. Until then neither the base's mise settings drop-in, the step creating mise's state
#     directory, nor the tool that records which mise configurations are trusted and the apply step
#     that runs it is deployed, so a machine with mise installed keeps mise's own defaults. Turning it
#     off again stops future deploys only; a drop-in already deployed stays until removed by hand. ---
.config/mise
create-mise-state-dir.sh
.local/bin/mise-fleet-trust
trust-mise-configs.sh
{{ else if not (lookPath "mise") }}
# mise's state directory is created, and the trust step runs, only where mise is installed.
create-mise-state-dir.sh
trust-mise-configs.sh
{{ end }}

# Per-machine skill exclusion: skills named in the skipSkills config value (a list in the [data] of
# ~/.config/chezmoi/chezmoi.toml, kept across `chezmoi init`) do not deploy on this machine. Ignoring
# stops future deploys only; a skill already deployed stays until removed by hand.
{{- range (get . "skipSkills" | default list) }}
.claude/skills/{{ . }}
.claude/skills/{{ . }}/**
{{- end }}
