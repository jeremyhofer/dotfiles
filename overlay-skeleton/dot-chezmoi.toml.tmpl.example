{{- /*
  Overlay chezmoi config template (this SECOND chezmoi instance's config). `chezmoi init` renders it
  and prompts once per machine for any unset [data] value, reusing whatever is already set
  (idempotent — a configured host is never re-prompted).

  [data] is THIS DOMAIN'S private vocabulary: define only the values this overlay's own templates
  consume, named in this domain's terms. Nothing below is required by the base or by overlay-doctor —
  an empty [data] is valid. `gitRoot` is kept as a worked example because most domains have one: the
  git host root that Devel/mani.yaml.tmpl builds clone URLs from. Add further domain values the same
  way (each consumer should `default ""` and skip, so an unset value degrades to a no-op instead of
  breaking the apply).

  Fill in this domain's git-root default(s) below (e.g. per-OS mount paths), then delete the FIXME
  line. Leaving the default empty just means the prompt starts blank — still valid.
  FIXME(overlay-doctor): set this domain's git-root default(s), or remove the prompt if unused.
*/ -}}
{{- $gitRootDefault := "" -}}
{{- /* Example OS-aware default (uncomment + set for your fleet):
       {{ if eq .chezmoi.os "darwin" }}{{ $gitRootDefault = "/path/on/macos" }}{{ else }}{{ $gitRootDefault = "/path/on/linux" }}{{ end }} */ -}}
{{- $gitRoot := promptStringOnce . "gitRoot" "Git host root for this domain's repo manifest" $gitRootDefault -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
destDir   = {{ .chezmoi.homeDir | quote }}
[data]
    gitRoot = {{ $gitRoot | quote }}
