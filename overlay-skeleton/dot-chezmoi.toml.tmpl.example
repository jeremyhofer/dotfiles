{{- /*
  Overlay chezmoi config template (this SECOND chezmoi instance's config). `chezmoi init` renders it
  and prompts once per machine for any unset [data] value, reusing whatever is already set
  (idempotent — a configured host is never re-prompted).

  [data] is THIS DOMAIN'S private vocabulary: define only the values this overlay's own templates
  consume, named in this domain's terms. Nothing here is required by the base or by overlay-doctor —
  an empty [data] is valid, and a domain whose files need no shared values (e.g. its repo manifest
  uses plain literal URLs) should leave it empty. If several of this overlay's templates DO share a
  value (a common git host root, an internal registry URL), define it once here and prompt for it
  per-machine, following this shape:

      {{- $someValue := promptStringOnce . "someValue" "Prompt shown at chezmoi init" "default" -}}
      [data]
          someValue = {{ $someValue | quote }}

  Every consumer of a [data] value must `default ""` and skip when unset, so a machine that leaves
  a prompt blank degrades to a no-op instead of a broken apply.

  FIXME(overlay-doctor): define this domain's [data] values (empty is a valid answer), then delete this line.
*/ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}
destDir   = {{ .chezmoi.homeDir | quote }}
[data]
