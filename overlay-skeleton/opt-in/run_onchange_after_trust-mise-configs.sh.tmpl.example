{{ if get . "miseActive" -}}
#!/bin/sh
# OPT-IN: re-runs the base's mise trust step when the manifest changes, so a project that opts in
# with `miseTrust: true` is trusted at the next apply rather than whenever the base's own trigger
# next fires. Keep it only if the manifest declares `miseTrust:`. Drop the `.example` suffix.
#
# It renders empty, and so does not run, until this layer's own `miseActive` is true. chezmoi data is
# per instance, so set `miseActive` in this layer's generated config and in the base's together.
#
# Re-runs whenever the manifest changes:
#   manifest hash: {{ include "Devel/mani.yaml.tmpl" | sha256sum }}
# The logic is the base's `mise-fleet-trust`; this only runs it, on the machine's own Python where
# there is one. The base's own trigger trusts the dotfiles source's mise.toml, so this passes no
# --base-source. A manifest the tool cannot read fails the apply (exit 2), naming why.
set -eu
command -v mise >/dev/null 2>&1 || { echo "trust-mise-configs: mise not installed, skipped" >&2; exit 0; }
tool=$(command -v mise-fleet-trust) || { echo "trust-mise-configs: mise-fleet-trust not on PATH -- apply the base first" >&2; exit 1; }
py=python3
[ -x /usr/bin/python3 ] && py=/usr/bin/python3
exec "$py" "$tool"
{{ end -}}
