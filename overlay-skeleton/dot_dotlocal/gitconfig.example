# vim: ft=gitconfig
# FIXME(overlay-doctor): fill in THIS domain's identity + signing, then delete this line.
# Included by the base-managed ~/.gitconfig. Identity + signing only. Any leak-guard
# hook wiring is domain-specific and deliberately NOT part of a fresh overlay.
[user]
	email = you@example.com
	name = Your Name
	signingkey = ~/.ssh/<your-signing-key>.pub
[gpg "ssh"]
	allowedSignersFile = ~/.dotlocal/allowed_signers
[commit]
	# true where commits can be signed; a machine that cannot reach a signing key sets this false.
	gpgsign = true
