# Fleet repo manifest — `mani` clones/syncs these repos into ~/Devel. (Scaffold stub — fill in.)
# FIXME(overlay-doctor): replace the example below with THIS domain's real repo set, then delete this line.
# URLs are whatever this domain's git host uses — plain literals are fine (a domain where everything
# lives on one hosted service needs nothing more). Only if many URLs share a host root this domain
# wants factored out: define an overlay [data] value (named in this domain's terms) and reference it
# here with chezmoi template syntax — this file is rendered as a template.
# `mani sync` clones; `mani exec --all 'git pull --ff-only'` safely updates; tag entries for subsets
# (e.g. `mani sync --tags active`). Exclude chezmoi-source dirs and retired repos.

projects:
  example-repo:
    path: internal/example-repo
    url: https://git.example.com/org/example-repo.git
    tags: [internal, active]
