#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""fleet-wait -- block until something in the fleet changes, or a heartbeat deadline passes.

  usage: fleet-wait --heartbeat DURATION [--interval DURATION] [--ci] [--ci-every DURATION] [--once]
         fleet-wait --armed [--json]

A heartbeat for a coordinating session on a machine with no cron and no /loop. --heartbeat is at
most 55m: a wake after Claude Code's one-hour prompt cache expires rewrites the session's whole
context instead of reading it, so a longer heartbeat is refused (exit 2). The session runs this
through its Bash tool's background mode; a background command that exits wakes its session, even
an idle one. On each wake the session sweeps, then arms the next wait.

It exits 0 at the earliest of the heartbeat deadline or a change since it started, and prints one
line per reason:

  event request-result <id> <outcome>   a lifecycle request result appeared, or its outcome changed
  event slot-queued <name>[,<name>...]  a timing-slot request is queued while the slot is free
  event staged <file>                   a new file in handoff staging
  event seat-missing <name> <state>     a seat the snapshot showed live is now dead, unknown or gone
  event snapshot-stale <age>s           the session snapshot is older than snapshot-max-age
  event ci <run id> <status>            `ci-trigger status` changed its run or status (--ci only)
  heartbeat <duration>                  the deadline passed with no change

The first line printed, before it waits, says what is watched and what is not, so a wake can be
read as "nothing happened" only for what was actually watched.

WHAT IT READS, all files other tools already write, so a poll starts no process except the CI read:
$FLEET_STATE/requests/*.result.json, $FLEET_STATE/handoff-staging/, $FLEET_STATE/sessions.json (the
snapshot `fleet-canonicals snapshot` writes from its timer; seats are named from it, so no fleet
record read is made here), and the slot's slot.json ($FLEET_SLOT_STATE, else $FLEET_STATE/slot).

THE CI READ IS OPT-IN, AND IS USUALLY UNAVAILABLE INSIDE A SANDBOX. `ci-trigger` reaches the node by
ssh, and an agent sandbox lets that through only when `ci-trigger` is the whole command, never as a
child of this one. With --ci it runs `ci-trigger status` (or $FLEET_WAIT_CI_CMD) at the start; if
that fails, the first line says CI is not watched and why, and the session reads CI itself, bare,
on each wake. It is polled every --ci-every (default 2m), not every interval.

--once checks once, one interval after the start: exit 0 with the events, or exit 1 with none. It
is for tests and scripts that must not block. SIGTERM or SIGINT ends the wait with "stopped" and
exit 0. Exit 2: a usage error.

ONE HEARTBEAT PER SESSION. A wait (not --once) writes a record, $FLEET_STATE/heartbeats/<holder>.rec,
and holds an exclusive flock on it for its whole life; it touches the file's mtime each interval and
removes the record on a normal wake, on SIGTERM or SIGINT, and on an exception. A second wait for the
same holder while that lock is held prints one line to stderr, `fleet-wait: REFUSED: a heartbeat for
<holder> is already armed ...`, writes nothing and exits 2. Exit 0 still means a wake. Stop the old
one before arming another.

The holder is the session name, resolved as `fleet-slot` resolves who ran a command (a copy of its
session_name: the status line's usage file for $CLAUDE_CODE_SESSION_ID, else $FLEET_SLOT_AS, else
the agents listing). When none resolves, the key is `unresolved-<pid>` and the record's first line
says so: two unresolved sessions cannot be told apart, so they never refuse each other.

LIVENESS IS THE LOCK, NOT A PID AND NOT A CLOCK. Each command in an agent sandbox has its own pid
namespace, so a recorded pid cannot be checked from another command; the flock is on the shared
inode, so it can. The kernel releases it on any death, SIGKILL included, so a stopped heartbeat can
be replaced at once. A record whose lock is free is stale: the next wait for that holder takes it
over, and the leftover file is harmless. The record's contents are written in place, never by
replacing the file, which would swap the inode and orphan the lock. The mtime only shows "refreshed
<age> ago" in --armed and decides nothing.

--armed lists each live record (holder, since, last refresh, heartbeat), then the stale ones (lock free) under a
separate `stale` heading (--json: {"armed": [...], "stale": [...]}), and exits 0. It reads only.

The defaults: --interval 30s. Config: snapshot-max-age, read from the fleet-canonicals config
($FLEET_CANONICALS_CONFIG, else ~/.config/fleet-canonicals/config), default 45.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("FLEET_STATE") or
             Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "fleet-canonicals")
SLOT = Path(os.environ.get("FLEET_SLOT_STATE") or STATE / "slot") / "slot.json"
REQUESTS = STATE / "requests"
STAGING = STATE / "handoff-staging"
SNAPSHOT = STATE / "sessions.json"
CONFIG = Path(os.environ.get("FLEET_CANONICALS_CONFIG") or
              Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "fleet-canonicals" / "config")
HEARTBEATS = STATE / "heartbeats"
# Claude Code keeps a main conversation's prompt cache for one hour on a subscription. A wake after it
# expires rewrites the whole context at the cache-write price (2x an input token) instead of reading
# it (0.05x), so a heartbeat is held to 55 minutes, leaving room for the session's own turn.
MAX_HEARTBEAT = 55 * 60
CI_CMD = (os.environ.get("FLEET_WAIT_CI_CMD") or "ci-trigger status").split()


def usage(msg: str) -> None:
    print(f"fleet-wait: {msg}", file=sys.stderr)
    print(__doc__.splitlines()[2], file=sys.stderr)
    sys.exit(2)


def duration(text: str) -> float:
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([smh]?)", text.strip())
    if not m or float(m.group(1)) <= 0:
        usage(f"not a duration: {text!r} (a number of seconds, or e.g. 90s, 30m, 1h)")
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600}[m.group(2)]


def snapshot_max_age() -> int:
    try:
        for line in CONFIG.read_text(encoding="utf-8").splitlines():
            k, sep, v = line.partition("=")
            if sep and k.strip() == "snapshot-max-age" and v.strip().isdigit():
                return int(v.strip())
    except OSError:
        pass
    return 45


def read_json(path: Path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


# ---- the sources: each returns comparable state, and a function lists what changed -------------

def results() -> dict[str, str]:
    """Request id -> outcome. A result being rewritten with the same outcome (a waiting request,
    every runner pass) is no change; a new id or a new outcome is."""
    out: dict[str, str] = {}
    try:
        files = list(REQUESTS.glob("*.result.json"))
    except OSError:
        return out
    for f in files:
        d = read_json(f)
        out[f.name.removesuffix(".result.json")] = str(d.get("outcome")) if isinstance(d, dict) else "?"
    return out


def staged() -> set[str]:
    try:
        return {p.name for p in STAGING.iterdir() if p.is_file()}
    except OSError:
        return set()


def slot_waiting() -> tuple[str, ...]:
    """The names queued for the slot while nobody holds it; empty when held or nobody waits."""
    st = read_json(SLOT)
    if not isinstance(st, dict) or st.get("holder") or not isinstance(st.get("queue"), list):
        return ()
    return tuple(str(e.get("name")) for e in st["queue"] if isinstance(e, dict))


def snapshot() -> tuple[dict[str, str] | None, float | None]:
    """(seat -> state, age in seconds) from the session snapshot; (None, None) when it is unreadable.
    An empty map is a readable snapshot of a machine with no seats declared for it."""
    d = read_json(SNAPSHOT)
    if not isinstance(d, dict) or not isinstance(d.get("seats"), dict):
        return None, None
    taken = d.get("takenAt")
    age = time.time() - taken if isinstance(taken, (int, float)) else None
    return {n: str(s.get("state")) for n, s in d["seats"].items() if isinstance(s, dict)}, age


def ci_read() -> tuple[str | None, str]:
    """(run id + status, or None on failure; the failure's first line)."""
    try:
        p = subprocess.run(CI_CMD, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    if p.returncode != 0:
        return None, ((p.stderr or p.stdout).strip().splitlines() or [f"exit {p.returncode}"])[0]
    run = re.search(r"^run:\s*(\S+)", p.stdout, re.M)
    status = re.search(r"^status:\s*(\S+)", p.stdout, re.M)
    if not run or not status:
        return None, "its output has no run: and status: lines"
    return f"{run.group(1)} {status.group(1)}", ""


class Watch:
    def __init__(self, ci: bool):
        self.max_age = snapshot_max_age()
        self.results = results()
        self.staged = staged()
        self.waiting = slot_waiting()
        self.seats, age = snapshot()
        self.live = {n for n, s in (self.seats or {}).items() if s == "live"}
        self.stale_at_start = age is None or age > self.max_age
        self.ci = None
        self.ci_note = "not watched (no --ci)"
        if ci:
            self.ci, why = ci_read()
            self.ci_note = f"watched ({self.ci})" if self.ci else f"NOT watched: {why}"

    def header(self, heartbeat: str) -> str:
        if self.seats is None:
            seats = "seats NOT watched (no readable snapshot at " + str(SNAPSHOT) + ")"
        elif self.stale_at_start:
            seats = f"seats NOT watched (the snapshot was already older than {self.max_age}s)"
        else:
            seats = f"seats watched ({len(self.live)} live" + (
                "; the snapshot names no seat for this machine)" if not self.seats else ")")
        return (f"fleet-wait: watching request results, the slot queue, handoff staging, {seats}; "
                f"CI {self.ci_note}; heartbeat {heartbeat}")

    def changes(self, with_ci: bool) -> list[str]:
        out: list[str] = []
        for rid, outcome in sorted(results().items()):
            if self.results.get(rid) != outcome:
                out.append(f"event request-result {rid} {outcome}")
        # Compared with the previous poll, not the start: a request granted, released and queued
        # again by the same holder ends where the start was, and is still a request nobody has seen.
        now_waiting = slot_waiting()
        if now_waiting and now_waiting != self.waiting:
            out.append("event slot-queued " + ",".join(now_waiting))
        self.waiting = now_waiting
        for f in sorted(staged() - self.staged):
            out.append(f"event staged {f}")
        if self.seats is not None and not self.stale_at_start:
            seats, age = snapshot()
            if age is None or age > self.max_age:
                out.append(f"event snapshot-stale {'unreadable' if age is None else f'{int(age)}'}"
                           + ("" if age is None else "s"))
            else:
                for n in sorted(self.live):
                    if (seats or {}).get(n) != "live":
                        out.append(f"event seat-missing {n} {(seats or {}).get(n, 'absent')}")
        if with_ci and self.ci:
            now, _why = ci_read()
            if now and now != self.ci:
                out.append(f"event ci {now}")
        return out


# ---- one heartbeat per holder --------------------------------------------------------------------

def usage_dir() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "claude-usage"


def session_name() -> str | None:
    """Who is running this, resolved as fleet-slot's session_name(listing=True) resolves it (copied,
    since both are single-file scripts): the status line's usage file for CLAUDE_CODE_SESSION_ID,
    else FLEET_SLOT_AS, else the agents listing."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if sid:
        try:
            name = json.loads((usage_dir() / f"{sid}.json").read_text(encoding="utf-8")).get("session_name")
            if name:
                return str(name)
        except (OSError, ValueError, AttributeError):
            pass
    if os.environ.get("FLEET_SLOT_AS"):
        return os.environ["FLEET_SLOT_AS"]
    if not sid:
        return None
    cmd = (os.environ.get("FLEET_AGENTS_JSON_ALL_CMD") or os.environ.get("FLEET_AGENTS_JSON_CMD") or
           "claude agents --json --all").split()
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
        rows = json.loads(out or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    for r in rows if isinstance(rows, list) else []:
        if isinstance(r, dict) and r.get("sessionId") == sid and r.get("name"):
            return str(r["name"])
    return None


def rec_path(holder: str) -> Path:
    return HEARTBEATS / (re.sub(r"[^A-Za-z0-9._-]", "_", holder) + ".rec")


def read_rec(path: Path) -> dict | None:
    """A record is `key: value` lines after a first line naming the holder; None when unreadable.
    Adds `refreshed` (mtime) from the file."""
    try:
        text = path.read_text(encoding="utf-8")
        mtime = path.stat().st_mtime
    except OSError:
        return None
    rec: dict = {"refreshed": mtime, "note": ""}
    for i, line in enumerate(text.splitlines()):
        k, sep, v = line.partition(": ")
        if i == 0 and sep and k == "holder":
            rec["holder"], _, rec["note"] = v.partition(" (")
            continue
        if sep:
            rec[k] = v
    try:
        rec["started"], rec["heartbeat"], rec["interval"] = (
            float(rec["started"]), float(rec["heartbeat"]), float(rec["interval"]))
    except (KeyError, ValueError):
        return None
    return rec if "holder" in rec else None


def is_live(path: Path) -> bool:
    """A record is live if and only if its holder still holds the exclusive flock on it: a shared,
    non-blocking attempt fails. The kernel drops the lock on any death, SIGKILL included, and the
    lock is on the shared inode, so it holds across the agent sandbox's separate pid and mount
    namespaces. An attempt that succeeds means the holder is gone (the file is left, harmless)."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)
    return False


def records() -> list[dict]:
    try:
        files = sorted(HEARTBEATS.glob("*.rec"))
    except OSError:
        return []
    return [r for r in (read_rec(f) for f in files) if r]


def when(t: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(t))


def armed(as_json: bool) -> int:
    now = time.time()
    live, stale = [], []
    for r in records():
        row = {"holder": r["holder"], "since": when(r["started"]), "refreshed": when(r["refreshed"]),
               "age_s": int(now - r["refreshed"]), "heartbeat_s": r["heartbeat"], "interval_s": r["interval"]}
        (live if is_live(rec_path(r['holder'])) else stale).append(row)
    if as_json:
        print(json.dumps({"armed": live, "stale": stale}, indent=2))
        return 0
    print("armed:" if live else "armed: none")
    for r in live:
        print(f"  {r['holder']}  since {r['since']}  refreshed {r['age_s']}s ago  heartbeat {int(r['heartbeat_s'])}s")
    if stale:
        print("stale (holder gone, lock free; ignored, taken over by the next wait):")
        for r in stale:
            print(f"  {r['holder']}  since {r['since']}  refreshed {r['age_s']}s ago")
    return 0


class Heartbeat:
    """The record of one running wait. arm() opens the record and takes an exclusive flock on it,
    refusing when another process holds it; the lock is held until this process dies. The contents
    are written in place (truncate, write), never by replacing the file, which would swap the inode
    and orphan the lock. touch() only moves the mtime, which --armed shows as the last refresh."""

    def __init__(self, heartbeat: float, interval: float):
        name = session_name()
        self.holder = name or f"unresolved-{os.getpid()}"
        self.note = "" if name else (" (UNRESOLVED: a per-process key; two sessions with no resolvable "
                                     "name cannot be told apart and never refuse each other)")
        self.path = rec_path(self.holder)
        self.heartbeat, self.interval = heartbeat, interval
        self.fd: int | None = None

    def _lock(self) -> int | None:
        """The fd of the record with our lock held, or None when another holds it. The file may be
        unlinked by a holder exiting between our open and our lock; then we hold a lock on a dead
        inode, so check the path still names the inode we locked, else try again."""
        HEARTBEATS.mkdir(parents=True, exist_ok=True)
        for _ in range(5):
            fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o644)
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                os.close(fd)
                return None
            try:
                if os.fstat(fd).st_ino == os.stat(self.path).st_ino:
                    return fd
            except OSError:
                pass
            os.close(fd)
        return None

    def arm(self) -> bool:
        try:
            fd = None
            for attempt in range(3):  # a reader's momentary shared lock is not a heartbeat
                fd = self._lock()
                if fd is not None:
                    break
                time.sleep(0.1)
        except OSError as e:
            print(f"fleet-wait: no heartbeat record written ({e.strerror}); the wait runs unguarded",
                  file=sys.stderr)
            return True
        if fd is None:
            old = read_rec(self.path)
            detail = (f" (since {when(old['started'])}, refreshed {int(time.time() - old['refreshed'])}s ago)"
                      if old else "")
            print(f"fleet-wait: REFUSED: a heartbeat for {self.holder} is already armed{detail}; stop it "
                  "before arming another", file=sys.stderr)
            return False
        self.fd = fd
        os.ftruncate(fd, 0)
        os.pwrite(fd, (f"holder: {self.holder}{self.note}\nstarted: {time.time()}\n"
                       f"heartbeat: {self.heartbeat}\ninterval: {self.interval}\n").encode(), 0)
        return True

    def touch(self) -> None:
        if self.fd is not None:
            try:
                os.utime(self.fd)
            except OSError:
                pass

    def drop(self) -> None:
        """Unlink while still holding the lock, then release it by closing."""
        if self.fd is None:
            return
        try:
            self.path.unlink()
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None


def main(argv: list[str]) -> int:
    heartbeat = interval = None
    ci_every, ci, once = 120.0, False, False
    list_armed = as_json = False
    hb_text = ""
    args = list(argv)
    while args:
        a = args.pop(0)
        if a in ("--heartbeat", "--interval", "--ci-every"):
            if not args:
                usage(f"{a} needs a duration")
            v = args.pop(0)
            if a == "--heartbeat":
                heartbeat, hb_text = duration(v), v
            elif a == "--interval":
                interval = duration(v)
            else:
                ci_every = duration(v)
        elif a == "--ci":
            ci = True
        elif a == "--once":
            once = True
        elif a == "--armed":
            list_armed = True
        elif a == "--json":
            as_json = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            usage(f"unknown argument {a!r}")
    if as_json and not list_armed:
        usage("--json goes with --armed")
    if list_armed:
        return armed(as_json)
    if heartbeat is None:
        usage("--heartbeat is required: the wait must end on its own")
    if heartbeat > MAX_HEARTBEAT:
        usage(f"--heartbeat {hb_text} is past {MAX_HEARTBEAT // 60:.0f}m: Claude Code's main-conversation prompt "
              "cache lives one hour, so a wake after it rewrites the session's whole context at the cache-write "
              "price instead of reading it; use 50m or less")
    interval = interval or 30.0

    stop = {"sig": None}

    def on_signal(signum, _frame):
        stop["sig"] = signum

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    hb = None if once else Heartbeat(heartbeat, interval)
    if hb and not hb.arm():
        return 2
    try:
        return wait(w_args=(ci, ci_every, once, hb_text, heartbeat, interval), stop=stop, hb=hb)
    finally:
        if hb:
            hb.drop()


def wait(w_args, stop, hb) -> int:
    ci, ci_every, once, hb_text, heartbeat, interval = w_args
    start = time.monotonic()
    w = Watch(ci)
    print(w.header(hb_text), flush=True)
    next_ci = start + ci_every
    while True:
        if hb:
            hb.touch()
        deadline = start + heartbeat
        wake = min(time.monotonic() + interval, deadline)
        while stop["sig"] is None and time.monotonic() < wake:
            time.sleep(min(1.0, max(0.0, wake - time.monotonic())))
        if stop["sig"] is not None:
            print(f"stopped ({signal.Signals(stop['sig']).name})", flush=True)
            return 0
        t = time.monotonic()
        with_ci = once or t >= next_ci
        if with_ci:
            next_ci = t + ci_every
        events = w.changes(with_ci)
        if events:
            print("\n".join(events), flush=True)
            return 0
        if once:
            print("no change", flush=True)
            return 1
        if t >= deadline:
            print(f"heartbeat {hb_text}", flush=True)
            return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
