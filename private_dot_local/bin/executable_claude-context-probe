#!/usr/bin/env bash
# claude-context-probe -- measure which context Claude Code actually loads on this machine.
#
# WHY. Where instruction files are read from, whether hooks run, whether a hook's injected context
# arrives, and whether MCP servers attach all vary by Claude Code version and by any managed policy
# an administrator has installed. On a managed machine they cannot be read off the docs; they have
# to be measured there. Designs that route context through any of these channels need the answer
# first.
#
# HOW. It builds throwaway repositories under a temp directory, plants a unique codeword in every
# place context might come from, starts headless `claude -p` sessions in them with the model's own
# tools switched off (so it cannot go and read a file itself), and asks the model to list every
# codeword it can see. A codeword it lists was delivered; one it does not was not.
#
# One session keeps a single tool on, Read, because some context loads only when a file is read: a
# nested CLAUDE.md, a nested AGENTS.md it imports, and a .claude/rules file scoped by `paths:`. It
# reads three files that carry no codeword, and nothing else; if it reads any other file, the
# session is INCONCLUSIVE, since it could have fetched a codeword itself.
#
# Two controls make a result trustworthy. The repository-root CLAUDE.md must be seen (positive
# control): if it is not, the model did not answer the question and that session is INCONCLUSIVE.
# A codeword planted in a file nothing references must never be seen (negative control): if it is,
# the session is INVALID, because the model is guessing or reading files.
#
# Hooks are measured twice: whether the hook RAN (it touches a marker file) and whether its context
# was DELIVERED (its codeword was seen). The two fail for different reasons -- a policy that blocks
# hooks versus a channel that drops their output -- and a single yes/no would hide which.
#
# The output is a short summary meant to be read aloud or retyped, carrying no paths, names or
# values from the machine: only Claude Code's version, the OS family, and one verdict per check.
#
# Deployed to Linux and macOS (bash 3.2), so every spelling here is two-userland safe.

set -u

CLAUDE_BIN=${CLAUDE_CONTEXT_PROBE_CLAUDE:-claude}
KEEP=0
FLEET=0
for arg in "$@"; do
  case "$arg" in
    --keep) KEEP=1 ;;
    --fleet) FLEET=1 ;;
    -h|--help)
      sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
      printf '\nusage: claude-context-probe [--keep]\n       claude-context-probe --fleet [--keep]\n'
      printf '  --keep   leave the temp tree in place and print its path\n'
      printf '  --fleet  run ONLY the background-session checks (--bg, agents, attach, resume, rm,\n'
      printf '           respawn, model aliases, tool names) instead of the context checks. It starts\n'
      printf '           real background sessions and a few small model calls, and removes them again.\n'
      exit 0 ;;
    *) printf 'claude-context-probe: unknown argument %s\n' "$arg" >&2; exit 2 ;;
  esac
done

command -v "$CLAUDE_BIN" >/dev/null 2>&1 || { printf 'claude-context-probe: %s not found on PATH\n' "$CLAUDE_BIN" >&2; exit 2; }
command -v git >/dev/null 2>&1 || { printf 'claude-context-probe: git not found on PATH\n' >&2; exit 2; }

tmpbase=${TMPDIR:-/tmp}; tmpbase=${tmpbase%/}   # macOS TMPDIR ends in a slash
ROOT=$(mktemp -d "$tmpbase/claude-context-probe.XXXXXX") || exit 2
if [ "$KEEP" -eq 0 ] && [ "$FLEET" -eq 0 ]; then trap 'rm -rf "$ROOT"' EXIT; fi
NONCE="$(date +%s)$$"
cw() { printf 'CCPROBE-%s-%s' "$1" "$NONCE"; }
plant() { printf 'Codeword: %s\n' "$(cw "$2")" > "$1"; }

# ---- --fleet: the background-session checks ---------------------------------------------------
# A different question from the context checks above: not "what reaches the model" but "which of
# the features a set of long-lived, named background sessions relies on work on this build and
# policy". It starts real background sessions (haiku, one-line prompts) plus a few `-p` calls,
# prints one row per check (yes, no, or INCONCLUSIVE with a fixed reason), and removes every
# session it started, even on failure. Like the summary above it prints no paths, names or values.
#
# Measured on Claude Code 2.1.285: `claude agents --json` rows have exactly the keys cwd, id, kind,
# name, sessionId, startedAt, state (state seen: working, blocked; kind: background) and NO pid.
# Another version may list one, so both are handled: liveness uses pid with `kill -0` when a row
# has it, else the state. A row with neither is treated as live because it is listed.
# Still guesses, to verify on a real run: the `--allowedTools` spelling and the `--` before the
# prompt, that `--all` is accepted, that `attach`/`rm` take the row id, and that `--resume`
# composes with `--bg`.
FLEET_WAIT=${CLAUDE_CONTEXT_PROBE_FLEET_WAIT:-30}                   # seconds to poll for a listing
FLEET_ATTACH_WAIT=${CLAUDE_CONTEXT_PROBE_FLEET_ATTACH_WAIT:-15}     # seconds `attach` runs before it is killed
# How the background session is allowed to run its one command without a prompt. Adjust if this
# Claude Code build spells it differently; a launch that fails on it reads as bg-launch no.
FLEET_ALLOW_FLAG=--allowedTools
FLEET_ALLOWED_TOOLS='Bash(printenv:*)'
FLEET_PROMPT='Run the shell command: printenv CCPROBE_ENV TMPDIR . Then reply with its output on one line, prefixed CCPROBE-FLEET: and nothing else.'

alive() { # a pid that exists and is not a zombie
  kill -0 "$1" 2>/dev/null || return 1
  case $(ps -o stat= -p "$1" 2>/dev/null) in Z*|'') return 1 ;; esac
  return 0
}
wait_for() { # <seconds> <command...>: run the command until it succeeds, once a second
  local n=$1 i=0; shift
  while :; do
    "$@" && return 0
    [ "$i" -ge "$n" ] && return 1
    sleep 1; i=$((i+1))
  done
}
rows_of() { # stdin: agents JSON. Prints id|name|pid|sessionId|cwd|state per row, '-' for a missing field.
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(3)
if isinstance(d, dict):
    d = next((v for v in d.values() if isinstance(v, list)), [])
for r in d:
    if isinstance(r, dict):
        print("|".join(str(r[k]) if r.get(k) not in (None, "") else "-" for k in ("id", "name", "pid", "sessionId", "cwd", "state")).replace("\n", " "))
'
  else
    jq -r 'if type == "object" then (([.[] | arrays] | first) // []) else . end | .[]
           | [.id, .name, .pid, .sessionId, .cwd, .state] | map(if . == null or . == "" then "-" else tostring end) | join("|")' 2>/dev/null
  fi
}
fleet_rows() { # every listed row, from `agents --json` then `agents --all --json`
  "$CLAUDE_BIN" agents --json 2>/dev/null </dev/null | rows_of
  "$CLAUDE_BIN" agents --all --json 2>/dev/null </dev/null | rows_of
}
find_row() { # <name>: sets R_ID R_PID R_SID R_CWD R_STATE from the first listed row with that name
  local line
  line=$(fleet_rows | awk -F'|' -v n="$1" '$2 == n { print; exit }')
  [ -n "$line" ] || return 1
  IFS='|' read -r R_ID _ R_PID R_SID R_CWD R_STATE <<< "$line"
  seen_names="$seen_names $1"
}
row_live() { # the row last read by find_row is running: its pid when listed, else its state
  if [ "$R_PID" != - ]; then alive "$R_PID"; return; fi
  case "$R_STATE" in
    exited|completed|complete|done|stopped|failed|error|dead) return 1 ;;
    *) return 0 ;;   # working, blocked, or a value not seen before: treated as live
  esac
}
row_up() { find_row "$1" && row_live; }
row_gone() { ! fleet_rows | awk -F'|' -v i="$1" '$1 == i { f = 1 } END { exit !f }'; }
reply_line() { # the model's one-line answer from the transcript, cleaned of JSON punctuation
  sed -n 's/.*CCPROBE-FLEET:[ ]*//p' "$TFILE" \
    | awk -v n="$NONCE" '{ gsub(/\\n/, " "); gsub(/["\\,}`]/, " ")
                           if ($1 ~ /^\// || $1 == n) { print; exit } }' > "$ROOT/reply"
  [ -s "$ROOT/reply" ]
}
FLEET_CLEANED=0
fleet_cleanup() {
  [ "$FLEET_CLEANED" -eq 1 ] && return
  FLEET_CLEANED=1
  [ -n "${apid:-}" ] && kill "$apid" 2>/dev/null
  local name
  for name in $created_names; do
    if find_row "$name"; then
      "$CLAUDE_BIN" rm "$R_ID" >/dev/null 2>&1 </dev/null
    else
      case " $seen_names " in *" $name "*) ;; *) "$CLAUDE_BIN" rm "$name" >/dev/null 2>&1 </dev/null ;; esac
    fi
  done
  # The transcripts the probe's own sessions wrote; nothing else is touched.
  for sid in $created_sids; do
    find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -name "$sid.jsonl" -type f -exec rm -f {} + 2>/dev/null
  done
  [ "$KEEP" -eq 1 ] || rm -rf "$ROOT"
}

fleet_main() {
  local NAME="ccprobe-fleet-$NONCE" INC='INCONCLUSIVE (needs an earlier check)' TD="$ROOT/sessiontmp"
  local r_bg=$INC r_ag=$INC r_apid=$INC r_ast=$INC r_env=$INC r_tmp=$INC r_tr=$INC r_att=$INC r_res=$INC r_rm=$INC r_resp=$INC
  local id2="" pid2="" oldpid alias out rc line t t2 td2 tool
  created_names=""; seen_names=""; created_sids=""; apid=""; TFILE=""
  mkdir -p "$ROOT/work" "$TD" || exit 2
  trap fleet_cleanup EXIT
  trap 'exit 130' INT TERM
  printf 'claude-context-probe: --fleet starting real background sessions (a few minutes)...\n' >&2
  local settings
  settings=$(printf '{"env":{"CCPROBE_ENV":"%s","CLAUDE_CODE_TMPDIR":"%s"}}' "$NONCE" "$TD")

  # 1. bg-launch. --allowedTools takes several values, so the prompt follows a `--`.
  ( cd "$ROOT/work" && "$CLAUDE_BIN" --bg -n "$NAME" --model haiku --settings "$settings" \
      "$FLEET_ALLOW_FLAG" "$FLEET_ALLOWED_TOOLS" -- "$FLEET_PROMPT" ) >/dev/null 2>&1 </dev/null
  if [ $? -eq 0 ]; then
    r_bg=yes; created_names="$NAME"
    # 2. agents-json
    if ! command -v python3 >/dev/null 2>&1 && ! command -v jq >/dev/null 2>&1; then
      r_ag='INCONCLUSIVE (needs python3 or jq)'; r_apid=$r_ag; r_ast=$r_ag
    elif wait_for "$FLEET_WAIT" find_row "$NAME"; then
      if [ "$R_ID" != - ] && [ "$R_SID" != - ] && [ "$R_CWD" != - ]; then
        r_ag=yes
      else
        r_ag='no (row lacks id, sessionId or cwd)'
      fi
      # Informational: a tool that keys liveness on pid or on state needs to know which exist.
      if [ "$R_PID" != - ]; then r_apid=yes; else r_apid=no; fi
      if [ "$R_STATE" != - ]; then r_ast=yes; else r_ast=no; fi
    else
      r_ag=no
    fi
  else
    r_bg=no
  fi

  if [ "$r_ag" = yes ]; then
    SID=$R_SID; ID=$R_ID; PID=$R_PID; created_sids="$SID"
    # 5. transcript (read first: 3 and 4 come from it)
    tfind() { TFILE=$(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -name "$SID.jsonl" -type f 2>/dev/null | head -n 1); [ -n "$TFILE" ]; }
    if wait_for "$FLEET_WAIT" tfind; then r_tr=yes; else r_tr=no; fi
    # 3. settings-env and 4. tmpdir
    if [ "$r_tr" = yes ]; then
      if wait_for $((FLEET_WAIT * 2)) reply_line; then
        line=$(cat "$ROOT/reply")
        r_env=no; r_tmp=no
        td2=${TD#/private}
        for t in $line; do
          [ "$t" = "$NONCE" ] && r_env=yes
          t2=${t#/private}
          case "$t2" in "$td2"|"$td2"/*) r_tmp=yes ;; esac
        done
      else
        r_env='INCONCLUSIVE (no reply in the transcript)'; r_tmp=$r_env
      fi
    else
      r_env='INCONCLUSIVE (no transcript)'; r_tmp=$r_env
    fi
    # 6. attach: run it detached, kill it, and see whether the session survived
    "$CLAUDE_BIN" attach "$ID" </dev/null >/dev/null 2>&1 &
    apid=$!
    sleep "$FLEET_ATTACH_WAIT"
    kill "$apid" 2>/dev/null; wait "$apid" 2>/dev/null; apid=""
    if row_up "$NAME"; then r_att=yes; else r_att=no; fi
    # 7. resume-bg
    created_names="$created_names $NAME-r"
    if ( cd "$ROOT/work" && "$CLAUDE_BIN" --bg -n "$NAME-r" --model haiku --resume "$SID" -- 'reply OK' ) >/dev/null 2>&1 </dev/null \
       && wait_for "$FLEET_WAIT" row_up "$NAME-r"; then
      r_res=yes; id2=$R_ID; pid2=$R_PID
      created_sids="$created_sids $R_SID"
    else
      r_res=no
    fi
    # 8. rm: the row goes, the transcript stays
    if "$CLAUDE_BIN" rm "$ID" >/dev/null 2>&1 </dev/null && wait_for "$FLEET_WAIT" row_gone "$ID" && [ -f "$TFILE" ]; then
      r_rm=yes
    else
      r_rm=no
    fi
    # 9. respawn: kill the resumed session's process and see whether it comes back on a new one
    if [ "$r_res" = yes ] && [ "$pid2" = - ]; then
      r_resp='INCONCLUSIVE (no pid to kill on this version)'
    elif [ "$r_res" = yes ]; then
      oldpid=$pid2
      kill "$oldpid" 2>/dev/null
      respawned() { find_row "$NAME-r" && [ "$R_PID" != "$oldpid" ] && row_live; }
      if wait_for "$FLEET_WAIT" respawned; then r_resp=yes; else r_resp=no; fi
    fi
  fi

  # 10. models
  local mrows=""
  for alias in haiku sonnet opus 'opus[1m]'; do
    out=$( cd "$ROOT/work" && "$CLAUDE_BIN" -p --model "$alias" --max-turns 1 --no-session-persistence \
             'Reply with the single word OK.' 2>/dev/null </dev/null ); rc=$?
    if [ "$rc" -eq 0 ] && grep -qw OK <<< "$out"; then mrows="$mrows$alias=yes;"; else mrows="$mrows$alias=no;"; fi
  done
  # 11. tools: names only, from a session told not to use any
  out=$( cd "$ROOT/work" && "$CLAUDE_BIN" -p --model haiku --max-turns 1 --no-session-persistence \
           'List the names of your available tools, comma separated, and nothing else. Do not use any tool.' 2>/dev/null </dev/null ); rc=$?

  fleet_cleanup
  local version notok=0 row_
  version=$("$CLAUDE_BIN" --version 2>/dev/null | head -n 1)
  row_() { printf '  %-18s %s\n' "$1" "$2"; [ "$2" = yes ] || notok=1; }
  printf 'claude-context-probe --fleet: Claude Code %s, %s\n' "${version%% *}" "$(uname -s)"
  row_ bg-launch "$r_bg"; row_ agents-json "$r_ag"; printf '  %-18s %s\n' agents-pid "$r_apid"; printf '  %-18s %s\n' agents-state "$r_ast"   # informational: not counted in the exit status
   row_ settings-env "$r_env"; row_ tmpdir "$r_tmp"
  row_ transcript "$r_tr"; row_ attach "$r_att"; row_ resume-bg "$r_res"; row_ rm "$r_rm"; row_ respawn "$r_resp"
  for alias in haiku sonnet opus 'opus[1m]'; do
    case "$mrows" in *"$alias=yes;"*) row_ "model $alias" yes ;; *) row_ "model $alias" no ;; esac
  done
  for tool in Agent Workflow EnterWorktree SendMessage ListAgents; do
    if [ "$rc" -ne 0 ]; then printf '  %-18s %s\n' "tool $tool" 'INCONCLUSIVE (session failed)'
    elif grep -qw "$tool" <<< "$out"; then printf '  %-18s %s\n' "tool $tool" present
    else printf '  %-18s %s\n' "tool $tool" absent; fi
  done
  if [ "$rc" -ne 0 ]; then printf '  %-18s %s\n' 'tool Bash' 'INCONCLUSIVE (session failed)'
  elif grep -qw Bash <<< "$out"; then printf '  %-18s %s\n' 'tool Bash' 'present (run_in_background is a Bash parameter; not checked)'
  else printf '  %-18s %s\n' 'tool Bash' absent; fi
  printf 'run with: claude-context-probe --fleet\n'
  [ "$KEEP" -eq 1 ] && printf '\nkept: %s\n' "$ROOT"
  return "$notok"
}
if [ "$FLEET" -eq 1 ]; then fleet_main; exit $?; fi

# ---- layout A: a bare-container repository with a worktree (the .git inside is a FILE) --------
A="$ROOT/container"
mkdir -p "$A"
git init -q --bare "$A/.bare" || exit 2
printf 'gitdir: ./.bare\n' > "$A/.git"
# One empty commit, made with plumbing so it works on any git (worktree --orphan needs 2.42) and
# never touches the user's identity, signing or hooks. It exists only inside the temp tree.
tree=$(git --git-dir="$A/.bare" hash-object -t tree -w /dev/null) || exit 2
commit=$(git --git-dir="$A/.bare" -c user.name=probe -c user.email=probe@example.invalid \
  commit-tree --no-gpg-sign "$tree" -m probe) || exit 2
git --git-dir="$A/.bare" update-ref refs/heads/main "$commit" || exit 2
git --git-dir="$A/.bare" worktree add -q "$A/main" main 2>/dev/null \
  || { printf 'claude-context-probe: could not create a worktree\n' >&2; exit 2; }
W="$A/main"
plant "$A/CLAUDE.md" CONTAINER
plant "$ROOT/import-abs.md" IMPORTABS
plant "$A/import-rel.md" IMPORTOUT
mkdir -p "$W/docs"
plant "$W/docs/import-in.md" IMPORTIN
{ printf 'Codeword: %s\n\n' "$(cw REPOROOT)"
  printf '@docs/import-in.md\n\n@../import-rel.md\n\n@%s\n' "$ROOT/import-abs.md"; } > "$W/CLAUDE.md"
mkdir -p "$W/.claude/skills/probe-skill"
plant "$W/.claude/CLAUDE.md" DOTCLAUDE
plant "$W/CLAUDE.local.md" LOCALMD
plant "$W/AGENTS.md" AGENTSWITH
mkdir -p "$W/sub"
plant "$W/sub/CLAUDE.md" SUBDIR
plant "$ROOT/unreferenced.md" NEGATIVE
printf -- '---\nname: probe-skill\ndescription: Probe skill. Codeword %s\n---\n\nNothing to do.\n' "$(cw SKILL)" \
  > "$W/.claude/skills/probe-skill/SKILL.md"

# On-demand context (session E). The data files carry no codeword; the context around them does.
mkdir -p "$W/pkg" "$W/scoped" "$W/.claude/rules"
printf 'Nothing here.\n' > "$W/sub/data.txt"
printf 'Nothing here.\n' > "$W/pkg/data.txt"
printf 'Nothing here.\n' > "$W/scoped/data.txt"
printf '@AGENTS.md\n' > "$W/pkg/CLAUDE.md"
plant "$W/pkg/AGENTS.md" NESTIMPORT
printf -- '---\npaths:\n  - "scoped/**"\n---\n\nCodeword: %s\n' "$(cw RULESCOPED)" > "$W/.claude/rules/probe-scoped.md"
plant "$W/.claude/rules/probe-always.md" RULEALWAYS

# Dynamic context: a skill whose body runs a command when the skill is invoked, and prints a
# codeword that appears nowhere in the skill's text. The model could also run that command itself
# through its shell tool, which the skill needs available, so session D records its tool calls and
# a codeword only counts as delivered when the model made no shell call of its own.
printf '#!/bin/sh\nprintf "CCPROBE-%%s-%%s\\n" DYN "%s"\n' "$NONCE" > "$ROOT/dyn.sh"
mkdir -p "$W/.claude/skills/probe-dynamic"
printf -- '---\nname: probe-dynamic\ndescription: Probe of dynamic context. Invoke when asked to.\nallowed-tools: Bash(sh %s)\n---\n\nRendered:\n!`sh %s`\n' \
  "$ROOT/dyn.sh" "$ROOT/dyn.sh" > "$W/.claude/skills/probe-dynamic/SKILL.md"

# Hooks: each touches a marker when it runs and returns its codeword as additionalContext. The
# large one (on UserPromptSubmit, so it is measured even where SessionStart hooks cannot run) pads its context to 12,000 characters with a codeword near the start and one at the
# end, to show whether a size cap truncates what a hook can inject.
mkhook() { # <file> <event> <marker> <context>
  printf '#!/bin/sh\n: > "%s"\nprintf %%s '"'"'{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}'"'"'\n' \
    "$3" "$2" "$4" > "$1"
  chmod +x "$1"
}
pad=$(awk 'BEGIN { for (i = 0; i < 11800; i++) printf "x"; }')
mkhook "$ROOT/hook-ss.sh" SessionStart "$ROOT/ran-ss" "Codeword: $(cw HOOKSESSION)"
mkhook "$ROOT/hook-ups.sh" UserPromptSubmit "$ROOT/ran-ups" "Codeword: $(cw HOOKPROMPT)"
mkhook "$ROOT/hook-big.sh" UserPromptSubmit "$ROOT/ran-big" "Codeword: $(cw BIGHEAD) $pad Codeword: $(cw BIGTAIL)"
cat > "$ROOT/settings.json" <<EOF
{"hooks": {
  "SessionStart": [{"hooks": [{"type": "command", "command": "$ROOT/hook-ss.sh"}]}],
  "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "$ROOT/hook-ups.sh"},
                                  {"type": "command", "command": "$ROOT/hook-big.sh"}]}]
}}
EOF

# MCP: a minimal stdio server offering one tool whose name carries the codeword. Needs python3.
mcp_args=""
if command -v python3 >/dev/null 2>&1; then
  cat > "$ROOT/mcp.py" <<EOF
import json, sys
TOOL = "$(cw MCP)"
for line in sys.stdin:
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    if "id" not in msg:
        continue
    method = msg.get("method")
    if method == "initialize":
        result = {"protocolVersion": msg.get("params", {}).get("protocolVersion", "2025-06-18"),
                  "capabilities": {"tools": {}}, "serverInfo": {"name": "probe", "version": "1"}}
    elif method == "tools/list":
        result = {"tools": [{"name": TOOL, "description": "Probe tool.",
                             "inputSchema": {"type": "object", "properties": {}}}]}
    else:
        sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg["id"],
                                     "error": {"code": -32601, "message": "not supported"}}) + "\n")
        sys.stdout.flush()
        continue
    sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg["id"], "result": result}) + "\n")
    sys.stdout.flush()
EOF
  printf '{"mcpServers": {"probe": {"command": "python3", "args": ["%s"]}}}\n' "$ROOT/mcp.py" > "$ROOT/mcp.json"
  mcp_args="--mcp-config $ROOT/mcp.json"
fi

# ---- layout B: a plain clone (the .git is a DIRECTORY) with an instruction file above it, and a
# CLAUDE.md one level higher that is a SYMLINK to a file elsewhere. A symlink surfaces a generated
# file kept outside the project without an @import, which Claude Code gates per project behind an
# interactive approval.
B="$ROOT/linkbox/parent"
mkdir -p "$B/repo"
plant "$ROOT/link-target.md" SYMLINK
ln -s "$ROOT/link-target.md" "$ROOT/linkbox/CLAUDE.md" || exit 2
git init -q "$B/repo" || exit 2
plant "$B/CLAUDE.md" PARENT
plant "$B/repo/CLAUDE.md" REPOROOT

# ---- layout C: a repository whose only instruction file is AGENTS.md ------------------------------
# Nothing above it may carry a CLAUDE.md: whether AGENTS.md is read can depend on whether any
# CLAUDE.md was found, which is exactly what "alone" is testing.
C="$ROOT/agents"
mkdir -p "$C"
git init -q "$C" || exit 2
plant "$C/AGENTS.md" AGENTSMD

ASK='List every token in your context that contains the text CCPROBE- : in your system prompt, instructions, memory files, hook output, skill descriptions and tool names. Output only those tokens, one per line, with nothing else. If there are none, output NONE.'

run_session() { # <dir> <outfile> [extra args...]
  local dir=$1 out=$2; shift 2
  # shellcheck disable=SC2086 -- $mcp_args is deliberately split into flag and value
  # The prompt goes on stdin: --mcp-config takes a variable number of values and would swallow a
  # prompt passed as the last argument.
  ( cd "$dir" && printf '%s\n' "$ASK" | "$CLAUDE_BIN" -p --no-session-persistence --tools "Skill" --max-turns 1 "$@" ) \
    > "$out" 2> "$out.err"
  printf '%s\n' "$?" > "$out.rc"
}

printf 'claude-context-probe: running 5 headless sessions (up to a minute each)...\n' >&2
# shellcheck disable=SC2086
run_session "$W" "$ROOT/out-a" --settings "$ROOT/settings.json" --strict-mcp-config $mcp_args
run_session "$B/repo" "$ROOT/out-b" --strict-mcp-config
run_session "$C" "$ROOT/out-c" --strict-mcp-config
# Session D asks the model to invoke the dynamic skill. It needs the shell tool, because a skill's
# injected command runs through it and the invocation aborts without it.
ASK_DYN='Invoke the probe-dynamic skill now. After it loads, list every token in your context that contains the text CCPROBE- , one per line, with nothing else.'
( cd "$W" && printf '%s\n' "$ASK_DYN" | "$CLAUDE_BIN" -p --no-session-persistence --strict-mcp-config \
    --tools "Skill,Bash" --allowedTools "Bash(sh $ROOT/dyn.sh)" --max-turns 3 \
    --output-format stream-json --verbose ) > "$ROOT/out-d" 2> "$ROOT/out-d.err"
printf '%s\n' "$?" > "$ROOT/out-d.rc"
# Session E reads three neutral files with the Read tool, so that context scoped to them can load.
ASK_READ='Use the Read tool to read these three files, and no others: sub/data.txt, pkg/data.txt, scoped/data.txt. Then list every token in your context that contains the text CCPROBE- , one per line, with nothing else.'
( cd "$W" && printf '%s\n' "$ASK_READ" | "$CLAUDE_BIN" -p --no-session-persistence --strict-mcp-config \
    --tools "Read" --allowedTools "Read" --max-turns 6 \
    --output-format stream-json --verbose ) > "$ROOT/out-e" 2> "$ROOT/out-e.err"
printf '%s\n' "$?" > "$ROOT/out-e.rc"

seen() { # <outfile> <label>
  grep -q -- "$(cw "$2")" "$1" 2>/dev/null
}
session_state() { # <outfile> <positive-control label or ''>  -> OK | INCONCLUSIVE | INVALID
  if seen "$1" NEGATIVE; then printf INVALID; return; fi
  if [ "$(cat "$1.rc" 2>/dev/null)" != 0 ]; then printf INCONCLUSIVE; return; fi
  if [ -n "$2" ] && ! seen "$1" "$2"; then printf INCONCLUSIVE; return; fi
  printf OK
}
verdict() { # <outfile> <label> <session state>
  if [ "$3" != OK ]; then printf '%s' "$3"; return; fi
  if seen "$1" "$2"; then printf 'loaded'; else printf 'NOT loaded'; fi
}
hookline() { # <marker> <outfile> <label> <session state>
  local ran=no
  [ -e "$1" ] && ran=yes
  if [ "$4" != OK ]; then printf 'ran=%s, delivered=%s' "$ran" "$4"; return; fi
  if seen "$2" "$3"; then printf 'ran=%s, delivered=yes' "$ran"; else printf 'ran=%s, delivered=no' "$ran"; fi
}

sa=$(session_state "$ROOT/out-a" REPOROOT)
sb=$(session_state "$ROOT/out-b" REPOROOT)
# Layout C has no CLAUDE.md, so it has no positive control of its own; it is only as trustworthy
# as the other two sessions, whose model and invocation it shares.
sc=$(session_state "$ROOT/out-c" '')
sd=$(session_state "$ROOT/out-d" REPOROOT)
se=$(session_state "$ROOT/out-e" REPOROOT)
# Session E counts only if it read exactly the three data files: reading anything else could have
# fetched a codeword directly, and reading fewer leaves a NOT loaded that means nothing.
if [ "$se" = OK ]; then
  reads=$(grep -o '"file_path":"[^"]*"' "$ROOT/out-e" 2>/dev/null | sed 's/^"file_path":"//; s/"$//' | sort -u)
  others=$(printf '%s\n' "$reads" | grep -v -E -e '^$' -e '(^|/)(sub|pkg|scoped)/data\.txt$')
  [ -z "$others" ] || se=INCONCLUSIVE
  for d in sub pkg scoped; do
    printf '%s\n' "$reads" | grep -q -E "(^|/)$d/data\\.txt\$" || se=INCONCLUSIVE
  done
fi
[ "$sa" = OK ] && [ "$sb" = OK ] || [ "$sc" != OK ] || sc=INCONCLUSIVE

managed="none found"
for m in /etc/claude-code/managed-settings.json "/Library/Application Support/ClaudeCode/managed-settings.json"; do
  if [ -r "$m" ]; then
    keys=""
    if command -v python3 >/dev/null 2>&1; then
      keys=$(python3 -c 'import json,sys; print(", ".join(sorted(json.load(open(sys.argv[1])).keys())))' "$m" 2>/dev/null)
    fi
    managed="present (top-level keys: ${keys:-unreadable})"
  fi
done

version=$("$CLAUDE_BIN" --version 2>/dev/null | head -n 1)
row() { printf '  %-58s %s\n' "$1" "$2"; }

printf '\nclaude-context-probe 1 -- %s -- %s\n' "${version:-unknown version}" "$(uname -s)"
printf 'sessions: bare-container=%s  plain-clone=%s  agents-only=%s  dynamic-skill=%s  on-demand=%s\n' "$sa" "$sb" "$sc" "$sd" "$se"
printf '\nInstruction files\n'
row 'CLAUDE.md at the repository root (positive control)'       "$(verdict "$ROOT/out-a" REPOROOT "$sa")"
row 'CLAUDE.md in the container above a worktree (.git file)'   "$(verdict "$ROOT/out-a" CONTAINER "$sa")"
row 'CLAUDE.md in the directory above a clone (.git dir)'       "$(verdict "$ROOT/out-b" PARENT "$sb")"
row '.claude/CLAUDE.md in the repository'                       "$(verdict "$ROOT/out-a" DOTCLAUDE "$sa")"
row 'CLAUDE.local.md in the repository'                         "$(verdict "$ROOT/out-a" LOCALMD "$sa")"
row 'CLAUDE.md in a subdirectory, at session start'             "$(verdict "$ROOT/out-a" SUBDIR "$sa")"
row 'AGENTS.md alone, with no CLAUDE.md'                         "$(verdict "$ROOT/out-c" AGENTSMD "$sc")"
row 'AGENTS.md beside a CLAUDE.md'                               "$(verdict "$ROOT/out-a" AGENTSWITH "$sa")"
row 'CLAUDE.md two levels up, a symlink to a file elsewhere'   "$(verdict "$ROOT/out-b" SYMLINK "$sb")"
printf '\nImports from CLAUDE.md\n'
row '@import inside the repository'                             "$(verdict "$ROOT/out-a" IMPORTIN "$sa")"
row '@import outside the repository (relative, ../)'            "$(verdict "$ROOT/out-a" IMPORTOUT "$sa")"
row '@import outside the repository (absolute path)'            "$(verdict "$ROOT/out-a" IMPORTABS "$sa")"
printf '\nRules files (.claude/rules)\n'
row 'without paths:, at session start'                           "$(verdict "$ROOT/out-a" RULEALWAYS "$sa")"
row 'with paths:, at session start'                              "$(verdict "$ROOT/out-a" RULESCOPED "$sa")"
printf '\nOn demand (a session that reads one file in each scope)\n'
row 'nested CLAUDE.md, after reading a file beside it'           "$(verdict "$ROOT/out-e" SUBDIR "$se")"
row 'nested CLAUDE.md importing AGENTS.md, at session start'     "$(verdict "$ROOT/out-a" NESTIMPORT "$sa")"
row 'nested CLAUDE.md importing AGENTS.md, after reading beside' "$(verdict "$ROOT/out-e" NESTIMPORT "$se")"
row 'rules file with paths:, after reading a matching file'      "$(verdict "$ROOT/out-e" RULESCOPED "$se")"
printf '\nHooks (from --settings) and dynamic context\n'
row 'SessionStart hook'                                         "$(hookline "$ROOT/ran-ss" "$ROOT/out-a" HOOKSESSION "$sa")"
row 'UserPromptSubmit hook'                                     "$(hookline "$ROOT/ran-ups" "$ROOT/out-a" HOOKPROMPT "$sa")"
row '12,000-char hook context (UserPromptSubmit): start'                      "$(hookline "$ROOT/ran-big" "$ROOT/out-a" BIGHEAD "$sa")"
row '12,000-char hook context (UserPromptSubmit): end'                        "$(hookline "$ROOT/ran-big" "$ROOT/out-a" BIGTAIL "$sa")"
printf '\nSkills and MCP\n'
row 'project skill (.claude/skills) listed'                     "$(verdict "$ROOT/out-a" SKILL "$sa")"
if [ "$sd" != OK ]; then dynline=$sd
elif grep -q '"type":"tool_use"[^}]*"name":"Bash"' "$ROOT/out-d" 2>/dev/null; then dynline='INCONCLUSIVE (the model ran a shell command itself)'
elif seen "$ROOT/out-d" DYN; then dynline='delivered'
elif grep -q 'disabled by policy' "$ROOT/out-d" "$ROOT/out-d.err" 2>/dev/null; then dynline='NOT delivered (disabled by policy)'
elif grep -q 'permission check failed' "$ROOT/out-d" "$ROOT/out-d.err" 2>/dev/null; then dynline='NOT delivered (permission check failed)'
else dynline='NOT delivered'; fi
row 'skill dynamic context (!`command` in SKILL.md)'               "$dynline"
if [ -n "$mcp_args" ]; then
  row 'stdio MCP server tool listed (--mcp-config)'             "$(verdict "$ROOT/out-a" MCP "$sa")"
else
  row 'stdio MCP server tool listed (--mcp-config)'             'not tested (no python3)'
fi
printf '\nManaged settings: %s\n' "$managed"
printf 'Negative control: a codeword in a file nothing references was %s.\n' \
  "$(if seen "$ROOT/out-a" NEGATIVE || seen "$ROOT/out-b" NEGATIVE || seen "$ROOT/out-c" NEGATIVE || seen "$ROOT/out-d" NEGATIVE || seen "$ROOT/out-e" NEGATIVE; then printf 'SEEN (results invalid)'; else printf 'not seen'; fi)"

if [ "$KEEP" -eq 1 ]; then printf '\nkept: %s\n' "$ROOT"; fi
[ "$sa" = OK ] && [ "$sb" = OK ] && [ "$sc" = OK ] && [ "$sd" = OK ] && [ "$se" = OK ]
