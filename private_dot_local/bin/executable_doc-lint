#!/usr/bin/env python3
"""doc-lint — block references a cold reader cannot resolve from committed markdown.

WHY THIS EXISTS
    A committed document has to read cold, for a reader holding none of the session context
    that produced it. A reference that resolves only inside the authoring session's private
    state is not a weak reference, it is an unresolvable one — and it is invisible to whoever
    wrote it, because for them it resolves. That asymmetry is why this needs a gate rather
    than care. Its sibling `comment-lint` covers source commentary; this covers prose.

WHAT IT CHECKS
    wikilink        `[[slug]]` — memory-store link syntax, which resolves inside a memory
                    store and nowhere else, so in a repository it points at nothing.
    memory-ptr      a `(memory some-slug)` or ``memory `some-slug` `` pointer — the prose form
                    of the same defect.
    dangling-path   a repo-relative path cited in backticks or a markdown link that this
                    repository does not track. ADVISORY (low precision; see below).
    Enabled by the repository's config (CONFIG below), because each needs a vocabulary that
    is itself private or repo-specific:
    session-path    a concrete per-machine agent-state path, BARE in running prose.
    bare-adr        `ADR-0009` / `ADR 0009` with no owner prefix, where the repository cites
                    decision records from more than one log and the bare form is ambiguous.
    bare-adr-decision
                    `0067 D1` — a decision record cited by number alone.
    id-shorthand    `ABC-11/12/13` — later ids elided, so grep misses them. ADVISORY.
    spec-decisions  a spec or plan with no `## Decisions` section, or an entry whose home is
                    missing, fits no accepted form, or does not resolve here. Enabled by
                    spec-dirs: (see SPECS below).
    spec-status     a spec or plan with no status line before its first `## ` heading.
    spec-pending    a `pending` home in a spec that is finished, or is being moved out of
                    spec-dirs or deleted.
    spec-undated    a file in spec-dirs whose name does not begin with a date, so it is not
                    checked. ADVISORY.

CONFIG
    `key: value` lines, `#` comments, read from --config FILE, then $DOC_LINT_CONFIG, then
    `.doc-lint` at the repository root. Every key is optional; with none, only the universal
    checks above run, and the tool says so on stderr rather than implying full coverage.

        session-path: <regex>     a per-machine agent-state path. Group 1, if present, is
                                  reported as the concrete slug.
        adr-owners: A B C         prefixes that own decision logs cited here (`A-ADR-0012`).
                                  Setting it declares that a BARE form is ambiguous in this
                                  repository and enables bare-adr and bare-adr-decision. A
                                  repository citing only its OWN log should not set it: there
                                  the bare form is correct.
        id-prefixes: A B C        work-item prefixes whose slash/comma shorthand is reported.
        frozen: path/ other/      path prefixes exempt from the reference-form checks
                                  (bare-adr, bare-adr-decision, id-shorthand): frozen
                                  snapshots record what was written at the time.
        ledger-sections: Name     heading texts (one word each, matched case-insensitively
                                  as the heading's first word) whose sections are LEDGERS of
                                  which memories were absorbed. There a memory slug is an
                                  identifier other sessions match against, not a claim resting
                                  on the memory, so `memory-ptr` is not reported inside them.
                                  The section runs to the next heading at its own level or
                                  higher, sub-headings included.

        spec-dirs: a/ b/          directories holding specs and plans (searched recursively).
                                  Enables the spec check; without it doc-lint says the check
                                  is off. A mistyped `spec…` key is reported, not ignored.
        spec-cutover: YYYY-MM-DD  only documents whose name begins with a date on or after
                                  this are checked. It is the spec check's ratchet.
        own-prefix: ABC           the prefix of this repository's own register and ADR log.
        adr-dir: docs/adr         where this repository's ADRs live, matched by number.
        register-dir: docs/register
                                  where this repository's register entries live.

SPECS
    A decision made in a spec or plan must reach a durable home before the document is called
    done, because specs are scaffolding that gets archived. Each covered document carries:
        Status: <word> ...        before the first `## `, in any markup (`- **Status:**`,
                                  `> **Status (date):**`, `**Status**:`). The first word of
                                  letters after the colon being `executed`, `superseded` or
                                  `abandoned` marks the document finished.
        ## Decisions              one `- <decision> — <home>` line per decision; the home is
                                  the text after the last ` — `, optionally in backticks:
                                  a tracked path (never another spec), `<repo>:<path>`, an ADR
                                  id (`ADR-0007` or `ABC-ADR-0007`), a register id
                                  (`ABC-0012`), `pending` or `dropped`. A spec deciding
                                  nothing says `None.` and nothing else.
    A finished document may hold no `pending` home, and neither may one being moved out of
    spec-dirs or deleted (found from the staged changes under --added-only). The whole
    document is read even under --added-only, because finishing a spec can leave its
    decisions untouched. Ids with another owner's prefix, and `<repo>:<path>` homes, are
    accepted by their form: another repository's index is not visible from here.

    WHY CONFIGURED, NOT BUILT IN: a private tree name or a tracker's id scheme is itself the
    kind of token a publish guard blocks, so a built-in list would make this tool
    uninstallable in exactly the places it is meant to guard.

WHAT IT CANNOT CHECK — stated because a gate that hides its blind spots gets over-trusted
    * Semantic drift: a document restating a count or a status that has since changed.
    * An undefined taxonomy: a naming scheme used consistently and defined nowhere.
    * References into other repositories: this process cannot resolve another repo's index.
    * A single-token memory name: `memory-ptr` requires a hyphen in the slug, because the
      bare parenthesised word is ordinary English prose.
    * A memory pointer that WRAPS across a line break (`memory` at the end of one line, the
      slug on the next): the check reads one line at a time.
    * A decision record cited by bare number with no decision after it (`0073 states
      that...`), or a bare `D4` whose owning record is not on the line.
    * Prose that is self-contained in form and incomprehensible in substance.
    * A file the git index does not hold: an explicitly named untracked path is SKIPPED, and
      says so on stderr, because silence there once read as a clean result.

MENTION vs USE
    A document ABOUT these forms necessarily names them. Inline code and fenced blocks are
    MENTION; a placeholder path is MENTION, a concrete slug is USE. `session-path` fires only
    on a path BARE in prose: a code-formatted path is an operand or a named subject, and
    blocking it would push an editor to delete a runbook's own operands to reach green.

BLOCKING vs ADVISORY
    Decided by measured precision, not by how serious the defect sounds. `dangling-path`
    cannot separate this repo's path from a foreign one sharing a generic top-level segment;
    `id-shorthand`'s comma form also matches ordinary prose after an id. Both advise.

RATCHET
    `--added-only` reads each file's STAGED BLOB and reports only findings on lines the
    commit ADDS, so a gate introduced over a corpus that already violates it refuses only new
    defects. A rewritten line counts as added, so touching an old line surfaces its old
    defects too; fix them in the same commit.

USAGE
    doc-lint [--blocking-only] [--added-only] [--config FILE] [PATH ...]
    No PATH lints every tracked markdown file. Exit 1 if any BLOCKING finding.
    Output: `[category] path:line: message`.
"""
import os
import pathlib
import re
import subprocess
import sys

WIKILINK = re.compile(r"\[\[([a-z0-9][a-z0-9._/-]*)\]\]")
MEMORY_PTR = re.compile(r"\(memory\s+`?([a-z0-9]+(?:-[a-z0-9]+)+)`?\s*\)")
# The bare form, "memory `some-slug`": backticks required, because "memory" followed by a
# plain word is ordinary prose.
MEMORY_BARE = re.compile(r"(?<!\()\b[Mm]emor(?:y|ies)\b:?\s+`([a-z0-9]+(?:-[a-z0-9]+)+)`")
# The forms the two patterns above missed, found by a hand scan after a clean lint run:
# `(memory: \`slug\`)`, `**Memories:** \`slug\``, and every item AFTER the first in a list
# (`memories \`a\`, \`b\` and \`c\``). One pattern opens at the keyword in any of those dresses;
# LIST_ITEM then walks the list that follows it.
# A closing `**` counts only when a `**` also opens AT the keyword (the `**Memories:**` label).
# Otherwise "…rather than a memory:** `tool-name`" — the word ending a bold phrase — read as one.
MEMORY_OPEN = re.compile(
    r"(?:\*\*[Mm]emor(?:y|ies):?\*\*|\b[Mm]emor(?:y|ies)\b:?)\s+`([a-z0-9]+(?:-[a-z0-9]+)+)`"
)
LIST_ITEM = re.compile(r"(?:\s*\([^)]*\))?\s*(?:,|\band\b|/|&|\+)\s*`([a-z0-9]+(?:-[a-z0-9]+)+)`")
BARE_ADR = re.compile(r"(?<![A-Za-z0-9-])ADR[- ](\d{4})\b")
BARE_ADR_DECISION = re.compile(r"(?<![\w/.#-])(0\d{3})(?=(?:'s|’s)?\s+D\d)")
# A CommonMark code span: a run of N backticks, content, and a closing run of exactly N.
INLINE_CODE = re.compile(r"(?<!`)(?P<fence>`+)(?!`)(?P<body>.+?)(?<!`)(?P=fence)(?!`)")
MD_LINK = re.compile(r"\]\(([^)\s]+)\)")
PLACEHOLDER = re.compile(r"[<>*?{}]|\bNN\b|\bnn\b|\bN\b|\bXX\b|\bYY\b")
# A trailing line or line-range suffix on a cited path: `x.ts:128`, `x.ts:32-37`, and a comma
# list of either, `x.ts:89-106,143-196`.
LINE_SUFFIX = re.compile(r":\d+(?:-\d+)?(?:,\d+(?:-\d+)?)*$")
FENCE = re.compile(r"^\s*(```|~~~)")
HEADING = re.compile(r"^(#{1,6})\s+(\S+)")
HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
ADVISORY = {"dangling-path", "id-shorthand", "spec-undated"}
SPEC_KEYS = {"spec-dirs", "spec-cutover"}
SPEC_DATE = re.compile(r"^(\d{4}-\d{2}-\d{2})")
# A status line once list markers, blockquote marks and emphasis are stripped from its start:
# `- **Status:**`, `> **Status (date):**`, `**Status**:` and plain `Status:` all read the same.
STATUS_LEAD = re.compile(r"^(?:\s|[-*+>]\s|>|\*\*|__|\*|_)+")
STATUS_LINE = re.compile(r"^status(?:\s*\([^)]*\))?[*_]*\s*:[*_]*\s*(.*)$", re.IGNORECASE)
FINISHED = {"executed", "superseded", "abandoned"}
OWNED_ADR = re.compile(r"^(?:([A-Z][A-Z0-9]*)-)?ADR-(\d{1,4})$")
REGISTER_ID = re.compile(r"^([A-Z][A-Z0-9]*)-(\d{1,4})$")
OTHER_REPO = re.compile(r"^[A-Za-z0-9._-]+:[^\s:]+$")
SPEC_FORMAT = ("the section is `## Decisions`; each entry is `- <decision> — <home>`, the home "
               "being a tracked path, `<repo>:<path>`, an ADR or register id, `pending` or "
               "`dropped`; a spec deciding nothing says `None.`")


class Config:
    def __init__(self, raw: dict[str, str]):
        sp = raw.get("session-path", "").strip()
        self.session_path = re.compile(sp) if sp else None
        self.adr_owners = raw.get("adr-owners", "").split()
        prefixes = raw.get("id-prefixes", "").split()
        self.id_shorthand = None
        if prefixes:
            alt = "|".join(re.escape(p) for p in prefixes)
            self.id_shorthand = re.compile(
                r"\b(?:%s)-(?:ADR-)?\d+"
                r"(?:\s*(?:/|,|\band\b|&)\s*(?!(?:%s)-)\d{1,4}\b(?![-\d]))+" % (alt, alt)
            )
        self.frozen = tuple(raw.get("frozen", "").split())
        self.ledgers = {w.lower() for w in raw.get("ledger-sections", "").split()}
        self.spec_dirs = tuple(d.rstrip("/") + "/" for d in raw.get("spec-dirs", "").split())
        self.spec_cutover = raw.get("spec-cutover", "").strip()
        self.own_prefix = raw.get("own-prefix", "").strip()
        self.adr_dir = raw.get("adr-dir", "").strip().rstrip("/")
        self.register_dir = raw.get("register-dir", "").strip().rstrip("/")
        # A mistyped key is otherwise ignored in silence, and for this check silence means "off".
        self.unknown_spec_keys = sorted(k for k in raw if k.startswith("spec") and k not in SPEC_KEYS)


def load_config(root: pathlib.Path, explicit: str | None) -> tuple[Config, str | None]:
    for candidate in (explicit, os.environ.get("DOC_LINT_CONFIG"), str(root / ".doc-lint")):
        if candidate and pathlib.Path(candidate).is_file():
            raw = {}
            for line in pathlib.Path(candidate).read_text(encoding="utf-8").splitlines():
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                key, sep, value = line.partition(":")
                if sep:
                    raw[key.strip()] = value.strip()
            return Config(raw), candidate
        if candidate == explicit and explicit:
            sys.exit("doc-lint: --config %s is not a file" % explicit)
    return Config({}), None


def code_spans(line: str) -> list[tuple[int, int]]:
    return [m.span() for m in INLINE_CODE.finditer(line)]


def inside_one_span(span: tuple[int, int], spans: list[tuple[int, int]]) -> bool:
    return any(a <= span[0] and span[1] <= b for a, b in spans)


def mask_code(line: str) -> str:
    """Blank out inline-code spans, preserving length so columns stay truthful."""
    return INLINE_CODE.sub(lambda m: " " * len(m.group(0)), line)


def git(*args: str, cwd: pathlib.Path) -> str:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=True).stdout


def tracked(root: pathlib.Path) -> tuple[set[str], set[str], set[str]]:
    """(every tracked path, every tracked directory prefix, every top-level entry)."""
    files = {p for p in git("ls-files", cwd=root).splitlines() if p}
    dirs: set[str] = set()
    for f in files:
        parts = f.split("/")
        for i in range(1, len(parts)):
            dirs.add("/".join(parts[:i]))
    # Dot-prefixed top-level entries are EXCLUDED as path roots: a directory like `.claude/`
    # exists in many repos and in $HOME, so naming one refers to a convention, not a file here.
    tops = {f.split("/")[0] for f in files if "/" in f and not f.startswith(".")}
    return files, dirs, tops


def added_lines(root: pathlib.Path, rel: str) -> set[int]:
    out = git("diff", "--cached", "-U0", "--", rel, cwd=root)
    added: set[int] = set()
    for line in out.splitlines():
        m = HUNK.match(line)
        if m:
            start = int(m.group(1))
            count = 1 if m.group(2) is None else int(m.group(2))
            added.update(range(start, start + count))
    return added


def path_candidates(line: str) -> list[str]:
    # A code span may hold a command, not just a path (`tools/x.sh check`): the path is its first
    # word. Taking the whole span reported the argument as part of a path that does not exist.
    out = [(m.group("body").split() or [""])[0] for m in INLINE_CODE.finditer(line)]
    out += [m.group(1).strip() for m in MD_LINK.finditer(line)]
    return out


def check_file(text, rel, files, dirs, tops, cfg: Config):
    findings = []
    in_fence = False
    frozen = bool(cfg.frozen) and rel.startswith(cfg.frozen)
    owners = ", ".join("`%s-ADR-`" % o for o in cfg.adr_owners)
    ledger_level = 0  # >0 while inside a ledger section opened by a heading of that level
    for n, raw in enumerate(text.splitlines(), 1):
        if FENCE.match(raw):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        h = HEADING.match(raw)
        if h:
            level = len(h.group(1))
            if ledger_level and level <= ledger_level:
                ledger_level = 0
            if not ledger_level and h.group(2).lower().rstrip(":") in cfg.ledgers:
                ledger_level = level
        spans = code_spans(raw)
        masked = mask_code(raw)

        if cfg.session_path is not None:
            for m in cfg.session_path.finditer(raw):
                if inside_one_span(m.span(), spans):
                    continue
                slug = m.group(1) if m.groups() else m.group(0)
                findings.append(("session-path", rel, n,
                    f"concrete per-machine agent-state path `{slug}` BARE in prose — it cannot "
                    "be followed by any other reader; describe what it held, or cite a committed "
                    "artifact. (Code-formatted paths are operands or named subjects, not reported.)"))

        for m in WIKILINK.finditer(masked):
            findings.append(("wikilink", rel, n,
                f"memory-store wikilink `[[{m.group(1)}]]` in a committed doc — resolves only "
                "inside a memory store; state the claim, or cite the committed record that owns it"))

        # Reads the RAW line: the live form puts backticks INSIDE the parens, so masking would
        # blank the slug. A match wholly inside one code span is a quotation, not a use.
        if not ledger_level:
            slugs: dict[str, None] = {}
            for pat in (MEMORY_PTR, MEMORY_BARE, MEMORY_OPEN):
                for m in pat.finditer(raw):
                    if inside_one_span(m.span(), spans):
                        continue
                    slugs[m.group(1)] = None
                    if pat is MEMORY_OPEN:
                        pos = m.end()
                        while True:
                            nxt = LIST_ITEM.match(raw, pos)
                            if not nxt:
                                break
                            slugs[nxt.group(1)] = None
                            pos = nxt.end()
            for slug in slugs:
                findings.append(("memory-ptr", rel, n,
                    f"memory pointer to `{slug}` — the memory store is not "
                    "version-controlled and is not readable by a cold reader"))

        if cfg.adr_owners and not frozen:
            for m in BARE_ADR.finditer(masked):
                findings.append(("bare-adr", rel, n,
                    f"`{m.group(0)}` carries no owner — cite it with its log's prefix ({owners})"))
            for m in BARE_ADR_DECISION.finditer(masked):
                findings.append(("bare-adr-decision", rel, n,
                    f"`{m.group(1)}` cites a decision record by number alone — cite it with its "
                    f"log's prefix ({owners})"))
        if cfg.id_shorthand is not None and not frozen:
            for m in cfg.id_shorthand.finditer(masked):
                findings.append(("id-shorthand", rel, n,
                    f"`{m.group(0)}` elides the prefix on later ids, so grep for them misses "
                    "this line — spell each id in full"))

        for cand in path_candidates(raw):
            c = LINE_SUFFIX.sub("", cand.split("#")[0]).rstrip("/.,;:")
            if not c or PLACEHOLDER.search(c) or "/" not in c:
                continue
            if c.startswith(("http://", "https://", "/", "~", "./", "../")):
                continue
            if c.split("/")[0] not in tops or c in files or c in dirs:
                continue
            # The PARENT directory must be tracked here, which keeps the check inside this
            # repository without a hand-kept exclusion list: a path cited from another repo
            # usually shares only a generic top-level segment, and its parent does not exist here.
            if c.rsplit("/", 1)[0] not in dirs:
                continue
            findings.append(("dangling-path", rel, n,
                f"`{c}` is rooted in this repo but is not tracked here — a reader who clones "
                "this repo cannot follow it (checked against the git index, not the filesystem)"))
    return findings


def in_spec_dirs(rel: str, cfg: Config) -> bool:
    return any(rel.startswith(d) for d in cfg.spec_dirs)


def spec_status(lines: list[str]) -> tuple[int, str] | None:
    """(line number, first word of the status) from the header block, or None if it has none."""
    for n, line in enumerate(lines, 1):
        if line.startswith("## "):
            return None
        m = STATUS_LINE.match(STATUS_LEAD.sub("", line))
        if m:
            word = re.search(r"[A-Za-z]+", m.group(1))
            return n, (word.group(0).lower() if word else "")
    return None


def home_problem(home: str, files: set[str], dirs: set[str], cfg: Config) -> str | None:
    """Why HOME is not an acceptable durable home, or None when it is."""
    if home in ("pending", "dropped"):
        return None
    m = OWNED_ADR.match(home)
    if m:
        if m.group(1) and m.group(1) != cfg.own_prefix:
            return None  # another owner's log: not visible from here, accepted by its form
        if not cfg.adr_dir:
            return f"`{home}` names this repository's own ADR, but no adr-dir: is configured"
        num = re.compile(r"(?:^|-)0*%d[-_.]" % int(m.group(2)))
        if any(f.startswith(cfg.adr_dir + "/") and num.search(f.rsplit("/", 1)[-1]) for f in files):
            return None
        return f"`{home}` does not resolve to a record under {cfg.adr_dir}/"
    m = REGISTER_ID.match(home)
    if m:
        if m.group(1) != cfg.own_prefix:
            return None
        if not cfg.register_dir:
            return f"`{home}` names this repository's register, but no register-dir: is configured"
        if any(f.startswith(cfg.register_dir + "/") and
               (f.rsplit("/", 1)[-1].startswith(home + "-") or f.endswith("/" + home + ".md"))
               for f in files):
            return None
        return f"`{home}` does not resolve to an entry under {cfg.register_dir}/"
    if OTHER_REPO.match(home):
        return None  # a file in another repository, named explicitly: accepted by its form
    if " " not in home and ("/" in home or "." in home):
        if in_spec_dirs(home, cfg) or any(home.rstrip("/") + "/" == d for d in cfg.spec_dirs):
            return f"`{home}` is a spec or plan, which is never a decision's durable home"
        if home in files or home.rstrip("/") in dirs:
            return None
        return f"`{home}` is not tracked in this repository"
    return f"`{home}` is not a home: " + SPEC_FORMAT


def check_spec(text: str, rel: str, files: set[str], dirs: set[str], cfg: Config,
               leaving: bool = False) -> list[tuple[str, str, int, str]]:
    """The spec-decision contract for one document in spec-dirs. LEAVING: it is being moved out
    of spec-dirs or deleted, which finishes it."""
    name = rel.rsplit("/", 1)[-1]
    dated = SPEC_DATE.match(name)
    if not dated:
        return [("spec-undated", rel, 1, "an undated file in spec-dirs is not checked; a spec or "
                 "plan's name begins with its YYYY-MM-DD date")]
    if cfg.spec_cutover and dated.group(1) < cfg.spec_cutover:
        return []
    lines = text.splitlines()
    out = []
    status = spec_status(lines)
    if status is None:
        out.append(("spec-status", rel, 1, "no status line before the first `## ` heading; a "
                    "spec or plan states `Status: <word> ...`, and `executed`, `superseded` or "
                    "`abandoned` as that word marks it finished"))
    finished = leaving or (status is not None and status[1] in FINISHED)
    start = next((n for n, l in enumerate(lines, 1) if re.match(r"^## Decisions\s*$", l)), None)
    if start is None:
        out.append(("spec-decisions", rel, 1, "no `## Decisions` section: " + SPEC_FORMAT))
        return out
    body = []
    for n in range(start, len(lines)):
        line = lines[n]
        if re.match(r"^#{1,2} ", line):
            break
        if line.strip():
            body.append((n + 1, line))
    entries = [(n, l) for n, l in body if l.startswith("- ")]
    has_none = any(l.strip() == "None." for _, l in body)
    if has_none and entries:
        out.append(("spec-decisions", rel, start, "`None.` alongside entries; say `None.` only "
                    "when the spec decides nothing"))
    if not has_none and not entries:
        out.append(("spec-decisions", rel, start, "the Decisions section is empty: " + SPEC_FORMAT))
    for n, line in entries:
        if " — " not in line:
            out.append(("spec-decisions", rel, n, "an entry with no home: " + SPEC_FORMAT))
            continue
        home = line.rsplit(" — ", 1)[1].strip()
        if len(home) > 1 and home[0] == "`" and home[-1] == "`":
            home = home[1:-1]
        problem = home_problem(home, files, dirs, cfg)
        if problem:
            out.append(("spec-decisions", rel, n, problem))
        elif home == "pending" and finished:
            why = "moved out of spec-dirs or deleted" if leaving else "marked finished"
            out.append(("spec-pending", rel, n, f"a decision is still `pending` in a spec {why}; "
                        "promote it to its durable home, or mark it `dropped`"))
    return out


def leaving_specs(root: pathlib.Path, cfg: Config) -> list[tuple[str, str]]:
    """(source path, content before the change) for staged renames out of, and deletions from,
    spec-dirs. The commit hooks pass added and modified files only, so these are found here."""
    out = []
    status = git("diff", "--cached", "--name-status", "-M", "--diff-filter=DR", cwd=root)
    for line in status.splitlines():
        parts = line.split("\t")
        src = parts[1] if len(parts) > 1 else ""
        dst = parts[2] if len(parts) > 2 else ""
        if in_spec_dirs(src, cfg) and not in_spec_dirs(dst, cfg) and src.endswith(".md"):
            out.append((src, git("show", f"HEAD:{src}", cwd=root)))
    return out


def main(argv: list[str]) -> int:
    blocking_only = "--blocking-only" in argv
    added_only = "--added-only" in argv
    explicit = None
    rest = []
    it = iter(argv)
    for a in it:
        if a == "--config":
            explicit = next(it, None)
        elif a not in ("--blocking-only", "--added-only"):
            rest.append(a)
    start = pathlib.Path.cwd()
    root = pathlib.Path(git("rev-parse", "--show-toplevel", cwd=start).strip())
    cfg, source = load_config(root, explicit)
    if source is None:
        print("doc-lint: no config found — only the universal checks ran (see CONFIG in the "
              "module docstring). This is not full coverage.", file=sys.stderr)
    if not cfg.spec_dirs:
        print("doc-lint: the spec check is off (no spec-dirs: in config).", file=sys.stderr)
    for key in cfg.unknown_spec_keys:
        print(f"doc-lint: unknown config key {key}: — did you mean one of "
              f"{', '.join(sorted(SPEC_KEYS))}? Until it is spelled right the spec check "
              "ignores it.", file=sys.stderr)
    files, dirs, tops = tracked(root)

    if rest:
        targets = []
        for a in rest:
            rel = str((start / a).resolve().relative_to(root))
            if rel in files and rel.endswith(".md"):
                targets.append(rel)
            else:
                print(f"doc-lint: SKIPPED {rel} — not a tracked .md path, so nothing was checked. "
                      "Stage it (git add) and re-run; this is not a clean result.", file=sys.stderr)
    else:
        targets = sorted(f for f in files if f.endswith(".md"))

    findings = []
    for rel in targets:
        if added_only:
            text = git("show", f":{rel}", cwd=root)
        else:
            f = root / rel
            if not f.exists():
                continue
            text = f.read_text(encoding="utf-8", errors="replace")
        hits = check_file(text, rel, files, dirs, tops, cfg)
        if added_only:
            keep = added_lines(root, rel)
            hits = [h for h in hits if h[2] in keep]
        findings.extend(hits)
        # The spec check reads the whole document even under --added-only: a status change can
        # finish a spec without touching its decisions. Its cutover date is its ratchet.
        if cfg.spec_dirs and in_spec_dirs(rel, cfg):
            findings.extend(check_spec(text, rel, files, dirs, cfg))
    if cfg.spec_dirs and added_only:
        for src, text in leaving_specs(root, cfg):
            findings.extend(check_spec(text, src, files, dirs, cfg, leaving=True))

    if blocking_only:
        findings = [f for f in findings if f[0] not in ADVISORY]
    blocking = [f for f in findings if f[0] not in ADVISORY]
    for cat, rel, n, msg in findings:
        print(f"[{cat}] {rel}:{n}: {msg}")
    if findings:
        print(f"\n{len(blocking)} blocking, {len(findings) - len(blocking)} advisory. What this "
              "gate CANNOT check is listed in its module docstring; a green run is not a "
              "self-containment guarantee.", file=sys.stderr)
    return 1 if blocking else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
