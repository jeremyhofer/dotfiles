#!/usr/bin/env python3
"""machine-snapshot — what is loading this machine, readable from inside an agent sandbox.

WHY IT EXISTS. Claude Code's Bash sandbox on Linux (bubblewrap) gives each command its own PID
namespace, so `ps` inside it shows that one command and nothing else. A session can read the load
average and the pressure files, which say THAT the machine is busy, but nothing says WHO: which
session, which test lane, which kernel worker. Coordinating work across sessions without that is
guessing. This tool runs OUTSIDE the sandbox, from a systemd user timer every 15 seconds, and
writes what it sees to a state directory every session can read. Reading is all a session can do
with it: it shows other sessions' processes, and gives no way to signal them.

    machine-snapshot record           take one sample (the timer runs this; refuses in a sandbox)
    machine-snapshot now              the latest sample: busiest processes, stalled tasks, sessions
    machine-snapshot since MINUTES    totals over the last MINUTES minutes (below)
    machine-snapshot between START END    the same totals over an absolute window, local time:
                                      `between 09:30 10:15` (both today), or with dates,
                                      `between 2026-10-12 09:30 2026-10-12 10:15`; a date
                                      and time may also be one quoted argument

A window summary (`since`, `between`) prints: pressure (mean, max and how many samples crossed a
threshold, for cpu "some" > 50%, memory "full" > 10% and io "full" > 10%; the first two are the
"load pattern" a test failure is judged against), load, /tmp use (min and max), CPU by session and
by command, I/O by session and by command (MB read and written), and stalled tasks.

WHAT A SAMPLE MEASURES, AND WHY NOT `ps %cpu`. ps reports CPU time divided by the process's whole
lifetime, which says nothing about the last minute. A sample here records each process's CPU time
and subtracts the previous sample's, so every figure is CPU spent in the interval between them.

Short commands are the hard case: most of an agent session's work is commands that start and end
between two samples and are never seen alive. Their CPU is not lost. When a process reaps a dead
child the kernel adds the child's CPU time to the parent's "children" counters (cutime, cstime in
/proc/<pid>/stat), so it shows up as growth there. Each row therefore carries two figures: `own`
(the process itself) and `reaped` (children that ended in the interval). A child seen alive in an
earlier sample had part of its CPU counted then, so that part is subtracted from its parent's
reaped figure when it disappears. That correction is approximate (a reparented orphan is credited
to its new parent), which is why totals are labelled CPU-seconds and not presented as exact.

ATTRIBUTION. A row's `session` is the nearest ancestor whose command name, or the first word of
whose command line, is $MACHINE_SNAPSHOT_SESSION_COMM (default `claude`), shown with that process's
working directory, which is the directory the session works in. Stalled tasks (state D, uninterruptible wait) are
listed with their kernel wait channel; a load average well above the CPU in use is usually them.

I/O is attributed the same way, from /proc/<pid>/io: `rd` and `wr` are the process's read_bytes and
write_bytes growth since the previous sample. Unlike CPU there is no "children" counter, so the I/O
of a process that began and ended between two samples is never seen; the figures are a floor.
read_bytes counts bytes fetched from the storage layer; write_bytes counts bytes the process caused
to be SENT to it, counted when a page is dirtied (as proc(5) words it; the man page is not
installed on the machine this was written on, so that wording is from memory). Buffered writes
therefore show up whether or not they ever reach the disk, and a file deleted before writeback is
still counted. Read it as who generated write pressure, not as a measure of disk traffic. A process
whose io file cannot be read (another user's, or one that exited mid-scan) has no I/O figure.

/tmp: each sample records the filesystem's used and total bytes (statvfs), because a full or
nearly full /tmp is a machine-level cause of test failures. A per-user figure is not recorded:
only a walk of the tree gives it, and walking /tmp every 15 seconds would add the load measured.

A SAMPLE IS AN INSTANT. A task stalled for a few milliseconds between samples is never seen. The
pressure figures (/proc/pressure, averaged by the kernel over 10 seconds) are recorded with each
sample so a stall rate can be seen even when no single task is caught.

Files, under $MACHINE_SNAPSHOT_DIR (default $XDG_STATE_HOME/machine-snapshot, else
~/.local/state/machine-snapshot): `latest.json`, the whole last sample, and `history.jsonl`, one
line per sample holding only the rows that used CPU or were stalled, kept for
$MACHINE_SNAPSHOT_KEEP_HOURS (default 24).

Linux only: it reads /proc. $MACHINE_SNAPSHOT_PROC replaces /proc for the test suite.
"""
import json
import os
import sys
import time

PROC = os.environ.get("MACHINE_SNAPSHOT_PROC", "/proc")
STATE = os.environ.get("MACHINE_SNAPSHOT_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "machine-snapshot")
SESSION_COMM = os.environ.get("MACHINE_SNAPSHOT_SESSION_COMM", "claude")
KEEP_HOURS = float(os.environ.get("MACHINE_SNAPSHOT_KEEP_HOURS", "24"))
# A previous sample older than this is not a baseline: deltas across a suspend or a stopped timer
# would attribute an hour of CPU to one interval.
MAX_GAP = float(os.environ.get("MACHINE_SNAPSHOT_MAX_GAP", "120"))
# Rows below this many CPU-seconds in an interval, and not stalled, are left out of the history.
MIN_CPU = float(os.environ.get("MACHINE_SNAPSHOT_MIN_CPU", "0.2"))
NOW = os.environ.get("MACHINE_SNAPSHOT_NOW")   # a fixed clock, for the test suite only
TICK = os.sysconf("SC_CLK_TCK")
HOME = os.path.expanduser("~")
# The directory whose filesystem use is recorded with each sample; replaceable for the test suite.
TMP_DIR = os.environ.get("MACHINE_SNAPSHOT_TMP", "/tmp")
# Rows that did less I/O than this in an interval (and are not otherwise kept) are left out of the
# history, as MIN_CPU does for CPU: it keeps the file small on a busy machine.
MIN_IO = float(os.environ.get("MACHINE_SNAPSHOT_MIN_IO_MB", "1")) * 1048576
# The thresholds a window summary counts samples against.
THRESHOLDS = (("cpu_some", "cpu some", 50), ("memory_full", "memory full", 10),
              ("io_full", "io full", 10))

LATEST = os.path.join(STATE, "latest.json")
HISTORY = os.path.join(STATE, "history.jsonl")


def read(path, default=""):
    try:
        with open(path, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except OSError:
        return default


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def pressure():
    out = {}
    for kind in ("cpu", "io", "memory"):
        for line in read(os.path.join(PROC, "pressure", kind)).splitlines():
            parts = line.split()
            if parts and parts[0] in ("some", "full"):
                fields = dict(p.split("=", 1) for p in parts[1:] if "=" in p)
                out[f"{kind}_{parts[0]}"] = float(fields.get("avg10", 0))
    return out


def tmp_usage():
    try:
        st = os.statvfs(TMP_DIR)
    except OSError:
        return None
    return {"used": (st.f_blocks - st.f_bfree) * st.f_frsize, "size": st.f_blocks * st.f_frsize}


def read_io(base):
    # Absent (None) when unreadable, which is routine: /proc/<pid>/io is mode 0400 and other users'
    # processes refuse it, and a process can exit between the listing and the read.
    fields = {}
    for line in read(os.path.join(base, "io")).splitlines():
        k, _, v = line.partition(":")
        if v.strip().isdigit():
            fields[k] = int(v)
    if "read_bytes" in fields and "write_bytes" in fields:
        return fields["read_bytes"], fields["write_bytes"]
    return None


def scan():
    procs = {}
    for name in os.listdir(PROC):
        if not name.isdigit():
            continue
        base = os.path.join(PROC, name)
        stat = read(os.path.join(base, "stat"))
        # The command name sits in parentheses and may itself contain spaces or parentheses, so
        # the fields are counted from the LAST closing parenthesis.
        rparen = stat.rfind(")")
        if rparen < 0:
            continue
        f = stat[rparen + 2:].split()
        if len(f) < 22:
            continue
        try:
            cwd = os.readlink(os.path.join(base, "cwd"))
        except OSError:
            cwd = ""
        args = read(os.path.join(base, "cmdline")).replace("\0", " ").strip()
        procs[name] = {
            "io": read_io(base),
            "ppid": f[1],
            "state": f[0],
            "cpu": (int(f[11]) + int(f[12])) / TICK,
            "ccpu": (int(f[13]) + int(f[14])) / TICK,
            "start": int(f[19]),
            "rss_mb": int(f[21]) * os.sysconf("SC_PAGE_SIZE") // 1048576,
            # /proc/<pid>/comm carries a kernel worker's workqueue name (kworker/u64:3+netns),
            # which the 15-character name inside stat truncates away.
            "comm": read(os.path.join(base, "comm")).strip() or stat[stat.find("(") + 1:rparen],
            "wchan": read(os.path.join(base, "wchan")).strip(),
            "cwd": tilde(cwd),
            "args": args[:200],
        }
    return procs


def session_of(pid, procs):
    seen = set()
    while pid in procs and pid not in seen:
        seen.add(pid)
        p = procs[pid]
        # By command name OR by the first word of the command line. A background session's
        # process is named after its version (`2.1.296`) and only its command line says
        # `claude bg-spare`, so matching the name alone files every background session's work under
        # no session. Seen on the first live sample, 2026-10-11.
        argv0 = os.path.basename(p["args"].split(" ", 1)[0]) if p["args"] else ""
        if SESSION_COMM in (p["comm"], argv0):
            return f"{pid} {p['cwd']}"
        pid = p["ppid"]
    return "-"


def cmd_record():
    if read(os.path.join(PROC, "1", "comm")).strip() == "bwrap":
        sys.exit("machine-snapshot: refusing to record inside a sandbox: only this sandbox's own "
                 "processes are visible here, so the sample would be wrong. The timer records; "
                 "use `now` or `since` to read.")
    now = float(NOW) if NOW else time.time()
    procs = scan()
    prev, interval = {}, None
    try:
        with open(LATEST) as fh:
            last = json.load(fh)
        if 0 < now - last["ts"] <= MAX_GAP:
            prev, interval = last["procs"], now - last["ts"]
    except (OSError, ValueError, KeyError):
        pass

    # CPU already counted for children that have since disappeared, per parent (see the header).
    counted = {}
    for pid, p in prev.items():
        if pid not in procs or procs[pid]["start"] != p["start"]:
            counted[p["ppid"]] = counted.get(p["ppid"], 0) + p["cpu"] + p["ccpu"]

    rows = []
    for pid, p in procs.items():
        q = prev.get(pid)
        if interval is None:
            own = reaped = 0.0
        elif q and q["start"] == p["start"]:
            own = max(0.0, p["cpu"] - q["cpu"])
            reaped = max(0.0, p["ccpu"] - q["ccpu"] - counted.get(pid, 0))
        else:   # born in the interval: everything it has used, it used since the last sample
            own, reaped = p["cpu"], p["ccpu"]
        p["own"], p["reaped"] = round(own, 2), round(reaped, 2)
        # I/O is treated exactly like `own`: growth since the previous sample for the same process,
        # and for one born in the interval everything it has done, since it did all of it in the
        # interval. If either side is unreadable there is no baseline, so the delta is absent
        # (None), not zero: a process whose io file becomes readable later must not be credited with
        # its whole lifetime.
        rd = wr = None
        if interval is not None and p["io"]:
            if q and q["start"] == p["start"]:
                if q.get("io"):
                    rd, wr = max(0, p["io"][0] - q["io"][0]), max(0, p["io"][1] - q["io"][1])
            else:
                rd, wr = p["io"]
        p["rd"], p["wr"] = rd, wr
        io_heavy = (rd or 0) + (wr or 0) >= MIN_IO
        if interval is not None and (own + reaped >= MIN_CPU or p["state"] == "D" or io_heavy):
            row = {"pid": pid, "comm": p["comm"], "state": p["state"], "wchan": p["wchan"],
                   "own": p["own"], "reaped": p["reaped"], "rss_mb": p["rss_mb"],
                   "cwd": p["cwd"], "session": session_of(pid, procs), "args": p["args"][:120]}
            if rd is not None:
                row["rd"], row["wr"] = rd, wr
            rows.append(row)

    sample = {"ts": now, "interval": interval,
              "load": read(os.path.join(PROC, "loadavg")).split()[:3], "pressure": pressure()}
    usage = tmp_usage()
    if usage:
        sample["tmp"] = usage
    os.makedirs(STATE, exist_ok=True)
    tmp = LATEST + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(dict(sample, procs=procs), fh)
    os.replace(tmp, LATEST)
    if interval is not None:
        with open(HISTORY, "a") as fh:
            fh.write(json.dumps(dict(sample, rows=rows)) + "\n")
        prune(now)


def prune(now):
    # Rewriting the history on every sample would be most of this tool's own I/O, so it is rewritten
    # only once its first line is an hour past the retention window.
    cutoff = now - KEEP_HOURS * 3600
    with open(HISTORY) as fh:
        first = fh.readline()
    try:
        if json.loads(first)["ts"] >= cutoff - 3600:
            return
    except (ValueError, KeyError):
        pass
    kept = []
    with open(HISTORY) as fh:
        for line in fh:
            try:
                if json.loads(line)["ts"] >= cutoff:
                    kept.append(line)
            except (ValueError, KeyError):
                continue
    tmp = HISTORY + ".tmp"
    with open(tmp, "w") as fh:
        fh.writelines(kept)
    os.replace(tmp, HISTORY)


def when(ts):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts))


def header(s):
    p = s.get("pressure", {})
    return (f"load {' '.join(s.get('load', []))}  |  pressure avg10: cpu {p.get('cpu_some', 0):.0f}%"
            f"  io {p.get('io_some', 0):.0f}% (all stalled {p.get('io_full', 0):.0f}%)"
            f"  memory {p.get('memory_some', 0):.0f}%")


def gb(n):
    return f"{n / 2**30:.2f} GB"


def cmd_now():
    try:
        with open(LATEST) as fh:
            s = json.load(fh)
    except (OSError, ValueError):
        sys.exit(f"machine-snapshot: no sample in {STATE}; is machine-snapshot.timer running?")
    age = (float(NOW) if NOW else time.time()) - s["ts"]
    print(f"sample {when(s['ts'])} ({age:.0f}s ago)  {header(s)}")
    if s.get("tmp"):
        print(f"  {TMP_DIR} used {gb(s['tmp']['used'])} of {gb(s['tmp']['size'])}")
    if age > MAX_GAP:
        print(f"  STALE: older than {MAX_GAP:.0f}s, so the timer has stopped; this is not the machine now")
    if not s.get("interval"):
        print("  first sample after a gap: no interval to measure CPU over yet")
        return
    procs, iv = s["procs"], s["interval"]
    busy = sorted(procs.items(), key=lambda kv: -(kv[1]["own"] + kv[1]["reaped"]))
    print(f"\nbusiest over the last {iv:.0f}s (cores = CPU-seconds / interval):")
    print(f"  {'cores':>6} {'own':>6} {'reaped':>6} {'pid':>8}  command  [session]")
    for pid, p in busy[:20]:
        tot = p["own"] + p["reaped"]
        if tot < MIN_CPU:
            break
        print(f"  {tot / iv:6.2f} {p['own']:6.1f} {p['reaped']:6.1f} {pid:>8}  {p['comm']}  "
              f"[{session_of(pid, procs)}]  {p['args'][:70]}")
    stalled = [(pid, p) for pid, p in procs.items() if p["state"] == "D"]
    print(f"\nstalled (state D) at the instant of the sample: {len(stalled)}")
    for pid, p in stalled:
        print(f"  {pid:>8}  {p['comm']}  waiting in {p['wchan'] or '-'}  [{session_of(pid, procs)}]")
    sessions = {}
    for pid, p in procs.items():
        k = session_of(pid, procs)
        sessions[k] = sessions.get(k, 0) + p["own"] + p["reaped"]
    print("\nCPU by session (cores):")
    for k, v in sorted(sessions.items(), key=lambda kv: -kv[1]):
        if v >= MIN_CPU:
            print(f"  {v / iv:6.2f}  {'(not under a session)' if k == '-' else k}")


def summarise(start, end):
    """Print the totals for samples with start <= ts <= end. `since` and `between` both land here."""
    n, span = 0, 0.0
    by_session, by_comm, stalls, loads = {}, {}, {}, []
    io_session, io_comm = {}, {}
    press = {key: [] for key, _, _ in THRESHOLDS}
    tmp_used, tmp_size = [], 0
    try:
        fh = open(HISTORY)
    except OSError:
        sys.exit(f"machine-snapshot: no history in {STATE}")
    with fh:
        for line in fh:
            try:
                s = json.loads(line)
            except ValueError:
                continue
            if not start <= s["ts"] <= end:
                continue
            n += 1
            span += s.get("interval") or 0
            # Samples from before a field existed lack it; they are skipped for that figure only.
            for key in press:
                if key in s.get("pressure", {}):
                    press[key].append(s["pressure"][key])
            if s.get("load"):
                loads.append(float(s["load"][0]))
            if s.get("tmp"):
                tmp_used.append(s["tmp"]["used"])
                tmp_size = max(tmp_size, s["tmp"]["size"])
            for r in s["rows"]:
                cpu = r["own"] + r["reaped"]
                by_session[r["session"]] = by_session.get(r["session"], 0) + cpu
                by_comm[r["comm"]] = by_comm.get(r["comm"], 0) + cpu
                if "rd" in r:
                    for table, k in ((io_session, r["session"]), (io_comm, r["comm"])):
                        have = table.setdefault(k, [0, 0])
                        have[0] += r["rd"]
                        have[1] += r["wr"]
                if r["state"] == "D":
                    k = f"{r['comm']}  in {r['wchan'] or '-'}"
                    stalls[k] = stalls.get(k, 0) + 1
    if not n:
        sys.exit(f"machine-snapshot: no samples from {when(start)} to {when(end)}")
    print(f"{n} samples from {when(start)} to {when(end)}, covering {span / 60:.1f} minutes")
    print(f"load1 mean {sum(loads) / max(len(loads), 1):.1f}, max {max(loads, default=0):.1f}")
    print("\npressure avg10 (mean, max, samples over the threshold):")
    for key, label, limit in THRESHOLDS:
        v = press[key]
        if v:
            over = sum(1 for x in v if x > limit)
            print(f"  {label:<12} mean {sum(v) / len(v):5.1f}%  max {max(v):5.1f}%  "
                  f"over {limit}%: {over} of {len(v)}")
        else:
            print(f"  {label:<12} not recorded")
    if tmp_used:
        print(f"\n{TMP_DIR} used: min {gb(min(tmp_used))}, max {gb(max(tmp_used))} of {gb(tmp_size)}")
    else:
        print(f"\n{TMP_DIR} used: not recorded")
    print("\nCPU by session (CPU-seconds, mean cores):")
    for k, v in sorted(by_session.items(), key=lambda kv: -kv[1])[:15]:
        print(f"  {v:8.1f}  {v / max(span, 1):5.2f}  {'(not under a session)' if k == '-' else k}")
    print("\nCPU by command:")
    for k, v in sorted(by_comm.items(), key=lambda kv: -kv[1])[:15]:
        print(f"  {v:8.1f}  {v / max(span, 1):5.2f}  {k}")
    for title, table in (("session", io_session), ("command", io_comm)):
        print(f"\nI/O by {title} (MB read, MB written; written = sent to writeback, not necessarily disk):")
        for k, (rd, wr) in sorted(table.items(), key=lambda kv: -(kv[1][0] + kv[1][1]))[:15]:
            if rd + wr:
                print(f"  {rd / 1048576:8.1f}  {wr / 1048576:8.1f}  "
                      f"{'(not under a session)' if k == '-' else k}")
        if not any(rd + wr for rd, wr in table.values()):
            print("  none recorded")
    print(f"\nstalled tasks, by how many of the {n} samples caught them:")
    for k, v in sorted(stalls.items(), key=lambda kv: -kv[1])[:15]:
        print(f"  {v:6d}  {k}")
    if not stalls:
        print("  none caught")


def cmd_since(minutes):
    now = float(NOW) if NOW else time.time()
    summarise(now - minutes * 60, now)


def parse_when(tokens, now):
    """Consume `HH:MM` (today) or `YYYY-MM-DD HH:MM` from the front of tokens: (epoch, rest)."""
    try:
        if tokens and "-" in tokens[0]:
            day, clock, rest = tokens[0], tokens[1], tokens[2:]
        else:
            day, clock, rest = time.strftime("%Y-%m-%d", time.localtime(now)), tokens[0], tokens[1:]
        return time.mktime(time.strptime(f"{day} {clock}", "%Y-%m-%d %H:%M")), rest
    except (ValueError, IndexError):
        raise ValueError


def cmd_between(args):
    now = float(NOW) if NOW else time.time()
    tokens = " ".join(args).split()
    try:
        start, rest = parse_when(tokens, now)
        end, rest = parse_when(rest, now)
        if rest:
            raise ValueError
    except ValueError:
        sys.exit("machine-snapshot: between takes START END, each HH:MM (today) or YYYY-MM-DD HH:MM, "
                 "local time")
    if end < start:
        sys.exit("machine-snapshot: between: END is before START")
    summarise(start, end)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if not sys.platform.startswith("linux") and "MACHINE_SNAPSHOT_PROC" not in os.environ:
        print(f"machine-snapshot: nothing to do on {sys.platform}; it reads Linux's /proc")
        return
    if cmd == "record":
        cmd_record()
    elif cmd == "now":
        cmd_now()
    elif cmd == "since" and len(argv) == 3:
        try:
            cmd_since(float(argv[2]))
        except ValueError:
            sys.exit("machine-snapshot: since takes a number of minutes")
    elif cmd == "between" and len(argv) >= 4:
        cmd_between(argv[2:])
    elif cmd in ("-h", "--help"):
        print(__doc__)
    else:
        sys.exit("usage: machine-snapshot record | now | since MINUTES | between START END")


if __name__ == "__main__":
    main(sys.argv)
