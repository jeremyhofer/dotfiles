#!/usr/bin/env python3
"""context-lint — check a repository's always-on agent context against the project context standard.

WHY THIS EXISTS
    A coding agent loads a repository's context file at the start of every session. When each
    repository shapes that file differently, a session cannot know where the task list, the
    decision log or the off-limits actions are written; and as the file grows, its instructions
    are followed less. The standard fixes the shape and caps the size. A written standard is a
    request; this is the check that holds it.

WHAT IT CHECKS, at the repository root
    agents-missing    BLOCKING. There is no AGENTS.md. It holds the tool-neutral context.
    claude-import     BLOCKING. CLAUDE.md is missing, or its first non-blank line is not
                      `@AGENTS.md`. Claude Code reads AGENTS.md natively only when no CLAUDE.md
                      or CLAUDE.local.md exists, so a personal CLAUDE.local.md would silently
                      drop the whole file; the import cannot fail that way.
    title             BLOCKING. AGENTS.md does not open with a `# <repo name>` heading.
    sections          BLOCKING. A required section is missing or out of order, or an optional
                      section sits before the last required one. Required, in order:
                      Tasks, Layout, Deeper context, Rules, Writing here.
    size              BLOCKING. What loads unconditionally exceeds 200 lines or 14,000 bytes:
                      AGENTS.md, the rest of CLAUDE.md, every file either imports (followed
                      transitively), and every .claude/rules file without a `paths:` scope.
                      An import loads at session start with the file that names it, so moving
                      text into one changes nothing a session loads.
    import            BLOCKING. An in-repository `@import` does not resolve, so it cannot be
                      counted. ADVISORY for an import outside the repository, which Claude Code
                      loads only after a per-project approval.
    generated         BLOCKING. A generated block (text between `<!-- ... start -->` and
                      `<!-- ... end -->` markers, as Nx writes) is followed by hand-written
                      text in its file. A generated block goes last.
    docs-index        BLOCKING. A `docs/` tree has no `docs/README.md`, or the index does not name a
                      subdirectory or a document loose at `docs/` root. The index is how a reader,
                      a session or a tool finds anything in `docs/`.
    docs-layout       BLOCKING. A `docs/` subdirectory is neither one of the fleet layout's names
                      (adr, register, specs, plans, runbooks, research, reference, policies,
                      compliance, initiatives, archive) nor named in
                      the context file's `## Layout`, where a project declares its own subjects.
    docs-dated        BLOCKING. A document in `docs/specs/`, `docs/plans/` or `docs/research/` is not
                      named `YYYY-MM-DD-slug`. Those documents are frozen or finished, and the date is
                      what orders and ages them.
    docs-retired      BLOCKING. A tracked path with a segment named `superpowers` or `.superpowers`,
                      anywhere in the repository, or `docs/claude/` or `docs/agents/`, declared in
                      `## Layout` or not. These are retired homes: the project's manual lives in
                      `docs/reference/`, specs and plans in `docs/specs/` and `docs/plans/`.
    docs-outside      BLOCKING. A directory directly under the repository root named as a document
                      type (adr, specs, plans, runbooks, research, reference, evidence, handoffs,
                      archive). Documents live under `docs/`. Top level only: a subject's
                      `research/` further down is not checked, and `policies/` and `compliance/`
                      are left alone, since a top-level one is often tool configuration rather
                      than documents.
    docs-nested       BLOCKING. A `docs/` tree below the repository root, outside a publishable npm
                      package: the nearest `package.json` above it (below the root) is missing or
                      has `"private": true`. A monorepo package ships its own docs; everything
                      else keeps one tree, at the root. Paths inside the root `docs/` are the
                      layout checks' business, not this one's.
                      The docs checks take their entries from the git index when the root is
                      in a work tree, so an untracked or ignored leftover on disk (an empty directory
                      git never records) does not block a commit; outside a work tree, as for a
                      snapshot directory of staged copies, they read the filesystem.
    docs-initiative   BLOCKING. A folder directly under `docs/initiatives/` has no README.md; its README
                      does not name each file and subdirectory in the folder; it holds a file
                      other than README.md; or it holds a subdirectory other than specs, plans,
                      runbooks, research, reference, policies or compliance. The README is what
                      makes a folder one initiative's whole record rather than a heap.
                      A document or directory directly under an initiative's specs/, plans/ or
                      research/ that is not named `YYYY-MM-DD-slug` is a docs-dated finding, as at
                      the repository-wide type folders.
    docs-subject      BLOCKING. A subject declared in `## Layout` (a `docs/<name>/` line naming a
                      directory that exists, other than a fleet layout name) has no README.md. A
                      declared subject that is not on disk yet is not checked.
                      Nothing inside `docs/archive/` is checked.
    volatile          ADVISORY. A figure that an edit somewhere else can make false: a census
                      ("12 tests"), a claim pinned to a date ("as of 2026"), or "currently".
                      Name the command that measures it instead. Advisory because a number
                      that describes something the file itself defines is fine, and no
                      pattern tells the two apart.

WHAT IT CANNOT CHECK
    * Whether the content is right: that each line is something a fresh session would otherwise
      get wrong, that a rule truly cannot be enforced by a check, that pointers point at the
      right documents. Those are review, not pattern.
    * Paths inside the prose. `doc-lint` checks that.
    * A nested context file, unless asked: `context-lint --nested <subdirectory>` checks one. A
      nested file adds to the root file, so it needs the `@AGENTS.md` bridge, the caps, working
      imports and a generated block last, but not the root's title and sections.

USAGE
    context-lint [<repo-root>]            default: the current directory
    context-lint --nested <subdirectory>  a nested context file: no title or section checks
    Exit 0 when nothing blocks, 1 when something does, 2 on a usage error.
"""
import json
import os
import pathlib
import re
import subprocess
import sys

MAX_LINES = 200
MAX_BYTES = 14000
REQUIRED = ["Tasks", "Layout", "Deeper context", "Rules", "Writing here"]
DOCS_LAYOUT = {"adr", "register", "specs", "plans", "runbooks", "research", "reference", "policies", "compliance", "initiatives", "archive"}
# The type subdirectories an initiative folder may hold, and the three whose entries are dated.
INITIATIVE_SUBDIRS = {"specs", "plans", "runbooks", "research", "reference", "policies", "compliance"}
INITIATIVE_DATED = ("specs", "plans", "research")
DATED = re.compile(r"^\d{4}-\d{2}-\d{2}-")
RETIRED_ANYWHERE = {"superpowers", ".superpowers"}
RETIRED_DOCS = {"claude", "agents"}
# A top-level document-type directory and where its content lives under docs/.
DOC_TYPES_TOP = {"adr": "adr", "specs": "specs", "plans": "plans", "runbooks": "runbooks", "research": "research",
                 "reference": "reference", "evidence": "research", "handoffs": "archive", "archive": "archive"}
MAX_IMPORT_DEPTH = 5  # Claude Code follows imports to this depth

GEN_START = re.compile(r"<!--\s*([\w .-]+?)\s*start\s*-->", re.IGNORECASE)
GEN_END = re.compile(r"<!--\s*([\w .-]+?)\s*end\s*-->", re.IGNORECASE)
FENCE = re.compile(r"^\s*(```|~~~)")
BACKTICK = re.compile(r"`[^`]*`")
# An import is `@` at the start of a line or after whitespace, followed by a path-like token.
# The leading boundary keeps e-mail addresses out.
IMPORT = re.compile(r"(?:^|(?<=\s))@((?:~/|\.{1,2}/|/)?[\w.~/-]*[\w-](?:\.[\w]+)?)")
CENSUS = re.compile(
    r"(?<![\w.-])(?:~|about |roughly |approximately )?\d+\s+"
    r"(rows|files|findings|violations|entries|packages|projects|posts|URLs|repos|"
    r"machines|hits|gaps|skills|agents|topics|commits|tests|cases|lines|bytes|pages)\b",
    re.IGNORECASE,
)
CENSUS_NOT = re.compile(
    r"\b(last|first|up to|beyond|at most|at least|fewer than|more than|per|under|over)\s+$"
    r"|[<>≥≤]=?\s*$"
)
ASOF = re.compile(r"\bas of\s+(20\d\d|[A-Z][a-z]+ 20\d\d|\d\d?/\d\d?/\d\d)", re.IGNORECASE)
CURRENTLY = re.compile(r"\bcurrently\b", re.IGNORECASE)


def prose_lines(text):
    """Yield (line number, line) for lines outside fenced code blocks."""
    fenced = False
    for n, line in enumerate(text.splitlines(), 1):
        if FENCE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            yield n, line


def imports_of(path, text):
    """Resolve each @import in a file's prose to a path (not yet checked for existence)."""
    out = []
    for n, line in prose_lines(text):
        bare = BACKTICK.sub(lambda m: " " * len(m.group(0)), line)
        for m in IMPORT.finditer(bare):
            token = m.group(1).rstrip(".,;:)")
            if "/" not in token and "." not in token:
                continue  # a handle or a word, not a path
            if token.startswith("~/"):
                target = pathlib.Path.home() / token[2:]
            elif token.startswith("/"):
                target = pathlib.Path(token)
            else:
                target = path.parent / token
            out.append((n, token, target))
    return out


def rules_without_scope(root):
    rules = root / ".claude" / "rules"
    if not rules.is_dir():
        return []
    found = []
    for f in sorted(rules.rglob("*.md")):
        head = f.read_text(errors="replace")
        m = re.match(r"---\n(.*?)\n---\n", head, re.DOTALL)
        if not (m and re.search(r"^paths\s*:", m.group(1), re.MULTILINE)):
            found.append(f)
    return found


def tracked_paths(root):
    """Path parts of every file in the git index, or None when root is not a work tree's top.

    The index, not the disk: git records no empty directory, so a leftover one (or an ignored build
    output) is not part of what a commit ships and must not block it. Only a root that IS the top of
    a work tree counts; a snapshot directory of staged copies is read from disk like any other."""
    # Inside a git hook, git exports GIT_DIR and GIT_INDEX_FILE, and they override `-C`: a snapshot
    # directory would then answer as the hook's repository and read its index. So ask which
    # repository root is with git's variables removed, and keep them for the index read only when the
    # hook's repository IS root's, where GIT_INDEX_FILE names the index actually being committed.
    clean = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    try:
        top = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, env=clean)
        if top.returncode != 0 or pathlib.Path(top.stdout.strip()).resolve() != root.resolve():
            return None
        env = clean
        if os.environ.get("GIT_DIR"):
            gd = subprocess.run(["git", "-C", str(root), "rev-parse", "--absolute-git-dir"],
                                capture_output=True, text=True, env=clean, check=True)
            if pathlib.Path(os.environ["GIT_DIR"]).resolve() == pathlib.Path(gd.stdout.strip()).resolve():
                env = None
        ls = subprocess.run(["git", "-C", str(root), "ls-files", "-z"],
                            capture_output=True, text=True, check=True, env=env)
    except (OSError, subprocess.CalledProcessError):
        return None
    return [pathlib.PurePosixPath(p).parts for p in ls.stdout.split("\0") if p]


def docs_tracked(root, tracked):
    """Path parts below docs/ of every tracked file, or None when root is not a work tree's top."""
    if tracked is None:
        return None
    return [parts[1:] for parts in tracked if len(parts) > 1 and parts[0] == "docs"]


def main(argv):
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    nested = bool(args) and args[0] == "--nested"
    if nested:
        args = args[1:]
    if len(args) > 1 or (nested and not args):
        print(__doc__.strip())
        return 2
    root = pathlib.Path(args[0] if args else ".").resolve()
    if not root.is_dir():
        print(f"context-lint: not a directory: {root}", file=sys.stderr)
        return 2
    blocking, advisory = [], []
    agents, claude = root / "AGENTS.md", root / "CLAUDE.md"

    def rel(p):
        try:
            return str(p.resolve().relative_to(root))
        except ValueError:
            return str(p)

    if not agents.is_file():
        blocking.append(("agents-missing", "AGENTS.md", 0, "no AGENTS.md at the repository root"))
    if not claude.is_file():
        blocking.append(("claude-import", "CLAUDE.md", 0, "no CLAUDE.md; create one whose first line is `@AGENTS.md`"))
    else:
        first = next((l.strip() for l in claude.read_text(errors="replace").splitlines() if l.strip()), "")
        if first != "@AGENTS.md":
            blocking.append(("claude-import", "CLAUDE.md", 1, f"first line is `{first[:60]}`; it must be `@AGENTS.md`"))

    # Sections: the root file only. A nested file adds to the root and carries its own content.
    if agents.is_file() and not nested:
        text = agents.read_text(errors="replace")
        heads = [(n, l) for n, l in prose_lines(text) if re.match(r"#{1,2} ", l)]
        if not heads or not heads[0][1].startswith("# "):
            blocking.append(("title", "AGENTS.md", heads[0][0] if heads else 1,
                             "the file must open with a `# <repo name>` heading"))
        h2 = [(n, l[3:].strip()) for n, l in heads if l.startswith("## ")]
        names = [h for _, h in h2]
        pos = -1
        for req in REQUIRED:
            if req not in names:
                blocking.append(("sections", "AGENTS.md", 0, f"missing required section `## {req}`"))
                continue
            i = names.index(req)
            if i < pos:
                blocking.append(("sections", "AGENTS.md", h2[i][0], f"`## {req}` is out of order; required order: "
                                 + ", ".join(REQUIRED)))
            pos = max(pos, i)
        last_req = max((names.index(r) for r in REQUIRED if r in names), default=-1)
        for i, (n, h) in enumerate(h2[:last_req]):
            if h not in REQUIRED:
                blocking.append(("sections", "AGENTS.md", n, f"optional section `## {h}` comes before the required ones end; move it after `## Writing here`"))

    # What loads unconditionally: the two files, their imports transitively, unscoped rules.
    loaded, seen = [], set()

    def visit(path, depth, is_claude=False):
        key = path.resolve()
        if key in seen:
            return
        seen.add(key)
        text = path.read_text(errors="replace")
        counted = text
        if is_claude:  # the `@AGENTS.md` line itself is the bridge, AGENTS.md is counted on its own
            counted = "\n".join(l for l in text.splitlines() if l.strip() != "@AGENTS.md")
        loaded.append((path, len(counted.splitlines()), len(counted.encode())))
        # A generated block must be the last content in its file.
        lines = text.splitlines()
        for n, line in enumerate(lines, 1):
            if GEN_END.search(line) and any(l.strip() for l in lines[n:]):
                blocking.append(("generated", rel(path), n, "hand-written text follows a generated block; the block goes last"))
        if depth >= MAX_IMPORT_DEPTH:
            return
        for n, token, target in imports_of(path, text):
            if is_claude and token == "AGENTS.md":
                continue
            try:
                inside = target.resolve().is_relative_to(root)
            except (OSError, ValueError):
                inside = False
            if not inside:
                advisory.append(("import", rel(path), n, f"`@{token}` is outside the repository; Claude Code loads it only after a per-project approval"))
                continue
            if not target.is_file():
                blocking.append(("import", rel(path), n, f"`@{token}` does not resolve, so what it loads cannot be counted"))
                continue
            visit(target, depth + 1)

    if agents.is_file():
        visit(agents, 0)
    if agents.is_file() and not nested:
        # A generated block in AGENTS.md before the required sections is out of place too.
        text = agents.read_text(errors="replace")
        first_req = next((n for n, l in prose_lines(text) if l.startswith("## ") and l[3:].strip() in REQUIRED), None)
        for n, line in enumerate(text.splitlines(), 1):
            if GEN_START.search(line) and first_req and n < first_req:
                blocking.append(("generated", "AGENTS.md", n, "a generated block sits before the required sections; it goes after them"))
    if claude.is_file():
        visit(claude, 0, is_claude=True)
    for f in ([] if nested else rules_without_scope(root)):
        if f.resolve() not in seen:
            seen.add(f.resolve())
            t = f.read_text(errors="replace")
            loaded.append((f, len(t.splitlines()), len(t.encode())))

    # The docs/ layout, for a repository root (a nested context file owns no docs/ tree).
    docs = root / "docs"
    alltracked = None if nested else tracked_paths(root)
    if not nested:
        # Retired homes anywhere, and document-type directories outside docs/. From the index in a
        # work tree; a snapshot directory of staged copies is small, so its disk is walked.
        if alltracked is None:
            paths = []
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules")]
                here = pathlib.Path(dirpath).relative_to(root).parts
                paths += [here + (f,) for f in filenames]
            topdirs = {e.name for e in root.iterdir() if e.is_dir()}
        else:
            paths = alltracked
            topdirs = {parts[0] for parts in alltracked if len(parts) > 1}
        retired = set()
        for parts in paths:
            for i, seg in enumerate(parts):
                if seg in RETIRED_ANYWHERE:
                    retired.add("/".join(parts[:i + 1]))
                    break
        for r in sorted(retired):
            blocking.append(("docs-retired", r, 0, "a retired home; the manual lives in docs/reference/, specs and plans in docs/specs/ and docs/plans/"))
        nested_docs = {}
        for parts in paths:
            if parts[0] == "docs":
                continue
            for i in range(1, len(parts) - 1):
                if parts[i] == "docs":
                    nested_docs.setdefault(parts[:i + 1], None)
                    break
        for d in sorted(nested_docs):
            owner = None
            for j in range(len(d) - 1, 0, -1):
                pj = root.joinpath(*d[:j], "package.json")
                if pj.is_file():
                    owner = pj
                    break
            if owner is None:
                blocking.append(("docs-nested", "/".join(d), 0, "a docs/ tree below the root with no package.json above it; move its content into the root docs/"))
                continue
            try:
                private = json.loads(owner.read_text(errors="replace")).get("private") is True
            except (ValueError, AttributeError):
                private = True
            if private:
                blocking.append(("docs-nested", "/".join(d), 0, f"a docs/ tree inside a private package ({owner.relative_to(root)}); only a publishable package ships its own docs; move it into the root docs/"))
        for name in sorted(topdirs & DOC_TYPES_TOP.keys()):
            blocking.append(("docs-outside", name, 0, f"a document-type directory outside docs/; its content belongs in docs/{DOC_TYPES_TOP[name]}/"))
    if docs.is_dir() and not nested:
        index = docs / "README.md"
        # {name: is_dir} for each entry directly under docs/, and the names under each dated directory.
        tracked = docs_tracked(root, alltracked)
        if tracked is None:
            top = {e.name: e.is_dir() for e in docs.iterdir()}
            below = {sub: [e.name for e in (docs / sub).iterdir()] for sub in ("specs", "plans", "research") if (docs / sub).is_dir()}
        else:
            top, below = {}, {}
            for parts in tracked:
                top[parts[0]] = top.get(parts[0], False) or len(parts) > 1
                if len(parts) > 1 and parts[0] in ("specs", "plans", "research"):
                    below.setdefault(parts[0], []).append(parts[1])
        entries = sorted((n, d) for n, d in top.items() if not n.startswith(".") and n != "README.md")
        if not index.is_file():
            blocking.append(("docs-index", "docs", 0, "no docs/README.md; it indexes every subdirectory and loose document in docs/"))
        else:
            itext = index.read_text(errors="replace")
            for name, is_dir in entries:
                if is_dir or pathlib.PurePath(name).suffix in (".md", ".txt"):
                    if not re.search(r"(?<![\w.-])" + re.escape(name) + r"(?![\w.-])", itext):
                        blocking.append(("docs-index", "docs/README.md", 0, f"does not name `{name}{'/' if is_dir else ''}`"))
        layout = ""
        if agents.is_file():
            at = agents.read_text(errors="replace")
            m = re.search(r"^## Layout\s*$(.*?)(?=^## |\Z)", at, re.MULTILINE | re.DOTALL)
            layout = m.group(1) if m else ""
        for name, is_dir in entries:
            if is_dir and name in RETIRED_DOCS:
                blocking.append(("docs-retired", f"docs/{name}", 0, "a retired home, even when declared; the manual lives in docs/reference/, specs and plans in docs/specs/ and docs/plans/"))
                continue
            if is_dir and name not in DOCS_LAYOUT and not re.search(r"(?<![\w.-])" + re.escape(name) + r"/", layout):
                blocking.append(("docs-layout", f"docs/{name}", 0, "not a fleet layout directory and not named in AGENTS.md `## Layout`; declare it there, or move its content"))
        for sub, names in sorted(below.items()):
            for name in sorted(set(names)):
                if name.startswith(".") or name == "README.md":
                    continue
                if not DATED.match(name):
                    blocking.append(("docs-dated", f"docs/{sub}/{name}", 0, "not named YYYY-MM-DD-slug"))

        # Initiative folders and declared subjects. Entries come from the same source as the checks above.
        def kids(prefix):
            if tracked is None:
                base = docs.joinpath(*prefix)
                return {e.name: e.is_dir() for e in base.iterdir()} if base.is_dir() else {}
            out = {}
            for parts in tracked:
                if len(parts) > len(prefix) and parts[:len(prefix)] == prefix:
                    out[parts[len(prefix)]] = out.get(parts[len(prefix)], False) or len(parts) > len(prefix) + 1
            return out

        for folder, is_dir in sorted(kids(("initiatives",)).items()):
            if not is_dir or folder.startswith("."):
                continue
            where = f"docs/initiatives/{folder}"
            inside = kids(("initiatives", folder))
            if "README.md" not in inside:
                blocking.append(("docs-initiative", where, 0, "no README.md; it names every file and subdirectory of the initiative"))
                rtext = None
            else:
                rtext = (docs / "initiatives" / folder / "README.md").read_text(errors="replace")
            for name, sub in sorted(inside.items()):
                if name.startswith(".") or name == "README.md":
                    continue
                if rtext is not None and not re.search(r"(?<![\w.-])" + re.escape(name) + r"(?![\w.-])", rtext):
                    blocking.append(("docs-initiative", f"{where}/README.md", 0, f"does not name `{name}{'/' if sub else ''}`"))
                if not sub:
                    blocking.append(("docs-initiative", f"{where}/{name}", 0, "a loose file in an initiative folder; only README.md sits here, documents go in a type subdirectory"))
                elif name not in INITIATIVE_SUBDIRS:
                    blocking.append(("docs-initiative", f"{where}/{name}", 0, "not one of the initiative type subdirectories (" + ", ".join(sorted(INITIATIVE_SUBDIRS)) + ")"))
                elif name in INITIATIVE_DATED:
                    for doc in sorted(kids(("initiatives", folder, name))):
                        if not doc.startswith(".") and doc != "README.md" and not DATED.match(doc):
                            blocking.append(("docs-dated", f"{where}/{name}/{doc}", 0, "not named YYYY-MM-DD-slug"))
        declared = set(re.findall(r"(?<![\w.-])docs/([\w.-]+)/", layout))
        for name in sorted(declared):
            if name in DOCS_LAYOUT or name in RETIRED_DOCS or name.startswith("."):
                continue
            if top.get(name) is True and "README.md" not in kids((name,)):
                blocking.append(("docs-subject", f"docs/{name}", 0, "a subject declared in AGENTS.md `## Layout` has no README.md; it says what the subject holds and how it is organized"))

    total_lines = sum(l for _, l, _ in loaded)
    total_bytes = sum(b for _, _, b in loaded)
    if total_lines > MAX_LINES or total_bytes > MAX_BYTES:
        over = []
        if total_lines > MAX_LINES:
            over.append(f"{total_lines} lines (cap {MAX_LINES})")
        if total_bytes > MAX_BYTES:
            over.append(f"{total_bytes} bytes (cap {MAX_BYTES})")
        blocking.append(("size", "AGENTS.md", 0, "what loads unconditionally is " + " and ".join(over)
                         + "; move situational content to a deeper-context document, a nested context file,"
                         " a path-scoped rules file or a skill, never into an import"))

    # Volatile figures, in the hand-written files only.
    for path, _, _ in loaded:
        for n, line in prose_lines(path.read_text(errors="replace")):
            bare = BACKTICK.sub(lambda m: " " * len(m.group(0)), line)
            for m in CENSUS.finditer(bare):
                if not CENSUS_NOT.search(bare[: m.start()]):
                    advisory.append(("volatile", rel(path), n, f"`{m.group(0).strip()}` is a census; if it counts something outside this file, name the command that measures it"))
            for rx, what in ((ASOF, "a claim pinned to a date"), (CURRENTLY, "\"currently\" dates itself")):
                m = rx.search(bare)
                if m:
                    advisory.append(("volatile", rel(path), n, f"`{m.group(0)}`: {what}"))

    print(f"context-lint: {root.name}: {total_lines} lines, {total_bytes} bytes load unconditionally "
          f"(caps {MAX_LINES} lines, {MAX_BYTES} bytes), from:")
    for path, l, b in loaded:
        print(f"  {rel(path):50} {l:5} lines {b:7} bytes")
    for kind, file, n, msg in blocking + advisory:
        where = f"{file}:{n}" if n else file
        tag = "BLOCKING" if (kind, file, n, msg) in blocking else "advisory"
        print(f"[{kind}] {tag} {where}: {msg}")
    print(f"context-lint: {len(blocking)} blocking, {len(advisory)} advisory. "
          "A clean run says the shape and size hold, not that the content is right.")
    return 1 if blocking else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
