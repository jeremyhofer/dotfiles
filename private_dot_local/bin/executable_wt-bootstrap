#!/bin/sh
# wt-bootstrap — install a freshly created git worktree's dependencies, deterministically.
#
# WHY THIS EXISTS. `git worktree add` gives a new worktree every tracked file in the
# repository, but not the installed dependencies that go with them -- node_modules, a uv
# virtualenv, and the rest are gitignored by design, so a brand-new worktree has none of
# them. Left alone, a project is unusable in that worktree until someone remembers to
# install by hand. worktrunk runs this script as a blocking `pre-start` hook so that never
# happens: the worktree is ready for work the moment it opens.
#
# Detection is by LOCKFILE, never by asking or guessing. The lockfile already states which
# package manager the project committed to, and every install below is a FROZEN install
# (never a plain "install") -- a worktree bootstrap must reproduce exactly what is locked,
# not resolve something new and possibly drift the lockfile that other worktrees share.
#
# For a project that uses husky, running its JavaScript package manager's install here also
# runs the package's own `prepare` script, which is how husky wires git hooks into
# .git/hooks. So for a husky repo this step doubles as hook setup too, with nothing extra to
# remember or run separately.
#
# OPT-IN PER PROJECT, NOT GLOBAL. worktrunk's own hooks APPEND to whatever a project
# configures rather than replacing it, so there is no single switch that turns this off for
# one project while leaving it on for another. A project that wants this wires it into its
# own worktrunk pre-start config; a project that does not, simply never calls it.
#
# USAGE: wt-bootstrap [-C <dir>]...
#   Operates on the current directory by default; -C <dir> targets a different one (the
#   worktree's OWN root, not necessarily the repository's -- a worktree of a monorepo may
#   lock dependencies at its own subdirectory). -C may be given more than once, for a
#   repository with a nested package that has a lockfile of its own: the directories are
#   processed in the order given, each by the rules below, and the first failure stops the run
#   with that failure's exit status. With more than one, every message is prefixed with the
#   directory it concerns ("wt-bootstrap: <dir>: npm ci"); with one, the output is as ever.
#   With more than one, a directory that does not exist is reported ("wt-bootstrap: <dir>: not a
#   directory here, skipped") and skipped, exit status unaffected: a worktree of an older branch may
#   predate a declared nested package, and failing this blocking hook would break its creation. A
#   single -C (or none) naming a missing directory is still refused, exit 1.
#   The directories are DECLARED, never discovered: a repository may track lockfiles inside
#   test fixtures that must never be installed. wt-config-gen writes them from the manifest's
#   worktrunk.bootstrapDirs. Prints nothing on success beyond one line per
#   action, to stderr, each prefixed "wt-bootstrap: ". Never reads or writes .env files or
#   any other secret material -- it only checks for lockfiles by name and runs the installer
#   that matches.
#
# WHAT RUNS, KEYED BY LOCKFILE:
#   pnpm-lock.yaml        -> pnpm install --frozen-lockfile
#   package-lock.json     -> npm ci
#   yarn.lock              -> yarn install --immutable
#   bun.lock / bun.lockb  -> bun install --frozen-lockfile
#   uv.lock                -> uv sync --frozen
#   none of the above     -> nothing; exit 0
#
# At most ONE JavaScript package manager runs. Two JS lockfiles in the same directory (e.g.
# a leftover package-lock.json beside an adopted pnpm-lock.yaml) is refused as ambiguous
# rather than guessed -- picking the wrong one silently would be worse than stopping.
# uv.lock is independent of all of that: a repository can commit to both a JS package
# manager and uv at once, and when it does, both installs run, JavaScript first (since that
# is also the one wiring git hooks, so it goes before anything else that might depend on
# them being in place).
#
# TOOL VERSIONS, ON A MACHINE SWITCHED TO MISE. A machine is switched when the [data] of its
# generated base chezmoi config (${XDG_CONFIG_HOME:-~/.config}/chezmoi/chezmoi.toml) says
# `miseActive = true`; absent or false, nothing below about mise runs and mise is never called.
# Switched, before any install, it asks mise which versions the worktree's pins request that are
# not installed (`mise ls --current --missing`, offline) and, when there are any, prints ONE line
# naming them and the command that installs them, `mise install` in the worktree. It never installs
# a version itself: versions are installed deliberately, and inside an agent sandbox the install
# could not write mise's directories anyway. The report does not change the exit status; an
# install below that needs a missing version then fails through mise, with its own status.

set -eu

# One directory per -C, kept in order, one per line (a directory name holding a newline is not
# supported). No -C at all is the current directory.
dirs=""
count=0
while [ $# -gt 0 ]; do
  case "$1" in
    -C) dirs="$dirs${dirs:+
}${2:-.}"; count=$((count + 1)); shift 2 ;;
    -h|--help) sed -n '2,69p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'wt-bootstrap: unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done
if [ "$count" -eq 0 ]; then dirs="."; count=1; fi

# With more than one directory every message names the one it concerns; with one, the output is
# what it always was.
tag=""

require_cmd() {
  command -v "$1" >/dev/null 2>&1 && return 0
  printf 'wt-bootstrap: %s%s not found on PATH (needed for %s)\n' "$tag" "$1" "$2" >&2
  exit 1
}

bootstrap_dir() {
  # --- Tool versions: report what a switched machine has not installed -----------------
  # Builtins only, like the rest of this script, so it runs on a PATH that holds nothing else.
  mise_switched() {
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"
    [ -f "$cfg" ] || return 1
    tab=$(printf '\t')
    while IFS=" $tab=" read -r key value _rest || [ -n "$key" ]; do
      if [ "$key" = miseActive ] && [ "$value" = true ]; then return 0; fi
    done < "$cfg"
    return 1
  }

  if mise_switched; then
    if ! command -v mise >/dev/null 2>&1; then
      printf 'wt-bootstrap: %smise not found on PATH, on a machine switched to it (miseActive); tool versions not checked\n' "$tag" >&2
    elif rows=$(MISE_OFFLINE=1 mise ls --current --missing --no-header); then
      # Each row: tool, version, "(missing)", the file that requests it, the request as written.
      missing=""
      while read -r tool version flag _rest; do
        if [ "$flag" = "(missing)" ]; then missing="$missing $tool@$version"; fi
      done <<EOF
$rows
EOF
      if [ -n "$missing" ]; then
        printf "wt-bootstrap: not installed:%s -- run 'mise install' in %s (never run here: versions are installed deliberately)\n" "$missing" "$(pwd)" >&2
      fi
    else
      printf 'wt-bootstrap: %smise could not list the tool versions this worktree needs (its error is above); not checked\n' "$tag" >&2
    fi
  fi

  # --- JavaScript: at most one lockfile may pick the package manager --------------------
  js_present=""
  js_lock=""
  js_manager=""
  note_js() { js_present="$js_present $1"; js_lock="$1"; js_manager="$2"; }

  [ -f pnpm-lock.yaml ]    && note_js pnpm-lock.yaml pnpm
  [ -f package-lock.json ] && note_js package-lock.json npm
  [ -f yarn.lock ]         && note_js yarn.lock yarn
  if [ -f bun.lock ]; then
    note_js bun.lock bun
  elif [ -f bun.lockb ]; then
    note_js bun.lockb bun
  fi

  # Deliberate word-splitting on a space-joined list, only to COUNT how many lockfiles were
  # found -- none of the names contain whitespace, so this is safe and simpler than an array
  # POSIX sh does not have.
  set -- $js_present
  js_count=$#

  if [ "$js_count" -gt 1 ]; then
    printf 'wt-bootstrap: %sambiguous: multiple JavaScript lockfiles present (%s) -- refusing to guess\n' "$tag" "${js_present# }" >&2
    exit 1
  fi

  if [ "$js_count" -eq 1 ]; then
    case "$js_manager" in
      pnpm)
        require_cmd pnpm "$js_lock"
        printf 'wt-bootstrap: %spnpm install --frozen-lockfile\n' "$tag" >&2
        pnpm install --frozen-lockfile
        ;;
      npm)
        require_cmd npm "$js_lock"
        printf 'wt-bootstrap: %snpm ci\n' "$tag" >&2
        npm ci
        ;;
      yarn)
        require_cmd yarn "$js_lock"
        printf 'wt-bootstrap: %syarn install --immutable\n' "$tag" >&2
        yarn install --immutable
        ;;
      bun)
        require_cmd bun "$js_lock"
        printf 'wt-bootstrap: %sbun install --frozen-lockfile\n' "$tag" >&2
        bun install --frozen-lockfile
        ;;
    esac
  fi

  # --- Python (uv): independent of the JavaScript branch above, runs after it -----------
  if [ -f uv.lock ]; then
    require_cmd uv uv.lock
    printf 'wt-bootstrap: %suv sync --frozen\n' "$tag" >&2
    uv sync --frozen
  fi
}

# Each directory runs in its own subshell, in the order given, and the first failure stops the
# run with that failure's own status. `set +e` around the subshell is deliberate: on the left of
# `||` or in an `if`, errexit would be switched off inside it.
while IFS= read -r d <&3; do
  if [ "$count" -gt 1 ]; then
    tag="$d: "
    # A worktree of an older branch may predate a declared nested package; failing the blocking
    # hook there would break worktree creation, so with several directories a missing one is
    # reported and skipped. A single directory is still refused (below).
    if [ ! -d "$d" ]; then
      printf 'wt-bootstrap: %snot a directory here, skipped\n' "$tag" >&2
      continue
    fi
  fi
  set +e
  (
    set -e
    [ -d "$d" ] || { printf 'wt-bootstrap: not a directory: %s\n' "$d" >&2; exit 1; }
    cd "$d"
    bootstrap_dir
  )
  rc=$?
  set -e
  [ "$rc" -eq 0 ] || exit "$rc"
done 3<<EOF
$dirs
EOF

exit 0
