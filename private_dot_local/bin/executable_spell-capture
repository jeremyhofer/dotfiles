#!/bin/sh
# spell-capture -- re-import a private nvim spell wordlist ($1) back into the
# overlay chezmoi source, so `chezmoi-overlay apply` can't clobber a word added
# via `zg`. Called (non-interactively) from nvim's spell keymaps -- see
# ~/.config/nvim/lua/config/spell.lua. No-op if the overlay isn't set up here.
set -u

cfg="$HOME/.config/chezmoi/overlay"
# Silent no-op when this machine has no overlay -- this runs from an nvim keymap, where an error
# would be noise. The check stays HERE rather than being delegated, because chezmoi-overlay fails
# loudly by design; quiet degradation is this caller's requirement, not the wrapper's.
[ -f "$cfg/chezmoi.toml" ] || exit 0

# Delegate to the one definition of "the overlay instance" instead of re-deriving its flags, which
# is how the two drifted apart into two copies. Absolute path, not PATH lookup: nvim may be launched
# from a desktop session that never sourced .zshenv.
exec "$HOME/.local/bin/chezmoi-overlay" re-add "$1"
