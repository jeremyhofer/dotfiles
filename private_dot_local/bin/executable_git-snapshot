#!/bin/sh
# git-snapshot — capture uncommitted work before a command that would discard it.
#
# WHY. `git checkout -- <path>`, `git restore`, `git reset --hard` and `git clean -fd`
# discard uncommitted changes silently, instantly, and with exit 0. For content that was
# never `git add`ed there is no object and no reflog entry, so the loss is total: unlike a
# bad `reset --hard` after a commit (recoverable from the reflog) or staged-then-discarded
# content (survives as a dangling blob), there is nothing to recover from. This script is
# the safety net that makes those commands non-destructive: it runs FIRST, records the
# current state, and gets out of the way.
#
# DESIGN: snapshot, do not prompt. A guard that asks for confirmation on every `checkout --`
# is muscle-memoried through within a week and then protects nothing. This adds no prompt and
# no approval step -- it costs one ref write, and only when the tree is actually dirty.
#
# HOW IT STORES THINGS.
#   Tracked changes -> `git stash create`, which builds a commit object WITHOUT touching the
#     worktree or the index (unlike `git stash push`, which would itself mutate the tree this
#     is trying to protect). The resulting commit is anchored under refs/git-snapshot/ so it
#     survives gc; a bare dangling commit would not.
#   Untracked files -> `git stash create` does not include them and has no -u equivalent, so
#     they are copied into a snapshot directory. Only done when asked (--untracked), because
#     only `git clean` destroys untracked files and copying a big untracked tree on every
#     `checkout --` would be a real cost for no benefit.
#
# RECOVERY:
#   git -C <repo> log --oneline refs/git-snapshot/            # what was captured, newest first
#   git -C <repo> show <ref>                                  # what it contained
#   git -C <repo> checkout <ref> -- <path>                    # restore one file
#   git -C <repo> stash apply <ref>                           # restore everything
#
# USAGE: git-snapshot [--untracked] [--label <text>] [-C <repo>]
# Exit 0 = a snapshot exists or none was needed (clean tree). Exit 1 = could NOT snapshot.
# Callers must treat exit 1 as "do not proceed with the destructive command": proceeding
# without a snapshot is exactly the unprotected case this exists to remove.
#
# ESCAPE HATCH: GIT_SNAPSHOT_SKIP=1 makes this a silent no-op returning 0. For the case where
# discarding is genuinely the point and the tree is huge; deliberately an env var, so it is
# per-invocation and cannot be set once and forgotten in a config file.

set -eu

repo="."
want_untracked=0
label="git-snapshot"

while [ $# -gt 0 ]; do
  case "$1" in
    --untracked) want_untracked=1; shift ;;
    --label) label="${2:-git-snapshot}"; shift 2 ;;
    -C) repo="${2:-.}"; shift 2 ;;
    -h|--help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'git-snapshot: unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done

[ "${GIT_SNAPSHOT_SKIP:-}" = "1" ] && exit 0

git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || exit 0   # not a repo: nothing to protect

# A repo with no commits has no HEAD for `stash create` to base a snapshot on. Untracked
# files there are still worth copying, so fall through rather than bailing.
has_head=0
git -C "$repo" rev-parse --verify -q HEAD >/dev/null 2>&1 && has_head=1

stamp=$(date -u +%Y%m%dT%H%M%SZ)
made_any=0

# --- tracked changes ---------------------------------------------------------------
if [ "$has_head" = 1 ] && ! git -C "$repo" diff --quiet HEAD 2>/dev/null; then
  sha=$(git -C "$repo" stash create "$label $stamp" 2>/dev/null || true)
  if [ -z "$sha" ]; then
    printf 'git-snapshot: FAILED to create a snapshot of tracked changes\n' >&2
    exit 1
  fi
  ref="refs/git-snapshot/$stamp"
  # Collision-proof: two destructive ops in the same second must not overwrite each other,
  # and losing the first would defeat the entire point.
  n=0
  while git -C "$repo" rev-parse --verify -q "$ref" >/dev/null 2>&1; do
    n=$((n + 1)); ref="refs/git-snapshot/$stamp-$n"
  done
  if ! git -C "$repo" update-ref "$ref" "$sha"; then
    printf 'git-snapshot: FAILED to anchor snapshot %s\n' "$sha" >&2
    exit 1
  fi
  printf 'git-snapshot: tracked changes saved -> %s  (git show %s)\n' "$ref" "$ref" >&2
  made_any=1
fi

# --- untracked files, only when the caller says the command destroys them -----------
if [ "$want_untracked" = 1 ]; then
  files=$(git -C "$repo" ls-files --others --exclude-standard 2>/dev/null || true)
  if [ -n "$files" ]; then
    top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || echo "$repo")
    dest="${XDG_STATE_HOME:-$HOME/.local/state}/git-snapshot/$(basename "$top")/$stamp"
    if ! mkdir -p "$dest"; then
      printf 'git-snapshot: FAILED to create %s\n' "$dest" >&2
      exit 1
    fi
    # -T reads the list from stdin so filenames with spaces survive; a `for` loop over
    # unquoted output would split them and silently save the wrong thing.
    if ! printf '%s\n' "$files" | tar -C "$top" -cf "$dest/untracked.tar" -T - 2>/dev/null; then
      printf 'git-snapshot: FAILED to archive untracked files\n' >&2
      exit 1
    fi
    printf 'git-snapshot: untracked files saved -> %s/untracked.tar\n' "$dest" >&2
    made_any=1
  fi
fi

[ "$made_any" = 0 ] && exit 0   # clean tree: silent no-op, which is the common case
exit 0
