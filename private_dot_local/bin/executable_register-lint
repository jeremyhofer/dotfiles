#!/usr/bin/env python3
"""register-lint — enforce the contract a work register states about itself.

WHY THIS EXISTS
    A work register is a directory of one-file-per-entry markdown documents that answers
    three questions mechanically: is this done, what parts are done, what is still open.
    Every one of those answers depends on a section that a human writes by hand, and the
    failure mode is not a missing section — it is a section containing prose that SAYS
    there is nothing to say. That reads as filled in to any check asking "is there text
    here?", so the register reports clean while holding none of the thing it exists for.

    Measured in one store before this tool existed: a checker written specifically to
    enforce "no entry past `idea` without a closure condition" tested that the heading had
    some text beneath it. Writing the literal string TODO passed it clean. A green run was
    fully compatible with the state the check existed to prevent.

    The fix is not a smarter reader. A checker cannot tell a real closure condition from a
    sentence explaining there isn't one, because both are just prose. So the ABSENCE gets
    a fixed vocabulary — a sentinel — and the check becomes three-state rather than two:
    written, declared absent, or unrecorded. Only the third fails.

WHAT IT CHECKS — blocking
    closure-condition  an open entry past `idea` whose closure-condition section holds
                       neither a real condition nor a recognised sentinel.
    undeclared-absence prose that reads as an absence ("not recorded", "TBD", "TODO") with
                       no sentinel. A HEURISTIC, and the only check here that guesses at
                       meaning -- it exists because the spellings already in the wild all
                       count as written, so without it every migrated register reports
                       clean while holding no condition at all.
    sentinel-mismatch  a sentinel contradicting the frontmatter, e.g. the exempt-at-`idea`
                       sentinel on an entry that is not at `idea`.
    conditional-field  a field present on a status that forbids it, or absent on one that
                       requires it. A stray gate is a lie about why something is stuck.
    empty-field        a key present with an empty value. The contract says to omit it instead;
                       writing it blank makes "absent" and "empty" indistinguishable, and it is
                       how a stray conditional field evades every check that asks whether it is set.
    yaml-truncation    an unquoted `#` in a value, which YAML reads as a comment so the value
                       silently truncates while the file still parses. Covers LIST items and
                       SCALARS alike -- it checked lists only until a scalar field truncated in
                       a real store and reached a generated index before anyone noticed.
    yaml-invalid       an unquoted value a strict YAML parser rejects: one opening with a reserved
                       indicator (a backtick, `@`, `&`, `*`, `!`, a bracket, a quote it does not
                       close), or a scalar holding ': '. This tool reads frontmatter without a
                       YAML parser, so without this check it passed files every parser refuses.
    artifact-path      a path-shaped artifact pointer that does not resolve from the repository
                       root. A pointer the reader cannot follow is worse than no pointer,
                       because it looks like it resolves. Skipped entirely when no repository
                       root can be found, rather than reporting every pointer as broken.
    initiative-id      a directory under `docs/initiatives/` or `docs/archive/initiatives/` whose
                       name does not start with an id in this register.
    initiative-folder  a live initiative directory its entry does not name as `folder:`.
    initiative-place   an initiative directory in the wrong tree for its entry's status: a `done`
                       or `dropped` entry under `docs/initiatives/`, or any other status under
                       `docs/archive/initiatives/`. Archived directories are read for their name
                       and place only, never their contents -- an archived tree is frozen.
    status-vocabulary  a status outside the vocabulary below.
    location           a closed entry outside the closed directory, or an open one inside.
    resolution         a closed entry with an empty resolution. Closing is a claim.
    next-action        an open entry with no next action. It is finished or abandoned.
    filename           a file whose name does not begin with its own id.
    id-integrity       a duplicate id, or one that does not match the register's prefix.
    required-field     a missing required frontmatter field.
    date-format        a date field that is not YYYY-MM-DD.
    standing-stale     a no-terminus entry last verified longer ago than its own declared
                       cadence. This is the only thing making that status an obligation
                       rather than an exemption. Also refused: `overdue:` on any status but
                       `standing`, or with any value but `report` (both `conditional-field`).
    relation-unknown   a relation naming an id with THIS register's prefix that is no entry in it,
                       open or closed. An id with another prefix is not checked: this tool sees
                       one register, and a foreign id is not its to resolve.
    relation-self      an entry that names itself under a relation key.
    relation-both-ends A names B and B names A under the same key. A relation is stated once, on
                       the entry its key belongs to; the other end is derived, never written.
    relation-cycle     a cycle of `blocks:`, reported once and naming its members. Nothing in a
                       cycle can start.
    relation-duplicate-status
                       an entry with `duplicates:` whose status is not `dropped`. A duplicate is
                       finished by being dropped in favour of the other entry.
    closure-review     only where the register's README carries a line
                       `Closure review required from: YYYY-MM-DD`: a `done` entry in the closed
                       directory, closed on or after that date, whose Resolution lacks
                       `**Closure review:** YYYY-MM-DD, met.` No such line, no check.
    not-renamed        the register keeps finished entries in a directory named `archive/`.
                       Build tooling commonly skips any path containing that word, because
                       an archived tree is frozen and exempt from checking; a closed entry
                       is an ordinary document that happens to be finished and must keep
                       being checked. Measured in one workspace: a prose gate covered three
                       fewer documents under the archived name, staying green throughout.

WHAT IT REPORTS — advisory, never blocking
    triage-debt        entries declared absent pending examination. Visible, counted debt
                       with a named owner, which an empty section is not.
    alignment-owed     entries whose condition cannot be written without deciding something
                       undecided. These need a person, not an edit.
    standing-overdue   a `standing` entry carrying `overdue: report` that is past its cadence.
                       It says so instead of blocking, for a review whose lateness is worth
                       seeing but not worth stopping every commit in the register over.

WHAT IT CANNOT CHECK — stated because a gate that hides its blind spots gets over-trusted
    * Whether a written closure condition is a good one, or even a condition. Any prose
      that is not a sentinel and does not trip the absence heuristic counts as written.
      The sentinel vocabulary moves the line from "is there text" to "is the absence
      declared"; it cannot judge what is there. The heuristic narrows the gap for the
      spellings seen so far and will not catch a new one.
    * Whether a task checklist reflects the work. An entry may carry one stale task.
    * Whether a relation is TRUE, only that it is well formed. An id with another prefix is
      never resolved here; that takes the manifest of registers, which this tool does not read.
    * Whether a closure review was any good, only that its line is present.
    * Whether an entry should exist at all, or who filed it. Authorship is a stated rule
      with no mechanism behind it; nothing here distinguishes one author from another.
    * A closed entry's closure condition. Closed entries are judged by their resolution,
      deliberately: a closed entry that never carried a condition cannot be given one now,
      so flagging it would be permanent red with no action attached.
    * Whether a register that does not exist should. An absent directory is not an error.

THE PREFIX IS DERIVED, NEVER CONFIGURED
    The register's identifier prefix is read from the entries themselves and must be
    uniform. A configured prefix is a second place for the answer to live, and the two
    drift; a derived one cannot disagree with the store it describes. A store holding two
    prefixes is reported rather than guessed at.
"""

import argparse
import datetime
import pathlib
import posixpath
import re
import sys

STATUSES = ("idea", "scoped", "ready", "active", "blocked", "held", "standing", "done", "dropped")
CLOSED_STATUSES = ("done", "dropped")
GATED_STATUSES = ("blocked", "held")
REQUIRED_FIELDS = ("id", "title", "status", "owner", "verified")

# A sentinel declares WHICH KIND of absence this is, and each kind names a different owner
# of the next move. They are matched on their own line so a condition may precede one --
# recovery is frequently partial, and the recovered half is the valuable half.
SENTINELS = {
    "NONE REQUIRED": "exempt",     # nothing is owed; the entry has not been committed to
    "ALIGNMENT REQUIRED": "align", # writing one would decide something undecided
    "TRIAGE REQUIRED": "triage",   # inherited without one and not yet examined
}
# Leading markdown decoration is STRIPPED before matching, and this is load-bearing rather than
# generous. A careful author writing `**ALIGNMENT REQUIRED.**` at the head of a paragraph is using
# the most natural emphasis markdown offers -- and an anchored `^\s*` match walks straight past the
# asterisks, finds no sentinel, and the entry then reads as holding a REAL closure condition.
# Measured: four entries, two characters, every surface green and "a decision is owed" silently
# converted to "settled". That is the TODO-passes-clean failure this tool exists to stop, wearing
# the tool's own vocabulary. Fail loudly or not at all; never fail into the reassuring state.
SENTINEL_RE = re.compile(
    r"^[\s>\-*_`]*(%s)(?![A-Za-z0-9])" % "|".join(SENTINELS), re.M)

# Prose that ASSERTS an absence rather than stating a condition.
#
# A PHRASE HERE MUST NOT COLLIDE WITH THE VOCABULARY THE CONTRACT ITSELF USES. This list once
# carried "not invented", which reads as an absence in isolation and is the opposite in the
# idiom the contract actually teaches -- "recovered from what is known, not invented here"
# AFFIRMS the condition is real. The result was a seat rewording a correct entry to get past
# the lint, which is the worst outcome available: the gate did not catch a defect, it
# manufactured one and then degraded the prose. The branch was also not load-bearing, since
# the migrated absences it was meant to catch all say "not recorded" as well.
#
# So the test for adding a phrase is not "does this sound like an absence" but "can this
# appear in a sentence that AFFIRMS a condition". If it can, leave it out.
#
# `deliberately not` was removed for failing exactly that test. It matched "the redirect is
# deliberately not forced today, so an untrusting machine degrades instead of failing" -- a
# sentence stating a live design property inside a real condition. The absence spellings it was
# meant to catch are `deliberately absent` and the `not recorded` family, both still listed, so
# nothing was lost by dropping it. Same failure as the `not invented` case above and the same
# cost: a correct entry reworded to satisfy the lint. This is a heuristic and is
# declared as one: the tool cannot read prose, so it cannot tell a real condition from a
# sentence explaining there is none -- which is the whole reason the sentinel vocabulary
# exists. What it CAN do is recognise the spellings that mean "nothing here", and require
# them to be said in the vocabulary a checker can count. Every phrase below was found in a
# real register, or is a placeholder that defeated a real checker.
ABSENCE_RE = re.compile(
    r"\b(not\s+recorded|deliberately\s+absent"
    r"|none\s+recorded|no\s+closure\s+condition|not\s+(?:yet\s+)?(?:written|defined|stated)"
    r"|unknown|to\s+be\s+(?:determined|decided)|TBD|TODO|FIXME|n/a)\b",
    re.I,
)

CADENCE_DAYS = {"weekly": 7, "fortnightly": 14, "monthly": 31, "quarterly": 93, "biannual": 186, "annual": 366}

# How long an ACTIONABLE entry may go unverified before it is worth a second look. Advisory, and
# absent statuses are exempt rather than generous: `idea` because an untouched idea is not stale
# merely for being untouched, and the closed ones because they are history. `active` is tight --
# an entry nobody re-verified in a month probably is not active -- while the parked statuses get a
# slow heartbeat, because their gates can clear silently and nothing announces that.
STALE_BUDGETS = {"active": 30, "ready": 90, "scoped": 90, "blocked": 90, "held": 90}


def repo_root(start):
    """The nearest ancestor holding `.git`, or None.

    None means "do not check paths", never "check them against the wrong root". A register may
    legitimately live outside a repository -- a fixture, a scratch copy -- and resolving its
    pointers against a guessed root would report every one of them broken, which is a louder
    wrong answer than the silence it replaced. `.git` may be a directory or a file; a worktree
    checkout has the file form, and the fleet uses those.
    """
    for d in [start] + list(start.parents):
        if (d / ".git").exists():
            return d
    return None


def initiative_root(root):
    """Where `docs/initiatives/` is looked for: the repository top, else the parent of `docs/`.

    The second form is for a snapshot directory of staged copies, which a hook lints and which has
    no `.git`. This does not shell out to git: inside a hook GIT_DIR overrides where git believes
    it is, so asking git would answer about the hook's repository rather than the directory given.
    """
    top = repo_root(root)
    if top is not None:
        return top
    parent = root.resolve().parent
    return parent.parent if parent.name == "docs" else None


def folder_artifacts(entry):
    """Normalised relative paths this entry names with a `folder:` artifact."""
    block = re.search(r"^artifacts:\s*$(.*?)(?=^\S|\Z)", entry.raw_front, re.M | re.S)
    found = set()
    if block:
        for value in re.findall(r"^\s*-\s*(.+?)\s*$", block.group(1), re.M):
            kind, sep, rest = value.strip().strip("'\"").partition(":")
            if sep and kind.strip() == "folder":
                found.add(posixpath.normpath(rest.strip().strip("'\"")))
    return found


ID_RE = re.compile(r"^([A-Z][A-Z0-9]*)-([0-9]+)$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
CLOSURE_HEADING = "Definition of done"

ADVISORY = ("triage-debt", "alignment-owed", "stale-entry", "standing-overdue")

# Each key states ONE kind of relation, on the entry it belongs to; the other end is derived.
RELATION_KEYS = ("part-of", "blocks", "duplicates", "split-from", "supersedes", "relates")
ANY_ID_RE = re.compile(r"[A-Z][A-Z0-9]*-[0-9]+")
REVIEW_FLOOR_RE = re.compile(r"^\s*Closure review required from:\s*(\d{4}-\d{2}-\d{2})\s*$", re.M)
REVIEW_LINE_RE = re.compile(r"\*\*Closure review:\*\*\s*\d{4}-\d{2}-\d{2},\s*met\.")


def relations(entry):
    """{key: [ids]} for the relation keys an entry states, as a scalar or a block list.

    Read the way `folder_artifacts` reads `artifacts:`, with no YAML parser. An inline `[a, b]`
    list yields nothing here: it is already refused as `yaml-invalid`, and guessing at it would
    report a second finding for the one defect.
    """
    found = {}
    for key in RELATION_KEYS:
        ids = []
        scalar = entry.meta.get(key, "")
        if scalar and not scalar.startswith("["):
            ids += ANY_ID_RE.findall(scalar)
        block = re.search(r"^%s:\s*$(.*?)(?=^\S|\Z)" % re.escape(key), entry.raw_front, re.M | re.S)
        if block:
            for value in re.findall(r"^\s*-\s*(.+?)\s*$", block.group(1), re.M):
                ids += ANY_ID_RE.findall(value)
        if ids:
            found[key] = ids
    return found


def closing_date(entry):
    """The entry's `closed:` date, or None when it is absent or malformed.

    `closed:` is the field the contract requires on every closed entry, and the only one that says
    when it closed: a History heading or `verified:` says when something was written or confirmed.
    A missing or malformed `closed:` is already its own finding, so it is not reported twice here.
    """
    closed = entry.meta.get("closed", "").strip().strip("'\"")
    return closed if DATE_RE.match(closed) else None


class Entry:
    def __init__(self, path, closed_dir):
        self.path = path
        self.in_closed_dir = closed_dir in path.parts
        self.text = path.read_text(encoding="utf-8", errors="replace")
        self.raw_front = ""
        self.meta = self._frontmatter()

    def _frontmatter(self):
        # Deliberately not a YAML parse. The frontmatter here is flat scalars by contract,
        # and depending on a parser would make this tool uninstallable wherever that
        # parser is not, for no gain over the shape the contract already guarantees.
        meta = {}
        self.raw_front = ""
        if not self.text.startswith("---"):
            return meta
        end = self.text.find("\n---", 3)
        if end == -1:
            return meta
        self.raw_front = self.text[3:end]
        for line in self.text[3:end].splitlines():
            if not line.strip() or line.startswith((" ", "\t", "-", "#")):
                continue
            key, sep, value = line.partition(":")
            if sep:
                meta[key.strip()] = value.strip()
        return meta

    @property
    def id(self):
        return self.meta.get("id", "")

    @property
    def status(self):
        return self.meta.get("status", "")

    def section(self, heading):
        """Body text under a heading, to the next heading of ANY level.

        Bounding at the same level would swallow a following shallower section, and
        bounding at a fixed level stops early at a deeper one. Both produce a clean-looking
        result with the wrong contents, which is worse than an error.
        """
        pattern = re.compile(
            r"^#{1,6}\s+%s\s*$(.*?)(?=^#{1,6}\s|\Z)" % re.escape(heading),
            re.M | re.S,
        )
        found = pattern.search(self.text)
        if not found:
            return None
        body = found.group(1)
        # An HTML comment is a template placeholder, not content. Counting one as a written
        # condition would make every freshly-copied template report clean.
        body = re.sub(r"<!--.*?-->", "", body, flags=re.S)
        return body.strip() or None


def resolve_closed_dir(root):
    """(directory name, finding) -- `closed/`, falling back to the legacy name.

    The fallback reads the legacy directory so a register can be linted BEFORE it is
    renamed, and reports the rename as a blocking finding so the fallback can never be
    mistaken for a permitted spelling.
    """
    if (root / "closed").is_dir():
        return "closed", None
    if (root / "archive").is_dir():
        return "archive", (
            "not-renamed", str(root),
            "finished entries are in `archive/`; the register contract names `closed/`. "
            "Rename it, and change every tool that enumerates or counts it IN THE SAME "
            "COMMIT -- one still looking for the old name reports zero closed entries, "
            "which is indistinguishable from health."
        )
    return "closed", None


def load(root, closed_dir):
    paths = sorted(root.glob("*.md")) + sorted((root / closed_dir).glob("*.md"))
    entries, skipped = [], []
    for p in paths:
        e = Entry(p, closed_dir)
        # An entry is identified by CONTENT -- frontmatter carrying an `id` -- and NOT by its
        # filename. Excluding only README by name made every other document in the directory an
        # entry, so a register could not carry a mapping table, a query cookbook or a charter
        # without each being linted as a malformed entry and counted in the census. That is this
        # tool's own §9 self-match trap, living inside the tool rather than in a documented query.
        #
        # Content is the right discriminator rather than a filename pattern, because a pattern
        # would ALSO skip a genuine entry whose filename is wrong -- silently retiring the very
        # check that exists to catch that.
        (entries if e.meta.get("id") else skipped).append(e)
    return entries, [p.name for p in (e.path for e in skipped)]


def check(entries, closed_dir, root=None, today=None):
    findings = []

    def fail(kind, entry, msg):
        findings.append((kind, str(entry.path), msg))

    prefixes = set()
    for e in entries:
        matched = ID_RE.match(e.id)
        if matched:
            prefixes.add(matched.group(1))
    if len(prefixes) > 1:
        findings.append((
            "id-integrity", "(store)",
            "entries carry more than one prefix (%s); a register has exactly one, and a "
            "renamed one keeps its numbers rather than mixing schemes"
            % ", ".join(sorted(prefixes)),
        ))

    # ONE WIDTH PER REGISTER. A register whose ids are mixed width (`X-9` beside `X-100`) sorts
    # 99 above 100 as text, and a session reading the highest id off a listing allocates one that
    # already exists -- that happened twice in this fleet before the ids were padded. Any single
    # width passes; mixing them does not. `register next` warns on the same condition, but only
    # when someone allocates, so without this a mis-padded entry could sit until then.
    widths = {}
    for e in entries:
        matched = ID_RE.match(e.id)
        if matched:
            widths.setdefault(len(matched.group(2)), []).append(e.id)
    if len(widths) > 1:
        common = max(widths, key=lambda w: len(widths[w]))
        odd = sorted(i for w, ids in widths.items() if w != common for i in ids)
        findings.append((
            "id-integrity", "(store)",
            "ids are mixed width (%s digits); pad to one width -- odd ones out: %s"
            % (", ".join(map(str, sorted(widths))), ", ".join(odd[:8]) + (" ..." if len(odd) > 8 else "")),
        ))

    seen = {}
    for e in entries:
        for field in REQUIRED_FIELDS:
            if not e.meta.get(field):
                fail("required-field", e, "missing required field %r" % field)

        if not ID_RE.match(e.id):
            fail("id-integrity", e, "id %r is not <PREFIX>-NN" % e.id)
        elif e.id in seen:
            fail("id-integrity", e, "duplicate id, also in %s" % pathlib.Path(seen[e.id]).name)
        else:
            seen[e.id] = str(e.path)

        # The contract says to OMIT a key that does not apply rather than writing it blank. A
        # register that does both makes "absent" and "empty" mean the same thing, and nothing can
        # tell them apart afterwards. This also catches the case the conditional-field checks
        # below cannot see: a key present with an empty value is falsy, so a stray blank `gate:`
        # on a status that forbids one slipped through every check that asked whether it was set.
        front_lines = e.raw_front.splitlines()
        for idx, line in enumerate(front_lines):
            if not line.strip() or line.startswith((" ", "\t", "-", "#")):
                continue
            key, sep, value = line.partition(":")
            if not sep or value.strip():
                continue
            # A key with no value ON ITS LINE is not empty if a block value follows -- an indented
            # line or a list item. Reading the key line in isolation reports every `artifacts:`
            # with a list beneath it, which is correct YAML and is what the contract's own template
            # shows. Found by running this check against two real registers that were already clean.
            has_block = False
            for nxt in front_lines[idx + 1:]:
                if not nxt.strip():
                    continue
                has_block = nxt.startswith((" ", "\t", "-"))
                break
            if not has_block:
                fail("empty-field", e,
                     "%r is present but empty -- omit the key instead, or 'absent' and 'empty' "
                     "become the same thing" % key.strip())

        # A `#` in an unquoted YAML value starts a comment, so the value silently truncates
        # while the file still parses. This reads the RAW frontmatter because the parser above
        # skips list items entirely, and because it stores a scalar's value already split on the
        # first colon -- neither view can see the defect.
        #
        # BOTH SHAPES, and the scalar one was missing until a real store hit it. Two `gate:`
        # values ending "(2012 Mac minis / #6 PC)" truncated at the hash. The file was intact,
        # every entry check passed, and the loss appeared only in a generated index -- so the
        # tool reported clean on a store it was actively mis-reading.
        #
        # A leading `#` is a comment line, not a value, and is skipped. A `#` with no space
        # before it does NOT start a comment in YAML (`a#b` is the literal string), which is why
        # the test is for the separator rather than for the character alone.
        for line in e.raw_front.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("- "):
                kind, value = "list", stripped[2:].strip()
            else:
                key, sep, rest = stripped.partition(":")
                if not sep or not rest.strip():
                    continue
                kind, value = "scalar %r" % key.strip(), rest.strip()
            if value.startswith(("'", '"')) and value.endswith(value[0]) and len(value) > 1:
                continue
            # Values a real YAML parser REJECTS rather than truncates. A plain scalar may not open
            # with a reserved indicator, and a SCALAR may not hold a mapping indicator (': ', or a
            # trailing ':'). In a list item `- key: value` is valid YAML, a one-entry mapping, so
            # the colon rule applies to scalars only. Found by a consumer that read a store with a
            # strict parser: four titles passed this lint, and that parse rejected all four.
            invalid = None
            if value[0] in "`@&*!|>%{}[],'\"":
                invalid = "opens with %r, which YAML reserves" % value[0]
            elif kind != "list" and (": " in value or value.endswith(":")):
                invalid = "holds ': ', which YAML reads as a second key"
            if invalid:
                fail("yaml-invalid", e,
                     "%s value %r %s -- a strict YAML parser rejects the file. Quote it."
                     % (kind, value, invalid))
            if re.search(r"(?:^|\s)#", value):
                fail("yaml-truncation", e,
                     "%s value %r contains an unquoted '#', which YAML reads as a comment -- the "
                     "value silently truncates while the file still parses. Quote it."
                     % (kind, value))

        if e.id and not e.path.name.startswith("%s-" % e.id):
            fail("filename", e, "filename does not begin with its id %r" % e.id)

        status = e.status
        if status and status not in STATUSES:
            fail("status-vocabulary", e, "status %r is not in the vocabulary" % status)
            continue

        for field in ("verified", "closed"):
            value = e.meta.get(field)
            if value and not DATE_RE.match(value):
                fail("date-format", e, "%s %r is not YYYY-MM-DD" % (field, value))

        gated = status in GATED_STATUSES
        if gated and not e.meta.get("gate"):
            fail("conditional-field", e, "status %r requires a 'gate'" % status)
        if not gated and e.meta.get("gate"):
            fail("conditional-field", e, "status %r must not carry a 'gate'" % status)

        standing = status == "standing"
        cadence = e.meta.get("cadence", "").strip().lower()
        if standing and not cadence:
            fail("conditional-field", e,
                 "status 'standing' requires a 'cadence' -- without one it is 'active' "
                 "wearing a label, which is the exemption this status exists instead of")
        if not standing and cadence:
            fail("conditional-field", e, "status %r must not carry a 'cadence'" % status)
        overdue = e.meta.get("overdue", "").strip().lower()
        if overdue and not standing:
            fail("conditional-field", e, "status %r must not carry an 'overdue'" % status)
        elif overdue and overdue != "report":
            fail("conditional-field", e,
                 "overdue %r is not 'report', the only value it takes" % overdue)
        if standing and cadence:
            if cadence not in CADENCE_DAYS:
                fail("conditional-field", e,
                     "cadence %r is not one of: %s" % (cadence, ", ".join(CADENCE_DAYS)))
            else:
                verified = e.meta.get("verified", "")
                if DATE_RE.match(verified):
                    age = (datetime.date.today() - datetime.date.fromisoformat(verified)).days
                    if age > CADENCE_DAYS[cadence]:
                        # `overdue: report` turns the block into a report. Only a review whose
                        # lateness is a fact worth seeing may ask for that; every other standing
                        # entry stays an obligation.
                        kind = "standing-overdue" if overdue == "report" else "standing-stale"
                        fail(kind, e,
                             "last verified %s is %dd old against a %s cadence (%dd) -- "
                             "re-verify it, or it is no longer standing"
                             % (verified, age, cadence, CADENCE_DAYS[cadence]))

        closed = status in CLOSED_STATUSES
        if closed != e.in_closed_dir:
            where = closed_dir + "/" if e.in_closed_dir else "the register directory"
            fail("location", e, "status %r does not belong in %s" % (status, where))
        if closed and not e.meta.get("closed"):
            fail("conditional-field", e, "closed entry has no 'closed' date")
        if not closed and e.meta.get("closed"):
            fail("conditional-field", e, "status %r must not carry a 'closed' date" % status)

        if closed and not e.section("Resolution"):
            fail("resolution", e,
                 "closed entry has an empty resolution -- closing is a claim, and a claim "
                 "needs a referent")
        if not closed and not e.section("Next action"):
            fail("next-action", e,
                 "open entry has no next action -- it is either finished or abandoned, and "
                 "both should be said out loud")

        # The three-state closure condition. Closed entries are out of scope on purpose;
        # see the module docstring.
        if not closed:
            body = e.section(CLOSURE_HEADING)
            declared = SENTINEL_RE.search(body) if body else None
            kind = SENTINELS[declared.group(1)] if declared else None
            if kind == "exempt" and status != "idea":
                fail("sentinel-mismatch", e,
                     "the exempt sentinel is on an entry at %r; it means no condition is "
                     "owed, which is only true at 'idea'" % status)
            if status != "idea" and not declared:
                if body is None:
                    fail("closure-condition", e,
                         "status %r has neither a closure condition nor a sentinel "
                         "declaring which kind of absence this is -- an unrecorded absence "
                         "and a declared one look identical to a reader and to this check"
                         % status)
                    continue
                # Inline code and fenced blocks are MENTION, not use -- the same discriminator
                # the fleet's comment linter draws. `TODO` and `FIXME` are in the absence
                # vocabulary AND are ordinary code tokens, so an entry whose SUBJECT is those
                # markers ("every `it.todo` placeholder is replaced") was flagged while holding a
                # genuine condition. Stripped for the HEURISTIC only: the is-there-text check
                # above still reads the raw body, so a condition written entirely in code spans
                # does not become an empty section.
                prose = re.sub(r"```.*?```", " ", body, flags=re.S)
                prose = re.sub(r"`[^`]*`", " ", prose)
                if ABSENCE_RE.search(prose):
                    fail("undeclared-absence", e,
                         "the closure-condition section reads as an ABSENCE but carries no "
                         "sentinel, so it counts as written and the register reports clean "
                         "while holding no condition. If it is an absence, declare which "
                         "kind with one of: %s. If it is a condition, reword it -- this is "
                         "a phrase heuristic and it can be wrong."
                         % ", ".join(sorted(SENTINELS)))
            if kind == "triage":
                findings.append(("triage-debt", str(e.path),
                                 "declared absent pending examination"))
            elif kind == "align":
                findings.append(("alignment-owed", str(e.path),
                                 "a closure condition here would decide something undecided"))

    # --- artifact pointers resolve, and staleness -----------------------------------------
    #
    # Both moved here from a register-specific lint that duplicated half of this tool's schema
    # checks from a second definition. Two definitions of one contract drift; these two checks
    # were the only part of that tool with no equivalent here, so they came across and the
    # duplicate went away.
    base = repo_root(root) if root is not None else None
    today_d = None
    if today:
        try:
            today_d = datetime.date.fromisoformat(today)
        except ValueError:
            today_d = None

    for e in entries:
        # A pointer is PATH-SHAPED if what follows the first colon contains a separator. A bare
        # token -- an id, a skill name, a label -- is not checkable from here and is left alone
        # rather than guessed at; that is the same line the module docstring draws elsewhere.
        block = re.search(r"^artifacts:\s*$(.*?)(?=^\S|\Z)", e.raw_front, re.M | re.S)
        if block and base is not None:
            for value in re.findall(r"^\s*-\s*(.+?)\s*$", block.group(1), re.M):
                value = value.strip().strip("'\"")
                _, sep, rest = value.partition(":")
                if not sep or "/" not in rest:
                    continue
                if not (base / rest).exists():
                    fail("artifact-path", e,
                         "artifact %r does not resolve from the repository root -- a pointer the "
                         "reader cannot follow is worse than none, because it looks like it does"
                         % rest)

        if today_d is None:
            continue
        budget = STALE_BUDGETS.get(e.status)
        raw = e.meta.get("verified", "").strip().strip("'\"")
        if budget is None or not DATE_RE.match(raw):
            continue                       # a malformed date is already a date-format finding
        age = (today_d - datetime.date.fromisoformat(raw)).days
        if age < 0:
            fail("stale-entry", e,
                 "verified %s is in the FUTURE, which no clock produces -- a typo, or a date "
                 "written forward to postpone the check" % raw)
        elif age > budget:
            fail("stale-entry", e,
                 "last verified %s, %dd ago, against a %dd budget for status %r"
                 % (raw, age, budget, e.status))

    # --- relations ------------------------------------------------------------------------
    # Only ids with THIS register's prefix are resolved. A foreign id names an entry in a register
    # this tool cannot see, so calling it unknown would report every cross-register pointer broken.
    # With two prefixes present there is no "this register" to resolve against, and that is already
    # an id-integrity finding, so the resolution check is skipped rather than guessed.
    known = {e.id: e for e in entries if e.id}
    own = next(iter(prefixes)) if len(prefixes) == 1 else None
    stated = {e.id: relations(e) for e in entries if e.id}
    for e in entries:
        rels = stated.get(e.id, {})
        for key, ids in rels.items():
            for other in dict.fromkeys(ids):
                if other == e.id:
                    fail("relation-self", e, "%s: names itself" % key)
                    continue
                m = ID_RE.match(other)
                if own and m and m.group(1) == own and other not in known:
                    fail("relation-unknown", e,
                         "%s: %s has this register's prefix but is not an entry in it, open or "
                         "closed" % (key, other))
                    continue
                if other in known and e.id in stated.get(other, {}).get(key, []) and e.id < other:
                    fail("relation-both-ends", e,
                         "%s: %s and %s each name the other -- state it once, on the entry the "
                         "key belongs to; the other end is derived" % (key, e.id, other))
        if "duplicates" in rels and e.status != "dropped":
            fail("relation-duplicate-status", e,
                 "has `duplicates:` but status is %r -- a duplicate is dropped in favour of the "
                 "entry it duplicates" % e.status)

    # A cycle in `blocks:` is a strongly connected group: every member reaches every other.
    # Reachability from each node is quadratic, which a register of hundreds of entries carrying a
    # handful of `blocks:` edges never notices, and it avoids a hand-rolled Tarjan to get wrong.
    edges = {i: [o for o in r.get("blocks", []) if o in known and o != i]
             for i, r in stated.items()}

    def reach(start):
        seen_, todo = set(), list(edges.get(start, []))
        while todo:
            n = todo.pop()
            if n not in seen_:
                seen_.add(n)
                todo.extend(edges.get(n, []))
        return seen_

    reached = {i: reach(i) for i in edges if edges[i]}
    grouped = set()
    for i in sorted(reached):
        if i in grouped or i not in reached[i]:
            continue
        members = sorted({n for n in reached[i] if n in reached and i in reached[n]} | {i})
        grouped.update(members)
        fail("relation-cycle", known[members[0]],
             "blocks: cycle among %s -- nothing in it can start" % ", ".join(members))

    # --- closure review ---------------------------------------------------------------------
    # The floor is a line in the register's own README, so each register opts in on a date of its
    # own choosing and an entry closed before it is never asked for a review it could not have had.
    readme = root / "README.md" if root is not None else None
    floor = None
    if readme is not None and readme.is_file():
        found = REVIEW_FLOOR_RE.search(readme.read_text(encoding="utf-8", errors="replace"))
        floor = found.group(1) if found else None
    if floor:
        for e in entries:
            if e.status != "done" or not e.in_closed_dir:
                continue
            closed_on = closing_date(e)
            if closed_on and closed_on >= floor and not REVIEW_LINE_RE.search(e.section("Resolution") or ""):
                fail("closure-review", e,
                     "closed %s, on or after the register's review floor %s, and its Resolution "
                     "has no `**Closure review:** YYYY-MM-DD, met.` line" % (closed_on, floor))

    # --- initiative folders ---------------------------------------------------------------
    # Only the NAME and PLACE of a directory are read here. A folder under docs/archive/ is frozen
    # and its contents are not this tool's business (nor are a live one's: shape is another tool's).
    top = initiative_root(root) if root is not None else None
    if top is not None:
        by_id = {e.id: e for e in entries if e.id}
        named = {}
        for e in entries:
            for rel in folder_artifacts(e):
                named.setdefault(rel, []).append(e)
        for live, tree in ((True, "docs/initiatives"), (False, "docs/archive/initiatives")):
            base_dir = top / tree
            if not base_dir.is_dir():
                continue
            # Dot-directories are not initiatives: the Claude Code sandbox leaves a `.claude/`
            # placeholder in any cwd a sandboxed shell used, undeletable while that session lives.
            for d in sorted(p for p in base_dir.iterdir()
                            if p.is_dir() and not p.name.startswith(".")):
                rel = "%s/%s" % (tree, d.name)
                lead = re.match(r"^([A-Z][A-Z0-9]*-[0-9]+)(?:-|$)", d.name)
                owner = by_id.get(lead.group(1)) if lead else None
                if owner is None:
                    findings.append((
                        "initiative-id", rel,
                        "the name does not start with an id in this register -- an initiative "
                        "folder is named for the entry that owns it, e.g. %s-<slug>"
                        % (sorted(by_id)[0] if by_id else "PREFIX-NN")))
                    continue
                if live and not any(o is owner for o in named.get(rel, [])):
                    findings.append((
                        "initiative-folder", rel,
                        "%s does not name this directory as an artifact `folder:%s/` -- the entry "
                        "and its folder must point at each other" % (owner.id, rel)))
                closed = owner.status in CLOSED_STATUSES
                if live and closed:
                    findings.append((
                        "initiative-place", rel,
                        "%s is %r, so its folder belongs under docs/archive/initiatives/"
                        % (owner.id, owner.status)))
                elif not live and not closed:
                    findings.append((
                        "initiative-place", rel,
                        "%s is %r, not finished, so its folder belongs under docs/initiatives/"
                        % (owner.id, owner.status)))

    return findings


def main(argv):
    parser = argparse.ArgumentParser(description="Lint a work register against its contract.")
    parser.add_argument("root", nargs="?", default="docs/register",
                        help="the register directory (default: docs/register)")
    parser.add_argument("--quiet", action="store_true",
                        help="print findings only, no census")
    parser.add_argument("--today", default=datetime.date.today().isoformat(),
                        help="reference date for staleness (default: today)")
    args = parser.parse_args(argv)

    root = pathlib.Path(args.root)
    if not root.is_dir():
        print("register-lint: no register at %s -- nothing checked." % root, file=sys.stderr)
        return 0

    closed_dir, rename_finding = resolve_closed_dir(root)
    entries, skipped = load(root, closed_dir)
    if not entries:
        print("register-lint: %s holds no entries -- nothing checked." % root, file=sys.stderr)
        return 0

    findings = check(entries, closed_dir, root, args.today)
    if rename_finding:
        findings.insert(0, rename_finding)

    blocking = [f for f in findings if f[0] not in ADVISORY]
    advisory = [f for f in findings if f[0] in ADVISORY]

    for kind, where, msg in blocking:
        print("[%s] %s: %s" % (kind, where, msg))
    for kind, where, msg in advisory:
        print("[%s] %s: %s" % (kind, where, msg))

    if not args.quiet:
        open_entries = [e for e in entries if e.status not in CLOSED_STATUSES]
        note = ""
        if skipped:
            note = " -- %d non-entry document(s) skipped: %s" % (len(skipped), ", ".join(skipped))
        print("\nregister-lint: %d entries (%d open, %d closed) in %s%s"
              % (len(entries), len(open_entries), len(entries) - len(open_entries), root, note),
              file=sys.stderr)
        print("register-lint: %d blocking, %d advisory. What this gate CANNOT check is in "
              "its module docstring; a green run is not a contract guarantee."
              % (len(blocking), len(advisory)), file=sys.stderr)

    return 1 if blocking else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
