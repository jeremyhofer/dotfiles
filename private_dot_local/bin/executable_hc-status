#!/usr/bin/env python3
"""hc-status -- the states of the checks in one or more Healthchecks.io projects.

WHY IT EXISTS. Healthchecks.io watches scheduled jobs: each job pings a check, and the check goes
`grace` and then `down` when pings stop. An agent session (or a person) that wants to know whether
the fleet's jobs are alive should not need a login or a decrypted secret. This tool reads the
check states with READ-ONLY API keys, which can list checks but not change or ping them.

    hc-status [--problems] [--json]

Exit status: 0 when no check is `down` or `grace`; 1 when one is; 2 on a configuration or network
error (a project that cannot be read is reported and forces 2, but the other projects still print).

KEYS FILE. ${XDG_CONFIG_HOME:-$HOME/.config}/hc-status/keys, written by the owner, never by this
tool. One project per line: `<project label> <read-only key>`. The key is the last word on the
line, so a label may contain spaces. Blank lines and lines starting with `#` are ignored. The tool
refuses to run when the file is readable by group or others. A key is never printed: errors name
only the project label, and any text that came from the network is scrubbed of every key first.

API (https://healthchecks.io/docs/api/, Management API v3). GET /api/v3/checks/ with the header
`X-Api-Key`. A read-only key gets the same list without `uuid`, `ping_url`, `update_url`,
`pause_url`, `resume_url` and `channels`, plus a stable `unique_key`. `status` is one of `new`,
`up`, `grace`, `down`, `paused`. `last_ping` and `next_ping` are ISO 8601 timestamps with an
offset, or null. A 401 means the key is missing or invalid.

ENVIRONMENT. HC_STATUS_BASE_URL replaces https://healthchecks.io (a self-hosted server, or a test
stub). HC_STATUS_NOW (epoch seconds) fixes "now", for tests. HC_STATUS_TIMEOUT is the per-request
timeout in seconds (default 20).

Standard library only: it runs unchanged on Linux and macOS.
"""
import argparse
import json
import os
import stat
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

# Fields that identify a check by its secret ping address. A full-access key would return them; they
# are dropped from --json so the output stays shareable whatever kind of key was configured.
SECRET_FIELDS = ("uuid", "ping_url", "update_url", "pause_url", "resume_url", "channels")
QUIET_STATUSES = ("up", "new", "paused")
ALARM_STATUSES = ("down", "grace")


class ConfigError(Exception):
    pass


def keys_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "hc-status", "keys")


def load_keys(path):
    """Return [(label, key)] from the keys file, or raise ConfigError saying how to fix it."""
    try:
        st = os.stat(path)
    except OSError:
        raise ConfigError(
            "no keys file at %s. Create it with one line per Healthchecks project, "
            "'<project label> <read-only key>', then chmod 600 it." % path)
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise ConfigError(
            "%s is readable by group or others (mode %s). Run: chmod 600 %s"
            % (path, oct(stat.S_IMODE(st.st_mode)), path))
    entries = []
    with open(path) as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.rsplit(None, 1)
            if len(parts) != 2:
                # Name the line number only: the line itself may be a bare key.
                raise ConfigError("%s line %d: expected '<project label> <read-only key>'" % (path, n))
            entries.append((parts[0], parts[1]))
    if not entries:
        raise ConfigError("%s has no project lines" % path)
    return entries


def scrub(text, keys):
    for k in keys:
        text = text.replace(k, "<key>")
    return text


def fetch(base, key, timeout):
    req = urllib.request.Request(base.rstrip("/") + "/api/v3/checks/", headers={"X-Api-Key": key})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        data = json.loads(resp.read().decode("utf-8"))
    checks = data.get("checks")
    if not isinstance(checks, list):
        raise ValueError("response has no 'checks' list")
    return checks


def parse_ts(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def age(seconds):
    seconds = max(0, int(seconds))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return "%d%s" % (seconds // size, unit)
    return "%ds" % seconds


def local(dt):
    return dt.astimezone().strftime("%Y-%m-%d %H:%M:%S")


def describe(value, now, past):
    dt = parse_ts(value)
    if dt is None:
        return "-"
    delta = now - dt.timestamp()
    if past:
        note = age(delta) + " ago"
    else:
        note = "in " + age(-delta) if delta < 0 else age(delta) + " overdue"
    return "%s (%s)" % (local(dt), note)


def render(rows, now):
    table = [("PROJECT", "CHECK", "STATUS", "LAST PING", "NEXT EXPECTED")]
    for r in rows:
        name = r["name"] or "(unnamed)"
        if r.get("slug"):
            name += " [%s]" % r["slug"]
        table.append((r["project"], name, r["status"],
                      describe(r.get("last_ping"), now, True),
                      describe(r.get("next_ping"), now, False)))
    widths = [max(len(row[i]) for row in table) for i in range(5)]
    return "\n".join("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip() for row in table)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hc-status", description="Healthchecks.io check states.")
    ap.add_argument("--problems", action="store_true",
                    help="show only checks that are not up, new or paused")
    ap.add_argument("--json", action="store_true", help="print the data as JSON (never keys)")
    args = ap.parse_args(argv)

    try:
        entries = load_keys(keys_path())
    except ConfigError as e:
        print("hc-status: %s" % e, file=sys.stderr)
        return 2
    keys = [k for _, k in entries]
    base = os.environ.get("HC_STATUS_BASE_URL", "https://healthchecks.io")
    timeout = float(os.environ.get("HC_STATUS_TIMEOUT", "20"))
    now = float(os.environ.get("HC_STATUS_NOW") or time.time())

    rows, errors = [], []
    for label, key in entries:
        try:
            checks = fetch(base, key, timeout)
        except urllib.error.HTTPError as e:
            errors.append({"project": label, "error": "HTTP %d%s" % (
                e.code, " (key missing or invalid)" if e.code == 401 else "")})
            continue
        except Exception as e:  # network, TLS, bad JSON: all mean "this project could not be read"
            errors.append({"project": label, "error": scrub("%s: %s" % (type(e).__name__, e), keys)})
            continue
        for c in checks:
            row = {k: v for k, v in c.items() if k not in SECRET_FIELDS}
            row["project"] = label
            row["status"] = str(row.get("status", "unknown"))
            rows.append(row)

    alarming = any(r["status"] in ALARM_STATUSES for r in rows)
    shown = [r for r in rows if r["status"] not in QUIET_STATUSES] if args.problems else rows

    if args.json:
        print(json.dumps({"checks": shown, "errors": errors}, indent=2, sort_keys=True))
    else:
        if shown:
            print(render(shown, now))
        elif not errors:
            print("no checks to show" if args.problems else "no checks")
    for e in errors:
        print("hc-status: project '%s' could not be read: %s" % (e["project"], e["error"]),
              file=sys.stderr)
    if errors:
        return 2
    return 1 if alarming else 0


if __name__ == "__main__":
    sys.exit(main())
