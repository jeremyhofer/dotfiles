#!/bin/sh
# claude-project-settings -- write each fleet project's declared Claude Code settings into that
# project's .claude/settings.local.json, and each declared directory's into that directory's
# .claude/settings.json, after checking them against what may be declared at all.
#
#   claude-project-settings apply [<project>]     validate, then write every declaring project and
#                                                 its declared directories
#   claude-project-settings check [<project>]     report drift, and in a project with directories
#                                                 every permission rule in the shared root file
#                                                 and every leftover directory settings.local.json;
#                                                 write nothing
#   claude-project-settings validate [<file>...]  check files against the rules; with no file,
#                                                 every file the record points at
#
#   exit 0  done / no drift / valid
#   exit 1  a project could not be written (an invalid declaration, an unparseable live file), or
#           drift found, or a file failed validation
#   exit 2  bad usage, a missing tool, or a fleet record fleet-decl cannot read
#
# WHY. A project's own Claude settings, such as the extra directories its sessions may write, lived
# in hand-edited, gitignored files on each machine: nothing recorded them, a new machine had none,
# and nobody could see which project was granted what. Now a private layer keeps one plain JSON
# file per project, in settings.json's own shape, and points at it from the project's entry in the
# fleet record:
#
#     claudeLocalSettings: claude/projects/notes.json
#
# A relative path is resolved against $CLAUDE_PROJECT_SETTINGS_ROOT, by default ~/.dotlocal, where a
# private layer deploys.
#
# WRITE ROOTS OUTSIDE THE HOME DIRECTORY. An allowWrite entry is written ~/... unless the private
# layer declares, in claude/write-roots under that same root ($CLAUDE_PROJECT_SETTINGS_WRITE_ROOTS
# overrides the file), the absolute directories a project may also be granted, one per line, `#`
# comments and blank lines ignored: a network share's mount, for example. An absolute entry is then
# valid only at or under one of them. A root that is not absolute, carries a glob, a . or ..
# segment or a doubled slash, is the filesystem root, is the home directory or contains it, or is at
# or under a protected directory fails every run, before anything is written: a mistaken roots file
# must not quietly widen what every project may be granted. The files hold settings only; the layer documents each grant beside them.
#
# WHAT MAY BE DECLARED, checked by `validate` and again before every write. The rules are closed:
#   - only the keys listed in ALLOWED_KEYS below, today sandbox.filesystem.allowWrite and
#     sandbox.excludedCommands. Anything else, permissions included, is refused until it is added
#     here on purpose;
#   - allowWrite is a list of paths written ~/..., with no glob characters, no `.` or `..`
#     segments, no doubled slash, not the whole home directory, and nothing at or under a
#     protected directory (PROTECTED below: keys, the GPG home, and Claude's own configuration);
#   - excludedCommands, the commands that run OUTSIDE the sandbox in that project, is a list of
#     entries of exactly the form `<command> *`: one plain command name, a space, a star. Never a
#     shell, interpreter or wrapper (SHELLISH below), because excluding one would take every
#     command written through it out of the sandbox, which leaves no boundary at all.
# A layer's commit gate should run `validate`, so a bad file is refused when it is committed, not
# when it is applied.
#
# WHY settings.local.json AND NOT settings.json, at the repository root. The local file is
# machine-local and gitignored; settings.json is committed and travels with every clone, the wrong
# place for a path on one machine.
#
# DIRECTORIES: SESSIONS STARTED INSIDE A REPOSITORY. One repository may host several long-running
# sessions, each started in its own subdirectory. Claude Code's rule, the same on every machine
# (v2.1.211 and later), is two files per session:
#   - <repository root>/.claude/settings.local.json is read by EVERY session in the repository,
#     wherever it started, and is where Claude Code saves a "Yes, and don't ask again" approval from
#     any of them, so a rule one session saves there applies to all of them;
#   - <starting directory>/.claude/settings.json is read only by a session started there.
# So a subdirectory's own settings can only be its .claude/settings.json, and the entry maps each
# directory, relative to the project's path, to a file of the same shape and rules:
#
#     claudeDirSettings:
#       seats/review: claude/projects/notes-review.json
#
# Each file is that directory's complete declaration: nothing is shared between directories or
# inherited from the root's file by this tool, so a grant every directory needs is written in each.
# A directory key that is absolute, is the root (`.`, which is claudeLocalSettings), has a `.` or
# `..` segment or a doubled slash, or resolves through a symlink to outside the repository is
# refused, as is a .claude that is a symlink. A directory not on this machine is skipped. Because
# the file is settings.json, a name git commits by default, the hosting repository must ignore it;
# a settings.json that git TRACKS is refused, never written, so a machine's paths are not committed.
#
# THE SHARED ROOT FILE, in a project that declares claudeDirSettings. A directory's grants go only in
# its own declared file; the root's claudeLocalSettings holds only what every session in the
# repository may have. `check` reports, as drift, each permission rule (permissions.allow, .ask and
# .deny entries) in the root's live settings.local.json: such a rule is an approval one session
# saved, now applying to every session, and nothing declared it. Permission rules cannot be declared
# through this tool (WHAT MAY BE DECLARED), so the resolution is to remove the rule from that file;
# `apply` never removes one, because that stays a person's decision. `check` also reports a
# settings.local.json in a declared directory: Claude Code still reads one left in a session's
# starting directory from before v2.1.211, unseen beside the directory's declared file. A project
# without claudeDirSettings has one session's worth of root file, and none of this applies to it.
#
# THE MERGE RULE, the same as the user-level file's (dot_claude/modify_settings.json): the declared
# keys win, merged deeply; every other key in the live file is kept, because Claude Code writes
# there too (every permission it is granted). A declared ARRAY replaces the live one wholesale, so a
# declared allowWrite is the complete list, and an entry dropped from the file is removed on the
# next apply. Removing a project's pointer removes nothing from its live file; declare an empty list
# to take entries away.
#
# NEVER CLOBBER. A live file that is not valid JSON is reported and left alone. A write goes through
# a temporary file and a rename. A project whose directory is not on this machine is skipped, so one
# record serves every machine.
#
# WHO RUNS IT. Not a sandboxed session: these files are among the paths Claude Code's sandbox
# protects, so a session cannot grant itself access. A private layer runs `apply` when its record or
# its files change, as the person applying it.
set -u

ALLOWED_KEYS='[["sandbox","filesystem","allowWrite"],["sandbox","excludedCommands"]]'
SHELLISH='["sh","bash","zsh","dash","fish","ksh","env","sudo","doas","su","exec","eval","command","xargs","nohup","timeout","nice","python","python3","node","perl","ruby","npx","uv","uvx"]'
PROTECTED='["~/.ssh","~/.gnupg","~/.claude"]'

say()  { printf 'claude-project-settings: %s\n' "$1"; }
warn() { printf 'claude-project-settings: %s\n' "$1" >&2; problems=$((problems + 1)); }
die2() { printf 'claude-project-settings: %s\n' "$1" >&2; exit 2; }

cmd=${1:-}
case "$cmd" in
  apply|check|validate) shift ;;
  -h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
  *) die2 "usage: claude-project-settings apply|check [<project>] | validate [<file>...]" ;;
esac
[ "$cmd" = validate ] || [ $# -le 1 ] || die2 "usage: claude-project-settings $cmd [<project>]"

command -v jq >/dev/null 2>&1 || die2 "jq is not installed"
SROOT=${CLAUDE_PROJECT_SETTINGS_ROOT:-$HOME/.dotlocal}
problems=0; drift=0

# The declared write roots, as a JSON list; a bad line fails the run (see WRITE ROOTS above).
WROOTS_FILE=${CLAUDE_PROJECT_SETTINGS_WRITE_ROOTS:-$SROOT/claude/write-roots}
WROOTS='[]'
if [ -f "$WROOTS_FILE" ]; then
  _r=$(jq -R -s --arg home "$HOME" --argjson protected "$PROTECTED" '
    [split("\n")[] | sub("#.*$"; "") | gsub("^[[:space:]]+|[[:space:]]+$"; "") | select(length > 0)] as $lines
    | ($protected | map(sub("^~"; $home))) as $prot
    | {roots: [$lines[] | sub("/+$"; "")],
       bad: [$lines[] as $l | ($l | sub("/+$"; "")) as $r
         | if ($l | startswith("/") | not) then "\($l) is not an absolute path"
           elif ($l | test("[*?\\[\\]{}]")) then "\($l) contains a glob character"
           elif ($l | test("(^|/)\\.{1,2}(/|$)")) then "\($l) contains a . or .. segment"
           elif ($l | test("//")) then "\($l) contains a doubled slash"
           elif $r == "" then "\($l) is the filesystem root"
           elif ($home == $r or ($home | startswith($r + "/"))) then "\($l) is the home directory or contains it"
           elif any($prot[] as $p | ($r == $p or ($r | startswith($p + "/"))); .) then "\($l) is at or under a protected directory"
           else empty end]}' "$WROOTS_FILE" 2>/dev/null) || die2 "$WROOTS_FILE cannot be read"
  _bad=$(printf '%s' "$_r" | jq -r '.bad[]')
  if [ -n "$_bad" ]; then
    printf '%s\n' "$_bad" | while IFS= read -r _l; do
      printf 'claude-project-settings: write-roots (%s): %s\n' "$WROOTS_FILE" "$_l" >&2
    done
    exit 1
  fi
  WROOTS=$(printf '%s' "$_r" | jq -c .roots)
fi

# Prints one line per rule the JSON file $1 breaks; prints nothing for a valid file.
violations() {
  jq -r --argjson allowed "$ALLOWED_KEYS" --argjson protected "$PROTECTED" --argjson shellish "$SHELLISH" \
    --argjson roots "$WROOTS" --arg rootsfile "$WROOTS_FILE" '
    def under($dirs): sub("/+$"; "") as $n
      | any($dirs[] as $d | ($n == $d or ($n | startswith($d + "/"))); .);
    if type != "object" then "the file is not a JSON object" else
      ([paths | map(select(type == "string")) | select(length > 0)] | unique[]
        | . as $k
        | select(any($allowed[]; .[0:($k | length)] == $k) | not)
        | "key \(join(".")) may not be declared"),
      (.sandbox.filesystem.allowWrite as $w
        | if $w == null then empty
          elif ($w | type) != "array" then "sandbox.filesystem.allowWrite must be a list"
          else $w[]
            | if type != "string" then "allowWrite entry \(tojson) is not a path"
              elif test("[*?\\[\\]{}]") then "allowWrite entry \(.) contains a glob character"
              elif test("(^|/)\\.{1,2}(/|$)") then "allowWrite entry \(.) contains a . or .. segment"
              elif test("//") then "allowWrite entry \(.) contains a doubled slash"
              elif startswith("/") and under($roots) then empty
              elif (startswith("~/") | not) then "allowWrite entry \(.) must be written ~/..., or be at or under a write root declared in \($rootsfile)"
              elif sub("/+$"; "") == "~" then "allowWrite entry \(.) is the whole home directory"
              elif under($protected) then "allowWrite entry \(.) is at or under a protected directory"
              else empty end
          end),
      (.sandbox.excludedCommands as $x
        | if $x == null then empty
          elif ($x | type) != "array" then "sandbox.excludedCommands must be a list"
          else $x[]
            | if type != "string" then "excludedCommands entry \(tojson) is not a string"
              elif (test("^[a-z0-9][a-z0-9._-]* \\*$") | not) then "excludedCommands entry \(.) must be one command name followed by \" *\""
              elif (split(" ")[0]) as $c | any($shellish[]; . == $c) then "excludedCommands entry \(.) names a shell, interpreter or wrapper"
              else empty end
          end)
    end' "$1" 2>/dev/null || echo "the file is not valid JSON"
}

check_file() {  # $1 file, $2 label; warns for each violation, returns 1 if any
  [ -f "$1" ] || { warn "$2: $1 does not exist"; return 1; }
  _v=$(violations "$1")
  [ -z "$_v" ] && return 0
  printf '%s\n' "$_v" | while IFS= read -r _l; do printf 'claude-project-settings: %s: %s\n' "$2" "$_l" >&2; done
  problems=$((problems + 1))
  return 1
}

resolve() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$SROOT" "$1" ;; esac; }

KEY=claudeLocalSettings
DKEY=claudeDirSettings
need_record() {
  command -v fleet-decl >/dev/null 2>&1 || die2 "fleet-decl is not installed (it ships with the public dotfiles base)"
  RECORD=${FLEET_RECORD:-$HOME/Devel/mani.yaml}
  ROOT=${FLEET_DEVEL_ROOT:-$(dirname "$RECORD")}
  FLEET_RECORD=$RECORD; FLEET_DEVEL_ROOT=$ROOT; export FLEET_RECORD FLEET_DEVEL_ROOT
}
unreadable() { die2 "the fleet record $RECORD could not be read (fleet-decl exit $1)"; }
# Sets PROJECTS: every project declaring either key, each once, in the record's order. Not called in
# a command substitution: its die2 must end the script, not a subshell.
load_projects() {
  _a=$(fleet-decl --projects-with "$KEY"); _rc=$?
  case $_rc in 0) ;; 1) _a="" ;; *) unreadable "$_rc" ;; esac
  _b=$(fleet-decl --projects-with "$DKEY"); _rc=$?
  case $_rc in 0) ;; 1) _b="" ;; *) unreadable "$_rc" ;; esac
  PROJECTS=$(printf '%s\n%s\n' "$_a" "$_b" | awk 'NF && !seen[$0]++')
}
# Sets SRC to the project's root file, or empty when it declares none. Not in a subshell.
pointer() {
  SRC=""
  _p=$(fleet-decl --entry "$1" "$KEY"); _rc=$?
  case $_rc in 0) SRC=$(resolve "$_p") ;; 1) ;; *) unreadable "$_rc" ;; esac
}
# Sets DIRS to the project's <directory><TAB><file> lines, or empty when it declares none.
dir_pointers() {
  DMALFORMED=""
  DIRS=$(fleet-decl --entry-map "$1" "$DKEY"); _rc=$?
  case $_rc in 0) ;; 1) DIRS="" ;; *) unreadable "$_rc" ;; esac
  # Declared but read as no pairs: anything but an empty map is malformed, and is said, not ignored.
  if [ -z "$DIRS" ] && _v=$(fleet-decl --entry "$1" "$DKEY") && [ "$_v" != "{}" ]; then
    warn "$1: $DKEY must be a map of <directory>: <settings file>; nothing written for it"
    DMALFORMED=1
  fi
}
TAB=$(printf '\t')

if [ "$cmd" = validate ]; then
  if [ $# -gt 0 ]; then
    for f in "$@"; do check_file "$f" "$f" || :; done
  else
    need_record; load_projects
    for p in $PROJECTS; do
      pointer "$p"
      [ -z "$SRC" ] || check_file "$SRC" "$p" || :
      dir_pointers "$p"
      [ -n "$DIRS" ] || continue
      while IFS=$TAB read -r d s; do
        check_file "$(resolve "$s")" "$p:${d%/}" </dev/null || :
      done <<EOF
$DIRS
EOF
    done
  fi
  [ "$problems" -eq 0 ] && exit 0
  exit 1
fi

# merge_into <label> <declaration file> <directory> <file name>: merge the validated declaration into
# <directory>/.claude/<file name> by THE MERGE RULE, or report the drift under `check`.
merge_into() {
  _decl=$(cat "$2"); _file=$3/.claude/$4
  if [ -s "$_file" ]; then
    jq -e . "$_file" >/dev/null 2>&1 || { warn "$1: $_file is not valid JSON; left alone"; return; }
    _live=$(cat "$_file")
  else
    _live='{}'
  fi
  _merged=$(jq -n --argjson live "$_live" --argjson decl "$_decl" '$live * $decl') \
    || { warn "$1: could not merge into $_file"; return; }
  if [ "$(printf '%s' "$_live" | jq -S -c .)" = "$(printf '%s' "$_merged" | jq -S -c .)" ]; then
    say "$1: current"; return
  fi
  if [ "$cmd" = check ]; then
    say "$1: $_file differs from the declaration"; drift=$((drift + 1)); return
  fi
  mkdir -p "$3/.claude" || { warn "$1: cannot create $3/.claude"; return; }
  _tmpf=$(mktemp "$3/.claude/.$4.XXXXXX") || { warn "$1: cannot write in $3/.claude"; return; }
  if printf '%s\n' "$_merged" | jq . > "$_tmpf" && mv -f "$_tmpf" "$_file"; then
    say "$1: written"
  else
    rm -f "$_tmpf"; warn "$1: could not write $_file"
  fi
}

# write_dir <project> <repository directory> <declared directory> <declaration pointer>. The
# directory must stay inside the repository, textually and once symlinks are resolved, and its
# settings.json must not be a file git tracks (see DIRECTORIES above).
write_dir() {
  _d=$3
  while :; do case "$_d" in */) _d=${_d%/} ;; *) break ;; esac; done
  _l="$1:$_d"
  case "$_d" in
    ""|.) warn "$_l: the repository root is declared with $KEY, not $DKEY; not written"; return ;;
  esac
  case "/$_d/" in
    //*|*//*|*/./*|*/../*|*"$TAB"*)
      warn "$_l: a $DKEY key must be a relative path inside the repository, with no . or .. segment or doubled slash; not written"; return ;;
  esac
  _src=$(resolve "$4")
  check_file "$_src" "$_l" || { warn "$_l: not written"; return; }
  _sd=$2/$_d
  if [ ! -d "$_sd" ]; then say "$_l: $_sd is not on this machine; skipped"; return; fi
  _rp=$(cd -P -- "$2" && pwd -P); _sp=$(cd -P -- "$_sd" && pwd -P)
  case "$_sp" in
    "$_rp"/*) ;;
    *) warn "$_l: $_sd resolves outside the repository ($_sp); not written"; return ;;
  esac
  if [ -L "$_sd/.claude" ]; then warn "$_l: $_sd/.claude is a symlink; not written"; return; fi
  if git -C "$_sd" ls-files --error-unmatch -- .claude/settings.json >/dev/null 2>&1; then
    warn "$_l: $_sd/.claude/settings.json is tracked by git; not written"; return
  fi
  merge_into "$_l" "$_src" "$_sd" settings.json
  if [ "$cmd" = check ] && [ -e "$_sd/.claude/settings.local.json" ]; then
    say "$_l: $_sd/.claude/settings.local.json is left over: Claude Code still reads it for a session started there, beside the declared settings.json; move any sandbox grant it should keep into $_src, then delete it"
    drift=$((drift + 1))
  fi
}

# shared_rules <project> <repository directory> <root declaration, or empty>: under `check`, in a
# project with directories, report each permission rule in the root's settings.local.json (THE
# SHARED ROOT FILE). An unparseable file is merge_into's to report when the root is declared.
shared_rules() {
  _f=$2/.claude/settings.local.json
  [ -s "$_f" ] || return 0
  if ! _rules=$(jq -r '(.permissions // {}) as $p | if ($p | type) != "object" then empty else
        ["allow","ask","deny"][] as $l | ($p[$l] // []) | (if type == "array" then .[] else . end)
        | "\($l)\t\(if type == "string" then . else tojson end)" end' "$_f" 2>/dev/null); then
    [ -n "$3" ] || warn "$1: $_f is not valid JSON; its permission rules were not checked"
    return
  fi
  [ -n "$_rules" ] || return 0
  while IFS=$TAB read -r _k _r; do
    say "$1: $_f: permissions.$_k rule $_r applies to every session in the repository"
    drift=$((drift + 1))
  done <<EOF
$_rules
EOF
  say "$1: a rule one session saved there reaches every session started anywhere in the repository; remove it from $_f (permission rules cannot be declared through claude-project-settings, by design)"
}

need_record
if [ -n "${1:-}" ]; then projects=$1; else load_projects; projects=$PROJECTS; fi

for p in $projects; do
  pointer "$p"; src=$SRC
  dir_pointers "$p"
  if [ -z "$src" ] && [ -z "$DIRS" ]; then
    [ -n "$DMALFORMED" ] || warn "$p: declares no $KEY or $DKEY"
    continue
  fi
  rootok=""
  if [ -n "$src" ]; then
    if check_file "$src" "$p"; then rootok=1; else warn "$p: not written"; fi
  fi
  path=$(fleet-decl --entry "$p" path) || { warn "$p: declares no path"; continue; }
  case "$path" in /*) dir=$path ;; *) dir=$ROOT/$path ;; esac
  if [ ! -d "$dir" ]; then say "$p: $dir is not on this machine; skipped"; continue; fi

  [ -z "$rootok" ] || merge_into "$p" "$src" "$dir" settings.local.json
  [ -n "$DIRS" ] || continue
  [ "$cmd" != check ] || shared_rules "$p" "$dir" "$src"
  while IFS=$TAB read -r d s; do
    write_dir "$p" "$dir" "$d" "$s" </dev/null
  done <<EOF
$DIRS
EOF
done

[ "$problems" -eq 0 ] && [ "$drift" -eq 0 ] && exit 0
exit 1
