#!/bin/sh
# ui-shot — render a page headless and capture it the way a visual review actually needs.
#
# ══ FROZEN 2026-08-30 — DO NOT ADD FLAGS ═════════════════════════════════════════════════════
# This is INTERIM. Jeremy's call: visual-review tooling belongs in keystone, shipped as a package
# projects depend on, with its guiding skill riding along -- not developed globally here.
#
# The evidence came from validating THIS script: russ and finmodel both, independently, asked for
# authentication, and auth is irreducibly project-specific (Cloudflare Access vs server-side
# session cookies). Without it, finmodel could only reach its dev-only styleguide. A global tool
# cannot hold per-project auth, route matrices or viewport sets -- and this one grew five flags in
# a single sitting driven by two consumers' needs, which is a product acquiring a roadmap rather
# than a dotfile.
#
# Keep using it: it works, it was validated against real pages in two projects, and it serves
# styleguide-level review fine. But if you are about to ADD A CAPABILITY, that capability belongs
# in the package instead. Known gaps left for it to inherit: authentication, per-project
# route/viewport matrices, forced-colors emulation, and a combined index across runs.
# ═════════════════════════════════════════════════════════════════════════════════════════════
#
# WHY THIS EXISTS AS TOOLING RATHER THAN AS INSTRUCTIONS. Every agent that needs to look at a UI
# change re-derives the same Playwright boilerplate, and gets it subtly wrong in the same two ways:
#
#   1. It takes ONE full-page screenshot. Rendered into a chat transcript that image is scaled
#      down, so a 1px border or a subtle divider is simply not present in what the reviewer sees.
#      "I looked at it" is then false confidence rather than a lie. The fix is a SECOND capture:
#      the changed region only, at native scale, which is what this tool always produces.
#   2. It reaches for a global or freshly-installed Playwright. The project's own version is the
#      one whose browsers are downloaded and whose behaviour matches its tests, so this resolves
#      the PROJECT's install and fails loudly rather than falling back.
#
# HEADLESS IS NOT A FLAG HERE. There is deliberately no --headed: a visible window is an
# unrequested interruption of whoever is at the keyboard, and the one time it happened it was six
# windows at bedtime. If you genuinely need a headed run, ask first and run Playwright directly.
#
# Layouts differ per repo and that is the whole resolution problem: playwright lives at
# node_modules/ in one project, frontend/node_modules/ in another, main/node_modules/ in a
# worktree-style monorepo. Searching down from the repo root and taking the shallowest hit covers
# all three without per-project config.
#
# Usage:
#   ui-shot <url> [--selector CSS]... [--probe CSS]... [--out DIR] [--scale N] [--width N]
#
#   --selector  capture this element alone, at native scale. Repeatable. This is the capture a
#               reviewer should actually look at; the full-page one is for layout regressions.
#   --color-scheme dark|light   render under that `prefers-color-scheme`. Not cosmetic: a theme
#               whose dark arm is a media query is otherwise UNTESTABLE, and a light-pin that
#               exists to defend against it cannot be verified without rendering the condition.
#   --wait-for CSS   wait for this selector to be visible before capturing (networkidle only
#               otherwise, which does not cover deferred or lazily-revealed content).
#   --height N  viewport height (default 900). Mostly moot under fullPage, but it is what makes
#               "what is above the fold" askable.
#   --probe     print computed styles for the first match. Repeatable.
#   --token --name   resolve a CSS custom property and say whether it is DEFINED. Repeatable.
#
# THE COMPUTED BORDER ALONE IS NOT DIAGNOSTIC, and an earlier version of this help claimed it was.
# A typo'd token and an element that is CORRECTLY borderless both compute to
# `borderTop: "0px none rgb(...)"` -- byte-identical. Since borderless is the overwhelmingly
# common case, reading that as "wrong token" invites a false positive on exactly the layout
# primitives a reviewer probes first. Measured by finmodel-canonical against its real stylesheet,
# 2026-08-30. `--token` is the check that actually discriminates: an undefined custom property
# resolves to empty, a defined one to its value. Use both together.
#
#   --out DIR   where captures go (default: a fresh mktemp dir, printed).
#   --scale N   deviceScaleFactor, default 2. Output pixels are --width x --scale.
#   --width N   viewport width in CSS pixels, default 1280.
set -eu

url=""; out=""; scale=2; width=1280; height=900; sels=""; probes=""; scheme=""; waitfor=""; tokens=""
while [ $# -gt 0 ]; do
  case "$1" in
    --selector) sels="$sels$2
"; shift 2 ;;
    --probe)    probes="$probes$2
"; shift 2 ;;
    --token)    tokens="$tokens$2
"; shift 2 ;;
    --out)      out=$2; shift 2 ;;
    --scale)    scale=$2; shift 2 ;;
    --width)    width=$2; shift 2 ;;
    --height)   height=$2; shift 2 ;;
    --color-scheme) scheme=$2; shift 2 ;;
    --wait-for) waitfor=$2; shift 2 ;;
    --headed|--ui|--debug|--trace|--trace=*)
      printf '%s\n' "ui-shot: $1 is deliberately not supported." >&2
      printf '%s\n' "  A visible window interrupts whoever is at the keyboard, at a time they did not choose." >&2
      printf '%s\n' "  Ask first, then run the project's playwright directly if it is really needed." >&2
      exit 2 ;;
    -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    -*) printf 'ui-shot: unknown option %s\n' "$1" >&2; exit 2 ;;
    *)  [ -z "$url" ] || { printf 'ui-shot: more than one URL given\n' >&2; exit 2; }
        url=$1; shift ;;
  esac
done
[ -n "$url" ] || { printf 'ui-shot: no URL. usage: ui-shot <url> [--selector CSS] [--probe CSS]\n' >&2; exit 2; }

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Shallowest wins: a monorepo root may have a stub node_modules while the real install is one
# level down, and vice versa. Sorting by path depth is stable across all three layouts in use.
pw=$(find "$root" -maxdepth 6 -type d -name playwright -path '*/node_modules/playwright' 2>/dev/null \
     | awk '{print gsub("/","/"), $0}' | sort -n | head -1 | cut -d' ' -f2-)
[ -n "$pw" ] || {
  printf '%s\n' "ui-shot: no project-local Playwright under $root" >&2
  printf '%s\n' "  Install it in the project (npm i -D playwright) rather than globally: the project's" >&2
  printf '%s\n' "  version is the one whose browsers are downloaded and whose behaviour matches its tests." >&2
  exit 1
}
nm=${pw%/playwright}

[ -n "$out" ] || out=$(mktemp -d "${TMPDIR:-/tmp}/ui-shot.XXXXXX")
mkdir -p "$out"

script=$(mktemp "${TMPDIR:-/tmp}/ui-shot.XXXXXX.cjs")
trap 'rm -f "$script"' EXIT INT TERM
cat > "$script" <<'NODE'
const { chromium } = require('playwright');
const [url, out, scale, width, selsRaw, probesRaw, scheme, height, waitFor, tokensRaw] = process.argv.slice(2);
const split = s => s.split('\n').map(x => x.trim()).filter(Boolean);
(async () => {
  const browser = await chromium.launch();              // headless: the default, and not overridable here
  const page = await browser.newPage({
    viewport: { width: Number(width), height: Number(height) },
    deviceScaleFactor: Number(scale),                   // native scale, so 1px detail survives
    ...(scheme ? { colorScheme: scheme } : {}),         // render the media condition, not just the default
  });
  await page.goto(url, { waitUntil: 'networkidle' });
  if (waitFor) await page.locator(waitFor).first().waitFor({ state: 'visible', timeout: 15000 });
  await page.screenshot({ path: `${out}/full.png`, fullPage: true });
  console.log(`full      ${out}/full.png`);
  let i = 0, missed = 0;
  for (const sel of split(selsRaw)) {
    const el = page.locator(sel).first();
    if (await el.count() === 0) { console.log(`MISSING   selector matched nothing: ${sel}`); missed++; continue; }
    const p = `${out}/crop-${++i}.png`;
    await el.screenshot({ path: p });
    const box = await el.boundingBox();
    const doc = await page.evaluate(() => ({ w: document.documentElement.scrollWidth, h: document.documentElement.scrollHeight }));
    const frac = box && doc.w && doc.h ? (box.width * box.height) / (doc.w * doc.h) : 0;
    console.log(`crop      ${p}   (${sel})`);
    // Selecting a page-level wrapper produces a "crop" the size of the page, which loses the
    // native-scale benefit silently -- and a wrapper class is the easiest selector to reach for.
    if (frac > 0.5) console.log(`WARNING   that crop is ${Math.round(frac*100)}% of the page: it will be scaled down like the full shot. Select a smaller element.`);
  }
  for (const sel of split(probesRaw)) {
    const got = await page.evaluate(s => {
      const e = document.querySelector(s); if (!e) return null;
      const c = getComputedStyle(e); const o = {};
      for (const k of ['color','backgroundColor','borderTop','borderBottom','fontSize','fontWeight','padding','margin','display','visibility','opacity']) o[k] = c[k];
      return o;
    }, sel);
    console.log(`probe     ${sel}\n${got ? JSON.stringify(got, null, 2).split('\n').map(l=>'          '+l).join('\n') : '          (no match)'}`);
  }
  for (const tok of split(tokensRaw)) {
    const v = await page.evaluate(t => {
      const e = document.querySelector(':root');
      return getComputedStyle(e).getPropertyValue(t);
    }, tok);
    console.log(`token     ${tok} -> ${v && v.trim() ? v.trim() : 'UNDEFINED (this is the typo signature)'}`);
  }
  await browser.close();
  // A --selector that matches nothing is a FAILURE, not a note. The crop is the entire product:
  // a selector typo is the likeliest single mistake here, and on exit 0 it leaves the reviewer
  // holding only the full-page shot -- which is the scaled-down false confidence this tool exists
  // to remove. It would fail back INTO the original bug, quietly, reporting success.
  // Found by russ-canonical, 2026-08-30, validating against real pages.
  if (missed > 0) { console.error(`ui-shot: ${missed} selector(s) matched nothing -- no crop was produced`); process.exit(1); }
})().catch(e => { console.error('ui-shot: ' + e.message); process.exit(1); });
NODE

NODE_PATH="$nm" node "$script" "$url" "$out" "$scale" "$width" "$sels" "$probes" "$scheme" "$height" "$waitfor" "$tokens"
