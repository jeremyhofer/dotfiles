#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""fleet-canonicals-queue -- the lifecycle request queue behind `fleet-canonicals request` and
`fleet-canonicals serve-requests`. Run it through `fleet-canonicals`; it is a separate file only
because its checks are easier to state and test in Python than in the bash the verbs are written in.

WHY A QUEUE. A session inside an agent sandbox cannot start, stop or refresh a canonical itself: a
launch writes a job directory under ~/.claude, which the sandbox cannot write, and inside the
sandbox the live session list can read every peer as stopped, so a sandboxed `up` can launch a
duplicate. What a sandboxed session CAN do is write a file under ~/.local/state. So it writes a
request there (`request`), and a runner outside every sandbox, started once a minute by a systemd
user timer or a LaunchAgent, reads the queue and runs the existing verb (`serve-requests`; where
neither can be loaded, `serve-requests --loop` repeats the pass every 60 seconds, e.g. in a tmux pane). The
verb's own checks still apply -- the pre-flight that the name can be launched, the handoff
freshness gate on `down` and `refresh`, a pointer that resolves -- and the runner adds the checks
the verbs lack, listed in CHECKS below.

THE TRUST IS COOPERATIVE. Anyone who can write the requests directory can write a request, and the
runner cannot authenticate who wrote it: a request records who it claims to be from. The checks
bound the harm instead. Four verbs only, never `--force` or `--stub`, only names the fleet record
declares for this machine, never a session that is working, never more than a few actions an hour.
Every request gets a result file and an audit line, so a request outside the rules is refused AND
visible. Nothing here sends a notification of any kind.

FILES, all under $FLEET_STATE (default $XDG_STATE_HOME/fleet-canonicals):
  requests/<id>.request.json   a queued request, written atomically (a temp file, then a rename)
  requests/<id>.running.json   claimed by a runner; its verb is executing
  requests/<id>.served.json    done with, whatever the outcome
  requests/<id>.result.json    the outcome: done, failed or refused, the check that refused it, the
                               verb's output; or `waiting` while the request stays queued (below)
  requests/PAUSED              while it exists, every request is refused
  requests-audit.jsonl         one line per served request, appended. Outside requests/ so that a
                               grant to write the queue is not also a grant to rewrite the history
                               the rate limits are counted from.
Served requests and their results older than seven days are removed by the runner.

A REQUEST FOR A BUSY SESSION WAITS. When the only thing refusing a request is that the session it
would stop is working, the request is left queued and its result file says `waiting`; each pass
checks it again from the start, so it is served once the session is idle, or refused as stale at
request-max-age. Without this a session could never have itself refreshed: it is working, by
construction, at the moment it writes the request, and the runner serves a new request within
seconds. A waiting pass writes no audit line, so waiting never counts against the rate limits.
Only a positive reading of work waits; a listing or transcript that cannot be read refuses at once.
"""
from __future__ import annotations

import calendar
import fcntl
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

VERBS = ("up", "down", "refresh", "resume", "init")
STOPPING = ("down", "refresh")                  # verbs that end a running session
STARTING = ("up", "refresh", "resume", "init")  # verbs that spend usage (init runs with --up)
REQUEST_KEYS = {"id", "time", "verb", "name", "reason", "requester"}
RETAIN_SECONDS = 7 * 24 * 3600
VERB_TIMEOUT = 600

# The configuration keys this file reads, with their defaults. The file is the one
# `fleet-canonicals` already reads (`key = value` lines, `#` comment lines, the last repeat wins).
# A key that is present but empty is an explicit empty value, not the default: `never-touch =`
# turns the never-touch list off.
DEFAULTS = {
    "request-max-age": "600",             # seconds before a queued request is stale
    "request-limit-canonical": "3",       # actions per canonical per rolling hour
    "request-limit-fleet": "auto",        # actions for the whole fleet per rolling hour; auto:
                                          # max(10, 2 x the seats declared for this machine)
    "request-usage-threshold": "85",      # 7-day usage percent at which starting verbs stop
    "request-usage-exempt": "",           # canonicals that may still be started above it
    "request-any": "director-canonical",  # requesters who may act on any canonical
    "never-touch": "director-canonical",  # canonicals the queue never acts on, for any verb
    "allow-self-refresh": "false",        # true: a canonical may request its own refresh
    "request-idle-states": "done,idle,waiting",  # agents-listing states that are not working
    "snapshot-max-age": "45",             # seconds before the session snapshot is too old to use
    "context-window": "200000",           # a seat's context window in tokens, unless its declared
                                          # launch model ends in [1m] (then 1,000,000)
}


def die(msg: str, code: int = 2) -> None:
    print(f"fleet-canonicals: {msg}", file=sys.stderr)
    sys.exit(code)


# ---- environment -----------------------------------------------------------------------------

HOME = Path.home()
STATE = Path(os.environ.get("FLEET_STATE") or
             Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "fleet-canonicals")
QUEUE = STATE / "requests"
AUDIT = STATE / "requests-audit.jsonl"
CONFIG = Path(os.environ.get("FLEET_CANONICALS_CONFIG") or
              Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "fleet-canonicals" / "config")
TRANSCRIPTS = Path(os.environ.get("FLEET_TRANSCRIPT_DIR") or HOME / ".claude" / "projects")
PID_RECORDS = Path(os.environ.get("FLEET_PID_RECORD_DIR") or HOME / ".claude" / "sessions")
PROC = Path(os.environ.get("FLEET_PROC_ROOT") or "/proc")
USAGE_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "claude-usage"
HERE = Path(__file__).resolve().parent


def sibling(name: str, env: str) -> list[str]:
    """A companion tool: the variable, else beside this file (a source tree names it
    executable_<name>), else on PATH."""
    if os.environ.get(env):
        return os.environ[env].split()
    for cand in (HERE / name, HERE / f"executable_{name}"):
        if cand.is_file():
            return ["bash", str(cand)] if name == "fleet-canonicals" else [str(cand)]
    found = shutil.which(name)
    return [found] if found else [name]


def claude_cmd() -> list[str]:
    return [os.environ.get("FLEET_CLAUDE_CMD") or "claude"]


def agents_cmds() -> tuple[list[str], list[str]]:
    """The live listing and the one including exited sessions, overridable exactly as in
    `fleet-canonicals`: an overridden base command answers both."""
    base = os.environ.get("FLEET_AGENTS_JSON_CMD")
    every = os.environ.get("FLEET_AGENTS_JSON_ALL_CMD")
    if base:
        return base.split(), (every or base).split()
    return claude_cmd() + ["agents", "--json"], (every.split() if every else claude_cmd() + ["agents", "--json", "--all"])


def config() -> dict[str, str]:
    values = dict(DEFAULTS)
    try:
        lines = CONFIG.read_text(encoding="utf-8").splitlines()
    except OSError:
        return values
    for line in lines:
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        values[k.strip()] = v.strip()
    return values


def as_list(v: str) -> list[str]:
    return [x for x in re.split(r"[\s,]+", v) if x]


def as_int(cfg: dict[str, str], key: str) -> int:
    try:
        return int(cfg[key])
    except ValueError:
        die(f"config key {key} is not a whole number: {cfg[key]!r} (in {CONFIG})")
        raise


def child_env() -> dict[str, str]:
    """This environment without what `uv run --script` added for this file: uv puts the script's
    own environment's bin first on PATH, and everything the runner starts inherits it, a launched
    canonical session included, whose python3 then became uv's (measured 2026-11-08: a session the
    runner refreshed had uv's environment first on PATH, which a suite's machine report showed)."""
    env = dict(os.environ)
    own_bin = os.path.realpath(os.path.dirname(sys.executable))
    parts = [d for d in env.get("PATH", "").split(os.pathsep)
             if d and os.path.realpath(d) != own_bin]
    env["PATH"] = os.pathsep.join(parts)
    if env.get("VIRTUAL_ENV") and os.path.realpath(env["VIRTUAL_ENV"]) == os.path.realpath(sys.prefix):
        del env["VIRTUAL_ENV"]
    return env


def run(cmd: list[str], timeout: int = 60, extra_env: dict[str, str] | None = None) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, text=True, timeout=timeout,
                           env={**child_env(), **(extra_env or {})})
        return p.returncode, p.stdout
    except FileNotFoundError:
        return 127, f"not found: {cmd[0]}"
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode(errors="replace")
        return 124, out + f"\n(killed after {timeout}s)"


def hostname() -> str:
    rc, out = run(["hostname"])
    return out.strip() if rc == 0 and out.strip() else socket.gethostname()


def decl(*args: str) -> tuple[int, str]:
    rc, out = run(sibling("fleet-decl", "FLEET_DECL_CMD") + list(args))
    return rc, out.strip()


def declared_here(name: str) -> tuple[bool, str]:
    """Is NAME a canonical the fleet record declares for this machine? The same two reads
    `fleet-canonicals` makes: a launch directory, and this host in canonicalMachines."""
    rc, _ = decl("--canonical", name, "canonicalLaunchDir")
    if rc == 2:
        return False, "the fleet record is unreadable (fleet-decl exit 2)"
    if rc != 0:
        return False, f"'{name}' is not a canonical the fleet record declares"
    rc, machines = decl("--canonical-list", name, "canonicalMachines")
    host = hostname()
    if rc != 0 or host not in machines.splitlines():
        return False, f"'{name}' is not declared for this machine ({host})"
    return True, ""


def project_of(name: str) -> str | None:
    rc, out = decl("--values", "canonical")
    if rc != 0:
        return None
    for line in out.splitlines():
        proj, _, canon = line.partition("\t")
        if canon == name:
            return proj
    return None


def agents(all_rows: bool = False) -> list[dict] | None:
    live, every = agents_cmds()
    rc, out = run(every if all_rows else live)
    if rc != 0:
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    return data if isinstance(data, list) else None


def newest_row(rows: list[dict], name: str) -> dict | None:
    mine = [r for r in rows if r.get("name") == name]
    return max(mine, key=lambda r: r.get("startedAt") or 0) if mine else None


def now() -> int:
    return int(time.time())


def stamp(t: int) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def write_atomic(path: Path, data: dict) -> None:
    tmp = path.with_name(f".tmp-{path.name}-{secrets.token_hex(4)}")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


# ---- who is asking ---------------------------------------------------------------------------

def calling_session_name() -> str | None:
    """The canonical name of the session this runs inside, when that can be read without the
    network: Claude Code exports CLAUDE_CODE_SESSION_ID into a session's shell, and the status-line
    usage recorder writes $XDG_RUNTIME_DIR/claude-usage/<session id>.json carrying session_name.
    The agents listing is the fallback; inside a sandbox it may be unreadable."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return None
    try:
        name = json.loads((USAGE_DIR / f"{sid}.json").read_text(encoding="utf-8")).get("session_name")
        if name:
            return str(name)
    except (OSError, ValueError, AttributeError):
        pass
    rows = agents(all_rows=True) or []
    for r in rows:
        if r.get("sessionId") == sid and r.get("name"):
            return str(r["name"])
    return None


# ---- the queue -------------------------------------------------------------------------------

def queued() -> list[Path]:
    return sorted(QUEUE.glob("*.request.json"))


def running() -> list[Path]:
    return sorted(QUEUE.glob("*.running.json"))


def read_request(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def pending_for(name: str, exclude: Path | None = None) -> list[str]:
    ids = []
    for p in queued() + running():
        if exclude is not None and p == exclude:
            continue
        r = read_request(p)
        if r and r.get("name") == name:
            ids.append(p.name)
    return ids


def vet_target(name: str, claimed: str, who: str) -> str:
    """The checks a request makes before anything is written, shared with `follow` so the two cannot
    drift: the name is not never-touch and is declared for this machine, and the requester can be
    told. Returns the requester. WHO is the verb's name, for the message prefix."""
    cfg = config()
    if name in as_list(cfg["never-touch"]):
        die(f"{who}: '{name}' is on the never-touch list ({CONFIG}): the queue never acts on it, "
            "for any verb, whoever asks. Its lifecycle is its operator's, from a terminal.", 1)
    ok, why = declared_here(name)
    if not ok:
        die(f"{who}: {why}; refusing to queue it", 1)
    derived = calling_session_name()
    if derived and claimed and claimed != derived:
        die(f"{who}: this is running inside '{derived}', so the request is from '{derived}', "
            f"not '{claimed}'. Drop --as, or ask '{claimed}' to request it.", 1)
    requester = derived or claimed
    if not requester:
        die(f"{who}: cannot tell who is asking -- this is not running inside a named session, so "
            "say who with --as <name>. A request records its requester, and the runner checks it.", 1)
    return requester


def enqueue(verb: str, name: str, reason: str, requester: str, who: str) -> tuple[str, Path]:
    """Write one request, atomically, and return its id and path. The one place a request is made."""
    QUEUE.mkdir(parents=True, exist_ok=True)
    pend = pending_for(name)
    if pend:
        die(f"{who}: a request for '{name}' is already queued or running ({pend[0]}); the queue "
            "holds one per canonical. Its result appears beside it.", 1)
    t = now()
    rid = f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime(t))}-{name}-{secrets.token_hex(3)}"
    req = {"id": rid, "time": t, "verb": verb, "name": name, "reason": reason, "requester": requester}
    path = QUEUE / f"{rid}.request.json"
    write_atomic(path, req)
    return rid, path


def cmd_request(argv: list[str]) -> int:
    usage = "usage: fleet-canonicals request <up|down|refresh|resume|init> <name> --reason <text> [--as <requester>]"
    pos: list[str] = []
    reason = ""
    claimed = ""
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--reason", "--as"):
            if i + 1 >= len(argv) or not argv[i + 1].strip():
                die(f"request: {a} needs a value\n{usage}")
            if a == "--reason":
                reason = argv[i + 1].strip()
            else:
                claimed = argv[i + 1].strip()
            i += 2
            continue
        if a in ("--force", "--stub"):
            die(f"request: {a} is never accepted through the queue. The queue runs the plain verb, "
                "with every check it makes; an escape hatch is the operator's, from a terminal.")
        if a in ("-h", "--help"):
            print(usage)
            return 0
        if a.startswith("-"):
            die(f"request: unknown option '{a}'\n{usage}")
        pos.append(a)
        i += 1
    if len(pos) != 2:
        die(f"request: need a verb and one canonical name\n{usage}")
    verb, name = pos
    if verb not in VERBS:
        die(f"request: '{verb}' cannot be requested; the queue accepts {', '.join(VERBS)}")
    if not reason:
        die(f"request: --reason is required; it is what the audit log will say this was for\n{usage}")
    requester = vet_target(name, claimed, "request")
    rid, path = enqueue(verb, name, reason, requester, "request")
    print(f"queued   {verb} {name} (from {requester})")
    print(f"         {path}")
    print(f"         the runner checks and serves it within a minute or two; the outcome will be in")
    print(f"         {QUEUE / (rid + '.result.json')}")
    if (QUEUE / "PAUSED").exists():
        print(f"note     the queue is PAUSED ({QUEUE / 'PAUSED'}): the runner will refuse it")
    return 0


# ---- follow ----------------------------------------------------------------------------------

FOLLOW_POLL = 3            # seconds between looks at the result file; a test shrinks it
FOLLOW_WAIT = 900          # seconds `follow` waits for the result unless --wait says otherwise
FOLLOW_LINES = 15          # how far into a handoff the "What follows this park" line may be
FOLLOWS = re.compile(r"^\*\*What follows this park: \(([123])\)")


def read_follow_line(handoff: Path) -> tuple[str, str]:
    """The (number, line) a handoff's first lines name, or die: none, or more than one, is a seat
    that has not said what follows its park, and guessing would stop or refresh the wrong way."""
    try:
        with handoff.open(encoding="utf-8", errors="replace") as fh:
            head = [fh.readline() for _ in range(FOLLOW_LINES)]
    except OSError as e:
        die(f"follow: cannot read the handoff {handoff}: {e}", 1)
    hits = [(m.group(1), line.rstrip("\n")) for line in head if (m := FOLLOWS.match(line))]
    if len(hits) != 1:
        die(f"follow: the handoff names {'no' if not hits else 'more than one'} 'What follows this park' "
            f"line in its first {FOLLOW_LINES} lines ({handoff}); ask the seat for it (skill "
            "parking-and-handoff, 'What follows the park'). Nothing was placed or queued.", 1)
    return hits[0]


def follow_handoff(name: str) -> tuple[int, str]:
    rc, out = run(sibling("fleet-canonicals", "FLEET_CANONICALS_BIN") + ["handoff", name])
    return rc, out.strip()


def cmd_follow(argv: list[str]) -> int:
    """Run the chain the hub ran by hand after a seat parked: read the handoff's line, place,
    queue the refresh or down it names, and wait for the runner's result. It stops at the first
    failure; every step before the request is queued is one that leaves the queue untouched."""
    usage = "usage: fleet-canonicals follow <name> [--dry-run] [--wait SECONDS] [--as <requester>]"
    pos: list[str] = []
    dry, claimed, wait = False, "", float(FOLLOW_WAIT)
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--as", "--wait"):
            if i + 1 >= len(argv) or not argv[i + 1].strip():
                die(f"follow: {a} needs a value\n{usage}")
            if a == "--as":
                claimed = argv[i + 1].strip()
            else:
                try:
                    wait = float(argv[i + 1])
                except ValueError:
                    die(f"follow: --wait needs a number of seconds, not {argv[i + 1]!r}\n{usage}")
                if wait < 0:
                    die(f"follow: --wait cannot be negative\n{usage}")
            i += 2
            continue
        if a == "--dry-run":
            dry = True
        elif a in ("-h", "--help"):
            print(usage)
            return 0
        elif a.startswith("-"):
            die(f"follow: unknown option '{a}'\n{usage}")
        else:
            pos.append(a)
        i += 1
    if len(pos) != 1:
        die(f"follow: need one canonical name\n{usage}")
    name = pos[0]

    # 1. Who may follow, before anything is read or moved. Following another seat's park is the hub's:
    # the runner refuses a seat's request against itself to refresh, and a peer has no standing to
    # move another's handoff.
    requester = vet_target(name, claimed, "follow")
    hubs = as_list(config()["request-any"])
    if requester not in hubs:
        die(f"follow: '{requester}' is not in request-any ({', '.join(hubs) or 'empty'}); following "
            "another seat's park is the hub's. Nothing was placed or queued.", 1)

    # 2. Cheap and certain before the side effects: a request already held.
    pend = pending_for(name)
    if pend:
        die(f"follow: a request for '{name}' is already queued or running ({pend[0]}); wait for its "
            "result, then follow again. Nothing was placed or queued.", 1)

    # 3. What the seat says follows its park, read before place so a handoff that says nothing
    # leaves the staging directory as it was.
    rc, out = follow_handoff(name)
    if rc != 0:
        die(f"follow: `fleet-canonicals handoff {name}` failed, so there is no handoff to read: {out}\n"
            "Nothing was placed or queued. The seat records its pointer when it parks.", 1)
    handoff = Path(out.splitlines()[-1])
    num, line = read_follow_line(handoff)

    # 4. Place. Its exit is 1 when ANY staged file needs judgment, another seat's included, so the
    # exit is not the test: this seat's pointer is.
    rc, out = run(sibling("fleet-canonicals", "FLEET_CANONICALS_BIN") + ["place"] + (["--dry-run"] if dry else []),
                  timeout=300)
    print(out.rstrip("\n"))
    if not dry:
        rc2, now_at = follow_handoff(name)
        staging = os.path.realpath(STATE / "handoff-staging")
        if rc2 != 0 or os.path.commonpath([staging, os.path.realpath(now_at.splitlines()[-1])]) == staging:
            die(f"follow: this seat's handoff was not placed; see place's output above "
                f"(pointer: {now_at.splitlines()[-1] if rc2 == 0 else 'unresolvable'}). Nothing was queued.", 1)
        handoff = Path(now_at.splitlines()[-1])
        if rc != 0:
            print("note     place reported items needing judgment (not this seat's); continuing")

    # 5. The request.
    verb = "refresh" if num == "1" else "down"
    if dry:
        print(f"would request {verb} {name} (the handoff says ({num}))")
        print(line)
        return 0
    rid, path = enqueue(verb, name, f"follow: {handoff.name} says ({num})", requester, "follow")
    result = QUEUE / f"{rid}.result.json"
    print(f"queued   {verb} {name} (from {requester}; the handoff says ({num}))")
    if wait == 0:
        print(f"         not waiting; the result will appear at {result}")
        return 0

    # 6. Wait for the runner. A `waiting` result is the runner holding the request for a seat that
    # is still working; it is not an outcome.
    deadline = time.monotonic() + wait
    said_waiting = False
    while True:
        try:
            doc = json.loads(result.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            doc = None   # not there yet, or caught mid-replace
        outcome = doc.get("outcome") if isinstance(doc, dict) else None
        if outcome == "waiting":
            if not said_waiting:
                print(f"waiting  {name} is still working, so the runner holds the request "
                      f"({doc.get('detail') or doc.get('check') or ''})")
                said_waiting = True
        elif outcome in ("done", "failed", "refused"):
            text = str(doc.get("output") if outcome == "done" else (doc.get("detail") or doc.get("output")) or "")
            if outcome == "done":
                tail = "\n".join(text.splitlines()[-20:])
                print(f"done     {verb} {name}" + (f"\n{tail}" if tail else ""))
                if num == "2":
                    print(f"reminder the return named in the handoff line is yours to record in your own "
                          f"handoff and to `request up {name}` at that time")
                return 0
            print(f"{outcome:<8} {verb} {name}" + (f" -- {doc['check']}" if doc.get("check") else ""))
            if text:
                print(text)
            return 1
        if time.monotonic() >= deadline:
            die(f"follow: still pending after {wait:g} s; the result will appear at {result}", 2)
        time.sleep(FOLLOW_POLL)


# ---- the checks ------------------------------------------------------------------------------
# Each takes the request and the pass context and returns None to pass, or the reason it refuses.
# They run in this order and the first refusal is the one recorded, so the cheap and certain ones
# come first and the ones that read the live session list come last. A reason returned as a Wait
# leaves the request queued for the next pass instead of consuming it.

class Wait(str):
    """A refusal that may clear by itself: the request stays queued and is checked again."""

class Pass:
    """What one serve-requests pass reads once and shares across its requests."""

    def __init__(self, cfg: dict[str, str]) -> None:
        self.cfg = cfg
        self.t = now()
        self.audit = read_audit()
        self._live: list[dict] | None | bool = False
        self._all: list[dict] | None | bool = False
        self._trust: tuple[int, set[str]] | None = None
        self._override: dict | None = None
        self.snapshot = [(p, read_request(p)) for p in queued()]

    def usage_override(self) -> dict:
        if self._override is None:
            self._override = usage_override()
        return self._override

    def live(self) -> list[dict] | None:
        if self._live is False:
            self._live = agents()
        return self._live  # type: ignore[return-value]

    def every(self) -> list[dict] | None:
        if self._all is False:
            self._all = agents(all_rows=True)
        return self._all  # type: ignore[return-value]

    def refresh_listing(self) -> None:
        self._live = False
        self._all = False

    def trust(self) -> tuple[int, set[str]]:
        if self._trust is None:
            rc, out = run(sibling("claude-trust-check", "FLEET_TRUST_CHECK_CMD") + ["--names-only"], timeout=120)
            names = {line.strip() for line in out.splitlines()
                     if line.strip() and not line.startswith("claude-trust-check:")}
            self._trust = (rc, names)
        return self._trust


def check_shape(req: dict, ctx: Pass, path: Path) -> str | None:
    if set(req) != REQUEST_KEYS:
        return f"malformed: the request's fields are not exactly {sorted(REQUEST_KEYS)}"
    for k in ("verb", "name", "reason", "requester", "id"):
        if not isinstance(req[k], str) or not req[k].strip():
            return f"malformed: '{k}' is not a non-empty string"
    if not isinstance(req["time"], int):
        return "malformed: 'time' is not an integer (epoch seconds)"
    if path.name != f"{req['id']}.request.json":
        return f"malformed: its id ({req['id']}) is not its file name"
    return None


def check_verb(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["verb"].startswith("-") or req["name"].startswith("-") or " " in req["verb"]:
        return "--force, --stub and every other option are never accepted through the queue"
    if req["verb"] not in VERBS:
        return f"verb '{req['verb']}' is not one the queue accepts ({', '.join(VERBS)})"
    if not re.fullmatch(r"[A-Za-z0-9._-]+", req["name"]):
        return f"name '{req['name']}' is not a plain canonical name"
    return None


def check_paused(req: dict, ctx: Pass, path: Path) -> str | None:
    if (QUEUE / "PAUSED").exists():
        return f"the queue is paused ({QUEUE / 'PAUSED'} exists)"
    return None


def check_age(req: dict, ctx: Pass, path: Path) -> str | None:
    limit = as_int(ctx.cfg, "request-max-age")
    age = ctx.t - req["time"]
    if age > limit:
        why = f"stale: written {age}s ago, more than request-max-age ({limit}s)"
        prior = read_request(QUEUE / f"{req['id']}.result.json") or {}
        if prior.get("outcome") == "waiting":
            why += (f"; it had waited since {stamp(int(prior.get('since') or 0))} because "
                    f"{prior.get('detail')}")
        return why
    if age < -60:
        return f"its time is {-age}s in the future"
    return None


def check_never_touch(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["name"] in as_list(ctx.cfg["never-touch"]):
        return f"'{req['name']}' is on the never-touch list: the queue never acts on it"
    return None


def check_declared(req: dict, ctx: Pass, path: Path) -> str | None:
    ok, why = declared_here(req["name"])
    return None if ok else why


def check_requester(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["requester"] == req["name"] or req["requester"] in as_list(ctx.cfg["request-any"]):
        return None
    return (f"'{req['requester']}' asked to {req['verb']} '{req['name']}': a canonical requests only "
            f"its own lifecycle actions (request-any: {ctx.cfg['request-any'] or 'none'})")


def check_self_refresh(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["verb"] != "refresh" or req["requester"] != req["name"]:
        return None
    if ctx.cfg["allow-self-refresh"].lower() == "true":
        return None
    # The 2026-08-29 measurement recorded beside `refresh`'s own self-refusal in fleet-canonicals:
    # a stopped session can be crash-respawned by the harness with --resume, so the same session
    # returns, unrefreshed, and reports OK. Whether a runner outside the session wins that race has
    # not been measured; allow-self-refresh = true is how that measurement is run on purpose.
    return ("a self-refresh waits for a measurement that the runner's refresh replaces the session "
            "rather than racing the harness's crash-respawn (allow-self-refresh = true runs it)")


def check_one_per_canonical(req: dict, ctx: Pass, path: Path) -> str | None:
    # Against the queue as it stood when the pass began: an older request for the same canonical
    # that this pass has already served still counts, so two requests queued together never both
    # run. A running marker found while this runner holds the lock is a runner that died mid-verb.
    for p in running():
        r = read_request(p)
        if r and r.get("name") == req["name"]:
            return (f"another request for '{req['name']}' is marked running ({p.name}); a runner "
                    "that died mid-verb leaves one, so inspect it and remove it by hand")
    for p, r in ctx.snapshot:
        if p.name < path.name and r and r.get("name") == req["name"]:
            return f"another request for '{req['name']}' was queued first ({p.name})"
    return None


FLEET_LIMIT_FLOOR = 10


def seats_here() -> int | None:
    """How many canonicals the fleet record declares for this machine, or None when the record
    cannot be read."""
    found = seat_declarations(hostname())
    return None if found is None else len(found[0])


def fleet_limit(cfg: dict[str, str]) -> int:
    """The fleet's lifecycle actions per rolling hour. A whole number in the config wins. `auto`,
    the default, scales with the machine: max(10, 2 x the seats declared for it), so one refresh
    round plus one recovery per seat fits. A fixed 10 was smaller than one round on a 13-seat
    machine. An unreadable record falls back to the floor, the smaller limit, never a larger one."""
    if cfg.get("request-limit-fleet", "auto").strip() in ("", "auto"):
        n = seats_here()
        return max(FLEET_LIMIT_FLOOR, 2 * n) if n is not None else FLEET_LIMIT_FLOOR
    return as_int(cfg, "request-limit-fleet")


def check_rate(req: dict, ctx: Pass, path: Path) -> str | None:
    hour = ctx.t - 3600
    acted = [a for a in ctx.audit if a.get("outcome") in ("done", "failed") and a.get("at", 0) > hour]
    mine = [a for a in acted if a.get("name") == req["name"]]
    lc = as_int(ctx.cfg, "request-limit-canonical")
    if len(mine) >= lc:
        return f"rate: '{req['name']}' has had {len(mine)} lifecycle actions in the last hour (limit {lc})"
    lf = fleet_limit(ctx.cfg)
    if len(acted) >= lf:
        return f"rate: the fleet has had {len(acted)} lifecycle actions in the last hour (limit {lf})"
    return None


def seven_day_pct(t: int) -> tuple[float | None, str]:
    """The current 7-day usage percent: the figure in the NEWEST of this machine's per-session
    usage files, by the written_at the status line's recorder stores (the file's mtime where there
    is none). The percent is the account's, so each file holds the same figure as of when it was
    written, and only the newest is current. The highest is not: the files of stopped sessions are
    never removed, and one written before the window was reset keeps its old figure under the same
    seven_day_resets_at (measured 2026-11-17: a file from 08:36 read 99% after a 09:10 reset, while
    live files read 1%, and every start through the queue was refused). A file whose
    seven_day_resets_at has passed describes a window that is over, and is skipped."""
    best: float | None = None
    best_key: float = 0.0
    src = ""
    for f in sorted(USAGE_DIR.glob("*.json")):
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
            mtime = f.stat().st_mtime
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict):
            continue
        pct, resets = d.get("seven_day_pct"), d.get("seven_day_resets_at")
        if not isinstance(pct, (int, float)):
            continue
        if isinstance(resets, (int, float)) and resets < t:
            continue
        written = d.get("written_at")
        key = float(written) if isinstance(written, (int, float)) else mtime
        if best is None or key > best_key:
            best, best_key, src = float(pct), key, f.name
    return best, src


def usage_override() -> dict:
    """The machine's temporary usage override, read by `claude-usage-override status --json`, the
    one reader every usage throttle shares. Fails safe: a reader that cannot run, or prints
    something that is not its JSON, means not active."""
    try:
        rc, out = run(sibling("claude-usage-override", "CLAUDE_USAGE_OVERRIDE_CMD") + ["status", "--json"],
                      timeout=30)
    except OSError as e:  # run() turns a missing command into 127; a non-executable one raises
        rc, out = 126, str(e)
    try:
        st = json.loads(out.strip().splitlines()[-1]) if out.strip() else None
    except ValueError:
        st = None
    if not isinstance(st, dict) or not isinstance(st.get("detail"), str):
        return {"state": "unknown", "active": False,
                "detail": f"claude-usage-override could not be read (exit {rc}); not applied"}
    st["active"] = rc == 0 and st.get("state") == "active" and st.get("active") is True
    return st


def check_usage(req: dict, ctx: Pass, path: Path) -> str | None:
    # Not held at the threshold: a stopping verb, a canonical on the exempt list, and any request
    # from a request-any requester (the hub), whose judgment on the active sessions and their work
    # stands at any usage level (Jeremy, 2026-11-19 09:12).
    if req["verb"] not in STARTING or req["name"] in as_list(ctx.cfg["request-usage-exempt"]):
        return None
    if req.get("requester") in as_list(ctx.cfg["request-any"]):
        return None
    limit = float(as_int(ctx.cfg, "request-usage-threshold"))
    pct, src = seven_day_pct(ctx.t)
    if pct is not None and pct >= limit:
        # Only a refusal asks the override: below the threshold there is nothing to stand down.
        ov = ctx.usage_override()
        msg = (f"the 7-day window is at {pct:g}% ({src}), at or above "
               f"request-usage-threshold ({limit:g}%), and '{req['name']}' is not exempt")
        if ov["active"]:
            req["_usage_override"] = f"{msg}; not applied, the usage override is {ov['detail']}"
            return None
        # An expired or invalid override is named, so nobody believes one is in force; an absent
        # one is the normal case and adds nothing.
        note = "" if ov.get("state") == "absent" else f" (usage override {ov['detail']})"
        return f"usage: {msg}{note}"
    return None


def check_trust(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["verb"] not in ("up", "resume", "init"):
        return None
    rc, untrusted = ctx.trust()
    if rc == 0:
        return None
    if rc == 1:
        proj = project_of(req["name"])
        if proj is None or proj in untrusted:
            return (f"workspace trust: claude-trust-check reports '{req['name']}'s directory untrusted; "
                    "an unattended `claude --bg` there exits. Accept the trust prompt in an "
                    "interactive `claude` there first")
        return None
    return f"workspace trust could not be read (claude-trust-check exit {rc})"


def keepalive_holds(name: str) -> list[str]:
    # The keep-alive verb is deferred until it is measured what keeps an idle background session
    # from the supervisor's stop. When it is built, a hold registers itself in the requests
    # directory and this returns the holders. Until then no hold can exist.
    return []


def check_keepalive(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["verb"] not in STOPPING:
        return None
    holders = [h for h in keepalive_holds(req["name"]) if h != req["requester"]]
    return f"'{req['name']}' is held up by {holders[0]}" if holders else None


def transcript_turn_ended(session_id: str) -> bool | None:
    """True when the session's last turn ended, False when one is in progress, None when its
    transcript cannot be read. A turn has ended when the last main-thread entry is the turn's
    closing system line or an assistant message that stopped on end_turn; a user entry (a prompt or
    a tool result) or an assistant tool call last means a turn is in progress."""
    if not session_id:
        return None
    hits = list(TRANSCRIPTS.glob(f"*/{session_id}.jsonl")) + list(TRANSCRIPTS.glob(f"{session_id}.jsonl"))
    if not hits:
        return None
    try:
        with open(hits[0], "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - 512 * 1024))
            tail = fh.read().decode("utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(tail):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("isSidechain"):
            continue
        typ = e.get("type")
        if typ == "system" and e.get("subtype") in ("turn_duration", "stop_hook_summary"):
            return True
        if typ == "assistant":
            return (e.get("message") or {}).get("stop_reason") in ("end_turn", "stop_sequence")
        if typ == "user":
            return False
    return None


def pid_alive(pid: int, proc_start: str) -> bool:
    """Is this pid a running process, and the same one the record was written for? On Linux the
    record's procStart is compared with field 22 of /proc/<pid>/stat (the start time in clock
    ticks since boot), so a reused pid or a record left from an earlier boot reads as dead. Where
    /proc is absent (macOS) only existence is checked, so a reused pid reads as alive: a false
    refusal, the safe direction."""
    stat = PROC / str(pid) / "stat"
    if PROC.is_dir():
        try:
            fields = stat.read_text(encoding="utf-8", errors="replace").rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            return False
        # fields[0] is field 3 (state); field 22 is therefore fields[19].
        return not proc_start or (len(fields) > 19 and fields[19] == str(proc_start))
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_pid_records_checked() -> tuple[list[tuple[Path, object]], bool]:
    """Each pid record under ~/.claude/sessions with what it parses to, in file-name order, and
    whether the source was read IN FULL: False when the directory cannot be listed or any record
    cannot be read or parsed (it could be the one that names a seat). A record that vanishes between
    the listing and the read is not unread: Claude Code removes it when its process ends."""
    records: list[tuple[Path, object]] = []
    try:
        files = sorted(PID_RECORDS.glob("*.json"))
    except OSError:
        return records, False
    complete = True
    for f in files:
        try:
            records.append((f, json.loads(f.read_text(encoding="utf-8"))))
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            complete = False
    return records, complete


def read_pid_records() -> list[tuple[Path, object]]:
    """The pid records that could be read (see read_pid_records_checked); an unreadable one is left out."""
    return read_pid_records_checked()[0]


def live_pid_entries(name: str, records: list[tuple[Path, object]] | None = None) -> list[tuple[int, str, str]]:
    """(pid, session id, description) for each pid record under ~/.claude/sessions that names this
    canonical and whose process is alive. These are Claude Code's own per-process files
    (undocumented, read as the transcripts are: a field missing or renamed finds nothing, which is
    today's behavior without this check). The session id is empty when the record carries none.
    RECORDS, from read_pid_records(), lets a caller asking about every seat read the files once."""
    found: list[tuple[int, str, str]] = []
    for f, d in read_pid_records() if records is None else records:
        if not isinstance(d, dict) or d.get("name") != name or not isinstance(d.get("pid"), int):
            continue
        if pid_alive(d["pid"], str(d.get("procStart") or "")):
            found.append((d["pid"], str(d.get("sessionId") or ""), f"pid {d['pid']} ({f})"))
    return found


def live_pid_records(name: str) -> list[str]:
    """A description of each live process whose pid record names this canonical."""
    return [desc for _pid, _sid, desc in live_pid_entries(name)]


def check_live_process(req: dict, ctx: Pass, path: Path) -> str | None:
    # Measured 2026-11-08: a canonical resumed after the supervisor's idle stop ran, idle, while
    # the sessions list had its job as `done` and left it out of the live listing. Every verb
    # here trusts that listing -- `up` would start a second session under the name, `resume`
    # would respawn a running one, and the working check below passes a session it cannot see --
    # so when the listing has no live row but a live process holds the name, refuse.
    live = ctx.live()
    if live is None or newest_row(live, req["name"]) is not None:
        return None
    holders = live_pid_records(req["name"])
    if not holders:
        return None
    if req["verb"] in STOPPING:
        # A stop or refresh may act on such a process, as the working check does on a listed row,
        # but only when it is provably between turns: every record for the name says `idle` and the
        # session's last turn ended. `fleet-canonicals` then treats the process as the session.
        # The same two signals as a stuck `working` row; anything else waits, so a queued request
        # never ends a turn in progress.
        why = unlisted_idle_signals(req["name"])
        if why is None:
            req["_admitted"] = "no live row in the sessions list; a live process whose pid records say idle and whose last turn ended"
        return why
    return (f"'{req['name']}' has no live row in the sessions list, but a live process holds the "
            f"name: {holders[0]}. The list cannot be trusted for it, so nothing is done; its "
            "operator decides, from a terminal")


def check_snapshot(req: dict, ctx: Pass, path: Path) -> str | None:
    # The session snapshot (see `snapshot` below). Missing: refuse, naming the timer; every machine
    # runs it (2026-11-17), so a missing file means it is off, and the verb run next would refuse
    # anyway. Stale or unreadable: refuse, since it may describe sessions as they no longer are. Fresh: a starting verb for a seat it reads as UNKNOWN is refused, since nothing
    # could tell whether the seat is running.
    if not SNAPSHOT.exists():
        return (f"no session snapshot ({SNAPSHOT}); is fleet-canonicals-snapshot running? "
                "systemctl --user enable --now fleet-canonicals-snapshot.timer "
                "(macOS: the local.dotfiles.fleet-canonicals-snapshot LaunchAgent)")
    try:
        d = json.loads(SNAPSHOT.read_text(encoding="utf-8"))
        taken = int(d["takenAt"])
    except (OSError, ValueError, KeyError, TypeError):
        return f"the session snapshot {SNAPSHOT} is unreadable; is fleet-canonicals-snapshot running?"
    limit = int(os.environ.get("FLEET_SNAPSHOT_MAX_AGE") or as_int(ctx.cfg, "snapshot-max-age"))
    if ctx.t - taken > limit:
        return (f"the session snapshot is {ctx.t - taken}s old (snapshot-max-age {limit}s); "
                "is fleet-canonicals-snapshot running?")
    seat = (d.get("seats") or {}).get(req["name"]) or {}
    if req["verb"] in STARTING and seat.get("state") == "unknown":
        return (f"'{req['name']}' is UNKNOWN in the session snapshot ({seat.get('why') or 'no reason given'}); "
                "not starting a seat whose state cannot be read")
    return None


def unlisted_idle_signals(name: str) -> "str | Wait | None":
    """None when the live process behind a canonical the listing omits is idle between turns; else
    a Wait (a signal says a turn may be running) or a refusal (a signal cannot be read)."""
    entries = live_pid_entries(name)
    statuses = []
    for pid, sid, _desc in entries:
        statuses += pid_record_statuses(name, sid) if sid else [""]
    if not statuses or any(st != "idle" for st in statuses):
        return Wait(f"'{name}' has no live row in the sessions list (its job is done) but a live "
                    f"process holds the name, and its own pid record says "
                    f"'{', '.join(statuses) or 'nothing'}', not idle")
    for pid, sid, _desc in entries:
        ended = transcript_turn_ended(sid)
        if ended is None:
            return (f"'{name}' has a live process (pid {pid}) but its transcript cannot be read, so "
                    "work in flight cannot be ruled out")
        if not ended:
            return Wait(f"'{name}' has a live process (pid {pid}) with no live row; its pid record "
                        "says idle but its transcript's last turn has not ended")
    return None


def pid_record_statuses(name: str, session_id: str) -> list[str]:
    """The `status` of each live pid record for this canonical's session (Claude Code's own
    per-process files, read as live_pid_records reads them)."""
    out = []
    try:
        files = sorted(PID_RECORDS.glob("*.json"))
    except OSError:
        return out
    for f in files:
        try:
            d = json.loads(f.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict) or d.get("name") != name or not isinstance(d.get("pid"), int):
            continue
        if session_id and d.get("sessionId") not in (None, session_id):
            continue
        if pid_alive(d["pid"], str(d.get("procStart") or "")):
            out.append(str(d.get("status") or ""))
    return out


def transcript_start(session_id: str) -> int | None:
    """The epoch of the first timestamped entry of the session's transcript: when its work began,
    which a resume does not rewrite (the handoff gate in fleet-canonicals reads the same)."""
    if not session_id:
        return None
    hits = list(TRANSCRIPTS.glob(f"*/{session_id}.jsonl")) + list(TRANSCRIPTS.glob(f"{session_id}.jsonl"))
    if not hits:
        return None
    try:
        with open(hits[0], encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    ts = json.loads(line).get("timestamp")
                except (ValueError, AttributeError):
                    continue
                if isinstance(ts, str) and ts:
                    try:   # transcript timestamps are UTC, ISO 8601 with a trailing Z
                        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
                    except ValueError:
                        return None
    except OSError:
        return None
    return None


def handoff_set_at(name: str) -> tuple[str, int] | None:
    """The handoff pointer's path and its `# set-at <epoch>` stamp, when both are there."""
    try:
        lines = (STATE / f"{name}.handoff").read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    target = next((ln.strip() for ln in lines if ln.strip() and not ln.startswith("#")), "")
    stamp = next((ln.split()[-1] for ln in lines if ln.startswith("# set-at ")), "")
    if not target or not stamp.isdigit():
        return None
    return target, int(stamp)


JOBS = Path(os.environ.get("FLEET_JOBS_DIR") or HOME / ".claude" / "jobs")


def job_needs(job_id: str) -> str:
    """What the agent view summarizes a session as needing, from ~/.claude/jobs/<id>/state.json (an
    undocumented file; empty when absent). Measured 2026-11-08: a `blocked` row with no waitingFor
    is a session whose last turn ended asking its human something, and `needs` carries the question,
    as `tempo: blocked`; the documentation pairs `blocked` only with a waitingFor."""
    try:
        d = json.loads((JOBS / job_id / "state.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    needs = d.get("needs") if isinstance(d, dict) else None
    return " ".join(str(needs).split())[:160] if needs else ""


ROSTER = Path(os.environ.get("FLEET_DAEMON_ROSTER") or HOME / ".claude" / "daemon" / "roster.json")


def roster_session_ids() -> set[str] | None:
    """The session ids of the daemon's running workers, from ~/.claude/daemon/roster.json (an
    undocumented file: `workers` maps a short id to a record carrying `sessionId`). None when it
    cannot be read: a file that exists but is unreadable or malformed is an error and never counts
    as "no workers". A file that does not exist is also None here, and take_snapshot tells the two
    apart (`absent` against `error`); an absent roster is read as "no daemon has written one"."""
    try:
        d = json.loads(ROSTER.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    workers = d.get("workers") if isinstance(d, dict) else None
    if not isinstance(workers, dict):
        return None
    return {str(w["sessionId"]) for w in workers.values() if isinstance(w, dict) and w.get("sessionId")}


def standard_handoff_stamp(path: str, name: str) -> int | None:
    """The epoch of a standard staged-handoff name for the seat, else None. Standard is exactly
    YYYY-MM-DD-HHMM-<name>-park.md or -checkpoint.md (what `fleet-canonicals stage` writes), the seat
    name literal, so `x-life-canonical` never matches `life-canonical`. The stamp is local time at
    minute precision. Reads names only to refuse, never to pick a pointer (see pointer_path in
    fleet-canonicals); the gate in that file's handoff_gate has the same semantics."""
    m = re.fullmatch(r"(\d{4}-\d{2}-\d{2}-\d{4})-" + re.escape(name) + r"-(?:park|checkpoint)\.md",
                     os.path.basename(path))
    if not m:
        return None
    try:
        return int(time.mktime(time.strptime(m.group(1), "%Y-%m-%d-%H%M")))
    except (ValueError, OverflowError):
        return None


def added_epoch(path: str) -> int | None:
    """The commit time of the commit that ADDED `path` in its git repository, or None when it cannot
    be read that way (not in a repository, not committed, git fails). The date of a document whose
    name carries none; the gate in fleet-canonicals (added_epoch) reads the same. --follow, so a
    document moved with `git mv` is dated by the commit that first added it, not by the move."""
    p = Path(path)
    rc, out = run(["git", "-C", str(p.resolve().parent), "log", "--follow", "--diff-filter=A", "--format=%ct",
                   "-1", "--", p.name])
    out = out.strip()
    return int(out) if rc == 0 and out.isdigit() else None


def handoff_dirs(placed_under: str = "") -> list[Path]:
    """Where a seat's handoff files live: the staging directory, the placed handoffs directory
    (FLEET_HANDOFFS_DIR or the config's `handoffs`) and, when given, `placed_under`."""
    dirs = [STATE / "handoff-staging"]
    configured = os.environ.get("FLEET_HANDOFFS_DIR") or config().get("handoffs") or ""
    for d in (configured, placed_under):
        if d:
            dirs.append(Path(os.path.expanduser(d)))
    seen, out = set(), []
    for d in dirs:
        real = os.path.realpath(d)
        if real not in seen and d.is_dir():
            seen.add(real)
            out.append(d)
    return out


def handoff_since_start(name: str, session_id: str, placed_under: str = "") -> str | None:
    """None when the handoff pointer names an existing file, under `placed_under` when one is given
    (a placed copy, not a staged draft), recorded after the session's work began; else what fails."""
    pointer = handoff_set_at(name)
    if pointer is None:
        return "no handoff pointer with a set-at stamp is recorded"
    target, set_at = pointer
    if not Path(target).is_file():
        return f"the handoff pointer names a missing file ({target})"
    if placed_under:
        root = os.path.realpath(placed_under)
        if os.path.commonpath([root, os.path.realpath(target)]) != root:
            return f"the handoff pointer names {target}, which is not under the placed handoffs ({placed_under})"
    start = transcript_start(session_id)
    if start is None:
        return "the session's transcript gives no start time to compare the handoff against"
    if set_at <= start:
        return "its handoff was recorded before the session started, so it has not parked since"
    # The pointer was recorded after the start; the DOCUMENT it names may still be older, or a newer
    # one may exist. Only standard names are read, and only to refuse.
    start_min = start - start % 60
    target_stamp = standard_handoff_stamp(target, name)
    # A name with no standard stamp is dated by the commit that added the file, never by the
    # pointer's own time (which only says when the pointer was recorded).
    dated, how = target_stamp, "stamped"
    if target_stamp is None:
        dated, how = added_epoch(target), "committed"
        if dated is None:
            return (f"the handoff pointer names a document that cannot be dated ({target}): its name "
                    f"carries no standard stamp and no commit that added it was found (not in a git "
                    f"repository, not committed, or git failed); `fleet-canonicals refresh {name} --force "
                    f"'<why>'` keeps the pointer and skips the comparison")
    if dated < start_min:
        return (f"the handoff pointer names a document {how} "
                f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(dated))}, written before the session "
                f"started ({time.strftime('%Y-%m-%d %H:%M', time.localtime(start_min))}): {target}")
    floor = target_stamp if target_stamp is not None else set_at - set_at % 60
    newest: tuple[int, Path] | None = None
    for d in handoff_dirs(placed_under):
        for f in sorted(d.glob("*.md")):
            stamp = standard_handoff_stamp(f.name, name)
            if (stamp is not None and f.is_file() and f.name != os.path.basename(target)
                    and stamp > floor and (newest is None or stamp > newest[0])):
                newest = (stamp, f)
    if newest is not None:
        return (f"a newer handoff than the recorded one exists ({newest[1]}, stamped "
                f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(newest[0]))}); record it with "
                f"`fleet-canonicals handoff {name} --set {newest[1]}`")
    return None


def stopped_signals(name: str, session_id: str, placed_under: str) -> str | None:
    """None when a `blocked` row with no waitingFor belongs to a session that is provably stopped
    and parked; else which signal fails. Measured 2026-11-08 (keystone, life, then russ): after the
    supervisor's idle stop a session whose last turn asked its human something stays in the live
    listing as `blocked`, with no process behind it, so every verb read it as running. Stopped means
    two independent signals agree: no live pid record holds the name (Claude Code removes a
    session's record when its process ends), and the daemon's roster lists no worker for the
    session. Parked means its handoff pointer names a placed file recorded after the session began.
    A live process fails the first two; a stopped session that never parked fails the third."""
    return process_gone(name, session_id, need_session=False) or handoff_since_start(name, session_id, placed_under)


def process_present(name: str, session_id: str) -> bool:
    """A positive sign that a process runs the canonical: a live pid record holding the name, or a
    daemon roster worker for the session. An unreadable roster is not a sign."""
    if live_pid_records(name):
        return True
    ids = roster_session_ids()
    return bool(session_id and ids and session_id in ids)


def process_gone(name: str, session_id: str, need_session: bool = True) -> str | None:
    """None when no process is behind the canonical's listed session; else what says one may be.
    Two independent signals must agree: no live pid record holds the name (Claude Code removes a
    session's record when its process ends), and the daemon's roster lists no worker for the
    session. An unreadable roster, or (with need_session) a row with no session id to look up in
    it, cannot rule a worker out, so it never reads as gone. Nor does a pid record that cannot be
    read: it could be the one that holds the name."""
    complete = read_pid_records_checked()[1]
    holders = live_pid_records(name)
    if holders:
        return f"a live process still holds the name ({holders[0]})"
    if not complete:
        return f"a pid record under {PID_RECORDS} cannot be read, so a live process cannot be ruled out"
    ids = roster_session_ids()
    if ids is None:
        return f"the daemon roster ({ROSTER}) cannot be read, so a running worker cannot be ruled out"
    if need_session and not session_id:
        return "its listed row carries no session id, so the daemon roster cannot be checked for it"
    if session_id and session_id in ids:
        return "the daemon roster lists a running worker for the session"
    return None


def parked_signals(name: str, session_id: str, placed_under: str = "") -> str | None:
    """None when independent signals say the session parked and is idle; else which one fails.
    For a `blocked` row with no waitingFor (three parked, idle canonicals read so on 2026-11-08,
    matching no documented blocked state). With a live process: its own pid record must say `idle`,
    and its handoff pointer must have been set after its work began. A session stuck on a real
    prompt fails the first; a working session that never parked fails the second. With no live pid
    record at all, the session must be provably stopped and parked (stopped_signals)."""
    statuses = pid_record_statuses(name, session_id)
    if not statuses:
        return stopped_signals(name, session_id, placed_under)
    if any(st != "idle" for st in statuses):
        return f"the session's own pid record says '{', '.join(statuses)}', not idle"
    return handoff_since_start(name, session_id)


def stuck_working_signals(name: str, session_id: str) -> str | None:
    """None when the session's own pid record says it is idle, for a `working` row with no
    waitingFor; else which signal fails. Every live record for the session must say exactly `idle`,
    and there must be one: with none, nothing says the turn is over."""
    statuses = pid_record_statuses(name, session_id)
    if not statuses:
        return "no live pid record says the session is idle"
    if any(st != "idle" for st in statuses):
        return f"the session's own pid record says '{', '.join(statuses)}', not idle"
    return None


def check_working(req: dict, ctx: Pass, path: Path) -> str | None:
    if req["verb"] not in STOPPING + ("resume",):
        return None
    live = ctx.live()
    if live is None:
        return "the sessions list (claude agents --json) could not be read, so work in flight cannot be ruled out"
    row = newest_row(live, req["name"])
    if row is None:
        return None
    if req["verb"] == "resume":
        # Measured 2026-11-08: the idle stop leaves a session listed, often `blocked`, with no
        # process behind it, and refusing every listed row left the director no way to reach it.
        # With no process there is no pending prompt or turn to lose, so a listed row is resumed
        # whatever its state once process_gone proves nothing runs it; a live process is still
        # refused, whatever its row says.
        gone = process_gone(req["name"], str(row.get("sessionId") or ""))
        if gone is None:
            req["_admitted"] = f"listed '{row.get('state') or 'none'}' with no process behind it"
            return None
        return (f"'{req['name']}' is running (id {row.get('id')}, listed "
                f"'{row.get('state') or 'none'}'): {gone}; there is nothing to resume")
    state = str(row.get("state") or "")
    if state not in as_list(ctx.cfg["request-idle-states"]):
        # The agent-view docs pair `blocked` with a waitingFor (a permission prompt, input, a sandbox
        # request, a dialog); a `blocked` with none matches no documented case (measured 2026-11-08 on
        # a parked, idle canonical). It still refuses, since an unknown state is not an idle one, but
        # the reason says so, for whoever reads the result.
        why = f" waiting for {row['waitingFor']}" if row.get("waitingFor") else ""
        parked = None
        if state == "blocked" and not row.get("waitingFor"):
            # Undocumented; accepted as idle only on two independent parked signals (parked_signals),
            # and the transcript's last turn must still have ended (below).
            placed = (os.environ.get("FLEET_HANDOFFS_SEARCH") or ctx.cfg.get("handoffs-search")
                      or ctx.cfg.get("handoffs") or "")
            parked = parked_signals(req["name"], str(row.get("sessionId") or ""), placed)
            needs = job_needs(str(row.get("id") or ""))
            asked = f" (its last turn asked: {needs})" if needs else ""
            why = f" with no waitingFor, so its last turn ended asking its human something{asked}, and " + (parked or "")
        stuck = None
        if state == "working" and not row.get("waitingFor"):
            # Measured 2026-11-08: a turn end sometimes writes no final job state, so the listing
            # keeps saying `working` for a session that is idle (seen for over an hour). Accepted as
            # idle only on two independent signals: its own pid record says `idle` (`shell` means a
            # background shell still runs, `busy` a turn), and, below, the transcript's last turn ended.
            stuck = stuck_working_signals(req["name"], str(row.get("sessionId") or ""))
            why = " with no waitingFor, and " + (stuck or "")
        if not ((state == "blocked" and not row.get("waitingFor") and parked is None)
                or (state == "working" and not row.get("waitingFor") and stuck is None)):
            return Wait(f"'{req['name']}' is working: the sessions list reports state '{state or 'none'}'{why} "
                        f"(not one of request-idle-states: {ctx.cfg['request-idle-states']})")
    ended = transcript_turn_ended(str(row.get("sessionId") or ""))
    if ended is None:
        return f"'{req['name']}''s transcript cannot be read, so work in flight cannot be ruled out"
    if not ended:
        return Wait(f"'{req['name']}' is working: its transcript's last turn has not ended")
    if state == "blocked":
        req["_admitted"] = "listed 'blocked' with no waitingFor, parked since it started; its last turn ended"
    elif state == "working":
        req["_admitted"] = "listed 'working' with no waitingFor (a stuck row); its pid records say idle and its last turn ended"
    else:
        req["_admitted"] = f"listed '{state}'; its last turn ended"
    return None


CHECKS = [
    ("shape", check_shape),
    ("verb", check_verb),
    ("paused", check_paused),
    ("age", check_age),
    ("never-touch", check_never_touch),
    ("declared", check_declared),
    ("requester", check_requester),
    ("self-refresh", check_self_refresh),
    ("one-per-canonical", check_one_per_canonical),
    ("rate", check_rate),
    ("usage", check_usage),
    ("trust", check_trust),
    ("keep-alive", check_keepalive),
    ("snapshot", check_snapshot),
    ("live-process", check_live_process),
    ("working", check_working),
]


# ---- serving ---------------------------------------------------------------------------------

def read_audit() -> list[dict]:
    out = []
    try:
        for line in AUDIT.read_text(encoding="utf-8").splitlines():
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if isinstance(d, dict):
                out.append(d)
    except OSError:
        pass
    return out


def append_audit(entry: dict) -> None:
    with open(AUDIT, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, sort_keys=True) + "\n")


def respawn(name: str, ctx: Pass) -> tuple[str, str]:
    """resume: restart the canonical's newest session from its own transcript with
    `claude respawn`, then confirm it is live again."""
    rows = ctx.every()
    if rows is None:
        return "failed", "the sessions list (claude agents --json --all) could not be read"
    row = newest_row(rows, name)
    if row is None or not row.get("id"):
        return "failed", f"no session is listed for '{name}', so there is nothing to resume; request `up`"
    rid = str(row["id"])
    sid = str(row.get("sessionId") or "")
    # A row the live listing already showed (the process-gone case in check_working) proves
    # nothing by showing again, so its confirmation is a process: a live pid record holding the
    # name, or a roster worker for the session.
    listed = any(r.get("id") == rid or r.get("name") == name for r in (ctx.live() or []))
    rc, out = run(claude_cmd() + ["respawn", rid], timeout=120)
    if rc != 0:
        return "failed", f"claude respawn {rid} exited {rc}\n{out}"
    wait = int(os.environ.get("FLEET_RESPAWN_WAIT", "30"))
    deadline = time.time() + wait
    while True:
        ctx.refresh_listing()
        if listed:
            if process_present(name, sid):
                return "done", f"claude respawn {rid}: a process holds the session again\n{out}"
        elif any(r.get("id") == rid or r.get("name") == name for r in (ctx.live() or [])):
            return "done", f"claude respawn {rid}: live again\n{out}"
        if time.time() >= deadline:
            seen = "no process (pid record or daemon roster worker)" if listed else "no live session"
            return "failed", f"claude respawn {rid} exited 0 but {seen} appeared within {wait}s\n{out}"
        time.sleep(2)


def execute(req: dict, ctx: Pass) -> tuple[str, str]:
    if req["verb"] == "resume":
        return respawn(req["name"], ctx)
    # init is requested to START a never-launched seat, so it runs with --up; `init` alone only
    # records a handoff, which nobody would queue a request for.
    extra = ["--up"] if req["verb"] == "init" else []
    rc, out = run(sibling("fleet-canonicals", "FLEET_CANONICALS_BIN") + [req["verb"]] + extra + [req["name"]],
                  timeout=VERB_TIMEOUT, extra_env={"FLEET_VERB_FROM_RUNNER": "1"})
    ctx.refresh_listing()
    return ("done" if rc == 0 else "failed"), f"fleet-canonicals {req['verb']} {req['name']} exited {rc}\n{out}"


def serve_one(path: Path, ctx: Pass) -> None:
    rid = path.name[: -len(".request.json")]
    req = read_request(path)
    outcome, check, detail = "refused", "", ""
    if req is None:
        check, detail, req = "shape", "malformed: not a JSON object", {}
    else:
        for cname, fn in CHECKS:
            why = fn(req, ctx, path)
            if why:
                check, detail = cname, why
                break
    if isinstance(detail, Wait):
        wait_one(rid, req, check, detail)
        return
    served = QUEUE / f"{rid}.served.json"
    if check:
        os.replace(path, served)
    else:
        claimed = QUEUE / f"{rid}.running.json"
        os.replace(path, claimed)
        outcome, detail = execute(req, ctx)
        os.replace(claimed, served)
    result = {"id": rid, "at": now(), "verb": req.get("verb"), "name": req.get("name"),
              "requester": req.get("requester"), "reason": req.get("reason"),
              "outcome": outcome, "check": check or None}
    if not check and req.get("_admitted"):
        # Which idle path let a stopping verb through, so a served request can be told apart from
        # the stuck-row and unlisted-process cases afterwards; the journal names only the outcome.
        result["admitted"] = req["_admitted"]
    if not check and req.get("_usage_override"):
        # A start the usage threshold would have refused, let through by the override: said in the
        # result and the journal, so the window it ran into is on record.
        result["usage_override"] = req["_usage_override"]
    result["detail" if check else "output"] = detail
    write_atomic(QUEUE / f"{rid}.result.json", result)
    entry = {k: result[k] for k in ("at", "id", "verb", "name", "requester", "outcome", "check")}
    if check:
        entry["detail"] = detail
    if "usage_override" in result:
        entry["usage_override"] = result["usage_override"]
    append_audit(entry)
    ctx.audit.append(entry)
    who = f"{req.get('verb')} {req.get('name')} (from {req.get('requester')})"
    print(f"{outcome:<8} {who}" + (f" -- {check}: {detail}" if check else ""), flush=True)


def wait_one(rid: str, req: dict, check: str, detail: str) -> None:
    """Leave the request queued and say so in its result file, keeping when the wait began."""
    prior = read_request(QUEUE / f"{rid}.result.json") or {}
    since = prior.get("since") if prior.get("outcome") == "waiting" else None
    t = now()
    write_atomic(QUEUE / f"{rid}.result.json",
                 {"id": rid, "at": t, "verb": req.get("verb"), "name": req.get("name"),
                  "requester": req.get("requester"), "reason": req.get("reason"),
                  "outcome": "waiting", "check": check, "detail": str(detail),
                  "since": since or t})
    who = f"{req.get('verb')} {req.get('name')} (from {req.get('requester')})"
    print(f"{'waiting':<8} {who} -- {check}: {detail}; left queued", flush=True)


def prune(t: int) -> None:
    for p in list(QUEUE.glob("*.served.json")) + list(QUEUE.glob("*.result.json")):
        try:
            if t - p.stat().st_mtime > RETAIN_SECONDS:
                p.unlink()
        except OSError:
            pass


def serve_pass() -> None:
    """One pass over the queue. Holds the runner lock for the pass only."""
    if not QUEUE.is_dir():
        return
    with open(QUEUE / ".serve.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("serve-requests: another runner is serving the queue; leaving it to that one")
            return
        ctx = Pass(config())
        for path, _ in ctx.snapshot:
            if path.exists():
                serve_one(path, ctx)
        prune(now())


def cmd_serve(argv: list[str]) -> int:
    usage = "serve-requests: takes no arguments except --loop [--interval SECONDS]"
    loop, interval = False, 60.0
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--loop":
            loop = True
        elif a == "--interval" and args:
            try:
                interval = float(args.pop(0))
            except ValueError:
                die("serve-requests: --interval takes a number of seconds")
            if interval <= 0:
                die("serve-requests: --interval must be positive")
        else:
            die(usage)
    if "--interval" in argv and not loop:
        die("serve-requests: --interval only applies with --loop")
    if not loop:
        serve_pass()
        return 0
    stop: list[int] = []
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda signum, _frame: stop.append(signum))
    while not stop:
        try:
            serve_pass()
        except Exception as exc:  # a failed pass is reported; the next one may succeed
            print(f"serve-requests: pass failed: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
        deadline = time.monotonic() + interval
        while not stop and time.monotonic() < deadline:
            time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))
    return 0


def cmd_live_holders(argv: list[str]) -> int:
    """For `fleet-canonicals`: one `<name><TAB><holder><TAB><pid><TAB><session id>` line per live
    process whose Claude Code pid record names the canonical. Prints nothing where none is found,
    or where the processes cannot be seen (inside a sandbox, other sessions' pids are hidden)."""
    for name in argv:
        for pid, sid, desc in live_pid_entries(name):
            print(f"{name}\t{desc}\t{pid}\t{sid}")
    return 0


# ---- the session-state snapshot ------------------------------------------------------------
#
# WHY A FILE. Inside a sandbox, other sessions' processes are hidden and the sessions list can
# omit a session that is running (measured 2026-11-09 22:51: `status` from a sandbox read a live,
# idle canonical MISSING while its pid record said idle and its process ran). So the state is read
# OUTSIDE every sandbox, by a 15-second timer, and written here for every reader. Each declared seat
# is `live` (any source shows it running), `dead` (every source was read and none shows it), or
# `unknown` (none shows it and a source that could have could not be read). Never "failed": an
# unreadable source is a fact about the reader, not about the session.
SNAPSHOT = Path(os.environ.get("FLEET_SNAPSHOT_FILE") or STATE / "sessions.json")
SNAPSHOT_VERSION = 1


def in_sandbox() -> bool:
    try:
        return (PROC / "1" / "comm").read_text(encoding="utf-8").strip() == "bwrap"
    except OSError:
        return False


def pid_records_readable() -> bool:
    try:
        list(PID_RECORDS.glob("*.json"))
        return PID_RECORDS.is_dir()
    except OSError:
        return False


def decl_pairs(flag: str, key: str) -> list[tuple[str, str]] | None:
    """(project, value) for each line of `fleet-decl --values KEY` or `--values-list KEY`: an empty
    list when no project declares KEY (exit 1), None when the record cannot be read."""
    rc, out = decl(flag, key)
    if rc == 1:
        return []
    if rc != 0:
        return None
    return [(p, v) for p, _tab, v in (line.partition("\t") for line in out.splitlines()) if _tab]


def seat_declarations(host: str) -> tuple[list[str], dict[str, str]] | None:
    """The canonicals the fleet record declares for HOST, in the record's order, and each one's
    declared launch model; None when the record cannot be read or declares no canonical.

    The same test declared_here() makes one seat at a time (a launch directory, and HOST among the
    canonicalMachines, with a name two projects declare left out), made with four reads of the
    whole record. Seat by seat it cost 1 + 2N `fleet-decl` runs and N `hostname` runs per pass,
    each `fleet-decl` several `yq` processes, called twice per snapshot: on a work machine with 29
    seats about 15 s a pass under load, against a 45 s snapshot-max-age (2026-11-12)."""
    canon = decl_pairs("--values", "canonical")
    if not canon:
        return None
    dirs = decl_pairs("--values", "canonicalLaunchDir")
    machines = decl_pairs("--values-list", "canonicalMachines")
    models = decl_pairs("--values", "canonicalLaunchModel")
    if dirs is None or machines is None or models is None:
        return None
    owners: dict[str, int] = {}
    for _p, n in canon:
        owners[n] = owners.get(n, 0) + 1
    with_dir = {p for p, _d in dirs}
    here = {p for p, m in machines if m == host}
    model_of = dict(models)
    seats = [n for p, n in canon if n and owners[n] == 1 and p in with_dir and p in here]
    return seats, {n: model_of.get(p, "") for p, n in canon if n in seats}


# ---- context use ----------------------------------------------------------------------------
# Jeremy, 2026-11-10 06:50: canonicals were running to 70-80% of their context window; he wants it
# watched and seats refreshed proactively above 50%. The figure is the prompt size of the session's
# last main-thread reply, read from its transcript: input_tokens + cache_read_input_tokens +
# cache_creation_input_tokens of that entry's message.usage (the director's hand method, 06:50).
# The window is not in the transcript, which records the bare model id, so it comes from the seat's
# declared launch model: a `[1m]` suffix is 1,000,000 tokens, anything else the config key
# context-window (200,000 by default). The window a plain alias gets depends on the plan, so a
# machine sets context-window to its own: on a plan where plain `opus` has 1M (measured 2026-11-10,
# a seat at 291k with no compaction), the default flags seats falsely.
TRANSCRIPT_TAIL = 4 * 1024 * 1024


def transcript_context(session_id: str) -> tuple[float, int, str] | None:
    """(transcript mtime, context tokens, entry timestamp) at the session's last main-thread
    assistant reply that carries usage, or None when there is none in the transcript's tail."""
    if not session_id:
        return None
    hits = list(TRANSCRIPTS.glob(f"*/{session_id}.jsonl")) + list(TRANSCRIPTS.glob(f"{session_id}.jsonl"))
    try:
        path = max(hits, key=lambda p: p.stat().st_mtime) if hits else None
        if path is None:
            return None
        mtime = path.stat().st_mtime
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - TRANSCRIPT_TAIL))
            tail = fh.read().decode("utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(tail):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("isSidechain") or e.get("type") != "assistant":
            continue
        u = (e.get("message") or {}).get("usage")
        if not isinstance(u, dict):
            continue
        try:
            tokens = sum(int(u.get(k) or 0) for k in
                         ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        except (TypeError, ValueError):
            continue
        if tokens > 0:
            return mtime, tokens, str(e.get("timestamp") or "")
    return None


def context_window(model: str, cfg: dict[str, str]) -> int:
    """MODEL is the seat's declared canonicalLaunchModel, empty when it declares none."""
    if model.strip().lower().endswith("[1m]"):
        return 1_000_000
    return as_int(cfg, "context-window")


def seat_context(model: str, sids: set[str], cfg: dict[str, str]) -> dict | None:
    """The context use of the seat's most recently written transcript among its session ids."""
    found = [(c, sid) for sid in sids if (c := transcript_context(sid))]
    if not found:
        return None
    (_m, tokens, at), sid = max(found, key=lambda f: f[0][0])
    window = context_window(model, cfg)
    if tokens > window:
        # A prompt cannot exceed its window, so the window value is what is wrong. Measured
        # 2026-11-10: a seat launched as plain `opus` reached 291k tokens with no compaction while
        # the 200,000 default applied, and status flagged it CONTEXT-HIGH at 145.7%. No percent is
        # recorded rather than a false one; status names the window as the thing to fix.
        return {"tokens": tokens, "window": window, "percent": None, "overWindow": True,
                "sessionId": sid, "at": at}
    return {"tokens": tokens, "window": window, "percent": round(100 * tokens / window, 1),
            "sessionId": sid, "at": at}


def take_snapshot(host: str, seat_list: list[str], models: dict[str, str]) -> dict:
    """SEAT_LIST and MODELS are seat_declarations(HOST), read once by the caller.

    Roster handling, deliberately: `roster_state` is `ok` (read), `absent` (no file) or `error`
    (exists, unreadable). The roster only ever ADDS evidence that a seat is live. A seat reads
    `dead` only when the sessions list and the pid records (every one of them: a record that cannot
    be parsed leaves the source unread) were both read and show nothing, so an
    `absent` roster does not make a seat unknown (only `error` counts as an unread source). A
    listed seat reads `stopped` only when the roster was read (`ok`); with it absent or in error
    the seat stays `live`. An absent roster is read as "no daemon has written one". The case this
    would get wrong is a sandbox hiding ~/.claude/daemon, which makes a real roster look absent:
    on Linux in_sandbox() detects that and the snapshot refuses to run; on macOS in_sandbox() does
    not detect a sandbox, a known gap."""
    t = now()
    cfg = config()
    live = agents()
    records, complete = read_pid_records_checked()
    # A record that cannot be parsed leaves the source unread (it could name a seat), but the records
    # that were read still count as evidence that a seat runs.
    pids_ok = pid_records_readable() and complete
    roster = roster_session_ids()
    roster_state = "ok" if roster is not None else ("absent" if not ROSTER.exists() else "error")
    seats: dict[str, dict] = {}
    for name in seat_list:
        row = newest_row(live, name) if live is not None else None
        entries = live_pid_entries(name, records)
        sids = {sid for _p, sid, _d in entries if sid}
        if row and row.get("sessionId"):
            sids.add(str(row["sessionId"]))
        in_roster = bool(roster and sids & roster)
        seen = []
        if row:
            seen.append(f"listed ({row.get('state') or 'no state'})")
        seen += [d for _p, _s, d in entries]
        if in_roster:
            seen.append("a daemon roster worker")
        unread = [src for src, ok in (("the sessions list", live is not None),
                                      ("the pid records", pids_ok),
                                      ("the daemon roster", roster_state != "error")) if not ok]
        if row and not entries and not in_roster and pids_ok and roster_state == "ok":
            # Listed, but provably not running: no live pid record holds the name and the daemon
            # roster, read, lists no worker for it. The reading Jeremy approved for a queued down
            # or refresh (2026-11-08); here it only names the state, so `status` stops reporting
            # such a seat as OK and `up` points at `refresh` instead of reading it as running.
            state, why = "stopped", (f"listed ({row.get('state') or 'no state'}), but no live pid "
                                     "record holds the name and the daemon roster lists no worker")
        elif seen:
            state, why = "live", "; ".join(seen)
        elif unread:
            state, why = "unknown", "no readable source: " + " and ".join(unread) + " could not be read"
        else:
            state, why = "dead", "not listed, no live pid record, no roster worker"
        seats[name] = {"state": state, "why": why, "listed": bool(row),
                       "pids": [p for p, _s, _d in entries], "sessionIds": sorted(sids),
                       "context": seat_context(models.get(name, ""), sids, cfg) if state == "live" else None}
    return {"version": SNAPSHOT_VERSION, "takenAt": t, "takenAtIso": stamp(t), "host": host,
            "sources": {"agents": "ok" if live is not None else "error",
                        "pidRecords": "ok" if pids_ok else "error", "roster": roster_state},
            "seats": seats}


def cmd_snapshot(argv: list[str]) -> int:
    """Write $FLEET_STATE/sessions.json once. Refuses inside a sandbox, where the snapshot would
    report hidden processes as dead: the one thing it exists to prevent."""
    if argv:
        die("usage: fleet-canonicals snapshot (no arguments)")
    if in_sandbox():
        die("snapshot: refusing inside a sandbox: other sessions' processes are hidden here, so every "
            "seat the sessions list omits would read as dead. The timer runs it outside "
            "(fleet-canonicals-snapshot.timer, or the LaunchAgent on macOS).")
    host = hostname()
    found = seat_declarations(host)
    if found is None:
        die("snapshot: the fleet record is unreadable (fleet-decl), so no seat can be named; "
            "the previous snapshot is left to age out")
    STATE.mkdir(parents=True, exist_ok=True)
    write_atomic(SNAPSHOT, take_snapshot(host, *found))
    return 0


def main() -> int:
    verbs = ("request", "follow", "serve-requests", "live-holders", "snapshot")
    if len(sys.argv) < 2 or sys.argv[1] not in verbs:
        die("usage: fleet-canonicals-queue request|follow|serve-requests|live-holders|snapshot ... (run it as `fleet-canonicals`)")
    verb, rest = sys.argv[1], sys.argv[2:]
    if verb == "live-holders":
        return cmd_live_holders(rest)
    if verb == "snapshot":
        return cmd_snapshot(rest)
    if verb == "follow":
        return cmd_follow(rest)
    return cmd_request(rest) if verb == "request" else cmd_serve(rest)


if __name__ == "__main__":
    sys.exit(main())
