#!/usr/bin/env bash
# git-clone-worktree — the old name for `fleet-repo clone`; forwards to it.
#
# Usage (unchanged, so every `clone:` line that names it keeps working):
#   git-clone-worktree <url> [target]      -> fleet-repo clone --url <url> [target]
#   git-clone-worktree --mani-project <name>
#                                          -> fleet-repo clone <name>
#   --filter=<spec>, with either form, anywhere on the line: passed through, and overriding any
#       `container.filter` the manifest declares for the project.
#
# WHY A SHIM AND NOT A DELETION. Manifests on other machines name this command in their `clone:`
# lines, and a sync tool runs those lines only when a repository is missing, so a removed command
# would surface weeks later on a fresh clone. Each domain rewrites its lines to
# `fleet-repo clone <name>` (moving any --filter into the entry's `container:` block) and this file
# is removed once no manifest names it.
#
# WHAT IT FORWARDS TO. fleet-repo next to this file (a source tree, an install directory), else on
# PATH, so a checkout's shim and its fleet-repo move together. The layout, the options and the
# exit codes are fleet-repo's; `fleet-repo --help` has the full description.
set -euo pipefail

die() { printf 'git-clone-worktree: %s\n' "$1" >&2; exit 1; }

here=$(cd "$(dirname "$0")" && pwd)
tool=""
for c in "$here/fleet-repo" "$here/executable_fleet-repo"; do
  if [ -x "$c" ]; then tool=$c; break; fi
done
[ -n "$tool" ] || tool=$(command -v fleet-repo 2>/dev/null || true)
[ -n "$tool" ] || die "fleet-repo is not installed; this command forwards to it"

# --filter=<spec> may sit anywhere, so a manifest's clone: line can append it. The ${a+...} form
# keeps an empty list safe under `set -u` in bash 3.2, which is what /usr/bin/env bash finds on a
# stock Mac.
filter=(); rest=()
for a in "$@"; do
  case "$a" in
    --filter=*) filter=("$a") ;;
    *) rest+=("$a") ;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}

# --help prints the header above. Any other leading dash is refused rather than taken as a url:
# that once ran `mkdir -p --help` and printed mkdir's help instead of this tool's.
case "${1:-}" in
  -h|--help) sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
  --mani-project)
    [ -n "${2:-}" ] || die "--mani-project requires a project name"
    [ $# -eq 2 ] || die "usage: git-clone-worktree --mani-project <name> [--filter=<spec>]"
    exec "$tool" clone "$2" ${filter[@]+"${filter[@]}"} ;;
  -*) die "unknown option '$1' (see --help)" ;;
  "") die "usage: git-clone-worktree <url> [target]   |   git-clone-worktree --mani-project <name>" ;;
esac
[ $# -le 2 ] || die "usage: git-clone-worktree <url> [target]"
exec "$tool" clone --url "$@" ${filter[@]+"${filter[@]}"}
