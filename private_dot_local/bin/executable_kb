#!/bin/sh
# kb -- a small, deterministic CLI for a markdown knowledge base (KB).
#
# The KB is a set of markdown records with YAML frontmatter and typed, forward-only
# relationship edges. `kb` makes records correct-by-construction (scaffolding, valid
# frontmatter), enforces the conventions mechanically (fail-loud lint, edge-target
# validation), and generates all derived views (reverse-edge/backlink index) so the
# store is never left to manual vigilance.
#
# The KB root is resolved at runtime (never hardcoded), so one tool serves many KBs
# across machines. See `kb help`.
set -eu
# macOS sets TMPDIR WITH a trailing slash, so a naive "$_TMP/x.XXXXXX" yields a
# path containing "//". Harmless for file I/O and fatal the moment such a path is compared
# textually against one a tool reports back normalized. Strip it once, here.
_TMP=${TMPDIR:-/tmp}; _TMP=${_TMP%/}
export LC_ALL=C   # deterministic, locale-independent sorting and byte-stable output

KB_VERSION=0.3.0

usage() {
  cat <<'EOF'
usage: kb [--kb-root DIR] [--instance NAME] <subcommand> [args]

  help                 show this help
  --version            print the kb version
  new <type> <slug>    scaffold a record with complete, valid frontmatter
  promote <src> --type T --domain D [--tier N] [--sensitivity S] [--slug NAME] [--date D]
                       scaffold a record from an existing memory file (migration)
  lint [path...]        validate records (schema, edges, boundary); fail-loud
  link <A> --EDGE <B>  add a forward edge A->B (EDGE: --related|--depends-on|--supersedes)
  index [--check [--if-present]]
                       regenerate index/ (sources-of-truth + backlinks); derived output.
                       --check reports drift and writes nothing (exit 1 on drift);
                       --if-present downgrades "never generated" to a pass
  project [--out DIR] [--max-sensitivity L] [--check [--if-present]]
                       generate the tier-0 projection
  rename <A> <C>       rename a record + rewrite every inbound edge A->C
  retire <A>           mark a record retired + strip inbound edges
  install-hooks [repo] wire a pre-commit that runs `kb lint` + both derived-output
                       freshness checks (blocks malformed or stale-derived commits)
  debug-root           print the resolved KB root (resolution seam)

Record types: standard | decision | context | research | register

Global options (before the subcommand):
  --kb-root DIR        use DIR as the KB root (highest precedence)
  --instance NAME      select a named instance from the config file

KB-root resolution precedence:
  --kb-root  >  KB_ROOT env  >  ~/.config/kb/config.toml  >  discovery
Discovery walks the current directory upward for a `kb.toml` file or a `.kb/` dir.

Records are created and edited through kb, not by hand-authoring frontmatter.
EOF
}

# kb_config_root CONFIG INSTANCE -- print the `root` for the named instance (or the
# top-level `root` when INSTANCE is empty) from a small TOML config. Prints nothing if
# absent. Format:
#   root = "/default"
#   [instance.personal]
#   root = "/personal"
kb_config_root() {
  _cfg=$1
  _inst=${2:-}
  awk -v want="$_inst" '
    function trim(s){ sub(/^[ \t]+/,"",s); sub(/[ \t]+$/,"",s); return s }
    function unquote(s){ sub(/^"/,"",s); sub(/"$/,"",s); return s }
    /^[ \t]*#/ { next }
    /^[ \t]*\[/ {
      sec=trim($0); sub(/^\[/,"",sec); sub(/\][ \t]*$/,"",sec)
      cur=""
      if (sec ~ /^instance\./) { cur=substr(sec, length("instance.")+1) }
      next
    }
    /^[ \t]*root[ \t]*=/ {
      v=$0; sub(/^[ \t]*root[ \t]*=[ \t]*/,"",v); v=unquote(trim(v))
      if (want=="" && cur=="") { print v; exit }
      if (want!="" && cur==want) { print v; exit }
    }
  ' "$_cfg"
}

# kb_config_path -- print the path to the kb config file (may not exist).
kb_config_path() { printf '%s/kb/config.toml\n' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

# kb_config_domains CONFIG -- print each configured domain slug (one per line) from
# `[domain.<slug>]` sections. Prints nothing if the file has none.
kb_config_domains() {
  awk '
    /^[ \t]*#/ { next }
    /^[ \t]*\[/ {
      sec=$0; sub(/^[ \t]*\[/,"",sec); sub(/\][ \t]*$/,"",sec)
      if (sec ~ /^domain\./) print substr(sec, length("domain.")+1)
    }
  ' "$1"
}

# kb_config_domain_repo CONFIG SLUG -- print the `repo` path for `[domain.<slug>]`
# (empty if absent).
kb_config_domain_repo() {
  awk -v want="$2" '
    function trim(s){ sub(/^[ \t]+/,"",s); sub(/[ \t]+$/,"",s); return s }
    function unquote(s){ sub(/^"/,"",s); sub(/"$/,"",s); return s }
    /^[ \t]*#/ { next }
    /^[ \t]*\[/ {
      sec=$0; sub(/^[ \t]*\[/,"",sec); sub(/\][ \t]*$/,"",sec)
      cur=""
      if (sec ~ /^domain\./) cur=substr(sec, length("domain.")+1)
      next
    }
    /^[ \t]*repo[ \t]*=/ {
      v=$0; sub(/^[ \t]*repo[ \t]*=[ \t]*/,"",v); v=unquote(trim(v))
      if (cur==want) { print v; exit }
    }
  ' "$1"
}

# kb_valid_domains -- print the space-joined set of valid domain values: `universal`
# plus every configured `[domain.*]` slug. `universal` is always valid, config or not.
kb_valid_domains() {
  _cfg=$(kb_config_path)
  _vd=universal
  if [ -f "$_cfg" ]; then
    _cd=$(kb_config_domains "$_cfg" | tr '\n' ' ')
    [ -n "$_cd" ] && _vd="universal $_cd"
  fi
  printf '%s' "$_vd"
}

# kb_resolve_root -- print the resolved KB root per the precedence above; error non-zero
# if none resolves. Reads globals: kb_root_flag, kb_instance.
kb_resolve_root() {
  if [ -n "${kb_root_flag:-}" ]; then printf '%s\n' "$kb_root_flag"; return 0; fi
  if [ -n "${KB_ROOT:-}" ]; then printf '%s\n' "$KB_ROOT"; return 0; fi

  _cfg="${XDG_CONFIG_HOME:-$HOME/.config}/kb/config.toml"
  if [ -f "$_cfg" ]; then
    _root=$(kb_config_root "$_cfg" "${kb_instance:-}")
    if [ -n "$_root" ]; then printf '%s\n' "$_root"; return 0; fi
  fi

  _dir=$(pwd)
  while [ -n "$_dir" ]; do
    if [ -f "$_dir/kb.toml" ] || [ -d "$_dir/.kb" ]; then printf '%s\n' "$_dir"; return 0; fi
    [ "$_dir" = "/" ] && break
    _dir=$(dirname "$_dir")
  done

  echo "kb: could not resolve a KB root (set --kb-root, KB_ROOT, ${XDG_CONFIG_HOME:-\$HOME/.config}/kb/config.toml, or run inside a KB with a kb.toml/.kb marker)" >&2
  return 1
}

# kb_zone_for_type TYPE -- print the zone directory for a record type; non-zero if unknown.
kb_zone_for_type() {
  case "$1" in
    standard) printf 'standards\n' ;;
    context)  printf 'context\n' ;;
    register) printf 'registers\n' ;;
    decision) printf 'decisions\n' ;;
    research) printf 'research\n' ;;
    *) return 1 ;;
  esac
}

# kb_default_frontmatter TYPE NAME UPDATED -- emit the built-in record template. Lean,
# lint-clean defaults; the agent fills content, never structure. Edges start empty.
kb_default_frontmatter() {
  cat <<EOF
---
name: $2
description:
type: $1
domain: universal
sensitivity: internal
tier: 2
status: draft
related: []
depends-on: []
supersedes: []
updated: $3
---

EOF
}

# kb_render TYPE NAME UPDATED ROOT -- emit a scaffolded record. A per-instance override
# at <root>/.templates/<type>.md wins (tokens __NAME__/__TYPE__/__UPDATED__ substituted);
# otherwise the built-in template is used.
kb_render() {
  _ovr="$4/.templates/$1.md"
  if [ -f "$_ovr" ]; then
    sed -e "s|__NAME__|$2|g" -e "s|__TYPE__|$1|g" -e "s|__UPDATED__|$3|g" "$_ovr"
  else
    kb_default_frontmatter "$1" "$2" "$3"
  fi
}

# cmd_new -- kb new <type> <slug>
cmd_new() {
  [ $# -eq 2 ] || { echo "usage: kb new <type> <slug>" >&2; exit 2; }
  _type=$1
  _slug=$2
  _zone=$(kb_zone_for_type "$_type") || {
    echo "kb: unknown type: $_type (valid: standard|decision|context|research|register)" >&2
    exit 2
  }
  case "$_slug" in
    ""|-*|*-|*/*|*[!a-z0-9-]*) echo "kb: invalid slug: '$_slug' (kebab-case: a-z 0-9 -, no leading/trailing hyphen)" >&2; exit 2 ;;
  esac
  _root=$(kb_resolve_root) || exit 1
  _dir="$_root/$_zone"
  _file="$_dir/$_slug.md"
  [ -e "$_file" ] && { echo "kb: record already exists: $_file" >&2; exit 1; }
  _date=${KB_DATE:-$(date +%F)}
  mkdir -p "$_dir"
  kb_render "$_type" "$_slug" "$_date" "$_root" > "$_file"
  printf '%s\n' "$_file"
}

# --- frontmatter parsing helpers ---------------------------------------------
# Records begin with a `---` fenced YAML frontmatter block. These helpers read that
# block only (never the body), matching the inline forms kb itself writes.

# kb_fm_get FILE KEY -- print the scalar value of a top-level frontmatter key (empty if
# absent). Matches only a line beginning exactly `KEY:`.
kb_fm_get() {
  awk -v key="$2" '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---" { exit }
    infm && index($0, key ":")==1 {
      v=substr($0, length(key)+2)
      sub(/^[ \t]+/,"",v); sub(/[ \t]+$/,"",v)
      print v; exit
    }
  ' "$1"
}

# kb_fm_has FILE KEY -- exit 0 if the frontmatter contains a line beginning `KEY:`.
kb_fm_has() {
  awk -v key="$2" '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---" { exit }
    infm && index($0, key ":")==1 { found=1; exit }
    END { exit(found?0:1) }
  ' "$1"
}

# kb_fm_list FILE KEY -- print the items of an inline `[a, b, c]` list, one per line
# (nothing for an empty list, a missing key, or a non-list scalar).
kb_fm_list() {
  _v=$(kb_fm_get "$1" "$2")
  case "$_v" in
    \[*\])
      _inner=${_v#\[}
      _inner=${_inner%\]}
      # [[:blank:]] rather than [ \t]: inside a BRACKET EXPRESSION, BSD/macOS sed does not
      # interpret \t as a tab -- it reads the set as {space, backslash, t}. So the trailing
      # trim stripped a literal 't', and an edge target named e.g. `ghost` silently became
      # `ghos` on darwin. Silently WRONG, not an error, and it reached lint messages,
      # backlinks generation and rename alike. Caught 2026-08-29, the first time this suite
      # was ever run on the Mac. POSIX classes mean the same thing on both userlands.
      printf '%s' "$_inner" | tr ',' '\n' | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//' | grep -v '^$' || true
      ;;
    *) : ;;
  esac
}

# kb_body FILE -- print the record body (everything after the frontmatter block).
kb_body() {
  awk '
    NR==1 && $0=="---" { infm=1; next }
    infm && $0=="---" { infm=0; body=1; next }
    body { print }
  ' "$1"
}

# The body with CODE removed -- fenced blocks and inline code spans. The no-wikilinks-in-prose
# rule is about PROSE: a `[[` inside code is a regex, a shell glob, or a doubled test bracket,
# none of which is a relationship claim and none of which belongs in frontmatter edges. Checking
# the raw body rejected a Tier-0 commit whose only offence was quoting a character class while
# DESCRIBING the wikilink convention -- i.e. the rule fired on documentation OF itself, which is
# the one place the construct has to be writable.
kb_prose() {
  kb_body "$1" | awk '
    /^[[:space:]]*```/ { infence = !infence; next }
    !infence
  ' | sed 's/`[^`]*`//g'
}

# Record zones (a record's type maps to one of these dirs; see kb_zone_for_type). Records
# only ever live in a zone, so anything else under the root (README, generated index/,
# .templates/, kb.toml) is not a record.
KB_ZONES='standards decisions context research registers'

# kb_find_records ROOT -- list plaintext record files in ROOT's record zones. Non-record
# markdown at the KB root and the generated/template dirs are excluded by construction;
# encrypted ciphertext (*.md.age) is opaque to lint and skipped by the *.md filter.
kb_find_records() {
  for _z in $KB_ZONES; do
    if [ -d "$1/$_z" ]; then find "$1/$_z" -type f -name '*.md' 2>/dev/null || true; fi
  done
  return 0
}

KB_ENUM_TYPE='standard decision context research register'
KB_ENUM_SENS='public internal private restricted'
KB_ENUM_TIER='0 1 2'
KB_ENUM_STATUS='active draft retired'

# kb_in_set VALUE SET -- exit 0 if VALUE is a whitespace-separated word in SET.
kb_in_set() {
  for _w in $2; do [ "$1" = "$_w" ] && return 0; done
  return 1
}

# kb_lint_file FILE NAMES_UNIQ VALID_DOMAINS -- validate one record against the schema;
# print `FILE: reason` per violation on stderr; return non-zero if any. VALID_DOMAINS is
# the space-joined set of acceptable `domain` values (universal + configured slugs).
kb_lint_file() {
  _f=$1
  _namesu=$2
  _validdomains=$3
  _frc=0

  for _k in name description type domain sensitivity tier status updated; do
    kb_fm_has "$_f" "$_k" || { echo "$_f: missing required field '$_k'" >&2; _frc=1; }
  done

  # name is the stable id (filename == name) and must be a kebab-case slug — reject anything
  # else (incl. embedded whitespace, which would also break downstream tooling).
  _name=$(kb_fm_get "$_f" name)
  case "$_name" in
    ""|-*|*-|*[!a-z0-9-]*) echo "$_f: invalid name '$_name' (must be a kebab-case slug: a-z 0-9 -)" >&2; _frc=1 ;;
  esac

  _t=$(kb_fm_get "$_f" type)
  [ -z "$_t" ] || kb_in_set "$_t" "$KB_ENUM_TYPE" || { echo "$_f: invalid type '$_t'" >&2; _frc=1; }
  _dm=$(kb_fm_get "$_f" domain)
  [ -z "$_dm" ] || kb_in_set "$_dm" "$_validdomains" || { echo "$_f: invalid domain '$_dm' (must be 'universal' or a configured [domain.*] slug)" >&2; _frc=1; }
  _s=$(kb_fm_get "$_f" sensitivity)
  [ -z "$_s" ] || kb_in_set "$_s" "$KB_ENUM_SENS" || { echo "$_f: invalid sensitivity '$_s'" >&2; _frc=1; }
  _ti=$(kb_fm_get "$_f" tier)
  [ -z "$_ti" ] || kb_in_set "$_ti" "$KB_ENUM_TIER" || { echo "$_f: invalid tier '$_ti'" >&2; _frc=1; }
  _st=$(kb_fm_get "$_f" status)
  [ -z "$_st" ] || kb_in_set "$_st" "$KB_ENUM_STATUS" || { echo "$_f: invalid status '$_st'" >&2; _frc=1; }

  # `### Provenance` must be the record's LAST section, because `kb project` renders a tier-0
  # body by replacing that section -- through to end of file -- with a pointer. A section added
  # after it would therefore vanish from the always-on projection while remaining present and
  # correct in the source, i.e. it would fail silently in the direction that hides the problem:
  # the rule would look filed while no session ever loaded it. `####` and deeper are fine, they
  # are subsections OF the provenance.
  if grep -q '^### Provenance' "$_f" 2>/dev/null; then
    _after=$(awk '/^### Provenance/{f=1;next} f && /^#{1,3} /{print}' "$_f" | head -n1)
    [ -z "$_after" ] || { echo "$_f: '### Provenance' must be the last section (found '$_after' after it; it would be dropped from the projection)" >&2; _frc=1; }
  fi

  # restricted records must be encrypted at rest (a `.md.age` ciphertext, which lint never
  # parses); a parsed plaintext record may not declare restricted.
  if [ "$_s" = restricted ]; then
    case "$_f" in *.md.age) ;; *) echo "$_f: restricted record must be encrypted at rest (.md.age)" >&2; _frc=1 ;; esac
  fi

  # every edge target must resolve to an existing record name
  _dang=$(for _et in related depends-on supersedes; do
    kb_fm_list "$_f" "$_et" | while IFS= read -r _item; do
      [ -n "$_item" ] || continue
      grep -qxF "$_item" "$_namesu" || echo "$_et target '$_item'"
    done
  done)
  if [ -n "$_dang" ]; then
    printf '%s\n' "$_dang" | while IFS= read -r _m; do echo "$_f: dangling $_m" >&2; done
    _frc=1
  fi

  # prose must be self-contained: no `[[` wikilinks in the body (code spans/fences exempt --
  # see kb_prose; inside code a `[[` is a regex or a shell test, not a relationship claim)
  if kb_prose "$_f" | grep -q '\[\['; then
    echo "$_f: '[[' wikilink in prose (relationships belong in typed frontmatter edges)" >&2
    _frc=1
  fi

  return $_frc
}

# cmd_lint -- kb lint [path...]
cmd_lint() {
  _root=$(kb_resolve_root) || exit 1
  _validdomains=$(kb_valid_domains)

  _all=$(mktemp "$_TMP/kb.lint.XXXXXX")
  _scope=$(mktemp "$_TMP/kb.lint.XXXXXX")
  _namesu=$(mktemp "$_TMP/kb.lint.XXXXXX")
  _names=$(mktemp "$_TMP/kb.lint.XXXXXX")

  kb_find_records "$_root" > "$_all"

  if [ $# -gt 0 ]; then
    : > "$_scope"
    for _p in "$@"; do
      if [ -d "$_p" ]; then find "$_p" -type f -name '*.md' 2>/dev/null >> "$_scope" || true
      elif [ -f "$_p" ]; then printf '%s\n' "$_p" >> "$_scope"
      fi
    done
  else
    cp "$_all" "$_scope"
  fi

  # name-set (whole root, always) + duplicate detection
  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    _n=$(kb_fm_get "$_f" name)
    [ -n "$_n" ] && printf '%s\n' "$_n"
  done < "$_all" | sort > "$_names"
  sort -u "$_names" > "$_namesu"

  _rc=0
  # duplicate names -> flag each file bearing a duplicated name
  _dups=$(uniq -d "$_names" || true)
  if [ -n "$_dups" ]; then
    printf '%s\n' "$_dups" | while IFS= read -r _dn; do
      [ -n "$_dn" ] || continue
      while IFS= read -r _f; do
        [ -n "$_f" ] || continue
        if [ "$(kb_fm_get "$_f" name)" = "$_dn" ]; then echo "$_f: duplicate name '$_dn'" >&2; fi
      done < "$_all"
    done
    _rc=1
  fi

  while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    kb_lint_file "$_f" "$_namesu" "$_validdomains" || _rc=1
  done < "$_scope"

  rm -f "$_all" "$_scope" "$_namesu" "$_names"
  return $_rc
}

# kb_file_for_name ROOT NAME -- print the file path of the record whose `name` == NAME
# (first match; empty if none).
kb_file_for_name() {
  kb_find_records "$1" | while IFS= read -r _f; do
    if [ "$(kb_fm_get "$_f" name)" = "$2" ]; then printf '%s\n' "$_f"; break; fi
  done
}

# kb_add_edge FILE EDGETYPE TARGET -- add TARGET to FILE's inline EDGETYPE list in the
# frontmatter (idempotent). Creates the key before the closing fence if absent.
kb_add_edge() {
  _tmp="$1.kbtmp.$$"
  awk -v et="$2" -v tgt="$3" '
    NR==1 && $0=="---" { print; infm=1; next }
    infm && $0=="---" {
      if (!seen) print et ": [" tgt "]"
      infm=0; print; next
    }
    infm && index($0, et ":")==1 && !seen {
      seen=1
      val=substr($0, length(et)+2); sub(/^[ \t]+/,"",val); sub(/[ \t]+$/,"",val)
      if (val ~ /^\[.*\]$/) {
        inner=substr(val, 2, length(val)-2); gsub(/^[ \t]+|[ \t]+$/,"",inner)
        if (inner=="") { print et ": [" tgt "]" }
        else {
          n=split(inner, arr, ","); found=0
          for (i=1;i<=n;i++){ g=arr[i]; gsub(/^[ \t]+|[ \t]+$/,"",g); if (g==tgt) found=1 }
          if (found) print $0
          else print et ": [" inner ", " tgt "]"
        }
      } else {
        print et ": [" tgt "]"
      }
      next
    }
    { print }
  ' "$1" > "$_tmp" && mv "$_tmp" "$1"
}

# cmd_link -- kb link <A> --related|--depends-on|--supersedes <B>
cmd_link() {
  [ $# -eq 3 ] || { echo "usage: kb link <A> --related|--depends-on|--supersedes <B>" >&2; exit 2; }
  _a=$1
  case "$2" in
    --related) _et=related ;;
    --depends-on) _et=depends-on ;;
    --supersedes) _et=supersedes ;;
    *) echo "kb: link needs an edge type: --related|--depends-on|--supersedes" >&2; exit 2 ;;
  esac
  _b=$3
  _root=$(kb_resolve_root) || exit 1

  _fa=$(kb_file_for_name "$_root" "$_a")
  [ -n "$_fa" ] || { echo "kb: no record named '$_a'" >&2; exit 1; }
  _fb=$(kb_file_for_name "$_root" "$_b")
  [ -n "$_fb" ] || { echo "kb: edge target '$_b' does not exist" >&2; exit 1; }

  kb_add_edge "$_fa" "$_et" "$_b"
}

# kb_reverse_label EDGETYPE -- the generated reverse-edge name for a forward edge type.
kb_reverse_label() {
  case "$1" in
    depends-on) printf 'depended-on-by\n' ;;
    related)    printf 'related-by\n' ;;
    supersedes) printf 'superseded-by\n' ;;
    *)          printf '%s-by\n' "$1" ;;
  esac
}

# cmd_index -- kb index. Regenerates <root>/index/{sources-of-truth,backlinks}.md.
# cmd_index -- kb index [--check]. Bare: regenerate index/. --check: regenerate to a
# temp dir, diff against the committed files, write nothing, exit 1 naming each drifted
# file.
#
# WHY --check EXISTS. `kb project` had one from the start and `kb index` did not, so the
# projection was gate-able and the index was not. It drifted, exactly as an ungated derived
# output does: between 2026-08-17 and 2026-08-29 no KB commit ran `kb index`, and
# sources-of-truth.md ended up with NO entry for a topic adopted in that window plus four
# superseded descriptions -- while every projection in the window was correct. The fresh
# layer is what hid it: people read the projection, saw it current, and took that as
# evidence the whole derivation had run. Mechanising ONE derived output and leaving a
# sibling to habit is worse than mechanising neither.
cmd_index() {
  _check=""
  _ifpresent=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) _check=1; shift ;;
      --if-present) _ifpresent=1; shift ;;
      *) echo "kb: index: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  [ -z "$_ifpresent" ] || [ -n "$_check" ] || { echo "kb: --if-present is only meaningful with --check" >&2; exit 2; }

  _root=$(kb_resolve_root) || exit 1

  if [ -n "$_check" ]; then
    if [ -n "$_ifpresent" ] \
       && kb_check_absent "$_root/index/sources-of-truth.md" "$_root/index/backlinks.md"; then
      echo "kb: no generated index present — nothing to check (--if-present)" >&2
      return 0
    fi
    _drift=0
    _tmp=$(mktemp -d "$_TMP/kb.index.XXXXXX")
    kb_index_root "$_root" "$_tmp"
    for _n in sources-of-truth.md backlinks.md; do
      cmp -s "$_tmp/$_n" "$_root/index/$_n" 2>/dev/null \
        || { echo "kb: index drift: $_root/index/$_n" >&2; _drift=1; }
    done
    rm -rf "$_tmp"
    [ "$_drift" -eq 0 ] || echo "kb: run \`kb index\` and stage the result" >&2
    return $_drift
  fi

  kb_index_root "$_root"
}

# kb_index_root ROOT [OUTDIR] -- (re)generate the derived index for ROOT. All views are
# DERIVED and disposable; the forward edges in records are the source of truth.
#
# OUTDIR defaults to ROOT/index. It is a parameter only so `kb index --check` can render
# the same bytes somewhere harmless and diff them, rather than duplicating the renderer --
# a second copy of the renderer would let the checker and the generator disagree, which is
# the one failure a freshness gate must not have.
kb_index_root() {
  _root=$1
  if [ $# -ge 2 ] && [ -n "$2" ]; then _idx=$2; else _idx="$_root/index"; fi
  mkdir -p "$_idx"

  # collect forward edges as: <target>\t<edgetype>\t<source>
  _edges="$_idx/.kb-edges.$$"
  kb_find_records "$_root" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    _n=$(kb_fm_get "$_f" name)
    [ -n "$_n" ] || continue
    for _et in depends-on related supersedes; do
      kb_fm_list "$_f" "$_et" | while IFS= read -r _tgt; do
        [ -n "$_tgt" ] && printf '%s\t%s\t%s\n' "$_tgt" "$_et" "$_n"
      done
    done
  done | sort -u > "$_edges"

  # sources-of-truth: one line per record, "name — relpath[ — description]", sorted by name
  {
    printf '# Sources of truth\n\n'
    printf 'Generated by `kb index` — do not edit by hand.\n\n'
    kb_find_records "$_root" | while IFS= read -r _f; do
      [ -n "$_f" ] || continue
      _n=$(kb_fm_get "$_f" name)
      [ -n "$_n" ] || continue
      _desc=$(kb_fm_get "$_f" description | tr '\t' ' ')
      _rel=${_f#"$_root"/}
      printf '%s\t%s\t%s\n' "$_n" "$_rel" "$_desc"
    done | sort | awk -F'\t' '{ line=$1 " — " $2; if ($3 != "") line=line " — " $3; print line }'
  } > "$_idx/sources-of-truth.md"

  # backlinks: group edges by target, emit each reverse-edge type with its sorted sources
  {
    printf '# Backlinks\n\n'
    printf 'Generated by `kb index` — do not edit by hand. Reverse views of the forward edges.\n\n'
    cut -f1 "$_edges" | sort -u | while IFS= read -r _tgt; do
      [ -n "$_tgt" ] || continue
      printf '## %s\n' "$_tgt"
      for _et in depends-on related supersedes; do
        _lbl=$(kb_reverse_label "$_et")
        _srcs=$(awk -F'\t' -v t="$_tgt" -v e="$_et" '$1==t && $2==e {print $3}' "$_edges" | sort -u | paste -sd, - | sed 's/,/, /g')
        [ -n "$_srcs" ] && printf '%s: %s\n' "$_lbl" "$_srcs"
      done
      printf '\n'
    done
  } > "$_idx/backlinks.md"

  rm -f "$_edges"
}

# kb_set_field FILE KEY VALUE -- replace the scalar value of a frontmatter KEY in place
# (first occurrence only; no-op if the key is absent).
kb_set_field() {
  _tmp="$1.kbtmp.$$"
  awk -v key="$2" -v val="$3" '
    NR==1 && $0=="---" { print; infm=1; next }
    infm && $0=="---" { infm=0; print; next }
    infm && index($0, key ":")==1 && !done { print key ": " val; done=1; next }
    { print }
  ' "$1" > "$_tmp" && mv "$_tmp" "$1"
}

# kb_edge_rewrite FILE OLD NEW -- in each inline edge list of FILE's frontmatter, replace
# list-item OLD with NEW; an empty NEW removes OLD. Body is untouched.
kb_edge_rewrite() {
  _tmp="$1.kbtmp.$$"
  awk -v old="$2" -v new="$3" '
    function emit(key, val,   inner,n,arr,i,g,out,cnt) {
      inner=substr(val, 2, length(val)-2)
      n=split(inner, arr, ","); cnt=0; out=""
      for (i=1;i<=n;i++) {
        g=arr[i]; gsub(/^[ \t]+|[ \t]+$/,"",g)
        if (g=="") continue
        if (g==old) { if (new=="") continue; else g=new }
        out=(cnt==0 ? g : out ", " g); cnt++
      }
      return key ": [" out "]"
    }
    NR==1 && $0=="---" { print; infm=1; next }
    infm && $0=="---" { infm=0; print; next }
    infm && $0 ~ /^(related|depends-on|supersedes):/ {
      key=$0; sub(/:.*/,"",key)
      val=substr($0, length(key)+2); sub(/^[ \t]+/,"",val); sub(/[ \t]+$/,"",val)
      if (val ~ /^\[.*\]$/) { print emit(key, val); next }
      print; next
    }
    { print }
  ' "$1" > "$_tmp" && mv "$_tmp" "$1"
}

# kb_has_inbound FILE NAME -- exit 0 if any of FILE's edge lists contains NAME.
kb_has_inbound() {
  for _et in related depends-on supersedes; do
    kb_fm_list "$1" "$_et" | grep -qxF "$2" && return 0
  done
  return 1
}

# cmd_rename -- kb rename <A> <C>: rename the record + name, rewrite every inbound edge.
cmd_rename() {
  [ $# -eq 2 ] || { echo "usage: kb rename <old-slug> <new-slug>" >&2; exit 2; }
  _a=$1
  _c=$2
  case "$_c" in
    ""|-*|*-|*/*|*[!a-z0-9-]*) echo "kb: invalid new slug: '$_c' (kebab-case, no leading/trailing hyphen)" >&2; exit 2 ;;
  esac
  _root=$(kb_resolve_root) || exit 1

  _fa=$(kb_file_for_name "$_root" "$_a")
  [ -n "$_fa" ] || { echo "kb: no record named '$_a'" >&2; exit 1; }
  _fc=$(kb_file_for_name "$_root" "$_c")
  [ -n "$_fc" ] && { echo "kb: a record named '$_c' already exists: $_fc" >&2; exit 1; }

  _dir=$(dirname "$_fa")
  _base=$(basename "$_fa")
  case "$_base" in "$_a".*) _suffix=${_base#"$_a"} ;; *) _suffix=".md" ;; esac
  _new="$_dir/$_c$_suffix"

  kb_set_field "$_fa" name "$_c"
  mv "$_fa" "$_new"

  kb_find_records "$_root" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    [ "$_f" = "$_new" ] && continue
    if grep -qw -- "$_a" "$_f"; then kb_edge_rewrite "$_f" "$_a" "$_c"; fi
  done

  kb_index_root "$_root"
}

# cmd_retire -- kb retire <A>: mark retired, strip inbound edges, report affected files.
cmd_retire() {
  [ $# -eq 1 ] || { echo "usage: kb retire <slug>" >&2; exit 2; }
  _a=$1
  _root=$(kb_resolve_root) || exit 1

  _fa=$(kb_file_for_name "$_root" "$_a")
  [ -n "$_fa" ] || { echo "kb: no record named '$_a'" >&2; exit 1; }

  kb_set_field "$_fa" status retired

  kb_find_records "$_root" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    [ "$_f" = "$_fa" ] && continue
    if kb_has_inbound "$_f" "$_a"; then
      kb_edge_rewrite "$_f" "$_a" ""
      echo "kb: removed inbound edge to '$_a' from $_f" >&2
    fi
  done

  kb_index_root "$_root"
}

# cmd_install_hooks -- kb install-hooks [repo]: wire a pre-commit that runs `kb lint`.
# Installs into the repo's OWN hooks dir (resolved via --git-common-dir so it is
# worktree-correct and ignores any global core.hooksPath). It never touches
# core.hooksPath, so a global hooks router (e.g. a leak-guard) still runs and simply
# chains to this hook. Refuses to clobber a foreign (non-kb) pre-commit.
cmd_install_hooks() {
  if [ $# -ge 1 ]; then _repo=$1; else _repo=$(pwd); fi

  # Resolve the KB root now and embed it in the hook, so the hook lints the actual KB
  # (which may be nested below the git top level) rather than depending on the hook's cwd.
  _kbroot=$(kb_resolve_root) \
    || { echo "kb: cannot resolve a KB root to lint; run from inside the KB or set --kb-root/KB_ROOT/config" >&2; exit 1; }
  case "$_kbroot" in /*) ;; *) _kbroot="$(pwd)/$_kbroot" ;; esac

  _common=$(git -C "$_repo" rev-parse --git-common-dir 2>/dev/null) \
    || { echo "kb: not a git repository: $_repo" >&2; exit 1; }
  case "$_common" in /*) ;; *) _common="$_repo/$_common" ;; esac
  _hookdir="$_common/hooks"
  mkdir -p "$_hookdir"
  _hook="$_hookdir/pre-commit"

  if [ -e "$_hook" ] && ! grep -qF 'kb-precommit (generated)' "$_hook" 2>/dev/null; then
    echo "kb: refusing to overwrite an existing non-kb pre-commit hook: $_hook" >&2
    echo "kb: integrate 'kb lint' into it manually, or remove it and re-run." >&2
    exit 1
  fi

  # Unquoted heredoc so the resolved root is embedded; backticks escaped.
  cat > "$_hook" <<HOOK
#!/bin/sh
# kb-precommit (generated) — block a commit if the KB fails validation OR if either
# derived output is stale.
# Composes with any global hooks router: a global core.hooksPath hook runs its own
# checks and then chains to this repo hook. Standalone, git runs this directly.
# \`kb\` is expected on PATH (it installs to ~/.local/bin).
#
# THREE checks, not one. \`lint\` validates the records themselves. The other two assert
# that the DERIVED outputs match those records: a KB edit that regenerates one derived
# output and not the other leaves a stale layer that nothing else will notice, because the
# fresh layer is the one people read. Both are pure comparisons — they write nothing.
#
# \`--if-present\` because this hook is GENERIC: a KB that has deliberately published no
# derived outputs yet must still be able to commit. A repo that always publishes both
# should gate with the strict form (drop \`--if-present\`), which additionally catches a
# deleted output.
#
# Scope: the Tier-0 universal projection at the default sensitivity ceiling. A KB that
# also emits per-domain projections (\`kb project --domain\`) is not covered here; add
# those explicitly if the repo emits them.
set -e
kb --kb-root "$_kbroot" lint
kb --kb-root "$_kbroot" project --check --if-present
kb --kb-root "$_kbroot" index --check --if-present
HOOK
  chmod +x "$_hook"
  echo "installed kb pre-commit hook -> $_hook"
}

# kb_check_absent FILE... -- true when EVERY named output is absent. Only consulted under
# `--check --if-present`.
#
# WHY --if-present IS OPT-IN RATHER THAN THE DEFAULT. `--check` is STRICT by design: a KB
# with projectable content and no projection is drift, and there is a test asserting exactly
# that. Making absence benign for everyone would have silently overturned that decision --
# it was caught only because the test existed, which is the argument for the test.
#
# But a GENERIC hook cannot be strict. `kb install-hooks` runs in any KB, including a fresh
# one that has deliberately published nothing yet, and a gate that bricks such a repo the
# moment it is wired up gets uninstalled rather than satisfied. So the generated hook asks
# for `--if-present` explicitly, and the strict form remains what a human or a KB-specific
# gate gets by default.
#
# ALL, deliberately, not ANY: a set where some outputs exist and some do not is a
# half-generated set, which is real drift and stays red even under --if-present. The known
# gap is that deleting a published output silences its gate under --if-present -- a
# deliberate act, visible in the commit diff, and the reason a repo that always publishes
# (like a KB whose projection is consumed at every session start) gates with the strict form
# instead.
#
# This lives in kb rather than in each hook on purpose. Duplicating the existence test into
# every consumer is how the checker and its callers drift into disagreeing about what is
# being asserted -- the same failure the shared-renderer design avoids one layer down.
kb_check_absent() {
  for _f in "$@"; do
    [ -e "$_f" ] && return 1
  done
  return 0
}

# kb_sens_rank LEVEL -- numeric rank of a sensitivity tier (higher = more sensitive); an
# unknown value ranks above everything so it is never included by a ceiling.
kb_sens_rank() {
  case "$1" in
    public) printf 0 ;;
    internal) printf 1 ;;
    private) printf 2 ;;
    restricted) printf 3 ;;
    *) printf 99 ;;
  esac
}

# kb_projection_records ROOT MAXRANK TIER DOMAIN -- record files with tier:TIER AND
# status:active AND domain:DOMAIN AND sensitivity rank <= MAXRANK, sorted by name (LC_ALL=C
# makes this byte-stable). Selection is tier AND domain (orthogonal dimensions): the
# universal Tier-0 slice uses TIER=0 DOMAIN=universal; a per-domain slice uses TIER=1 DOMAIN=<slug>. The
# sensitivity ceiling keeps private/restricted content out of the broadly-read projection.
kb_projection_records() {
  _maxrank=$2
  _wanttier=$3
  _wantdomain=$4
  kb_find_records "$1" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    [ "$(kb_fm_get "$_f" tier)" = "$_wanttier" ] || continue
    [ "$(kb_fm_get "$_f" status)" = active ] || continue
    _rd=$(kb_fm_get "$_f" domain); [ -n "$_rd" ] || _rd=universal
    [ "$_rd" = "$_wantdomain" ] || continue
    [ "$(kb_sens_rank "$(kb_fm_get "$_f" sensitivity)")" -le "$_maxrank" ] || continue
    printf '%s\t%s\n' "$(kb_fm_get "$_f" name)" "$_f"
  done | sort | cut -f2-
}

# kb_render_agents ROOT MAXRANK TIER DOMAIN TITLE -- the AGENTS.md content (deterministic; no
# timestamps): a banner, the TITLE, then per included record a `## <name>` section + body.
# kb_body_projected FILE ROOT -- a record body with its historical record replaced by a pointer.
#
# A projection is loaded at EVERY session start and again per subagent, so every byte in it is a
# recurring cost paid forever, so a projection is kept deliberately lean and anything that is not
# needed at runtime becomes a pointer. A topic's trailing `### Provenance` section is history --
# what was decided, when, and
# which incident motivated it. That is genuinely valuable when EDITING the topic, which is why it
# stays in the source record, and near-worthless to a session that merely has to FOLLOW the rule.
# Measured before this was built: 32% of the always-on set was provenance.
#
# The heading is kept and replaced with a pointer rather than dropped silently, so a reader can see
# the history exists and where to find it -- the whole point of the record is that decisions are not
# re-derived, which a session cannot know to avoid if it cannot see that a record exists at all.
#
# Safe because `### Provenance` is the LAST section in every topic (verified across the whole tier-0
# set before this was written, and enforced from here on by `kb lint`).
kb_body_projected() {
  _rel=${1#"$2"/}
  kb_body "$1" | awk -v rel="$_rel" '
    /^### Provenance/ && !skip {
      print "### Provenance"
      print ""
      print "*Omitted here to keep the always-on set lean. Full provenance and amendment history is"
      print "in the source record: `" rel "`.*"
      skip = 1
      next
    }
    !skip { print }
  '
}

kb_render_agents() {
  printf '%s\n\n' '<!-- Generated by `kb project` — do not edit by hand. Regenerate from the KB. -->'
  printf '# %s\n\n' "$5"
  kb_projection_records "$1" "$2" "$3" "$4" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    printf '## %s\n\n' "$(kb_fm_get "$_f" name)"
    kb_body_projected "$_f" "$1"
    printf '\n'
  done
}

# kb_render_claude -- the Claude projection: a thin @AGENTS.md import (Claude Code does not
# read AGENTS.md natively) + a marked, currently-empty Claude-only-additions section.
kb_render_claude() {
  printf '%s\n\n' '<!-- Generated by `kb project` — do not edit by hand. Regenerate from the KB. -->'
  printf '%s\n\n' '@AGENTS.md'
  printf '%s\n' '<!-- Claude-only additions below (managed separately; empty until authored). -->'
}

# cmd_project -- kb project [--out DIR]. Generates the Tier-0 projection artifacts. Output is
# derived/disposable; default --out is a staging dir under the generated index/.
# kb_file_bytes FILE -- size in bytes, on either userland (GNU -c, BSD -f).
kb_file_bytes() { stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null; }

# kb_projection_budget ROOT -- the always-on ceiling in BYTES, from this KB's own kb.toml, or empty.
#
# WHY A BUDGET AT ALL. The Tier-0 projection is loaded into EVERY session at startup, so its size is
# a tax paid per session forever, not a one-off. It only ever grows: every amendment adds and none
# subtracts, and no single addition ever looks like the one that made it expensive. Measured
# 2026-08-29: the projection had reached ~24k tokens, 78% of the entire always-on context, having
# been specified as "bounded/shrinking" and never bounded.
#
# WHY BYTES, NOT TOKENS. Bytes are exact and free to measure; a token count is an estimate that
# varies by tokenizer. A budget that is precise about the wrong unit invites arguing with it.
#
# WHY IN kb.toml AND NOT HERE. This CLI is public; the ceiling is a property of one person's KB. The
# number belongs with the records it governs, which is also what lets separate instances (personal,
# work) carry different ceilings.
#
# THE POINT IS NOT THE NUMBER, IT IS THE FORCED CHOICE. Set at roughly current size, so adding a
# rule means deciding what leaves. Ratchet it DOWN as content moves to on-demand skills; never up
# without a deliberate decision that says why.
kb_projection_budget() {
  [ -f "$1/kb.toml" ] || return 0
  sed -n 's/^[[:space:]]*projection_max_bytes[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1/kb.toml" 2>/dev/null | head -1
}

cmd_project() {
  _outflag=""
  _check=""
  _ifpresent=""
  _domainflag=""
  _maxsens=internal   # default ceiling: include public+internal, exclude private/restricted
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) [ $# -ge 2 ] || { echo "kb: --out needs a value" >&2; exit 2; }; _outflag=$2; shift 2 ;;
      --out=*) _outflag=${1#*=}; [ -n "$_outflag" ] || { echo "kb: --out needs a value" >&2; exit 2; }; shift ;;
      --domain) [ $# -ge 2 ] || { echo "kb: --domain needs a value" >&2; exit 2; }; _domainflag=$2; shift 2 ;;
      --domain=*) _domainflag=${1#*=}; [ -n "$_domainflag" ] || { echo "kb: --domain needs a value" >&2; exit 2; }; shift ;;
      --max-sensitivity) [ $# -ge 2 ] || { echo "kb: --max-sensitivity needs a value" >&2; exit 2; }; _maxsens=$2; shift 2 ;;
      --max-sensitivity=*) _maxsens=${1#*=}; shift ;;
      --check) _check=1; shift ;;
      --if-present) _ifpresent=1; shift ;;
      *) echo "kb: project: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done
  [ -z "$_ifpresent" ] || [ -n "$_check" ] || { echo "kb: --if-present is only meaningful with --check" >&2; exit 2; }
  case "$_maxsens" in
    public|internal|private) ;;
    *) echo "kb: --max-sensitivity must be public|internal|private (restricted is never projected)" >&2; exit 2 ;;
  esac
  _maxrank=$(kb_sens_rank "$_maxsens")

  _root=$(kb_resolve_root) || exit 1

  # Selection = tier AND domain. Bare: Tier-0 universal. --domain <slug>:
  # that domain's Tier-1 slice, output repo resolved from config `[domain.<slug>] repo`.
  if [ -n "$_domainflag" ]; then
    _tier=1
    _domain=$_domainflag
    _title="Domain context: $_domain (Tier 1)"
    if [ -n "$_outflag" ]; then _out=$_outflag
    else
      _cfg=$(kb_config_path)
      _repo=""
      [ -f "$_cfg" ] && _repo=$(kb_config_domain_repo "$_cfg" "$_domain")
      if [ -n "$_repo" ]; then _out=$_repo
      else _out="$_root/index/projections/domains/$_domain"; fi
    fi
  else
    _tier=0
    _domain=universal
    _title="Operating model (Tier 0)"
    if [ -n "$_outflag" ]; then _out=$_outflag; else _out="$_root/index/projections"; fi
  fi

  if [ -n "$_check" ]; then
    if [ -n "$_ifpresent" ] \
       && kb_check_absent "$_out/AGENTS.md" "$_out/GEMINI.md" "$_out/CLAUDE.md"; then
      echo "kb: no generated projection present — nothing to check (--if-present)" >&2
      return 0
    fi
    # regenerate to a temp and compare; never write the real outputs. Exit 1 on any drift.
    _drift=0
    _tmp=$(mktemp "$_TMP/kb.proj.XXXXXX")
    kb_render_agents "$_root" "$_maxrank" "$_tier" "$_domain" "$_title" > "$_tmp"
    cmp -s "$_tmp" "$_out/AGENTS.md" 2>/dev/null || { echo "kb: projection drift: $_out/AGENTS.md" >&2; _drift=1; }
    cmp -s "$_tmp" "$_out/GEMINI.md" 2>/dev/null || { echo "kb: projection drift: $_out/GEMINI.md" >&2; _drift=1; }
    # Budget check runs against the FRESHLY RENDERED projection, before $_tmp is reused below --
    # not against the committed file. Checking the committed one would pass a change that pushes it
    # over, since the committed file is by definition the pre-change size.
    _budget=$(kb_projection_budget "$_root")
    if [ -n "$_budget" ]; then
      _psize=$(kb_file_bytes "$_tmp")
      if [ -n "$_psize" ] && [ "$_psize" -gt "$_budget" ] 2>/dev/null; then
        echo "kb: projection OVER BUDGET: $_psize bytes > $_budget (over by $((_psize - _budget)))" >&2
        echo "kb: this file loads into EVERY session at startup, so its size is a per-session tax." >&2
        echo "kb: adding here means deciding what leaves. Move situational procedure to an on-demand" >&2
        echo "kb: skill and keep a stub, or trim an existing topic -- then re-run \`kb project\`." >&2
        _drift=1
      fi
    fi
    kb_render_claude > "$_tmp"
    cmp -s "$_tmp" "$_out/CLAUDE.md" 2>/dev/null || { echo "kb: projection drift: $_out/CLAUDE.md" >&2; _drift=1; }
    rm -f "$_tmp"
    return $_drift
  fi

  mkdir -p "$_out"
  # write via temp + mv so consumers never see a half-generated set
  kb_render_agents "$_root" "$_maxrank" "$_tier" "$_domain" "$_title" > "$_out/AGENTS.md.kbtmp.$$" && mv "$_out/AGENTS.md.kbtmp.$$" "$_out/AGENTS.md"
  kb_render_claude                                                    > "$_out/CLAUDE.md.kbtmp.$$" && mv "$_out/CLAUDE.md.kbtmp.$$" "$_out/CLAUDE.md"
  kb_render_agents "$_root" "$_maxrank" "$_tier" "$_domain" "$_title" > "$_out/GEMINI.md.kbtmp.$$" && mv "$_out/GEMINI.md.kbtmp.$$" "$_out/GEMINI.md"
  _budget=$(kb_projection_budget "$_root")
  if [ -n "$_budget" ]; then
    _psize=$(kb_file_bytes "$_out/AGENTS.md")
    printf 'kb: projection %s / %s bytes (%s%% of budget)\n' \
      "$_psize" "$_budget" "$(( _psize * 100 / _budget ))" >&2
  fi
  printf '%s\n' "$_out"
}

# cmd_promote -- kb promote <src> --type T --domain D [--tier N] [--sensitivity S]
#   [--slug NAME] [--date YYYY-MM-DD]. Scaffold a valid KB record from an existing memory
# file: name from --slug > src `name:` > filename; description + body carried over (body
# minus its frontmatter block; `[[wikilinks]]` kept verbatim for later edge conversion);
# domain/tier/sensitivity from flags/defaults; status active; updated from --date/KB_DATE.
# Runs `kb lint` on the result only as an ADVISORY: body wikilinks / dangling edges are an
# expected transient during migration (resolved by edge conversion), so a lint finding does
# NOT fail promote — the batch-end `kb lint` is the real backstop.
cmd_promote() {
  [ $# -ge 1 ] || { echo "usage: kb promote <src> --type T --domain D [--tier N] [--sensitivity S] [--slug NAME] [--date YYYY-MM-DD]" >&2; exit 2; }
  _src=$1; shift
  _ptype=""; _pdomain=""; _ptier=2; _psens=internal; _pslug=""; _pdate=${KB_DATE:-$(date +%F)}
  while [ $# -gt 0 ]; do
    case "$1" in
      --type) [ $# -ge 2 ] || { echo "kb: --type needs a value" >&2; exit 2; }; _ptype=$2; shift 2 ;;
      --type=*) _ptype=${1#*=}; shift ;;
      --domain) [ $# -ge 2 ] || { echo "kb: --domain needs a value" >&2; exit 2; }; _pdomain=$2; shift 2 ;;
      --domain=*) _pdomain=${1#*=}; shift ;;
      --tier) [ $# -ge 2 ] || { echo "kb: --tier needs a value" >&2; exit 2; }; _ptier=$2; shift 2 ;;
      --tier=*) _ptier=${1#*=}; shift ;;
      --sensitivity) [ $# -ge 2 ] || { echo "kb: --sensitivity needs a value" >&2; exit 2; }; _psens=$2; shift 2 ;;
      --sensitivity=*) _psens=${1#*=}; shift ;;
      --slug) [ $# -ge 2 ] || { echo "kb: --slug needs a value" >&2; exit 2; }; _pslug=$2; shift 2 ;;
      --slug=*) _pslug=${1#*=}; shift ;;
      --date) [ $# -ge 2 ] || { echo "kb: --date needs a value" >&2; exit 2; }; _pdate=$2; shift 2 ;;
      --date=*) _pdate=${1#*=}; shift ;;
      *) echo "kb: promote: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done

  [ -f "$_src" ] || { echo "kb: source file not found: $_src" >&2; exit 1; }
  [ -n "$_ptype" ] || { echo "kb: promote requires --type" >&2; exit 2; }
  [ -n "$_pdomain" ] || { echo "kb: promote requires --domain" >&2; exit 2; }
  _zone=$(kb_zone_for_type "$_ptype") \
    || { echo "kb: unknown type: $_ptype (valid: standard|decision|context|research|register)" >&2; exit 2; }

  # domain must be universal or a configured slug; guard tier/sensitivity so we never
  # scaffold a structurally-invalid record.
  kb_in_set "$_pdomain" "$(kb_valid_domains)" \
    || { echo "kb: unknown domain '$_pdomain' (must be 'universal' or a configured [domain.*] slug)" >&2; exit 2; }
  kb_in_set "$_ptier" "$KB_ENUM_TIER" || { echo "kb: invalid tier '$_ptier' (0|1|2)" >&2; exit 2; }
  kb_in_set "$_psens" "$KB_ENUM_SENS" || { echo "kb: invalid sensitivity '$_psens'" >&2; exit 2; }

  # slug: --slug > src name: > filename (sans .md)
  _name=$_pslug
  [ -n "$_name" ] || _name=$(kb_fm_get "$_src" name)
  if [ -z "$_name" ]; then _base=$(basename "$_src"); _name=${_base%.md}; fi
  case "$_name" in
    ""|-*|*-|*/*|*[!a-z0-9-]*) echo "kb: invalid slug: '$_name' (kebab-case: a-z 0-9 -, no leading/trailing hyphen)" >&2; exit 2 ;;
  esac

  _desc=$(kb_fm_get "$_src" description)

  _root=$(kb_resolve_root) || exit 1
  _dir="$_root/$_zone"
  _file="$_dir/$_name.md"
  [ -e "$_file" ] && { echo "kb: record already exists: $_file" >&2; exit 1; }
  mkdir -p "$_dir"

  # frontmatter from flags/defaults + carried description; body verbatim from src (minus fm)
  {
    printf '%s\n' '---'
    printf 'name: %s\n' "$_name"
    printf 'description: %s\n' "$_desc"
    printf 'type: %s\n' "$_ptype"
    printf 'domain: %s\n' "$_pdomain"
    printf 'sensitivity: %s\n' "$_psens"
    printf 'tier: %s\n' "$_ptier"
    printf 'status: active\n'
    printf 'related: []\n'
    printf 'depends-on: []\n'
    printf 'supersedes: []\n'
    printf 'updated: %s\n' "$_pdate"
    printf '%s\n' '---'
    kb_body "$_src"
  } > "$_file"

  printf '%s\n' "$_file"

  if ! cmd_lint "$_file" >/dev/null 2>&1; then
    echo "kb: note: '$_name' has lint findings (expected during migration if the body has [[wikilinks]] or unresolved edges); rerun 'kb lint' after edge conversion." >&2
  fi
}

main() {
  kb_root_flag=""
  kb_instance=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kb-root) [ $# -ge 2 ] || { echo "kb: --kb-root needs a value" >&2; exit 2; }; kb_root_flag=$2; shift 2 ;;
      --kb-root=*) kb_root_flag=${1#*=}; shift ;;
      --instance) [ $# -ge 2 ] || { echo "kb: --instance needs a value" >&2; exit 2; }; kb_instance=$2; shift 2 ;;
      --instance=*) kb_instance=${1#*=}; shift ;;
      --) shift; break ;;
      *) break ;;
    esac
  done

  [ $# -ge 1 ] || { usage >&2; exit 2; }
  cmd=$1
  shift
  case "$cmd" in
    help|-h|--help) usage ;;
    --version|-V) printf '%s\n' "$KB_VERSION" ;;
    new) cmd_new "$@" ;;
    promote) cmd_promote "$@" ;;
    lint) cmd_lint "$@" ;;
    link) cmd_link "$@" ;;
    index) cmd_index "$@" ;;
    project) cmd_project "$@" ;;
    rename) cmd_rename "$@" ;;
    retire) cmd_retire "$@" ;;
    install-hooks) cmd_install_hooks "$@" ;;
    debug-root) kb_resolve_root ;;
    *)
      printf 'kb: unknown subcommand: %s\n' "$cmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
