#!/bin/sh
# git-staged-run -- run a command against what is STAGED: the unstaged edits to tracked files are
# set aside for the command's run and put back afterwards, whatever its result.
#
#   git-staged-run <command> [args...]
#
#   exit  the command's own status; 1 if the edits could not be put back (both patches are kept
#         and named); 1 if they could not be set aside, in which case the command did not run.
#
# WHY. A commit gate reads files from disk, but a commit is made from the index. Whenever a staged
# file has further edits on disk, the gate judges the wrong version, and passes or refuses a commit
# on code it does not contain. Measured 2026-10-12 in a fleet repository: `git mv` staged a register
# entry's old content into `closed/`, the closing edits stayed on disk, and the register lint passed
# the finished file while the commit carried the entry still `active`. Every commit gate the fleet
# runs goes through this one helper: run-repo-gates for a repository's tracked .githooks/, and the
# gate install-test-gate writes for a chezmoi source.
#
# HOW, as the pre-commit framework does: the unstaged edits are saved as a binary patch, reversed off
# the working tree, and applied again after the command. Untracked files are not touched, so a
# command that reads one still sees it. During a merge the command runs on the working tree as it
# is, because a half-resolved merge is no state to patch.
#
# If the patch will not go back (the command rewrote a file the edits also touch), the command's
# rewrite is saved to a second patch and reversed off, then the edits are applied. Everything here
# writes the working tree only, never the index: inside a commit, git holds the index lock. If even that fails,
# both patch files are KEPT and named: nothing is discarded without a copy. `git apply --3way` is not
# used: it also writes the index, which would put the unstaged edits into the commit being made.
#
# Run from inside the repository's work tree (any directory in it).
set -u
[ $# -ge 1 ] || { printf 'usage: git-staged-run <command> [args...]\n' >&2; exit 2; }
case "$1" in -h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;; esac

top=$(git rev-parse --show-toplevel 2>/dev/null) || { "$@"; exit $?; }
if [ -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then "$@"; exit $?; fi
cd "$top" || exit 1

patch=$(mktemp "${TMPDIR:-/tmp}/git-staged-run-unstaged.XXXXXX") || {
  printf 'git-staged-run: no temp file for the unstaged edits; not run -- refusing.\n' >&2; exit 1; }
if ! git diff --binary --no-color --no-ext-diff --ignore-submodules >"$patch"; then
  rm -f "$patch"
  printf 'git-staged-run: could not read the unstaged edits; not run -- refusing.\n' >&2
  exit 1
fi
if [ ! -s "$patch" ]; then rm -f "$patch"; "$@"; exit $?; fi
if ! git apply --reverse --binary --whitespace=nowarn "$patch"; then
  rm -f "$patch"
  printf 'git-staged-run: could not set the unstaged edits aside; not run -- refusing.\n' >&2
  printf '  Stage or stash them, then try again.\n' >&2
  exit 1
fi

restore() {
  trap - EXIT HUP INT TERM
  if git apply --binary --whitespace=nowarn "$patch" 2>/dev/null; then rm -f "$patch"; return 0; fi
  fix=$(mktemp "${TMPDIR:-/tmp}/git-staged-run-rewrite.XXXXXX") || fix=""
  if [ -n "$fix" ] && git diff --binary --no-color --no-ext-diff --ignore-submodules >"$fix" \
     && git apply --reverse --binary --whitespace=nowarn "$fix" \
     && git apply --binary --whitespace=nowarn "$patch" 2>/dev/null; then
    rm -f "$patch"
    printf 'git-staged-run: your unstaged edits are back; what the command rewrote on disk conflicted\n' >&2
    printf '  with them and was undone. It is kept in %s\n' "$fix" >&2
    return 0
  fi
  printf 'git-staged-run: YOUR UNSTAGED EDITS COULD NOT BE PUT BACK. They are kept in\n  %s\n' "$patch" >&2
  [ -n "$fix" ] && printf '  and what the command rewrote is kept in %s\n' "$fix" >&2
  printf '  Reapply them with: git apply %s\n' "$patch" >&2
  return 1
}
trap 'restore; exit 1' HUP INT TERM
trap restore EXIT
"$@"; rc=$?
restore || [ "$rc" != 0 ] || rc=1
exit "$rc"
