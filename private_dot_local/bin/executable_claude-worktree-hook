#!/usr/bin/env bash
# claude-worktree-hook -- Claude Code hooks that keep a session's worktree work on worktrunk.
#
# SUBCOMMANDS, one per hook event (the hook's JSON input on stdin in every case):
#
#   bash             PreToolUse, matcher "Bash". Refuses a raw `git worktree add` or `move` typed
#                    by the session, naming the worktrunk command to use instead; refuses any
#                    removal that is not the whole command (below); lets a bare raw
#                    `git worktree remove` through with a warning naming `wt remove`.
#                    `git worktree list` and the other subcommands pass silently. It never rewrites
#                    the command.
#   subagent-start   SubagentStart. Warns when the session's checkout has commits that are on no
#                    remote.
#
# Any other subcommand does nothing and exits 0. That includes `enter-worktree`, which until
# 2026-11-19 refused the EnterWorktree tool wherever sessions work in place (`worktree.bgIsolation`
# "none"). That refusal is gone: EnterWorktree and ExitWorktree are open to every session and
# subagent, so a session reaches a worktree by entering it rather than by a clone of its own. A
# settings file not yet re-applied may still wire `enter-worktree`; it allows. What entering costs
# is a behavior to know, not a block: until the session calls ExitWorktree, its sandbox write set
# is the worktree, so it cannot write its main checkout (skill `working-in-worktrees`).
#
# WHY REFUSE RAW `git worktree add`. Worktrunk (`wt`) owns worktree creation: it places a worktree
# where the machine's layout says (`.worktrees/` or `.claude/worktrees/`, by the dotfiles' per-machine
# flag) and runs the creation hooks (among them the one that fetches the base first). A raw
# `git worktree add` skips all of that and puts the worktree wherever the command line says.
# A bare raw removal is only WARNED: the standard is `wt remove --no-hooks --foreground <name>`, but
# a plain `git worktree remove <path>` stays a sanctioned fallback where a setup exempts it from the
# sandbox (git's own clean check still refuses a worktree holding uncommitted work), so refusing it
# would remove a working route. Any removal that is not the whole command is refused, because no
# setup exempts it (bare_removal, below). The refusal is a guard against habit, not a security boundary: it reads only the
# command line the session typed, so a script, an alias or a heredoc fed to a shell is not seen, and
# tooling that manages worktrees itself keeps calling git.
# Where worktrunk is not installed there is no `wt` command to name, so the guard stands down.
#
# THE UNPUSHED WARNING. A subagent given its own worktree starts from the base as fetched from the
# remote, so commits that exist only in the session's checkout are not in it. It warns, it never
# blocks: dispatching an agent that reads, rather than builds on, those commits is fine. "Not on the
# remote" means reachable from HEAD and from no remote-tracking ref, which also covers a push
# through a multi-URL remote that leaves `origin/*` stale. A branch with no upstream is quiet.
#
# FAIL OPEN. A hook that breaks a session is worse than one that misses a case: without jq, with
# unreadable input, or on any internal error, every subcommand exits 0 and prints nothing.
# Portable: bash 3.2 and BSD userland; the command scanner is POSIX awk.
set -u

subcommand=${1:-}
case "$subcommand" in
  bash | subagent-start) ;;
  *) exit 0 ;;
esac

input=$(cat 2>/dev/null) || exit 0

# Cheap exit for the hottest path: this runs before every Bash call, and almost none mention
# worktrees or a removal. Checked on the raw JSON before anything is spawned.
if [ "$subcommand" = bash ]; then
  case "$input" in *worktree* | *remove*) ;; *) exit 0 ;; esac
fi

command -v jq >/dev/null 2>&1 || exit 0

field() { printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null; }

deny() {
  jq -n --arg r "$1" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}

# ---- the command scanner -------------------------------------------------------------------
# Prints the word after `worktree` for every git invocation in the command line, one per line.
# It tokenizes like a shell, roughly: quotes, backslashes, comments and heredoc bodies are honored,
# so text that merely mentions `git worktree add` (a commit message, a search pattern, a file being
# written) is not mistaken for a call. A `git` word is matched anywhere, not only at a command's
# start, so `env git …`, `command git …` and `/usr/bin/git …` are seen; its global options are
# skipped (`-C <path>`, `-c <k=v>`, `--git-dir`, …). The text of `$(…)`, backticks, `sh -c '…'` and
# `eval …` is scanned again, recursively.
IFS= read -r -d '' SCANNER <<'AWK' || true
function fl() { if (have) { tok[D, n++] = cur; cur = ""; have = 0 } }
function bname(t) { sub(/.*\//, "", t); return t }
function tokenize(s, d,    L, i, c, nx, j, q, dep, delim, strip, line, k) {
  D = d; n = 0; cur = ""; have = 0; nh = 0; L = length(s); i = 1
  while (i <= L) {
    c = substr(s, i, 1)
    if (c == "\\") {
      nx = substr(s, i + 1, 1)
      if (nx != "\n") { cur = cur nx; have = 1 }
      i += 2; continue
    }
    if (c == "'") {
      j = index(substr(s, i + 1), "'")
      if (j == 0) { cur = cur substr(s, i + 1); have = 1; break }
      cur = cur substr(s, i + 1, j - 1); have = 1; i += j + 1; continue
    }
    if (c == "\"") {
      have = 1; i++
      while (i <= L) {
        c = substr(s, i, 1)
        if (c == "\\") {
          nx = substr(s, i + 1, 1)
          if (nx ~ /[\\"$`]/) { cur = cur nx; i += 2; continue }
          cur = cur c; i++; continue
        }
        if (c == "\"") { i++; break }
        cur = cur c; i++
      }
      continue
    }
    if (c == "$" && substr(s, i + 1, 1) == "(") {
      dep = 0; j = i + 1
      while (j <= L) {
        q = substr(s, j, 1)
        if (q == "(") dep++
        else if (q == ")") { dep--; if (dep == 0) break }
        j++
      }
      cur = cur substr(s, i, j - i + 1); have = 1; i = j + 1; continue
    }
    if (c == "`") {
      j = index(substr(s, i + 1), "`")
      if (j == 0) j = L - i
      cur = cur substr(s, i, j + 1); have = 1; i += j + 1; continue
    }
    if (c == "#" && !have) {
      j = index(substr(s, i), "\n")
      if (j == 0) break
      i += j - 1; continue
    }
    if (c == "<" && substr(s, i + 1, 1) == "<" && substr(s, i + 2, 1) != "<") {
      fl(); i += 2; strip = 0
      if (substr(s, i, 1) == "-") { strip = 1; i++ }
      while (i <= L && substr(s, i, 1) ~ /[ \t]/) i++
      delim = ""
      while (i <= L) {
        q = substr(s, i, 1)
        if (q ~ /[ \t\n;&|<>()]/) break
        if (q != "'" && q != "\"" && q != "\\") delim = delim q
        i++
      }
      if (delim != "") { nh++; hdq[nh] = delim; hds[nh] = strip }
      continue
    }
    if (c == "\n") {
      fl(); tok[D, n++] = SEP; i++
      for (k = 1; k <= nh; k++) {
        while (i <= L) {
          j = index(substr(s, i), "\n")
          if (j == 0) { line = substr(s, i); i = L + 1 } else { line = substr(s, i, j - 1); i += j }
          if (hds[k]) sub(/^\t+/, "", line)
          if (line == hdq[k]) break
        }
      }
      nh = 0; continue
    }
    if (c ~ /[;&|()]/) { fl(); tok[D, n++] = SEP; i++; continue }
    if (c ~ /[ \t<>]/) { fl(); i++; continue }
    cur = cur c; have = 1; i++
  }
  fl(); ntok[d] = n
}
function subs(t, d,    L, i, j, dep, q) {
  L = length(t); i = 1
  while (i <= L) {
    if (substr(t, i, 2) == "$(") {
      dep = 0; j = i + 1
      while (j <= L) {
        q = substr(t, j, 1)
        if (q == "(") dep++
        else if (q == ")") { dep--; if (dep == 0) break }
        j++
      }
      rescan(substr(t, i + 2, j - i - 2), d + 1); i = j + 1; continue
    }
    if (substr(t, i, 1) == "`") {
      j = index(substr(t, i + 1), "`")
      if (j == 0) break
      rescan(substr(t, i + 1, j - 1), d + 1); i += j + 1; continue
    }
    i++
  }
}
function rescan(s, d) { if (d > 8) return; tokenize(s, d); scan(d) }
function scan(d,    k, m, t, b, j, u, inner, q, fg) {
  m = ntok[d]
  for (k = 0; k < m; k++) {
    t = tok[d, k]
    if (t == SEP) continue
    if (index(t, "$(") || index(t, "`")) subs(t, d)
    b = bname(t)
    if (b == "git") {
      for (j = k + 1; j < m; j++) {
        u = tok[d, j]
        if (u == SEP) break
        if (u ~ /^-/) {
          if (u == "-C" || u == "-c" || u == "--git-dir" || u == "--work-tree" || u == "--namespace" || u == "--super-prefix" || u == "--config-env") j++
          continue
        }
        if (u == "worktree" && j + 1 < m) print tok[d, j + 1]
        break
      }
    }
    if (b == "wt") {
      # `wt remove` without --foreground: worktrunk moves the worktree into its trash and deletes it
      # from a detached process, which the end of a session's command can kill, leaving the trash
      # full. The first non-option word is the subcommand; -C takes a value.
      for (j = k + 1; j < m && tok[d, j] != SEP; j++) {
        u = tok[d, j]
        if (u == "-C") { j++; continue }
        if (u ~ /^-/) continue
        if (u == "remove") {
          fg = 0
          for (q = j + 1; q < m && tok[d, q] != SEP; q++) if (tok[d, q] == "--foreground") fg = 1
          if (!fg) print "wt-remove-bg"; else print "wt-remove-fg"
        }
        break
      }
    }
    if (b == "sh" || b == "bash" || b == "zsh" || b == "dash" || b == "ksh") {
      for (j = k + 1; j < m && tok[d, j] != SEP; j++) {
        u = tok[d, j]
        if (u ~ /^-[A-Za-z]*c[A-Za-z]*$/) { if (j + 1 < m) rescan(tok[d, j + 1], d + 1); break }
        if (u !~ /^-/) break
      }
    }
    if (b == "eval") {
      inner = ""
      for (j = k + 1; j < m && tok[d, j] != SEP; j++) inner = inner " " tok[d, j]
      rescan(inner, d + 1)
    }
  }
}
BEGIN { SEP = "\001"; rescan(ENVIRON["HOOK_CMD"], 0) }
AWK

# What the command line does with `git worktree`: "add" or "move" if it invokes either (refused),
# "wt-remove-bg" for a `wt remove` without --foreground (refused), else "remove" if it invokes
# `git worktree remove` (warned when bare), else "wt-remove" for a `wt remove --foreground`
# (allowed when bare), else nothing.
worktree_verdict() {
  HOOK_CMD=$1 awk "$SCANNER" </dev/null 2>/dev/null | {
    seen=""
    while IFS= read -r sub; do
      case "$sub" in
        add|move) printf '%s' "$sub"; exit 0 ;;
        wt-remove-bg) printf '%s' "$sub"; exit 0 ;;
        remove) seen=remove ;;
        wt-remove-fg) [ -n "$seen" ] || seen=wt-remove ;;
      esac
    done
    printf '%s' "$seen"
  }
}

# WHY A REMOVAL MUST BE THE WHOLE COMMAND. The sandbox exempts exactly two removal forms, matched
# against the whole command string: `git worktree remove <path>` and
# `wt remove --no-hooks --foreground <name>`. Anything else (a `cd … &&` before it, a `| tail`
# after it, a loop, `git -C <path> worktree remove`, an environment prefix, `wt -C`) runs inside
# the sandbox, where the placeholders it mounts over protected paths sit in every worktree. A
# repository that lists them in `.gitignore` then passes git's clean check and the removal stops
# halfway, "Device or resource busy", leaving a partly deleted worktree for a person to finish
# (measured 2026-11-19 and 2026-11-22). Refusing costs one retry; the bare
# form works whether or not a sandbox is on.
bare_removal() {
  nl='
'
  case "$1" in *[';&|<>()$`']* | *"$nl"*) return 1 ;; esac
  case "$1" in 'git worktree remove '?* | 'wt remove --no-hooks --foreground '?*) return 0 ;; esac
  return 1
}

# Allows the call, and tells both the session and the person what the standard form is. No
# permissionDecision is set, so the normal permission flow still decides.
warn() {
  jq -n --arg m "$1" '{systemMessage: $m, hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $m}}'
  exit 0
}

guard_bash() {
  command -v wt >/dev/null 2>&1 || exit 0
  cmd=$(field '.tool_input.command')
  [ -n "$cmd" ] || exit 0
  sub=$(worktree_verdict "$cmd")
  case "$sub" in
    remove | wt-remove)
      bare_removal "$cmd" || deny 'A worktree removal is refused here unless it is the whole command: the sandbox exempts only the bare forms, so this one would run sandboxed, where its placeholders make it refuse or stop halfway with a partly deleted worktree. Run exactly `wt remove --no-hooks --foreground <name>` from the checkout root as a Bash call of its own: no `cd`, `&&`, pipe, loop, `-C` or variable, after ExitWorktree with action "keep" if this session entered the worktree, and with nothing else of this session running. For several worktrees, one call each. Never force it.' ;;
  esac
  case "$sub" in
    wt-remove) exit 0 ;;
    add) how='In a session, create it with the EnterWorktree tool by name, or launch a subagent with isolation "worktree". For an existing branch, enter by name and then run `git switch <branch>` in the new worktree; a branch checked out in another worktree cannot be switched to, so commit on it where it is checked out. Do not run `wt switch --create` from a sandboxed session in the repository the session started in: the sandbox holds that repository'"'"'s `.git/worktrees` read-only, so it fails after creating the branch. A person or an unsandboxed script uses worktrunk: `wt switch --create <branch> --base <base> --no-cd` for a new branch, or `wt switch <branch>` for an existing one. Never clone the repository a second time instead.' ;;
    move) how='worktrunk has no move: create the new worktree (the EnterWorktree tool in a session, `wt switch --create <branch>` outside the sandbox), carry the work across by committing it, then `wt remove --no-hooks --foreground <old name>`.' ;;
    wt-remove-bg) deny 'wt remove is refused here without --foreground: a background removal moves the worktree into worktrunk'"'"'s trash and deletes it from a detached process that the end of this command can kill, so the trash is never emptied. Use `wt remove --no-hooks --foreground <name>`.' ;;
    remove) warn 'Raw `git worktree remove` is the fallback here; the standard removal is `wt remove --no-hooks --foreground <name>`, after leaving the worktree (ExitWorktree with action "keep" if this session entered it). Never force either one.' ;;
    *) exit 0 ;;
  esac
  deny "Raw \`git worktree $sub\` is refused in sessions here: worktrunk owns worktree creation, so the layout, the fetch of the base and the creation hooks are applied. $how \`git worktree list\` stays available."
}

warn_unpushed() {
  command -v git >/dev/null 2>&1 || return 0
  dir=${CLAUDE_PROJECT_DIR:-}
  [ -n "$dir" ] && [ -d "$dir" ] || dir=$(field '.cwd')
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || return 0
  ahead=$(git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null)
  [ "$ahead" -gt 0 ] 2>/dev/null || return 0
  br=$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || printf 'HEAD')
  jq -n --arg n "$ahead" --arg b "$br" '{
    systemMessage: ("Push before dispatching: this checkout has \($n) commit(s) on \($b) that are on no remote. A subagent in its own worktree starts from the remote base and will not have them."),
    hookSpecificOutput: {hookEventName: "SubagentStart",
      additionalContext: ("Your parent session'"'"'s checkout has \($n) commit(s) on \($b) that were not pushed. If you work in your own worktree, it was created from the remote base and does not contain them; if your task depends on them, say so in your report rather than recreating them.")}}'
}

case "$subcommand" in
  bash)
    guard_bash
    ;;
  subagent-start)
    warn_unpushed
    ;;
esac
exit 0
