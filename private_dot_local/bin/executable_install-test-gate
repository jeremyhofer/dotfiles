#!/bin/sh
# install-test-gate -- install a commit gate into a chezmoi source repository: a .git/hooks/pre-commit
# that runs the repository's tests/run-all.sh when a staged change could break what it ships.
#
#   usage: install-test-gate <source-repo> --label <name> --skip-var <VAR> [--paths <ERE>]
#
#   --label     names the gate in its refusal ("my-layer pre-commit: the test suite failed").
#   --skip-var  an environment variable that, set to 1, lets a deliberate WIP commit through.
#   --paths     an extended regex over staged paths; only a match runs the suite. Without it, every
#               commit runs it except one staging only documentation (docs/ and top-level *.md).
#
# OPT-IN. The base never runs this for a private layer. A layer that wants a gate calls it from its
# own run_onchange_install-test-gate.sh.tmpl (example: overlay-skeleton/). It writes a hook into the
# layer's own git directory, so a machine that may not run custom hooks simply does not opt in.
#
# WHY A COMMIT GATE AT ALL. A layer's suites guard its scripts and hooks, and until a gate existed
# nothing ran them: one was failing on macOS for weeks with nobody aware. The commit path rather than
# a build lane, because a gate reachable only through a lane goes dark whenever something earlier in
# the lane fails, and says nothing when it does.
#
# NEVER OVERWRITES A HOOK IT DID NOT WRITE. A pre-commit without this tool's marker (or its
# predecessor's) is someone else's, and replacing it would silently drop whatever it enforced: exit 1.
#
# Known limit, shared with the base's own gate: the suite runs on the WORKING TREE, so an unstaged
# edit can make a commit pass or fail on code it does not contain.
#
# Exit 0 installed, or nothing to do (not a git checkout); 1 a foreign hook is in the way; 2 usage.
set -eu

die_usage() { printf 'install-test-gate: %s\nusage: install-test-gate <source-repo> --label <name> --skip-var <VAR> [--paths <ERE>]\n' "$1" >&2; exit 2; }
[ $# -ge 1 ] || die_usage "no source repository given"
case "$1" in -h|--help) sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;; esac
repo=$1; shift
label=""; skipvar=""; paths=""
while [ $# -gt 0 ]; do
  case "$1" in
    --label)    [ $# -ge 2 ] || die_usage "--label needs a value"; label=$2; shift 2 ;;
    --skip-var) [ $# -ge 2 ] || die_usage "--skip-var needs a value"; skipvar=$2; shift 2 ;;
    --paths)    [ $# -ge 2 ] || die_usage "--paths needs a value"; paths=$2; shift 2 ;;
    *) die_usage "unknown argument '$1'" ;;
  esac
done
[ -n "$label" ] || die_usage "--label is required"
case "$label" in *[!A-Za-z0-9._\ -]*) die_usage "--label may hold letters, digits, space, '.', '_' and '-' only" ;; esac
printf '%s' "$skipvar" | grep -Eq '^[A-Z_][A-Z0-9_]*$' || die_usage "--skip-var must be an upper-case variable name"

[ -d "$repo/.git" ] || { printf 'install-test-gate: %s is not a git checkout; nothing installed\n' "$repo"; exit 0; }
hook="$repo/.git/hooks/pre-commit"
if [ -f "$hook" ] && ! grep -Eq 'generated by (install-test-gate|run_onchange_install-overlay-hooks)' "$hook"; then
  printf 'install-test-gate: %s holds a pre-commit this tool did not write; left alone, no gate installed\n' "$hook" >&2
  exit 1
fi
mkdir -p "$repo/.git/hooks"

# Single-quote a value for the generated script.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

{
  printf '#!/bin/sh\n'
  printf '# %s pre-commit (generated by install-test-gate; re-run it rather than editing this file).\n' "$label"
  printf '# Deliberate WIP commit: %s=1 git commit ...\n' "$skipvar"
  printf 'set -eu\n'
  printf 'GATE_LABEL=%s\nGATE_PATHS=%s\n' "$(q "$label")" "$(q "$paths")"
  printf '[ "${%s:-0}" = 1 ] && exit 0\n' "$skipvar"
  printf 'GATE_SKIP_VAR=%s\n' "$skipvar"
  cat <<'HOOK'
# Git exports GIT_DIR, GIT_INDEX_FILE and friends into a hook, and everything the hook runs inherits
# them: a suite that shells out to git then sees the wrong repository, and GIT_DIR makes any
# directory look like one. Measured: a suite failed during a real commit while passing standalone.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || true
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$GATE_PATHS" ]; then
  printf '%s\n' "$staged" | grep -qE "$GATE_PATHS" || exit 0
else
  printf '%s\n' "$staged" | grep -qvE '^(docs/|[^/]+\.md$)' || exit 0
fi
[ -f "$root/tests/run-all.sh" ] || exit 0
if ! out=$(cd "$root" && sh tests/run-all.sh 2>&1); then
  printf '\n%s pre-commit: the test suite failed -- commit refused:\n' "$GATE_LABEL" >&2
  printf '%s\n' "$out" >&2
  printf '\n  re-run with: sh tests/run-all.sh [filter]\n  deliberate WIP commit: %s=1 git commit ...\n' "$GATE_SKIP_VAR" >&2
  exit 1
fi
HOOK
} > "$hook.new"
chmod +x "$hook.new"
mv "$hook.new" "$hook"
printf 'install-test-gate: %s gate installed -> %s\n' "$label" "$hook"
