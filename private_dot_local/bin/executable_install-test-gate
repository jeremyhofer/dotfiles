#!/bin/sh
# install-test-gate -- install a commit gate into a chezmoi source repository: a .git/hooks/pre-commit
# that runs the repository's suites when a staged change could break what it ships. Which runner,
# decided each time the hook runs:
#   * a repository with an nx.json runs `python3 tests/apply-suites.py check`: every suite through
#     Nx, each replayed from Nx's cache when its inputs did not change, so a commit waits on what it
#     can break (that script's header has the rules: the Node it runs under, and why a stale
#     node_modules refuses the commit, naming the `npm ci` to run, rather than installing). An
#     nx.json without that script is refused, never skipped;
#   * otherwise it runs tests/run-all.sh, every suite.
#
#   usage: install-test-gate <source-repo> --label <name> --skip-var <VAR> [--paths <ERE>]
#
#   --label     names the gate in its refusal ("my-layer pre-commit: the test suite failed").
#   --skip-var  an environment variable that, set to 1, lets a deliberate WIP commit through.
#   --paths     an extended regex over staged paths; only a match runs the suite. Without it, every
#               commit runs it except one staging only documentation (docs/ and top-level *.md).
#
# OPT-IN. The base never runs this for a private layer. A layer that wants a gate calls it from its
# own run_onchange_install-test-gate.sh.tmpl (example: overlay-skeleton/). It writes a hook into the
# layer's own git directory, so a machine that may not run custom hooks simply does not opt in.
#
# WHY A COMMIT GATE AT ALL. A layer's suites guard its scripts and hooks, and until a gate existed
# nothing ran them: one was failing on macOS for weeks with nobody aware. The commit path rather than
# a build lane, because a gate reachable only through a lane goes dark whenever something earlier in
# the lane fails, and says nothing when it does.
#
# NEVER OVERWRITES A HOOK IT DID NOT WRITE. A pre-commit without this tool's marker (or its
# predecessor's) is someone else's, and replacing it would silently drop whatever it enforced: exit 1.
#
# THE SUITE JUDGES WHAT IS STAGED. It runs under git-staged-run, which sets the unstaged edits aside
# for the run and puts them back, so a commit passes or fails on the code it contains. Without that
# helper (it ships with this base) the gate refuses rather than judge the working tree.
#
# IT WAITS WHEN ANOTHER SESSION HOLDS THE TIMING SLOT (fleet-slot check exits 1), bounded. The
# suites are heavy work, and heavy work defers while a timing measurement holds the slot, so it does
# not land on that sample: `fleet-slot wait` blocks until the slot is free, for at most
# $FLEET_SLOT_COMMIT_WAIT_MIN minutes (default 45, longer than any slot granted so far; 0 does not
# wait). Past the cap, or if the wait itself fails, it warns and runs anyway: a slot left held must
# not block every commit behind it. It never refuses a commit over the slot. An agent committing
# while a slot is held runs the commit in the background, since a foreground tool call times out
# first.
#
# The base's own source repository gets its gate from this tool too (run_onchange_install-git-hooks),
# so the one hook it generates, and the rule above, serve both.
#
# Exit 0 installed, or nothing to do (not a git checkout); 1 a foreign hook is in the way; 2 usage.
set -eu

die_usage() { printf 'install-test-gate: %s\nusage: install-test-gate <source-repo> --label <name> --skip-var <VAR> [--paths <ERE>]\n' "$1" >&2; exit 2; }
[ $# -ge 1 ] || die_usage "no source repository given"
case "$1" in -h|--help) sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;; esac
repo=$1; shift
label=""; skipvar=""; paths=""
while [ $# -gt 0 ]; do
  case "$1" in
    --label)    [ $# -ge 2 ] || die_usage "--label needs a value"; label=$2; shift 2 ;;
    --skip-var) [ $# -ge 2 ] || die_usage "--skip-var needs a value"; skipvar=$2; shift 2 ;;
    --paths)    [ $# -ge 2 ] || die_usage "--paths needs a value"; paths=$2; shift 2 ;;
    *) die_usage "unknown argument '$1'" ;;
  esac
done
[ -n "$label" ] || die_usage "--label is required"
case "$label" in *[!A-Za-z0-9._\ -]*) die_usage "--label may hold letters, digits, space, '.', '_' and '-' only" ;; esac
printf '%s' "$skipvar" | grep -Eq '^[A-Z_][A-Z0-9_]*$' || die_usage "--skip-var must be an upper-case variable name"

[ -d "$repo/.git" ] || { printf 'install-test-gate: %s is not a git checkout; nothing installed\n' "$repo"; exit 0; }
hook="$repo/.git/hooks/pre-commit"
if [ -f "$hook" ] && ! grep -Eq 'generated by (install-test-gate|run_onchange_install-overlay-hooks|run_onchange_install-git-hooks)' "$hook"; then
  printf 'install-test-gate: %s holds a pre-commit this tool did not write; left alone, no gate installed\n' "$hook" >&2
  exit 1
fi
mkdir -p "$repo/.git/hooks"

# Single-quote a value for the generated script.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

{
  printf '#!/bin/sh\n'
  printf '# %s pre-commit (generated by install-test-gate; re-run it rather than editing this file).\n' "$label"
  printf '# Deliberate WIP commit: %s=1 git commit ...\n' "$skipvar"
  printf 'set -eu\n'
  printf 'GATE_LABEL=%s\nGATE_PATHS=%s\n' "$(q "$label")" "$(q "$paths")"
  printf '[ "${%s:-0}" = 1 ] && exit 0\n' "$skipvar"
  printf 'GATE_SKIP_VAR=%s\n' "$skipvar"
  cat <<'HOOK'
# Git exports GIT_DIR, GIT_INDEX_FILE and friends into a hook, and everything the hook runs inherits
# them: a suite that shells out to git then sees the wrong repository, and GIT_DIR makes any
# directory look like one. Measured: a suite failed during a real commit while passing standalone.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || true
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$GATE_PATHS" ]; then
  printf '%s\n' "$staged" | grep -qE "$GATE_PATHS" || exit 0
else
  printf '%s\n' "$staged" | grep -qvE '^(docs/|[^/]+\.md$)' || exit 0
fi
[ -f "$root/nx.json" ] || [ -f "$root/tests/run-all.sh" ] || exit 0
# The suite judges what is staged, not the working tree (git-staged-run; this tool's header).
staged_run=$(command -v git-staged-run 2>/dev/null || true)
if [ -z "$staged_run" ]; then
  printf '%s pre-commit: git-staged-run is not installed, so the suite would judge the working tree
' "$GATE_LABEL" >&2
  printf '  rather than what is staged; refused. It ships with the public dotfiles base: apply that,
' >&2
  printf '  or commit with %s=1.
' "$GATE_SKIP_VAR" >&2
  exit 1
fi
# Heavy work defers while another session's timing measurement holds the slot (this tool's header):
# wait for it, bounded, then run. Never a refusal.
if command -v fleet-slot >/dev/null 2>&1; then
  slot_rc=0
  slot_msg=$(fleet-slot check 2>/dev/null) || slot_rc=$?
  if [ "$slot_rc" -eq 1 ]; then
    cap=${FLEET_SLOT_COMMIT_WAIT_MIN:-45}
    case "$cap" in ''|*[!0-9]*) cap=45 ;; esac
    wait_rc=1
    if [ "$cap" -gt 0 ]; then
      printf '%s pre-commit: waiting for the timing slot, %s (up to %s min; fleet-slot status)\n' "$GATE_LABEL" "$slot_msg" "$cap" >&2
      wait_rc=0
      fleet-slot wait --timeout $((cap * 60)) >/dev/null 2>&1 || wait_rc=$?
    fi
    if [ "$wait_rc" -ne 0 ]; then
      printf '%s pre-commit: warning: the timing slot is still held after %s min; the suites run anyway (fleet-slot status)\n' "$GATE_LABEL" "$cap" >&2
    fi
  fi
fi
# A repository with an nx.json runs its suites through Nx (this tool's header). The script prints
# what it is doing as it starts, one summary line on a pass, and each failing suite on a failure.
if [ -f "$root/nx.json" ]; then
  if [ ! -f "$root/tests/apply-suites.py" ]; then
    printf '%s pre-commit: %s/nx.json is present but tests/apply-suites.py, which runs the suites\n' "$GATE_LABEL" "$root" >&2
    printf '  through Nx, is not; refused rather than skipped. Commit with %s=1 to bypass.\n' "$GATE_SKIP_VAR" >&2
    exit 1
  fi
  if ! (cd "$root" && sh "$staged_run" python3 tests/apply-suites.py check); then
    printf '\n%s pre-commit: commit refused (the suites failed, or could not run).\n' "$GATE_LABEL" >&2
    printf '  re-run with: python3 tests/apply-suites.py check\n  deliberate WIP commit: %s=1 git commit ...\n' "$GATE_SKIP_VAR" >&2
    exit 1
  fi
  exit 0
fi
# Said before the suite starts, since its output is held until it ends: a slow suite must not read
# as a hung commit.
printf '%s pre-commit: running the test suite (tests/run-all.sh); its output shows only if it fails\n' "$GATE_LABEL" >&2
if ! out=$(cd "$root" && sh "$staged_run" sh tests/run-all.sh 2>&1); then
  printf '\n%s pre-commit: the test suite failed -- commit refused:\n' "$GATE_LABEL" >&2
  printf '%s\n' "$out" >&2
  printf '\n  re-run with: sh tests/run-all.sh [filter]\n  deliberate WIP commit: %s=1 git commit ...\n' "$GATE_SKIP_VAR" >&2
  exit 1
fi
HOOK
} > "$hook.new"
chmod +x "$hook.new"
mv "$hook.new" "$hook"
printf 'install-test-gate: %s gate installed -> %s\n' "$label" "$hook"
