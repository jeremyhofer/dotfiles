#!/usr/bin/env bash
# fleet-repo — make each repository on disk match its entry in the fleet manifest.
#
#   fleet-repo clone <project> [--filter=<spec>] [--branches=<all|default|a,b,..>]
#   fleet-repo clone --url <url> [target] [--filter=<spec>] [--branches=<all|default|a,b,..>]
#   fleet-repo update [--project <name>]
#   fleet-repo check [<project>]
#   fleet-repo -h | --help
#
#   exit 0  done / no drift
#   exit 1  something could not be done (a worktree that would not create or fast-forward, a fetch
#           that failed) or, for `check`, drift was found
#   exit 2  the invocation or the manifest is unusable: bad usage, no manifest found, or a manifest
#           `fleet-decl` cannot read. A caller enforcing anything treats 2 as a refusal.
#
# TWO LAYOUTS, chosen by the DECLARATION (`fleet-decl --layout <project>`), never by what is on disk:
# an entry is a bare container when it declares one (a `container:` block, a `clone:` that runs this
# tool or its older name, or `worktrunk.layout: bare`), and a standard clone otherwise.
#
# THE STANDARD CLONE is the fleet's layout: an ordinary clone at `path`, checked out on the branch
# mani's `branch:` key names, with worktrees nested inside it:
#
#   <repo>/                 the checkout, on the declared branch; <repo>/.git is an ordinary git dir
#     .worktrees/<name>/    further worktrees (`.worktrees/` must be ignored, or tools that walk the
#                           tree meet a second copy of the repository)
#
# Its point: an agent session may write the directory it stands in and that repository's .git, so
# with everything inside one directory a session and the subagents it starts in their own worktrees
# can all work without any extra sandbox grant. The cost: the checkout is load-bearing, and deleting
# it takes every nested worktree with it.
#
# THE BARE CONTAINER, the older layout, still supported for machines that have not changed over. A
# "container" is a bare clone with every branch checked out as a sibling directory:
#
#   <container>/
#     .git/             the git directory itself: a bare clone (core.bare = true), no pointer file
#     <default-branch>/ a worktree for the repository's default branch
#     <other-branch>/   further worktrees, declared in the manifest or added later with `wt`
#
# Its point: no single directory's deletion is catastrophic. The git data lives in <container>/.git, so
# removing any one worktree, the default branch's included, loses only that checkout. In an ordinary
# clone the git directory lives inside the primary checkout, and deleting it orphans every other
# worktree of the repository. The directory is named .git because Claude Code's sandbox lets a
# linked worktree write its shared git directory only under that name.
#
# THE OLD SHAPE. Containers made before that rename keep the git data in <container>/.bare, with
# <container>/.git a one-line file reading "gitdir: ./.bare". Every verb still works on one, so a
# machine can update before it converts anything; `check` reports it as old-layout and prints the
# three commands that convert it. There is no conversion verb: the conversion is a rename plus one
# `git worktree repair`, and it must run with nothing using the container.
#
# WHAT EACH VERB DOES, for a STANDARD entry
#   clone <project>   An absent or empty `path`: `git clone --branch <branch>` (plus --single-branch
#                     when `single_branch: true`, as mani does), then each declared worktree nested at
#                     its `path`, relative to the clone. An existing clone is RECONCILED: missing
#                     worktrees created, missing upstreams set; a checkout on another branch than the
#                     declared one is REPORTED, never switched. A bare container at `path` is refused
#                     untouched: changing one over is a documented procedure, never a side effect.
#   update            As below, for the checkout and its worktrees; refuses a bare container.
#   check [<project>] Findings: no-checkout, bare-container, not-a-clone, checkout-branch, no-upstream,
#                     missing-worktree, worktrunk-bare (the generated worktrunk config would put new
#                     worktrees beside the repository). With no project, every entry that declares
#                     `branch:` and reads as standard is examined, besides the bare ones.
#
# WHAT EACH VERB DOES, for a BARE entry
#   clone <project>   Read the entry, make the container match it. A fresh path: clone the default
#                     branch only, add the rest of the fetched set, fetch once, set each worktree
#                     branch's upstream, create the worktrees. An existing container is RECONCILED:
#                     missing refspecs are added and fetched; a branch no longer declared loses its
#                     refspec and remote-tracking ref, but a local branch or worktree for it is only
#                     REPORTED, never deleted (it may hold unpushed work); upstreams are repaired and
#                     missing worktrees created. Idempotent, which is what makes it safe as a
#                     `clone:` command a sync tool invokes. `clone --url` is the same for a
#                     repository not in the manifest, with no declaration, so every branch.
#   update            In a repository (or `--project <name>`): ONE fetch for the container, then a
#                     fast-forward-only merge of each worktree's upstream, one line per worktree
#                     saying what happened. Exit 1 if any could not move. Across many repositories:
#                     mani exec --all --parallel 'fleet-repo update'
#   check [<project>] Drift between declaration and disk, reported and never fixed: no container, a
#                     plain clone where a container is declared, fetch refspecs that differ from the
#                     declared set, a missing worktree, a missing upstream, a container the
#                     generated worktrunk config has no table for, a container still in the old
#                     .bare shape (old-layout, with the conversion commands). With no project, every entry that
#                     declares a container. Offline.
#
# THE DECLARATION, read through fleet-decl so every tool resolves an entry the same way. Standard:
#     path:   <repo>                       the repository root, where mani runs tasks
#     url:    <the remote>
#     branch: <the checkout's branch>      mani's own key; absent means the remote's default
#     single_branch: true                  mani's own key: fetch that branch only
#     worktrees: [{name: <branch>, path: .worktrees/<name>}]   relative to path
# Bare:
#     path: <container>/<default-branch>   the container is its PARENT (mani runs tasks in `path`)
#     url:  <the remote>
#     worktrees: [{name: <branch>, path: <relative to path>}]    mani's own key, each name a branch
#     container:
#       branches: all | default | [names]  default: containerDefaults.branches, else all
#       filter:   blob:none                a partial clone; applies to a FRESH clone only
#   The fetched set is the remote's default branch, plus every `worktrees:` branch, plus all
#   branches / none / the listed names. It is written into the container as fetch refspecs, so every
#   later `git fetch` and `git pull` stays inside it: a branch that is not declared never arrives,
#   which also keeps branch names that differ only in case (Feature/x, feature/x) from colliding on
#   a case-insensitive filesystem. `all` is the one form that needs no second fetch after cloning.
#
#   --filter=<spec> and --branches=<..> override the declaration. --filter=blob:none fetches every
#   commit and tree but file contents only as needed (the server must allow filters; GitHub does),
#   for a repository with a long history of large files; old versions (`blame`, `log -p`) are fetched
#   on demand and need the network. A filter declared for an EXISTING unfiltered container is
#   reported and not applied: converting one is a re-clone.
#
# WHERE THE MANIFEST IS. $FLEET_RECORD if set; else the nearest mani.yaml (or mani.yml) at or above
# the current directory, as mani itself finds it; else ~/Devel/mani.yaml. `path` is resolved against
# the manifest's directory, never the current one: run by hand from a subdirectory, the old tool
# built the container there. The manifest is read with fleet-decl (a sibling file, else on PATH).
#
# A post-worktree-create hook is offered, not required: see run_post_worktree_create_hook below.
set -euo pipefail

die() { printf 'fleet-repo: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf 'fleet-repo: %s\n' "$1"; }
PROBLEMS=0
problem() { printf 'fleet-repo: WARNING: %s\n' "$1" >&2; PROBLEMS=$((PROBLEMS + 1)); }

usage() { sed -n '2,/^set /{/^set /d;s/^# \{0,1\}//;p;}' "$0"; }

# ---- plumbing ---------------------------------------------------------------------------------

# Find a companion tool: next to this file when it runs from a source tree or an install directory
# (the source copy is named executable_<name>), else on PATH. The sibling comes first so the
# forwarding shim and the test suite use the checkout they sit in, not an older deployed copy.
here=$(cd "$(dirname "$0")" && pwd)
sibling() {
  local c
  for c in "$here/$1" "$here/executable_$1"; do
    if [ -x "$c" ]; then printf '%s\n' "$c"; return 0; fi
  done
  command -v "$1" 2>/dev/null || true
}
FLEET_DECL=$(sibling fleet-decl)

# decl_into VAR <fleet-decl args>: VAR gets the value. Returns 1 when nothing is declared (VAR is
# empty), exits 2 when the manifest cannot be read. Never `x=$(decl ..) || x=""`: that would turn
# exit 2 into "nothing declared", the collapse fleet-decl's exit codes exist to prevent.
decl_into() {
  local _v=$1 _out _rc=0
  shift
  _out=$("$FLEET_DECL" "$@" 2>&1) || _rc=$?
  case "$_rc" in
    0) printf -v "$_v" '%s' "$_out" ;;
    1) printf -v "$_v" '%s' ""; return 1 ;;
    *) die "the manifest cannot be read: $_out" 2 ;;
  esac
}

# A path with . and .. collapsed lexically; relative input is taken against $PWD. Lexical because a
# declared worktree path usually does not exist yet, so `cd` cannot resolve it.
lexnorm() {
  local p=$1 out="" seg rest
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  rest=${p#/}
  while [ -n "$rest" ]; do
    case "$rest" in
      */*) seg=${rest%%/*}; rest=${rest#*/} ;;
      *)   seg=$rest; rest="" ;;
    esac
    case "$seg" in
      ""|.) ;;
      ..) out=${out%/*} ;;
      *) out="$out/$seg" ;;
    esac
  done
  printf '%s\n' "${out:-/}"
}

# Sets RECORD and MDIR (the manifest's directory) and exports what fleet-decl reads. Exit 2 with a
# message that names where it looked, since "no such project" would send the reader to the wrong
# place.
load_manifest() {
  local r="" d
  [ -n "$FLEET_DECL" ] || die "fleet-decl is not installed, so the manifest cannot be read" 2
  if [ -n "${FLEET_RECORD:-}" ]; then
    r=$FLEET_RECORD
    [ -f "$r" ] || die "FLEET_RECORD names $r, which does not exist" 2
  else
    d=$PWD
    while :; do
      if [ -f "$d/mani.yaml" ]; then r="$d/mani.yaml"; break; fi
      if [ -f "$d/mani.yml" ]; then r="$d/mani.yml"; break; fi
      [ "$d" = / ] && break
      d=$(dirname "$d")
    done
    if [ -z "$r" ] && [ -f "$HOME/Devel/mani.yaml" ]; then r="$HOME/Devel/mani.yaml"; fi
    [ -n "$r" ] || die "no manifest: looked for mani.yaml at or above $PWD and at $HOME/Devel/mani.yaml (set FLEET_RECORD to name one)" 2
  fi
  MDIR=$(cd "$(dirname "$r")" && pwd)
  RECORD="$MDIR/$(basename "$r")"
  export FLEET_RECORD="$RECORD"
  export FLEET_DEVEL_ROOT="${FLEET_DEVEL_ROOT:-$MDIR}"
}

# Newline lists as sets. All exact-line, so branch names that differ only in case stay different.
list_minus() { awk 'NR==FNR { b[$0] = 1; next } NF && !($0 in b)' <(printf '%s\n' "$2") <(printf '%s\n' "$1"); }
list_dedupe() { awk 'NF && !seen[$0]++'; }
brief() {  # a newline list as "a b c (+N more)"
  awk 'NF { n++; if (n <= 5) s = s (n > 1 ? " " : "") $0 } END { if (n > 5) s = s " (+" (n - 5) " more)"; print s }'
}

# ---- the entry --------------------------------------------------------------------------------
# Fills P_LAYOUT (bare|standard) P_URL P_PATH P_TARGET (absolute: the container, or the standard
# clone's root) P_EXPECT (bare: the default worktree's directory name as declared) P_BRANCH and
# P_SINGLE (standard: the declared checkout branch, and "1" for single_branch: true) P_FILTER P_MODE
# (all|default|list) P_LIST WT_NAMES WT_DIRS (parallel newline lists; WT_DIRS absolute).
load_entry() {
  local p=$1 v names paths i n rel
  case "$p" in ""|*[!A-Za-z0-9_.-]*) die "'$p' is not a manifest project name" 2 ;; esac
  decl_into P_URL --entry "$p" url || die "no such project in $RECORD, or it has no url: $p" 2
  decl_into P_PATH --entry "$p" path || die "project $p has no path in $RECORD" 2
  [ -n "$P_URL" ] || die "project $p has no url" 2
  [ -n "$P_PATH" ] || die "project $p has no path" 2
  decl_into P_LAYOUT --layout "$p" || die "project $p is not declared in $RECORD" 2
  P_BRANCH=""; P_SINGLE=""
  decl_into P_BRANCH --entry "$p" branch || P_BRANCH=""
  if decl_into v --entry "$p" single_branch && [ "$v" = true ]; then P_SINGLE=1; fi
  if [ "$P_LAYOUT" = standard ]; then
    # The repository root IS path: mani clones there and runs tasks there.
    P_TARGET=$(lexnorm "$MDIR/$P_PATH")
    P_EXPECT=""
  else
    # mani's path names the DEFAULT-BRANCH WORKTREE, so the container is its parent. Keeping that
    # convention is what lets `mani exec` run ordinary git commands: the container is bare and has no
    # work tree, so it cannot be the exec target.
    P_TARGET=$(lexnorm "$MDIR/$(dirname "$P_PATH")")
    P_EXPECT=$(basename "$P_PATH")
  fi
  decl_into P_FILTER --entry "$p" container.filter || P_FILTER=""
  P_MODE=all; P_LIST=""
  if decl_into v --entry-list "$p" container.branches; then P_MODE=list; P_LIST=$v
  elif decl_into v --entry "$p" container.branches; then P_MODE=$v
  elif decl_into v --fleet-list containerDefaults.branches; then P_MODE=list; P_LIST=$v
  elif decl_into v --fleet containerDefaults.branches; then P_MODE=$v
  fi
  [ "$P_MODE" != '[]' ] || { P_MODE=list; P_LIST=""; }
  case "$P_MODE" in all|default|list) ;; *) die "container.branches for $p is '$P_MODE': want all, default or a list (fleet-decl --check says more)" 2 ;; esac
  WT_NAMES=""; WT_DIRS=""
  if decl_into names --entry-list "$p" worktrees name; then
    decl_into paths --entry-list "$p" worktrees path || paths=""
    i=0
    while IFS= read -r n; do
      i=$((i + 1))
      [ -n "$n" ] || continue
      rel=$(printf '%s\n' "$paths" | sed -n "${i}p")
      # Undeclared: where worktrunk would put it, a branch's slashes becoming dashes.
      if [ -z "$rel" ]; then
        if [ "$P_LAYOUT" = standard ]; then rel=".worktrees/$(printf '%s' "$n" | tr '/' '-')"
        else rel="../$n"; fi
      fi
      WT_NAMES="$WT_NAMES$n
"
      WT_DIRS="$WT_DIRS$(lexnorm "$MDIR/$P_PATH/$rel")
"
    done <<EOF
$names
EOF
  fi
  return 0
}

# The nth line of a newline list.
nth() { printf '%s\n' "$1" | sed -n "${2}p"; }

# ---- git helpers ------------------------------------------------------------------------------
# managed_refspecs: the branch names (or *) behind the container's `+refs/heads/X:refs/remotes/
# origin/X` fetch refspecs. Other refspecs are somebody else's and left alone.
managed_refspecs() {
  git --git-dir="$1" config --get-all remote.origin.fetch 2>/dev/null \
    | sed -n 's#^+refs/heads/\([^:]*\):refs/remotes/origin/\1$#\1#p' || true
}

has_ref() { git --git-dir="$1" rev-parse -q --verify "$2" >/dev/null 2>&1; }
# The same, for a repository named by its working directory rather than its git directory.
has_ref_c() { git -C "$1" rev-parse -q --verify "$2" >/dev/null 2>&1; }

# CONTRACT: ~/.dotlocal/hooks/post-worktree-create <absolute-worktree-path>
# A new worktree is the moment a per-worktree defect is BORN and the cheapest moment to catch it:
# whoever is here is about to run an install anyway. This base repo is public and must not depend on
# any private tooling, so it does not name a checker; it offers a documented hook and runs it if
# something has been installed there. ADVISORY ONLY: the exit status is discarded, because a
# reporting hook that can fail a worktree creation is a guard people route around.
run_post_worktree_create_hook() {
  local hook="$HOME/.dotlocal/hooks/post-worktree-create"
  [ -x "$hook" ] || return 0
  "$hook" "$1" || true
}

# A new worktree gets a copy of the gitignored files its repository lists in a .worktreeinclude at
# the root of the primary worktree (Gradle's local.properties, a .env): the standard in
# docs/reference/repository-layouts.md. worktrunk does this through a pre-start hook, but `git
# worktree add` runs no worktrunk hook, so worktrees made here would otherwise go without. The copy
# itself is worktrunk's (`wt step copy-ignored`), so the two paths cannot disagree about what is
# copied. Nothing to do without a list, or without wt. A failed copy is a warning and not a failed
# clone: the worktree exists and is correct, it only lacks a file someone can copy by hand.
# The primary worktree is the standard clone's root, or a container's default-branch directory.
copy_listed_files() {  # $1 primary worktree's directory, $2 its branch, $3 new worktree's branch
  [ -f "$1/.worktreeinclude" ] || return 0
  if ! command -v wt >/dev/null 2>&1; then
    say "NOTE: $1 lists files in .worktreeinclude, but wt is not installed, so worktree $3 did not get them"
    return 0
  fi
  if ! wt -C "$1" step copy-ignored --require-include --from "$2" --to "$3" >/dev/null; then
    printf 'fleet-repo: WARNING: could not copy the files listed in %s/.worktreeinclude into worktree %s\n' "$1" "$3" >&2
  fi
}

# The git directory of the container at $1, or nothing if it is not one. Two shapes:
#   new  <c>/.git is a directory holding a bare repository
#   old  <c>/.git is a file reading "gitdir: ./.bare", and <c>/.bare is the bare repository
# An ordinary clone's <c>/.git is also a directory, so the new shape also requires core.bare.
container_gitdir() {
  local c=$1 line
  if [ -d "$c/.git" ]; then
    if [ "$(git --git-dir="$c/.git" rev-parse --is-bare-repository 2>/dev/null || true)" = true ]; then
      printf '%s\n' "$c/.git"
    fi
  elif [ -f "$c/.git" ] && [ -d "$c/.bare" ]; then
    IFS= read -r line < "$c/.git" || true
    [ "$line" != "gitdir: ./.bare" ] || printf '%s\n' "$c/.bare"
  fi
  return 0
}

# ---- clone ------------------------------------------------------------------------------------
# Globals in: URL TARGET EXPECT FILTER MODE LIST WT_NAMES WT_DIRS
do_clone() {
  local bare fresh=0 default desired have want drop add b n i dir refspec remote_heads
  local wild='+refs/heads/*:refs/remotes/origin/*'

  bare=$(container_gitdir "$TARGET")

  # A directory that already holds files but is not a container is refused: making it one would put a
  # .git into whatever it was. The usual cause is a manifest `path:` naming the container instead of
  # its default-branch worktree: the container is then the PARENT, and for a top-level entry that is
  # the devel root itself.
  if [ -z "$bare" ] && [ -d "$TARGET" ] && [ -n "$(ls -A "$TARGET")" ]; then
    # `branch:` is the standard clone's key. With it beside a container clause, the likeliest story
    # is a manifest change from container to standard clone made only halfway: path: already names
    # the repository root, so its parent, a directory of other repositories, became the "container".
    if [ -n "${BRANCH:-}" ]; then
      die "$TARGET already holds files and is not a container; nothing was created. This entry declares a container (clone:, container: or worktrunk.layout: bare) AND branch:, which only a standard clone uses: the manifest change looks half made. Finish it (remove the container clause) or revert it"
    fi
    die "$TARGET already holds files and is not a container; refusing to clone into it. As a mani clone: command, path: must name the worktree, <container>/<default-branch>, and the container is its parent"
  fi

  if [ -n "$bare" ]; then
    say "$TARGET already present; ensuring it is complete"
  else
    fresh=1
    bare="$TARGET/.git"
    mkdir -p "$TARGET"
    if [ "$MODE" = all ]; then
      # A bare clone does not fetch like a normal one: it records no fetch refspec, so `git fetch`
      # would update nothing and no refs/remotes/origin/* would exist. Given at clone time, the
      # clone itself fills them, so a fresh `all` clone needs no second fetch (a further network
      # round trip, and the fetch set off git's automatic maintenance as well).
      git clone --bare ${FILTER:+"--filter=$FILTER"} -c "remote.origin.fetch=$wild" "$URL" "$bare"
    else
      # Only the default branch comes down; the rest of the fetched set is added below.
      git clone --bare --single-branch ${FILTER:+"--filter=$FILTER"} "$URL" "$bare"
    fi
  fi

  # The default branch comes from the bare clone's own HEAD, which git set from the remote's HEAD at
  # clone time. This is why main / master / develop all work without being special-cased, and it
  # needs no second network round trip.
  default=$(git --git-dir="$bare" symbolic-ref --short HEAD 2>/dev/null || true)
  [ -n "$default" ] || die "could not determine the default branch of $URL"

  # --- the fetched set: refspecs ------------------------------------------------------------
  if [ "$MODE" = all ]; then
    want='*'
  else
    desired=$(printf '%s\n%s%s\n' "$default" "$WT_NAMES" "$LIST" | list_dedupe)
    # Only branches that exist on the remote: a refspec for a missing one makes every later fetch
    # fail with "couldn't find remote ref". One listing, exact-string match.
    remote_heads=$(git --git-dir="$bare" ls-remote --heads origin | sed 's#^[0-9a-f]*[[:space:]]*refs/heads/##') \
      || die "cannot list the branches of $URL"
    want=""
    while IFS= read -r b; do
      [ -n "$b" ] || continue
      if ! git check-ref-format "refs/heads/$b" 2>/dev/null; then
        problem "'$b' is not a valid branch name; skipped"
      elif [ "$b" = "$default" ] || printf '%s\n' "$remote_heads" | grep -Fxq -- "$b"; then
        want="$want$b
"
      else
        problem "branch $b is declared but does not exist on the remote; skipped"
      fi
    done <<EOF
$desired
EOF
  fi
  have=$(managed_refspecs "$bare")
  drop=$(list_minus "$have" "$want")
  add=$(list_minus "$want" "$have")
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    git --git-dir="$bare" config --fixed-value --unset-all remote.origin.fetch "+refs/heads/$b:refs/remotes/origin/$b"
  done <<EOF
$drop
EOF
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    if [ "$b" = '*' ]; then
      git --git-dir="$bare" config --add remote.origin.fetch "$wild"
    else
      git --git-dir="$bare" remote set-branches --add origin "$b"
    fi
  done <<EOF
$add
EOF

  # A fresh `all` clone already fetched everything; every other case fetches once.
  if [ "$fresh" = 0 ] || [ "$MODE" != all ]; then
    git --git-dir="$bare" fetch --quiet origin
  fi

  # --- branches no longer declared ----------------------------------------------------------
  if [ "$MODE" != all ]; then
    # Remote-tracking refs outside the set go, in ONE update-ref transaction (a process per ref is
    # what made the old tool take 8.9 s at 3000 branches). Empty input is a no-op that exits 0.
    local keep_refs have_refs gone
    keep_refs=$(printf '%s\n' "$want" | awk 'NF { print "refs/remotes/origin/" $0 }')
    have_refs=$(git --git-dir="$bare" for-each-ref --format='%(refname)' refs/remotes/origin/ | grep -v '^refs/remotes/origin/HEAD$' || true)
    gone=$(list_minus "$have_refs" "$keep_refs")
    if [ -n "$gone" ]; then
      printf '%s\n' "$gone" | sed 's/^/delete /' | git --git-dir="$bare" update-ref --stdin
      say "dropped $(printf '%s\n' "$gone" | awk 'END { print NR }') remote-tracking ref(s) no longer declared"
      # Never delete what may hold work: say what survives, and how to remove it.
      local wts
      wts=$(git --git-dir="$bare" worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch refs\/heads\//{print substr($0,19) "\t" p}')
      while IFS= read -r b; do
        n=${b#refs/remotes/origin/}
        if has_ref "$bare" "refs/heads/$n"; then
          say "kept local branch $n (no longer declared; remove with: git branch -D $n)"
        fi
        printf '%s\n' "$wts" | awk -F'\t' -v n="$n" '$1 == n { print $2 }' | while IFS= read -r dir; do
          say "kept worktree $dir for $n (no longer declared; remove with: wt -C $TARGET/$default remove --no-delete-branch $n)"
        done
      done <<EOF
$gone
EOF
    fi
  fi

  # A bare clone creates a local branch for every remote branch, so `git branch` lists them all and
  # every one of them is a name that cannot be checked out anywhere useful. On a FRESH clone keep
  # only the default; the rest remain reachable as refs/remotes/origin/*, which is what a later
  # `git worktree add` wants. Never on an existing container: a local branch there is somebody's.
  # One transaction; with --single-branch there are no extras, and empty input is a no-op.
  if [ "$fresh" = 1 ] && [ "$MODE" = all ]; then
    git --git-dir="$bare" for-each-ref --format='delete %(refname)' refs/heads/ \
      | awk -v keep="delete refs/heads/$default" '$0 != keep' \
      | git --git-dir="$bare" update-ref --stdin
  fi

  if [ -n "$EXPECT" ] && [ "$EXPECT" != "$default" ]; then
    printf 'fleet-repo: WARNING: manifest expects the worktree at %s/%s, but the default branch is %s.\n' \
      "$TARGET" "$EXPECT" "$default" >&2
    printf '            Creating %s. Update the manifest path, or that path will not resolve.\n' "$default" >&2
  fi

  # --- worktrees ----------------------------------------------------------------------------
  if [ -d "$TARGET/$default" ]; then
    say "worktree $TARGET/$default already present"
  else
    git -C "$TARGET" worktree add "$default" "$default"
  fi

  i=0
  while IFS= read -r b; do
    i=$((i + 1))
    [ -n "$b" ] || continue
    [ "$b" != "$default" ] || continue            # the default has its own worktree above
    dir=$(nth "$WT_DIRS" "$i")
    if [ -e "$dir" ]; then
      say "worktree $dir already present"
      continue
    fi
    if ! has_ref "$bare" "refs/heads/$b"; then
      if has_ref "$bare" "refs/remotes/origin/$b"; then
        git --git-dir="$bare" branch --quiet --track "$b" "origin/$b"
      else
        problem "worktree $dir: branch $b is not on the remote, so it cannot be created"
        continue
      fi
    fi
    if git -C "$TARGET" worktree add "$dir" "$b"; then
      copy_listed_files "$TARGET/$default" "$default" "$b"
      run_post_worktree_create_hook "$(cd "$dir" 2>/dev/null && pwd)"
    else
      problem "could not create worktree $dir for $b"
    fi
  done <<EOF
$WT_NAMES
EOF

  # A bare clone records no upstream, so `git pull` in a worktree stops at "There is no tracking
  # information" -- and `mani exec --all 'git pull --ff-only'`, the fleet's update, skipped every
  # container while updating every plain clone. Set it on every run for every branch that has a
  # worktree, so a re-run also repairs a container cloned before this line existed.
  for b in "$default" $(printf '%s' "$WT_NAMES" | tr '\n' ' '); do
    if has_ref "$bare" "refs/heads/$b" && has_ref "$bare" "refs/remotes/origin/$b"; then
      git --git-dir="$bare" branch --set-upstream-to="origin/$b" "$b" >/dev/null
    fi
  done

  # A filter is applied by `git clone`, so it cannot be applied here.
  if [ "$fresh" = 0 ] && [ -n "$FILTER" ] \
     && [ "$(git --git-dir="$bare" config remote.origin.promisor 2>/dev/null || true)" != true ]; then
    say "NOTE: filter $FILTER is declared but $TARGET is not a partial clone; not applied (a filter applies to a fresh clone only; re-clone to change it)"
  fi

  say "$TARGET ready (default branch: $default)"
  # ABSOLUTISE before handing the path over. $TARGET may come from the caller relative, and a hook
  # that receives a relative path resolves it against whatever directory it runs in, so it would
  # inspect the wrong tree and report confidently either way. `cd`+`pwd` rather than `realpath`,
  # which is not present on both userlands.
  run_post_worktree_create_hook "$(cd "$TARGET/$default" 2>/dev/null && pwd)"
  [ "$PROBLEMS" -eq 0 ] || return 1
}

# ---- clone, standard ----------------------------------------------------------------------------
# Globals in: PROJECT URL TARGET BRANCH SINGLE FILTER WT_NAMES WT_DIRS
do_clone_standard() {
  local cur b i dir need_fetch="" wild='+refs/heads/*:refs/remotes/origin/*'

  # Refused before anything else, and before any write: a container is changed over by a person,
  # following the documented procedure, with the old directory kept aside. Converting it here would
  # edit the only copy of whatever its worktrees hold.
  if [ -n "$(container_gitdir "$TARGET")" ]; then
    die "$TARGET is a bare container, but the manifest declares a standard clone for $PROJECT. Not converted and not touched: change it over by hand (docs/reference/standard-clone-changeover.md in the dotfiles), or revert the manifest entry"
  fi

  if [ -d "$TARGET" ] && [ -n "$(ls -A "$TARGET")" ]; then
    # Only a clone whose root is exactly TARGET is reconciled. A directory of files, or one that is
    # merely inside some other repository, would otherwise have worktrees and branches added to a
    # repository that is not this entry's.
    if [ "$(git -C "$TARGET" rev-parse --show-toplevel 2>/dev/null || true)" != "$(cd "$TARGET" && pwd -P)" ]; then
      die "$TARGET already holds files and is not a clone of its own; refusing to clone into it"
    fi
    say "$TARGET already present; ensuring it is complete"
  else
    mkdir -p "$(dirname "$TARGET")"
    # The same command mani runs for an entry with no clone:, so `mani sync` and this tool give one
    # declaration the same checkout and the same fetch refspecs. A filter comes only from --filter=:
    # the declared filter lives under container:, and declaring that makes the entry bare.
    git clone ${BRANCH:+--branch "$BRANCH"} ${SINGLE:+--single-branch} ${FILTER:+"--filter=$FILTER"} "$URL" "$TARGET"
  fi

  cur=$(git -C "$TARGET" branch --show-current)
  # Reported, never switched: the checkout belongs to whoever works in it, and a switch could strand
  # or carry their uncommitted work.
  if [ -n "$BRANCH" ] && [ "$cur" != "$BRANCH" ]; then
    say "NOTE: $TARGET is on ${cur:-a detached HEAD}; the manifest declares $BRANCH. Not switched"
  fi

  # A worktree's branch must be fetched before it can be checked out. A single-branch clone fetches
  # only its own branch, so each worktree branch it lacks gets a refspec of its own, as a bare
  # container's declared set does; then one fetch serves them all.
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    has_ref_c "$TARGET" "refs/heads/$b" && continue
    has_ref_c "$TARGET" "refs/remotes/origin/$b" && continue
    if ! git -C "$TARGET" config --get-all remote.origin.fetch | grep -Fxq -- "$wild"; then
      git -C "$TARGET" remote set-branches --add origin "$b"
    fi
    need_fetch=1
  done <<EOF
$WT_NAMES
EOF
  if [ -n "$need_fetch" ]; then
    git -C "$TARGET" fetch --quiet origin || problem "fetch failed for $PROJECT; worktrees whose branch is not yet here cannot be made"
  fi

  i=0
  while IFS= read -r b; do
    i=$((i + 1))
    [ -n "$b" ] || continue
    dir=$(nth "$WT_DIRS" "$i")
    if [ -e "$dir" ]; then say "worktree $dir already present"; continue; fi
    if [ "$b" = "$cur" ]; then
      problem "worktree $dir: branch $b is the checkout's own branch, and git allows a branch in one worktree only"
      continue
    fi
    if ! has_ref_c "$TARGET" "refs/heads/$b"; then
      if has_ref_c "$TARGET" "refs/remotes/origin/$b"; then
        git -C "$TARGET" branch --quiet --track "$b" "origin/$b"
      else
        problem "worktree $dir: branch $b is not on the remote, so it cannot be created"
        continue
      fi
    fi
    if git -C "$TARGET" worktree add --quiet "$dir" "$b"; then
      copy_listed_files "$TARGET" "$cur" "$b"
      run_post_worktree_create_hook "$(cd "$dir" 2>/dev/null && pwd)"
    else
      problem "could not create worktree $dir for $b"
    fi
  done <<EOF
$WT_NAMES
EOF

  # Upstreams: only where one is MISSING. In a standard clone a person may have pointed a branch at
  # another remote on purpose; a missing one is never a choice, and without it `git pull` and
  # `fleet-repo update` stop at "There is no tracking information".
  for b in "$BRANCH" "$cur" $(printf '%s' "$WT_NAMES" | tr '\n' ' '); do
    [ -n "$b" ] || continue
    if has_ref_c "$TARGET" "refs/heads/$b" && has_ref_c "$TARGET" "refs/remotes/origin/$b" \
       && ! git -C "$TARGET" rev-parse -q --verify "$b@{u}" >/dev/null 2>&1; then
      git -C "$TARGET" branch --quiet --set-upstream-to="origin/$b" "$b"
    fi
  done

  say "$TARGET ready (on ${cur:-a detached HEAD})"
  run_post_worktree_create_hook "$(cd "$TARGET" 2>/dev/null && pwd)"
  [ "$PROBLEMS" -eq 0 ] || return 1
}

cmd_clone() {
  local project="" url="" target="" filter="" branches="" use_url=0 pos=0 a
  while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
      -h|--help) usage; exit 0 ;;
      --filter=*) filter=${a#--filter=}; [ -n "$filter" ] || die "--filter needs a spec, e.g. --filter=blob:none" 2 ;;
      --branches=*) branches=${a#--branches=}; [ -n "$branches" ] || die "--branches needs all, default or a comma-separated list" 2 ;;
      --url) use_url=1; url=${1:-}; [ -n "$url" ] || die "--url needs a repository url" 2; shift ;;
      -*) die "unknown option '$a' (see --help)" 2 ;;
      *)
        pos=$((pos + 1))
        if [ "$use_url" = 1 ]; then target=$a; [ "$pos" -le 1 ] || die "usage: fleet-repo clone --url <url> [target]" 2
        else project=$a; [ "$pos" -le 1 ] || die "usage: fleet-repo clone <project>" 2; fi ;;
    esac
  done
  if [ "$use_url" = 0 ] && [ -z "$project" ]; then die "usage: fleet-repo clone <project> | clone --url <url> [target]" 2; fi

  if [ "$use_url" = 1 ]; then
    # No declaration: the manifest is not consulted, so every branch unless --branches says less.
    URL=$url; EXPECT=""; MODE=all; LIST=""; WT_NAMES=""; WT_DIRS=""
    if [ -z "$target" ]; then target=${url##*/}; target=${target%.git}; fi
    TARGET=$target
  else
    load_manifest
    load_entry "$project"
    URL=$P_URL; TARGET=$P_TARGET; EXPECT=$P_EXPECT; MODE=$P_MODE; LIST=$P_LIST
    PROJECT=$project; BRANCH=$P_BRANCH; SINGLE=$P_SINGLE
    if [ "$P_LAYOUT" = standard ]; then
      # --branches chooses what a bare container fetches; a standard clone's set is mani's
      # (single_branch:), so the option would silently mean nothing here.
      [ -z "$branches" ] || die "--branches applies to a bare container; $project is declared a standard clone (single_branch: in the manifest limits its fetch)" 2
      FILTER=$filter
      do_clone_standard
      return
    fi
  fi
  FILTER=${filter:-${P_FILTER:-}}
  if [ -n "$branches" ]; then
    case "$branches" in
      all|default) MODE=$branches; LIST="" ;;
      *) MODE=list; LIST=$(printf '%s\n' "$branches" | tr ',' '\n') ;;
    esac
  fi
  do_clone
}

# ---- update -----------------------------------------------------------------------------------
cmd_update() {
  local project="" a b i dir branch before after out rc default dirs bare
  while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
      -h|--help) usage; exit 0 ;;
      --project) project=${1:-}; [ -n "$project" ] || die "--project needs a name" 2; shift ;;
      *) die "usage: fleet-repo update [--project <name>]" 2 ;;
    esac
  done
  load_manifest
  if [ -z "$project" ]; then
    decl_into project --project "$PWD" \
      || die "$PWD is not inside a repository the manifest declares (no entry's scope contains it); name one with --project" 2
  fi
  load_entry "$project"
  dir="$MDIR/$P_PATH"
  [ -d "$dir" ] || die "$project is not cloned at $dir; run: fleet-repo clone $project"
  # Refused BEFORE the fetch: the manifest says this machine should hold a standard clone, so the
  # container found instead is waiting to be changed over, and is left exactly as it is.
  if [ "$P_LAYOUT" = standard ] && [ -n "$(container_gitdir "$dir")" ]; then
    printf '[bare-container] %s: %s is a bare container, but the manifest declares a standard clone; not updated (change it over by hand, or revert the manifest entry)\n' "$project" "$dir"
    exit 1
  fi
  # One fetch serves every worktree: they share the repository's git directory.
  git -C "$dir" fetch --quiet origin || die "fetch failed for $project"
  dirs="$dir
"
  i=0
  while IFS= read -r b; do
    i=$((i + 1))
    [ -n "$b" ] || continue
    dirs="$dirs$(nth "$WT_DIRS" "$i")
"
  done <<EOF
$WT_NAMES
EOF
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    if [ ! -d "$dir" ]; then
      printf '%s: MISSING (run: fleet-repo clone %s)\n' "$dir" "$project"; PROBLEMS=$((PROBLEMS + 1)); continue
    fi
    branch=$(git -C "$dir" branch --show-current)
    if [ -z "$branch" ]; then printf '%s: detached HEAD, skipped\n' "$dir"; continue; fi
    if ! git -C "$dir" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
      printf '%s: %s has no upstream, skipped (fleet-repo clone %s repairs it)\n' "$dir" "$branch" "$project"
      PROBLEMS=$((PROBLEMS + 1)); continue
    fi
    before=$(git -C "$dir" rev-parse HEAD)
    rc=0; out=$(git -C "$dir" merge --ff-only --quiet '@{u}' 2>&1) || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf '%s: CANNOT fast-forward %s: %s\n' "$dir" "$branch" "$(printf '%s\n' "$out" | sed -n '1p')"
      PROBLEMS=$((PROBLEMS + 1)); continue
    fi
    after=$(git -C "$dir" rev-parse HEAD)
    if [ "$before" = "$after" ]; then printf '%s: %s already up to date\n' "$dir" "$branch"
    else printf '%s: %s fast-forwarded %s..%s\n' "$dir" "$branch" "$(printf '%s' "$before" | cut -c1-7)" "$(printf '%s' "$after" | cut -c1-7)"; fi
  done <<EOF
$dirs
EOF
  [ "$PROBLEMS" -eq 0 ]
}

# ---- check ------------------------------------------------------------------------------------
# <host>/<owner>/<repo> from a remote URL, as wt-config-gen derives it for worktrunk's per-project
# table: ssh:// and https:// (user, port optional) and scp-style user@host:path.
url_to_id() {
  printf '%s\n' "$1" | sed -E \
    -e 's#^[A-Za-z][A-Za-z0-9+.-]*://##' \
    -e 's#^[^@/]*@##' \
    -e 's#^([^/:]+):[0-9]+/#\1/#' \
    -e 's#^([^/:]+):#\1/#' \
    -e 's#\.git/?$##' \
    -e 's#/+$##' | grep -E '^[^/]+/.+' || true
}

drift() { printf '[%s] %s: %s\n' "$1" "$2" "$3"; DRIFT=$((DRIFT + 1)); }

projects_with() {  # prints names; exits 2 if the manifest is unusable
  local out rc=0
  out=$("$FLEET_DECL" --projects-with "$1" 2>&1) || rc=$?
  case "$rc" in 0) printf '%s\n' "$out" ;; 1) ;; *) die "the manifest cannot be read: $out" 2 ;; esac
}

check_one() {
  load_entry "$1"
  if [ "$P_LAYOUT" = standard ]; then check_standard "$1"; else check_bare "$1"; fi
}

# The generated worktrunk config's table for a project's id, body only (empty without one).
wt_table() {  # $1 config file, $2 id
  awk -v h="[projects.\"$2\"]" 'index($0, h) == 1 { f = 1; next } /^\[/ { f = 0 } f' "$1"
}

check_standard() {
  local p=$1 t=$P_TARGET cur b i dir wt_all cfg id
  # Each of the first three findings ends the check: nothing below means anything without a clone.
  if [ -n "$(container_gitdir "$t")" ]; then
    drift bare-container "$p" "$t is a bare container, but the manifest declares a standard clone (changing it over is manual: see the standard-clone changeover reference)"
    return 0
  fi
  if [ ! -d "$t" ] || [ -z "$(ls -A "$t")" ]; then
    drift no-checkout "$p" "nothing at $t (run: fleet-repo clone $p)"
    return 0
  fi
  if [ "$(git -C "$t" rev-parse --show-toplevel 2>/dev/null || true)" != "$(cd "$t" && pwd -P)" ]; then
    drift not-a-clone "$p" "$t holds files but is not a git clone of its own"
    return 0
  fi
  cur=$(git -C "$t" branch --show-current)
  if [ -n "$P_BRANCH" ] && [ "$cur" != "$P_BRANCH" ]; then
    drift checkout-branch "$p" "$t is on ${cur:-a detached HEAD}; the manifest declares $P_BRANCH (switching it back is its owner's call)"
  fi
  # Upstreams: the checkout's own branch and every declared worktree's.
  wt_all="$cur	$t
"
  i=0
  while IFS= read -r b; do
    i=$((i + 1))
    [ -n "$b" ] || continue
    wt_all="$wt_all$b	$(nth "$WT_DIRS" "$i")
"
  done <<EOF
$WT_NAMES
EOF
  while IFS="	" read -r b dir; do
    [ -n "$b" ] || continue
    if [ ! -d "$dir" ]; then drift missing-worktree "$p" "no worktree at $dir for $b (fleet-repo clone $p creates it)"; continue; fi
    # Only a branch the remote also has: a local-only branch has nothing to track yet, and clone
    # could not repair it, so reporting it would be a finding nobody can clear.
    if has_ref_c "$t" "refs/heads/$b" && has_ref_c "$t" "refs/remotes/origin/$b" \
       && ! git -C "$t" rev-parse -q --verify "$b@{u}" >/dev/null 2>&1; then
      drift no-upstream "$p" "branch $b has no upstream (fleet-repo clone $p repairs it)"
    fi
  done <<EOF
$wt_all
EOF
  # A table left from the time this entry was a container (wt-config-gen not re-run since the
  # manifest changed) would put new worktrees BESIDE the repository, outside the directory a
  # session may write. Only judged where the generated file exists.
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk/config.toml"
  if [ -f "$cfg" ]; then
    id=$(url_to_id "$P_URL")
    if [ -n "$id" ] && wt_table "$cfg" "$id" | grep -Fq '{{ repo_path }}/../'; then
      drift worktrunk-bare "$p" "the generated worktrunk config still places new worktrees beside the repository for $id (run: wt-config-gen)"
    fi
  fi
}

check_bare() {
  local p=$1 bare default dir b i want have wt_all cfg id
  bare=$(container_gitdir "$P_TARGET")
  dir="$MDIR/$P_PATH"
  if [ -z "$bare" ]; then
    if [ -d "$P_TARGET/.git" ] || [ -d "$dir/.git" ]; then
      drift plain-clone "$p" "a container is declared but $P_TARGET holds an ordinary clone. If it has changed over to a standard clone, the manifest entry has not: remove its container clause, point path: at the repository root and declare branch: (see the repository-layouts reference)"
    else
      drift no-container "$p" "nothing at $P_TARGET (run: fleet-repo clone $p)"
    fi
    return 0
  fi
  default=$(git --git-dir="$bare" symbolic-ref --short HEAD 2>/dev/null || true)
  [ -n "$default" ] || { drift no-container "$p" "$bare has no HEAD"; return 0; }

  if [ "$bare" = "$P_TARGET/.bare" ]; then
    drift old-layout "$p" "the git data is in $P_TARGET/.bare behind a pointer file; the current layout names it .git. Convert with nothing running in $P_TARGET (between the second and third command every worktree is broken, and any git process or session there would fail or hold it open), then move the container's Claude Code memory store to the project key without the --bare suffix:
    rm $P_TARGET/.git
    mv $P_TARGET/.bare $P_TARGET/.git
    git -C $P_TARGET/.git worktree repair"
  fi

  # The fetched set, compared offline: what the declaration asks for against the refspecs on disk.
  if [ "$P_MODE" = all ]; then want='*'
  else want=$(printf '%s\n%s%s\n' "$default" "$WT_NAMES" "$P_LIST" | list_dedupe); fi
  have=$(managed_refspecs "$bare")
  if [ -n "$(list_minus "$want" "$have")$(list_minus "$have" "$want")" ]; then
    drift refspec-drift "$p" "fetch refspecs differ from the declared set; missing: $(list_minus "$want" "$have" | brief); not declared: $(list_minus "$have" "$want" | brief)"
  fi

  # Worktrees and upstreams: the default branch and every declared one.
  wt_all="$default	$P_TARGET/$default
"
  i=0
  while IFS= read -r b; do
    i=$((i + 1))
    [ -n "$b" ] || continue
    [ "$b" != "$default" ] || continue
    wt_all="$wt_all$b	$(nth "$WT_DIRS" "$i")
"
  done <<EOF
$WT_NAMES
EOF
  while IFS="	" read -r b dir; do
    [ -n "$b" ] || continue
    if [ ! -d "$dir" ]; then drift missing-worktree "$p" "no worktree at $dir for $b"; continue; fi
    if has_ref "$bare" "refs/heads/$b" \
       && ! git --git-dir="$bare" rev-parse -q --verify "$b@{u}" >/dev/null 2>&1; then
      drift no-upstream "$p" "branch $b has no upstream (fleet-repo clone $p repairs it)"
    fi
  done <<EOF
$wt_all
EOF

  # wt-config-gen writes a per-project table; a container without one gets worktrunk's nested
  # default, so new worktrees land inside the default branch's checkout. Only judged on a machine
  # that has the generated file at all.
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk/config.toml"
  if [ -f "$cfg" ]; then
    id=$(url_to_id "$P_URL")
    if [ -n "$id" ] && ! grep -Fq "[projects.\"$id\"]" "$cfg"; then
      drift worktrunk-missing "$p" "the generated worktrunk config has no table for $id, so new worktrees would nest (run: wt-config-gen)"
    fi
  fi
}

cmd_check() {
  local project="" a names clones syncs n count=0 cands branches layout
  while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option '$a' (see --help)" 2 ;;
      *) [ -z "$project" ] || die "usage: fleet-repo check [<project>]" 2; project=$a ;;
    esac
  done
  load_manifest
  DRIFT=0
  if [ -n "$project" ]; then
    load_entry "$project"
    check_one "$project"
    count=1
  else
    # Assigned one at a time, in this shell: a die inside a command substitution or a loop
    # expression would only end that subshell and read as "no containers".
    # The entries examined: every one that declares a container, as always, plus every one that
    # declares mani's `branch:` and reads as standard. Not every standard entry: on a machine whose
    # manifest has not moved to standard clones, its plain entries were never examined, and an
    # entry that names its checkout branch is the one that has opted in.
    cands=$(projects_with container)
    clones=$(projects_with clone)
    branches=$(projects_with branch)
    cands=$(printf '%s\n%s\n%s\n' "$cands" "$clones" "$branches" | sort -u)
    names=""
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      decl_into layout --layout "$n" || continue
      if [ "$layout" = bare ] || printf '%s\n' "$branches" | grep -Fxq -- "$n"; then names="$names
$n"; fi
    done <<EOF
$cands
EOF
    names=$(printf '%s\n' "$names" | sort -u)
    syncs=$(projects_with sync)
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      # sync: false means this machine does not keep the repository, so its absence is not drift.
      # fleet-decl reads a YAML false as "not declared" (exit 1), so a declared key that reads as
      # absent is the false.
      if printf '%s\n' "$syncs" | grep -Fxq -- "$n" && ! decl_into a --entry "$n" sync; then continue; fi
      check_one "$n"; count=$((count + 1))
    done <<EOF
$names
EOF
  fi
  if [ "$DRIFT" -eq 0 ]; then say "$count repository(ies) match their declarations."; exit 0; fi
  exit 1
}

# ---- main -------------------------------------------------------------------------------------
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  clone) shift; cmd_clone "$@" ;;
  update) shift; cmd_update "$@" ;;
  check) shift; cmd_check "$@" ;;
  "") usage >&2; exit 2 ;;
  -*) die "unknown option '$1' (see --help)" 2 ;;
  *) die "unknown verb '$1' (clone, update or check; see --help)" 2 ;;
esac
