#!/bin/sh
# git-secret-scan — pre-commit hook: refuse a commit whose staged changes contain a plaintext secret.
#
# Wired as a git configured hook in ~/.gitconfig, so it runs in every repository on the machine,
# external clones included, with nothing installed per repository. Needs git 2.54+ (configured
# hooks) and gitleaks.
#
# Two scans of the staged changes, and either one refuses:
#   1. the FLOOR: gitleaks' default rules, from ~/.config/gitleaks/floor.toml. A repository cannot
#      weaken this one, because a repository config that defines its own rules replaces the
#      defaults rather than adding to them.
#   2. the repository's own .gitleaks.toml, when it has one, so its extra rules apply too.
# Both configs, and the scan target, are explicit paths. gitleaks looks for a repository config
# relative to the directory it is handed; git runs hooks from the top of the worktree, so that is
# already right inside a commit, and the explicit paths keep it right when this is run by hand.
#
# A finding that is not a secret is allowed where it lives: a `gitleaks:allow` comment on the line,
# or its fingerprint in the repository's .gitleaksignore. The scan itself offers no wider
# allowance. Git does let a repository disable any configured hook with a local setting
# (`git config hook.secret-scan.enabled false`); that is a deliberate act outside this script.
#
# It REFUSES rather than skips when gitleaks or the floor config is missing: a scan that silently
# does not run produces the same silence as one that passed.
set -u

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "git-secret-scan: gitleaks is not on PATH, so staged changes cannot be scanned for secrets. Commit refused." >&2
  echo "  install it (pacman: gitleaks; Homebrew: gitleaks) and commit again." >&2
  exit 1
fi

# A fixed path under $HOME, where the dotfiles deploy it, and deliberately not XDG_CONFIG_HOME:
# sessions point that at a scratch directory for tools that need a writable config dir, and the
# scan then refused every commit for want of a floor that was sitting at the usual place.
floor="$HOME/.config/gitleaks/floor.toml"
if [ ! -f "$floor" ]; then
  echo "git-secret-scan: the floor config $floor is missing, so the default rules cannot be enforced. Commit refused." >&2
  echo "  it ships with the dotfiles base; apply that." >&2
  exit 1
fi

top=$(git rev-parse --show-toplevel) || exit 1

# --redact keeps a found secret out of the terminal, and so out of any transcript reading it.
scan() {
  gitleaks git --pre-commit --staged --redact --no-banner --verbose --config "$1" "$top"
}

refuse() {
  printf '%s\n' "$2" >&2
  echo "git-secret-scan: $1 found what looks like a plaintext secret in the staged changes. Commit refused." >&2
  echo "  remove it, or, if it is not a secret, mark the line with a gitleaks:allow comment." >&2
  exit 1
}

out=$(scan "$floor" 2>&1) || refuse "the default rules" "$out"
if [ -f "$top/.gitleaks.toml" ]; then
  out=$(scan "$top/.gitleaks.toml" 2>&1) || refuse "this repository's .gitleaks.toml" "$out"
fi
exit 0
