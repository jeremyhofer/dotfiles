#!/usr/bin/env bash
set -e
gitDir=$(git rev-parse --git-dir | sed 's/\/\.bare.*//')
[[ $gitDir == '.bare' ]] && gitDir=$(pwd)

# --- post-worktree-create extension point --------------------------------------------------------
# A new worktree is the moment a per-worktree defect is BORN and the cheapest moment to catch it:
# whoever is here is about to run an install anyway. This base repo is public and must not depend on
# any private tooling, so it does not name a checker -- it offers a documented hook and runs it if
# something has been installed there. That is the base-provides-the-mechanism split.
#
# CONTRACT: ~/.dotlocal/hooks/post-worktree-create <absolute-worktree-path>
# ADVISORY ONLY. Its exit status is deliberately discarded -- a reporting hook must never be able to
# fail a worktree creation, and a guard people route around is worse than no guard at all.
run_post_worktree_create_hook() {
  hook="$HOME/.dotlocal/hooks/post-worktree-create"
  [ -x "$hook" ] || return 0
  "$hook" "$1" || true
}

[[ -z "$1" ]] && echo "Usage: git-nb <branch-name>" && exit 1
baseName=$(basename "$1")
git fetch

if [[ -z "$2" ]]; then
    cd "$gitDir" && git worktree add "$baseName" "$1"
else
    cd "$gitDir" && git worktree add -b "$baseName" "$2"
fi

run_post_worktree_create_hook "$gitDir/$baseName"
