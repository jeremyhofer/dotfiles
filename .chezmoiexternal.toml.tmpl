# All externals are archives, not git-repos, deliberately: a global git URL rewrite
# (https://github.com/ -> SSH) turns anonymous git fetches into key-requiring SSH fetches,
# and chezmoi aborts the whole apply part-way when an external refresh fails — which bites
# hardest on a dormant machine (externals stale past refreshPeriod, agent keys not yet
# loaded) where the pending change set is largest. Archives download over chezmoi's own
# HTTP client: git is never invoked, no key is ever needed, and the rewrite (kept for
# everything else by preference) is irrelevant here. `exact` keeps each tree pristine,
# which also cleaned up the legacy .git dirs from the old git-repo deployments.

[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/nx-completion"]
    type = "archive"
    url = "https://github.com/jscutlery/nx-completion/archive/main.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# avoid-ai-writing — a third-party prose lint, PINNED to a release tag rather than tracking a
# branch like the externals above. Those deliver shell code that is already trusted; this
# delivers INSTRUCTIONS AN AGENT OBEYS, so an unattended refresh could change what a session is
# told without anyone reviewing it. Pinning makes an upgrade a one-line bump that can be diffed.
# Measured at adoption: the default branch was 56 commits and 300 changed files ahead of the
# newest tag, and this skill's own body differed by ~46% between the two -- so "latest" and
# "released" are not close together in this project.
#
# `include` patterns match the member paths AS THEY APPEAR IN THE ARCHIVE, before
# stripComponents is applied; stripComponents then removes the leading 5 components so
# SKILL.md lands at the root of the target directory. Verified by extracting the archive.
[".claude/skills/avoid-ai-writing"]
    type = "archive"
    url = "https://github.com/conorbronsdon/avoid-ai-writing/archive/refs/tags/v3.35.0.tar.gz"
    exact = true
    stripComponents = 5
    include = ["*/plugins/avoid-ai-writing/skills/avoid-ai-writing/**"]

# The licence is at the archive root, outside the subtree above, and MIT requires the notice
# travel with the copy. `archive-file` extracts a single member, named by `path`.
[".claude/skills/avoid-ai-writing/LICENSE"]
    type = "archive-file"
    url = "https://github.com/conorbronsdon/avoid-ai-writing/archive/refs/tags/v3.35.0.tar.gz"
    path = "avoid-ai-writing-3.35.0/LICENSE"
