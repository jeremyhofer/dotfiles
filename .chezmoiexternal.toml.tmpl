# All externals are archives, not git-repos, deliberately: a global git URL rewrite
# (https://github.com/ -> SSH) turns anonymous git fetches into key-requiring SSH fetches,
# and chezmoi aborts the whole apply part-way when an external refresh fails — which bites
# hardest on a dormant machine (externals stale past refreshPeriod, agent keys not yet
# loaded) where the pending change set is largest. Archives download over chezmoi's own
# HTTP client: git is never invoked, no key is ever needed, and the rewrite (kept for
# everything else by preference) is irrelevant here. `exact` keeps each tree pristine,
# which also cleaned up the legacy .git dirs from the old git-repo deployments.

[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh/custom/plugins/nx-completion"]
    type = "archive"
    url = "https://github.com/jscutlery/nx-completion/archive/main.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".tmux/plugins/tpm"]
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/master.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

{{/* Pinned third-party skills, generated from .chezmoidata.yaml `skill_externals`.

     PINNED TO A TAG, deliberately unlike every external above. Those deliver shell code that is
     already trusted; a skill delivers INSTRUCTIONS AN AGENT OBEYS, so an unattended refresh could
     change what a session is told with nobody reviewing it. A default branch routinely runs well
     ahead of its newest release, so tracking one deploys content that no release ever contained.

     stripComponents and the include glob are DERIVED from `subtree` rather than hand-written:
     the archive root is one component, so stripping (1 + depth of subtree) lands SKILL.md at the
     root of the target. `include` matches member paths AS THEY APPEAR IN THE ARCHIVE, before any
     stripping -- verified by extraction, not assumed. A companion verifier script asserts what
     actually landed, because these are positional assumptions about someone else's layout and a
     repackage upstream would otherwise install an empty or mis-nested directory in silence. */}}
{{ range .skill_externals -}}
{{ $root := printf "%s-%s" (base .repo) .version -}}
{{ $strip := add 1 (len (splitList "/" .subtree)) -}}
[".claude/skills/{{ .name }}"]
    type = "archive"
    url = "https://github.com/{{ .repo }}/archive/refs/tags/v{{ .version }}.tar.gz"
    exact = true
    stripComponents = {{ $strip }}
    include = ["*/{{ .subtree }}/**"]

{{/* The licence sits at the archive root, outside the subtree, and MIT requires the notice
     travel with the copy. Its `path` embeds the version, which is exactly the kind of string
     that gets forgotten in a bump -- hence templated from the same single source. */}}
[".claude/skills/{{ .name }}/LICENSE"]
    type = "archive-file"
    url = "https://github.com/{{ .repo }}/archive/refs/tags/v{{ .version }}.tar.gz"
    path = "{{ $root }}/LICENSE"
{{ end -}}
