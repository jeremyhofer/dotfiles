# vim: ft=zsh
# ~/.zshenv — read by EVERY zsh: login, interactive, non-interactive, scripts, `ssh host cmd`.
# The universal ENV layer: exports only, fast, silent, no TTY assumptions. PATH lives
# here (not .zprofile/.zshrc) so non-interactive / ssh / GUI-adjacent contexts get it too.

typeset -U path fpath
path=($path "$HOME/.local/bin" "$HOME/go/bin")
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew ahead of the system dirs, so its tools win over the older copies macOS ships (git
# especially: the base Brewfile declares it so every machine runs the same current version).
# Login shells lose this to /etc/zprofile's path_helper, which runs after this file and moves the
# system dirs back to the front, so ~/.zprofile prepends again. `typeset -U` keeps the first copy.
[ -d /opt/homebrew/bin ] && path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
{{ end -}}
# User completions dir, prepended so it's on fpath before omz runs compinit (zshenv precedes zshrc).
# Holds generated tool completions (e.g. _mani) that aren't shipped as omz plugins.
fpath=("$HOME/.local/share/zsh/completions" $fpath)

export EDITOR='nvim'

# Shared local-dev TLS cert paths (paths, not secrets) — projects read these instead of hardcoding,
# so the cert's issuer/location can change without touching any project.
export DEV_TLS_CERT="${DEV_TLS_CERT:-$HOME/.local/share/devcerts/localhost.pem}"
export DEV_TLS_KEY="${DEV_TLS_KEY:-$HOME/.local/share/devcerts/localhost-key.pem}"

# mani finds a manifest only at or above the current directory; outside ~/Devel it fails. It reads
# MANI_CONFIG only when that search finds nothing, so a repository's own mani.yaml still wins and
# this makes the fleet manifest the fallback from anywhere. tests/test-mani-config.sh checks both.
[ -f "$HOME/Devel/mani.yaml" ] && export MANI_CONFIG="${MANI_CONFIG:-$HOME/Devel/mani.yaml}"
{{ if eq .chezmoi.os "linux" -}}
# Session env shared with ~/.config/environment.d — rendered from the same SSOT (.chezmoidata.yaml),
# so shells and the systemd/GUI session env can't drift.
{{ range .session_env -}}
export {{ .name }}="{{ .value }}"
{{ end -}}
{{- end }}

# Private env layer (overlay), if present.
[ -f "$HOME/.dotlocal/zshenv" ] && source "$HOME/.dotlocal/zshenv"
