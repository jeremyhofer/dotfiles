#!/bin/sh
# Installs the FALLBACK pre-push leak floor into the chezmoi SOURCE repo
# (.git/hooks/pre-push). The full leak-guard (markers + sensitive terms) runs globally
# when the domain supplies its pattern files; this floor is what a clone without them
# still gets. The hook lives in .git/hooks (never pushed), so it may
# hold the literal overlay URL; THIS installer is committed+public, so it injects that URL
# via the {{ "{{ .overlayRepo }}" }} template var rather than a literal.
set -eu

src="{{ .chezmoi.sourceDir }}"
[ -d "$src/.git" ] || exit 0          # only meaningful in the git-backed source repo
hook="$src/.git/hooks/pre-push"
mkdir -p "$src/.git/hooks"

cat > "$hook" <<'HOOK'
#!/bin/sh
# Generic pre-push floor for a clone whose domain supplies no leak-guard patterns.
# The full leak-guard (markers + sensitive terms) runs as a global configured hook
# when it has them; this is only the fallback.
KEY_RE='-----BEGIN[ A-Z]*PRIVATE KEY-----'
OVERLAY='{{ .overlayRepo }}'
zero=0000000000000000000000000000000000000000
block=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  hits=$(git grep -nIE "$KEY_RE" "$lsha" 2>/dev/null || true)
  [ -n "$OVERLAY" ] && hits="$hits
$(git grep -nIF "$OVERLAY" "$lsha" 2>/dev/null || true)"
  hits=$(printf '%s\n' "$hits" | sed '/^$/d')
  [ -n "$hits" ] && { echo "content leak:" >&2; printf '%s\n' "$hits" >&2; block=1; }
done
[ "$block" -ne 0 ] && { echo "pre-push BLOCKED: private key or overlay URL in the push." >&2; exit 1; }
exit 0
HOOK

chmod +x "$hook"
echo "installed pre-push leak guard -> $hook"

# --- pre-commit: run the test suite unless only documentation changed ----------------------
#
# WHY THIS EXISTS. The base ships 20 test suites and, until 2026-08-29, nothing ran them:
# no runner, no CI, no hook. They were exercised only when someone remembered, one file at
# a time. The whole suite takes ~10s, so cost was never the reason -- it simply had no
# trigger. `tests/run-all.sh` is the runner; this is the trigger.
#
# SCOPED, deliberately: a commit that touches only documentation (docs/ and the repository's
# own *.md files at the root) skips it. Everything else that deploys or runs has a suite that
# reads it -- the settings merge, the git hook entries, the template fragments, the skeleton --
# and an earlier, narrower trigger let changes to those commit without the suites that cover
# them. tests/test-pre-commit-trigger.sh pins the rule.
#
# COMMIT PATH, not a build lane: a gate reachable only through a lane goes dark whenever
# something earlier in that lane fails, and says nothing when it does.
#
# It lives in .git/hooks (never pushed) and is installed from here so every machine that
# applies the base gets it, rather than depending on each machine being told to wire it up.
#
# INSTALLED BY install-test-gate, the tool private layers use for the same gate, so the base runs the
# one generated hook rather than a second copy of it (the copies had drifted: both judged the working
# tree, and only one was going to be fixed). That hook runs the suite under git-staged-run, so it
# judges what is staged. It is run from this source tree, because this script can run before the
# base's bin/ is deployed. tests/test-pre-commit-trigger.sh pins the scope against this invocation.
sh "$src/private_dot_local/bin/executable_install-test-gate" "$src" --label dotfiles-base --skip-var SKIP_BASE_TESTS
