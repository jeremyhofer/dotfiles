#!/bin/sh
# Installs the FALLBACK pre-push leak-guard floor into the chezmoi SOURCE repo
# (.git/hooks/pre-push). The FULL publish-boundary guard (markers + sensitive terms) is
# provided globally by the overlay when present; this floor is what a public-base-only
# clone (no overlay) still gets. The hook lives in .git/hooks (never pushed), so it may
# hold the literal overlay URL; THIS installer is committed+public, so it injects that URL
# via the {{ "{{ .overlayRepo }}" }} template var rather than a literal.
set -eu

src="{{ .chezmoi.sourceDir }}"
[ -d "$src/.git" ] || exit 0          # only meaningful in the git-backed source repo
hook="$src/.git/hooks/pre-push"
mkdir -p "$src/.git/hooks"

cat > "$hook" <<'HOOK'
#!/bin/sh
# Generic pre-push floor for a public-base-only clone (no overlay). The FULL
# publish-boundary guard (markers + sensitive terms) is provided by the overlay's
# global core.hooksPath hook when present; this is only the fallback for a bare clone.
KEY_RE='-----BEGIN[ A-Z]*PRIVATE KEY-----'
OVERLAY='{{ .overlayRepo }}'
zero=0000000000000000000000000000000000000000
block=0
while read -r lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  hits=$(git grep -nIE "$KEY_RE" "$lsha" 2>/dev/null || true)
  [ -n "$OVERLAY" ] && hits="$hits
$(git grep -nIF "$OVERLAY" "$lsha" 2>/dev/null || true)"
  hits=$(printf '%s\n' "$hits" | sed '/^$/d')
  [ -n "$hits" ] && { echo "content leak:" >&2; printf '%s\n' "$hits" >&2; block=1; }
done
[ "$block" -ne 0 ] && { echo "pre-push BLOCKED: private key or overlay URL in the push." >&2; exit 1; }
exit 0
HOOK

chmod +x "$hook"
echo "installed pre-push leak guard -> $hook"

# --- pre-commit: run the test suite when a shipped script or a test changes -------------
#
# WHY THIS EXISTS. The base ships 20 test suites and, until 2026-08-29, nothing ran them:
# no runner, no CI, no hook. They were exercised only when someone remembered, one file at
# a time. The whole suite takes ~10s, so cost was never the reason -- it simply had no
# trigger. `tests/run-all.sh` is the runner; this is the trigger.
#
# SCOPED, deliberately. It fires only when something under private_dot_local/bin/, setup/
# or tests/ is staged, so a docs- or config-only commit is not taxed. A gate that fires on
# every commit gets disabled, and then it guards nothing.
#
# COMMIT PATH, not a build lane: a gate reachable only through a lane goes dark whenever
# something earlier in that lane fails, and says nothing when it does.
#
# It lives in .git/hooks (never pushed) and is installed from here so every machine that
# applies the base gets it, rather than depending on each machine being told to wire it up.
pre_commit="$src/.git/hooks/pre-commit"
cat > "$pre_commit" <<'HOOK'
#!/bin/sh
# dotfiles-base pre-commit (generated by run_onchange_install-git-hooks.sh).
# Runs tests/run-all.sh when a shipped script or a test is staged. ~10s.
# Deliberate WIP commit: SKIP_BASE_TESTS=1 git commit ...
set -eu
[ "${SKIP_BASE_TESTS:-0}" = "1" ] && exit 0
# Git exports GIT_DIR, GIT_INDEX_FILE and friends into a hook, and they are INHERITED by
# everything the hook runs. A suite that shells out to git then sees the wrong repo -- worse,
# GIT_DIR makes ANY directory look like a repo, so a test asserting "this is not a repo"
# fails. Measured: the overlay gate reported test-ci-bridge-workdir.sh failing during a real
# commit while it passed standalone. A gate that cries wolf gets disabled, so clear them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES 2>/dev/null || true
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
printf '%s\n' "$staged" | grep -qE '^(private_dot_local/bin/|setup/|tests/)' || exit 0
[ -f "$root/tests/run-all.sh" ] || exit 0
if ! out=$(cd "$root" && sh tests/run-all.sh 2>&1); then
  printf '\n%s\n' "pre-commit: the base test suite failed — commit refused:" >&2
  printf '%s\n' "$out" >&2
  printf '\n%s\n' "  re-run with: sh tests/run-all.sh [filter]" >&2
  printf '%s\n' "  deliberate WIP commit: SKIP_BASE_TESTS=1 git commit ..." >&2
  exit 1
fi
HOOK
chmod +x "$pre_commit"
echo "installed base test-suite pre-commit -> $pre_commit"
